{
  "name": "posttruncate-com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "predev": "node scripts/optimize-images.mjs && astro sync",
    "build": "astro build",
    "prebuild": "node scripts/optimize-images.mjs",
    "postbuild": "node scripts/prune-dist-originals.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs scripts/check-i18n.mjs",
    "test:fast": "npm run typecheck && npm run lint",
    "test:lib": "node --experimental-strip-types --import ./scripts/ts-resolve.mjs --test \"src/lib/**/*.test.ts\"",
    "clean": "node -e \"for (const d of ['.astro','dist']) require('node:fs').rmSync(d, { recursive: true, force: true })\"",
    "clean:full": "node -e \"for (const d of ['.astro','dist','node_modules']) require('node:fs').rmSync(d, { recursive: true, force: true })\" && npm install",
    "fresh": "npm run clean && astro sync && astro dev",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.2",
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/preact": "^4.1.3",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^5.18.2",
    "cheerio": "^1.2.0",
    "preact": "^10.29.2",
    "sharp": "0.34.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
