{
  // Root Wrangler config. The @astrojs/cloudflare adapter reads this as the base
  // and merges Astro's generated settings (ASSETS binding, SESSION KV, IMAGES,
  // compatibility date) on top into dist/server/wrangler.json at build time.
  // Put durable, rebuild-safe settings HERE, not in the generated file.
  "name": "posttruncate-com",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": [ "nodejs_compat" ],
  
  // Explicitly tell Cloudflare Workers where the generated Astro server script and static assets are
  "main": "./dist/_worker.js/index.js",
  // `binding: "ASSETS"` is REQUIRED, not optional: the @astrojs/cloudflare
  // adapter serves prerendered pages (incl. the custom 404/500) by calling
  // env.ASSETS.fetch(request). Without this binding env.ASSETS is undefined and
  // the Worker throws "Cannot read properties of undefined (reading 'fetch')"
  // → Cloudflare Error 1101 on any path that reaches the Worker (e.g.
  // /[lang]/<unknown>). `not_found_handling` makes the asset layer serve our
  // built 404.html for unmatched static requests.
  //
  // `run_worker_first` lists the paths that MUST invoke the Worker before the
  // asset layer. Two reasons a path needs to be here:
  //  • "/" — the bare-root locale router has no static index.html (it's an
  //    on-demand SSR redirect), so with asset-first routing +
  //    not_found_handling:"404-page" the asset layer would answer HTML
  //    navigations to "/" with the cached 404.html and never invoke the Worker
  //    (browsers send `Accept: text/html`; a plain curl slips through). This
  //    forces "/" to run the Worker first so geo/language detection runs.
  //  • "/api/*" — the static-asset server only handles GET/HEAD. A POST to an
  //    asset-first path (no matching static file) is rejected with 405 BEFORE it
  //    reaches the SSR handler, so /api/improve must run the Worker first or
  //    every POST returns 405. GET pages fall through to the Worker fine; only
  //    non-GET methods hit this, which is why it surfaced as a 405 on POST.
  //  • "/admin" + "/admin/*" — the admin PAGES are SSR (prerender = false) so the
  //    Basic-Auth gate in src/middleware.ts runs (a prerendered page is
  //    asset-served and would bypass the Worker). Like "/", SSR routes need to be
  //    worker-first so not_found_handling doesn't answer them with 404.html. The
  //    one static admin file, /admin/config.yml, is matched by /admin/* and is
  //    served by the gate via env.ASSETS.fetch() after auth. Backed by the
  //    ADMIN_AUTH secret (below); the gate fails closed when it is unset.
  // Every other path keeps the fast asset-first behavior.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [ "/", "/api/*", "/admin", "/admin/*" ]
  },

  // Serve the Worker at both the apex and the www hostname. custom_domain:true
  // tells Cloudflare to manage the DNS record + edge certificate for each
  // hostname and point it at this Worker (this is preferred over raw
  // pattern/zone_name routes for serving a whole site — no manual proxied DNS
  // record or cert wrangling needed). The bare-root locale router inside the
  // Worker then 302s either host to the visitor's /<lang>/ path.
  "routes": [
    { "pattern": "posttruncate.com", "custom_domain": true },
    { "pattern": "www.posttruncate.com", "custom_domain": true }
  ],
  // KV namespace backing the /api/improve rate limiter (3 AI rewrites per
  // visitor IP per 12h). Local dev (miniflare) emulates this automatically by
  // binding name. For production, create the namespace once and paste its id:
  //   npx wrangler kv namespace create AI_RATELIMIT
  // The GEMINI_API_KEY is a *secret*, set with:
  //   npx wrangler secret put GEMINI_API_KEY   (and .dev.vars for local dev)
  // GROQ_API_KEY (optional) is also a *secret* — it enables the Llama 3.3 70B
  // fallback used when Gemini fails or returns an empty/truncated rewrite:
  //   npx wrangler secret put GROQ_API_KEY     (and .dev.vars for local dev)
  // GROQ_API_KEY is an optional *secret* enabling the Llama 3.3 70B fallback
  // (used when Gemini errors or returns an empty/truncated rewrite). Set with:
  //   npx wrangler secret put GROQ_API_KEY     (and .dev.vars for local dev)
  // GROQ_API_KEY is an optional *secret* enabling the Llama 3.3 70B fallback
  // used when Gemini errors or returns an empty/truncated rewrite:
  //   npx wrangler secret put GROQ_API_KEY     (and .dev.vars for local dev)
  // ADMIN_AUTH: HTTP Basic Auth credential guarding /admin/* (see
  // src/middleware.ts). A single "username:password" string. The gate fails
  // CLOSED — if unset in production, every /admin/* request returns 401. The
  // localhost dev server (astro dev) skips the gate. Set with:
  //   npx wrangler secret put ADMIN_AUTH        (value: user:password)
  // To exercise the gate in local `wrangler dev`, pass --var ADMIN_AUTH:user:pass.
  // SESSION: required by the @astrojs/cloudflare adapter, which auto-enables
  // Astro sessions with the cloudflare-kv-binding driver bound as "SESSION".
  // Local dev (miniflare) emulates this by name, so it only fails in
  // production — a missing binding throws at runtime on every on-demand route
  // (/, /[lang]/, /api/improve) → Cloudflare Error 1101. Create it once:
  //   npx wrangler kv namespace create SESSION
  // then paste the returned id below.
  "kv_namespaces": [
    { "binding": "AI_RATELIMIT", "id": "1c6900843cb84f74971e30fc8070997d" },
    { "binding": "SESSION", "id": "bdf2b44c5ce24b89a9443cc23312c4dd" }
  ]
}