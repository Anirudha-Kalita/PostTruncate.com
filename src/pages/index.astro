---
// Bare-root locale router. This page must run on demand so it can inspect each
// visitor's request headers instead of shipping a one-size static redirect.
export const prerender = false;

import {
  DEFAULT_LOCALE,
  LOCALE_CODES,
  isLocale,
  getLocale,
  type LocaleCode,
} from '../i18n/config';

const LANGUAGE_COOKIE = 'preferred_locale';
// Geo-IP is the primary signal, with browser language as a secondary fallback,
// so the response varies on the visitor's country signal, a saved cookie, and
// Accept-Language.
const REDIRECT_VARY =
  'Cookie, x-vercel-ip-country, cf-ipcountry, x-country-code, x-nf-country, fastly-client-country-code, Accept-Language';

const COUNTRY_LOCALE = {
  AD: 'es',
  AR: 'es',
  BO: 'es',
  CL: 'es',
  CO: 'es',
  CR: 'es',
  CU: 'es',
  DO: 'es',
  EC: 'es',
  ES: 'es',
  GT: 'es',
  HN: 'es',
  MX: 'es',
  NI: 'es',
  PA: 'es',
  PE: 'es',
  PR: 'es',
  PY: 'es',
  SV: 'es',
  UY: 'es',
  VE: 'es',

  AT: 'de',
  CH: 'de',
  DE: 'de',
  LI: 'de',

  BE: 'fr',
  FR: 'fr',
  LU: 'fr',
  MC: 'fr',

  AO: 'pt',
  BR: 'pt',
  MZ: 'pt',
  PT: 'pt',

  IT: 'it',
  SM: 'it',
  VA: 'it',

  NL: 'nl',
  SR: 'nl',

  JP: 'ja',

  CN: 'zh',
  HK: 'zh',
  MO: 'zh',
  TW: 'zh',

  DK: 'da',

  AU: 'en',
  CA: 'en',
  GB: 'en',
  IE: 'en',
  IN: 'en',
  NZ: 'en',
  SG: 'en',
  US: 'en',
  ZA: 'en',
} satisfies Record<string, LocaleCode>;

type CloudflareRequest = Request & {
  cf?: {
    country?: string;
  };
};

const supportedLocales = new Set(LOCALE_CODES);
const requestUrl = new URL(Astro.request.url);

const normalizeLocale = (value: string | null | undefined): LocaleCode | undefined => {
  const base = value?.trim().toLowerCase().replace('_', '-').split('-')[0];
  return isLocale(base) ? base : undefined;
};

const redirectTarget = (locale: LocaleCode) => {
  const { slug } = getLocale(locale);
  const target = new URL(`/${locale}/${slug}/`, requestUrl);
  for (const [key, value] of requestUrl.searchParams) {
    if (key.toLowerCase() !== 'lang') target.searchParams.append(key, value);
  }
  return `${target.pathname}${target.search}`;
};

const redirectTo = (locale: LocaleCode) => {
  const response = Astro.redirect(redirectTarget(locale), 302);
  response.headers.set('Vary', REDIRECT_VARY);
  return response;
};

const getBrowserLocale = (): LocaleCode | undefined => {
  const browserLocales = [
    Astro.preferredLocale,
    ...(Astro.preferredLocaleList ?? []),
  ];

  for (const locale of browserLocales) {
    const normalized = normalizeLocale(locale);
    if (normalized && supportedLocales.has(normalized)) return normalized;
  }
};

const getGeoCountry = () => {
  const request = Astro.request as CloudflareRequest;
  const headers = Astro.request.headers;

  return (
    request.cf?.country ??
    headers.get('x-vercel-ip-country') ??
    headers.get('cf-ipcountry') ??
    headers.get('x-country-code') ??
    headers.get('x-nf-country') ??
    headers.get('fastly-client-country-code') ??
    ''
  )
    .trim()
    .toUpperCase();
};

const getGeoLocale = (): LocaleCode | undefined => {
  const country = getGeoCountry();
  return (COUNTRY_LOCALE as Record<string, LocaleCode>)[country];
};

const queryLocale = normalizeLocale(requestUrl.searchParams.get('lang'));
if (queryLocale) {
  Astro.cookies.set(LANGUAGE_COOKIE, queryLocale, {
    path: '/',
    maxAge: 60 * 60 * 24 * 365,
    sameSite: 'lax',
  });

  return redirectTo(queryLocale);
}

// Precedence: an explicit saved choice (set via ?lang= or the language
// switcher) always wins; then the visitor's IP country; then browser language
// (Accept-Language) as a fallback when geo is unknown/unmapped; English is the
// final fallback.
const savedLocale = normalizeLocale(Astro.cookies.get(LANGUAGE_COOKIE)?.value);
const detectedLocale =
  savedLocale ?? getGeoLocale() ?? getBrowserLocale() ?? DEFAULT_LOCALE;

return redirectTo(detectedLocale);
---
