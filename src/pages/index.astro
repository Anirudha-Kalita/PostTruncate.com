---
// Root redirect (/) → a locale landing page. Every locale is URL-prefixed, so
// "/" itself renders nothing meaningful; this picks the best language and
// forwards. Resolution order, all client-side so the static HTML stays cacheable:
//   1. a previously stored choice (localStorage 'lang')
//   2. the browser's preferred languages (navigator.languages)
//   3. the default locale (en)
// A <meta http-equiv="refresh"> + <noscript> link guarantee a forward even with
// JS disabled or before the inline script runs.
import { LOCALE_CODES, DEFAULT_LOCALE } from '../i18n/config';

const codes = LOCALE_CODES;
const fallback = `/${DEFAULT_LOCALE}/`;
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PostTruncate</title>
    <link rel="canonical" href={fallback} />
    {/* JS-off / pre-script fallback: forward to the default locale. */}
    <meta http-equiv="refresh" content={`0; url=${fallback}`} />
    <meta name="robots" content="noindex" />

    <script is:inline define:vars={{ codes, fallback }}>
      (function () {
        try {
          var pick = function () {
            var stored = null;
            try {
              stored = localStorage.getItem('lang');
            } catch (e) {}
            if (stored && codes.indexOf(stored) !== -1) return stored;

            var prefs = navigator.languages || [navigator.language || ''];
            for (var i = 0; i < prefs.length; i++) {
              var base = String(prefs[i]).toLowerCase().split('-')[0];
              if (codes.indexOf(base) !== -1) return base;
            }
            return null;
          };
          var lang = pick();
          // Replace (not push) so the bare "/" doesn't sit in history between
          // the user and the back button.
          location.replace(lang ? '/' + lang + '/' : fallback);
        } catch (e) {
          location.replace(fallback);
        }
      })();
    </script>
  </head>
  <body>
    <noscript>
      <p>
        Redirecting to PostTruncate. <a href={fallback}>Continue</a>.
      </p>
    </noscript>
  </body>
</html>
