---
// Sveltia CMS entry point, served at /admin/ — deliberately OUTSIDE the [lang]
// i18n routing (no locale prefix). It's a thin loader: the CMS is a client-side
// SPA that reads its config from /admin/config.yml (a static file in public/).
//
// • noindex/nofollow so search engines never list the admin UI.
// • Excluded from the sitemap via a filter rule in astro.config.mjs.
// • No site Layout (no nav/footer) — the CMS owns the whole viewport.
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Content Manager · PostTruncate</title>
  </head>
  <body>
    <!-- is:inline so Astro doesn't bundle/transform the external CMS module.
         Sveltia auto-loads ./config.yml (i.e. /admin/config.yml).

         PINNED to an exact version + Subresource-Integrity hash so this
         third-party script (which authenticates to GitHub with write access to
         this repo) can neither silently change nor be tampered with on the CDN:
         the browser refuses to run the file if its hash doesn't match. The
         @<version> URL is immutable, and the dist bundle is self-contained
         (no external sub-imports), so the one hash covers all of it.
         To upgrade: bump the version, then regenerate the hash with
           curl -sL "https://unpkg.com/@sveltia/cms@<VER>/dist/sveltia-cms.js" \
             | openssl dgst -sha384 -binary | openssl base64 -A -->
    <script
      is:inline
      type="module"
      src="https://unpkg.com/@sveltia/cms@0.169.1/dist/sveltia-cms.js"
      integrity="sha384-bZPXv5iCz/2JNwBehhFWqz6qWmJ0z9GrJYbWpm9S/YYviAs5yLypyxUp+U8ps7DP"
      crossorigin="anonymous"></script>
  </body>
</html>
