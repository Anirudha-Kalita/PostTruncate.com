---
import Layout from '../../layouts/Layout.astro';
import ContactContent from '../../components/ContactContent.astro';
import { getTranslations } from '../../i18n';
import { LOCALE_CODES } from '../../i18n/config';

// Bare Contact route (/[lang]/contact/). Shares its body with the slug-prefixed
// /[lang]/<slug>/contact/ route via ContactContent.
export function getStaticPaths() {
  return LOCALE_CODES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const page = getTranslations(lang).pages.contact;
---

<Layout
  lang={lang}
  path="/contact/"
  title={page.title}
  description={page.description}
>
  <ContactContent lang={lang} />
</Layout>
