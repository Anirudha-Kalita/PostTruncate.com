---
import Layout from '../../../layouts/Layout.astro';
import TermsContent from '../../../components/TermsContent.astro';
import { getTranslations } from '../../../i18n';
import { interp } from '../../../i18n/interp';
import { LOCALES } from '../../../i18n/config';

export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l.code, slug: l.slug } }));
}

const { lang } = Astro.params as { lang: string };
const t = getTranslations(lang);
const page = t.pages.terms;
const lastUpdated = interp(t.pages.common.lastUpdated, {
  date: t.pages.common.lastUpdatedDate,
});
---

<Layout
  lang={lang}
  path="/terms/"
  title={page.title}
  description={page.description}
>
  <TermsContent
    lang={lang}
    page={page}
    lastUpdated={lastUpdated}
    lastUpdatedDate={t.pages.common.lastUpdatedDate}
    backHome={t.pages.common.backHome}
  />
</Layout>
