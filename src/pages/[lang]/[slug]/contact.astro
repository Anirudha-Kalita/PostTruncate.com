---
import Layout from '../../../layouts/Layout.astro';
import ContactContent from '../../../components/ContactContent.astro';
import { getTranslations } from '../../../i18n';
import { LOCALES } from '../../../i18n/config';

// Slug-prefixed Contact route (/[lang]/<slug>/contact/) — the one the nav links
// to. Shares its body with /[lang]/contact/ via ContactContent.
export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l.code, slug: l.slug } }));
}

const { lang } = Astro.params as { lang: string };
const page = getTranslations(lang).pages.contact;
---

<Layout
  lang={lang}
  path="/contact/"
  title={page.title}
  description={page.description}
  footerVariant="minimal"
>
  <ContactContent lang={lang} />
</Layout>
