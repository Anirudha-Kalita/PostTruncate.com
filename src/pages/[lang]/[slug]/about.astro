---
import Layout from '../../../layouts/Layout.astro';
import AboutContent from '../../../components/AboutContent.astro';
import { getTranslations } from '../../../i18n';
import { LOCALES } from '../../../i18n/config';

export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l.code, slug: l.slug } }));
}

const { lang } = Astro.params as { lang: string };
const t = getTranslations(lang);
const page = t.pages.about;
---

<Layout
  lang={lang}
  path="/about/"
  title={page.title}
  description={page.description}
  footerVariant="minimal"
>
  <AboutContent lang={lang} page={page} backHome={t.pages.common.backHome} authorImage="/author-anirudha.webp" authorImageSectionIndex={1} authorImageAlt={t.images.authorAlt} />
</Layout>
