---
import Layout from '../../../layouts/Layout.astro';
import Ad from '../../../components/Ad.astro';
import Dashboard from '../../../components/island/Dashboard.tsx';
import HomePageSchema from '../../../components/HomePageSchema.astro';
import { getTranslations } from '../../../i18n';
import { interp } from '../../../i18n/interp';
import { LOCALES, getLocale } from '../../../i18n/config';
import { tools } from '../../../data/tools';
import PlatformBanner from '../../../components/PlatformBanner.astro';
import TrustBar from '../../../components/TrustBar.astro';
import HowItWorks from '../../../components/HowItWorks.astro';

// One statically-rendered landing page per locale at the keyword-rich slug
// (/en/character-counter/, /de/zeichenzaehler/, …). Slug values come from the
// LOCALES registry so they stay in sync with Nav, Footer, and hreflang tags.
export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l.code, slug: l.slug } }));
}

const { lang } = Astro.params as { lang: string };
const t = getTranslations(lang);
const locale = getLocale(lang);

// Resolve locale-specific slugs for the platform sub-tool pages.
const toolSlugs: Record<string, string> = {};
for (const tool of tools) {
  toolSlugs[tool.id] = tool.slugs[lang] ?? tool.slugs['en'];
}

// Referral banner: the ?platform= param is only known at runtime (static page),
// so we pass all translated platform data to the client script via data attributes.
const bannerPlatforms = {
  linkedin:  { name: t.guides.items.linkedin.name,  logoAlt: interp(t.images.platformLogo, { platform: t.guides.items.linkedin.name }),  cardId: 'platform-card-linkedin', logo: '/logos/linkedin.svg',  color: '#0A66C2' },
  twitter:   { name: t.guides.items.twitter.name,   logoAlt: interp(t.images.platformLogo, { platform: t.guides.items.twitter.name }),   cardId: 'platform-card-twitter',  logo: '/logos/twitter.svg',   color: '#000000' },
  instagram: { name: t.guides.items.instagram.name, logoAlt: interp(t.images.platformLogo, { platform: t.guides.items.instagram.name }), cardId: 'platform-card-meta',     logo: '/logos/instagram.svg', color: '#E1306C' },
  facebook:  { name: t.guides.items.facebook.name,  logoAlt: interp(t.images.platformLogo, { platform: t.guides.items.facebook.name }),  cardId: 'platform-card-meta',     logo: '/logos/facebook.svg',  color: '#1877F2' },
  threads:   { name: t.guides.items.threads.name,   logoAlt: interp(t.images.platformLogo, { platform: t.guides.items.threads.name }),   cardId: 'platform-card-threads',  logo: '/logos/threads.svg',   color: '#101010' },
};

// Platform guides: pair each translated entry with its stable anchor id (the
// ids are referenced by nav + footer links, so they must not change per locale).
const guideOrder = [
  'linkedin',
  'twitter',
  'threads',
  'instagram',
  'facebook',
] as const;

const guideBrand = {
  linkedin: {
    name: 'LinkedIn',
    logo: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>',
  },
  twitter: {
    name: 'X',
    logo: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>',
  },
  threads: {
    name: 'Threads',
    logo: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.291 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.781 3.631 2.695 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.36-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.32.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.235-11.587c-.336 0-.679.01-1.024.029-1.838.103-2.978.95-2.913 2.122.063 1.235 1.435 1.81 2.756 1.737 1.211-.066 2.79-.534 3.058-3.71-.59-.124-1.215-.181-1.876-.181Z"/></svg>',
  },
  instagram: {
    name: 'Instagram',
    logo: '<svg viewBox="0 0 24 24" aria-hidden="true"><defs><linearGradient id="guide-instagram-gradient" x1="3" y1="21" x2="21" y2="3" gradientUnits="userSpaceOnUse"><stop stop-color="#FEDA75"/><stop offset=".25" stop-color="#FA7E1E"/><stop offset=".5" stop-color="#D62976"/><stop offset=".75" stop-color="#962FBF"/><stop offset="1" stop-color="#4F5BD5"/></linearGradient></defs><rect x="2.2" y="2.2" width="19.6" height="19.6" rx="5.4" fill="none" stroke="url(#guide-instagram-gradient)" stroke-width="2.2"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="url(#guide-instagram-gradient)" stroke-width="2.2"/><circle cx="17.35" cy="6.65" r="1.25" fill="url(#guide-instagram-gradient)"/></svg>',
  },
  facebook: {
    name: 'Facebook',
    logo: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07c0 6.02 4.39 11.01 10.13 11.93v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.69 4.53-4.69 1.31 0 2.69.24 2.69.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.25h3.33l-.53 3.49h-2.8v8.44C19.61 23.08 24 18.09 24 12.07z"/></svg>',
  },
} as const;

const platforms = guideOrder.map((key) => ({
  key,
  id: `${key}-guide`,
  brand: guideBrand[key],
  ...t.guides.items[key],
}));

const faqs = t.faq.items;

// Canonical URL for this locale's keyword-rich homepage — passed to the schema.
const site = Astro.site ?? new URL('https://posttruncate.com');
const pageUrl = new URL(`/${lang}/${locale.slug}/`, site).href;
---

<Layout lang={lang} path="/">
  <HomePageSchema
    slot="head"
    toolName={locale.toolName}
    canonicalUrl={pageUrl}
    description={t.seo.description}
    inLanguage={lang}
    faqItems={faqs}
  />
  <PlatformBanner
    platforms={bannerPlatforms}
    textTemplate={t.banner.text}
    closeLabel={t.banner.close}
  />
  <!-- ── Hero ─────────────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero__mesh mesh-gradient" aria-hidden="true"></div>
    <div class="container-page hero__inner">
      <p class="hero__eyebrow">{t.hero.eyebrow}</p>
      <h1 class="hero__title">{t.hero.title}</h1>
      <p class="hero__lede">{t.hero.lede}</p>
      <div class="hero__cta">
        <a href="#workspace" class="hero__primary">{t.hero.primary}</a>
        <a href="#platforms" class="hero__secondary">{t.hero.secondary}</a>
        <a href={`/${lang}/embed-widget/`} class="hero__tertiary">{t.embedWidget.homepageLinkLabel}</a>
      </div>
    </div>
  </section>

  <!-- ── Trust bar ─────────────────────────────────────────────────────── -->
  <TrustBar />

  <!-- ── Top leaderboard ad (reserved height → 0 CLS) ─────────────────── -->
  <div class="container-page mt-8">
    <Ad variant="leaderboard" />
  </div>

  <!-- ── How it works ─────────────────────────────────────────────────── -->
  <HowItWorks />

  <!-- ── Interactive workspace (the island) ───────────────────────────── -->
  <main id="workspace" class="container-page workspace">
    <div class="workspace__head">
      <h2 class="workspace__title">{t.workspace.title}</h2>
      <p class="workspace__sub">{t.workspace.sub}</p>
    </div>
    <Dashboard client:load lang={lang} strings={t.island} toolSlugs={toolSlugs} />
  </main>

  <!-- ── Long-form SEO copy ───────────────────────────────────────────────
       Localized keyword body. Headings are plain text; paragraphs carry inline
       <strong> keyword markup, so they render with set:html. Placed right below
       the editor so it sits in the main content flow for crawlers. -->
  <section class="seo-copy container-page" aria-label={t.seoCopy.ariaLabel}>
    <article class="seo-prose">
      {
        t.seoCopy.sections.map((s) => (
          <Fragment>
            <h2>{s.heading}</h2>
            {s.paragraphs.map((p) => (
              <p set:html={p} />
            ))}
          </Fragment>
        ))
      }
    </article>
  </section>

  <!-- ── Static platform guides + sticky side banner ──────────────────── -->
  <section id="platforms" class="container-page guides">
    <header class="guides__head">
      <p class="section-eyebrow">{t.guides.eyebrow}</p>
      <h2 class="section-title">{t.guides.title}</h2>
      <p class="section-lede">{t.guides.lede}</p>
    </header>

    <div class="guides__layout">
      <div class="guides__list">
        {
          platforms.map((p) => (
            <article id={p.id} class="guide" data-brand={p.key}>
              <div class="guide__top">
                <span class="guide__brand-logo" set:html={p.brand.logo} />
                <h3 class:list={['guide__name', p.key === 'twitter' && 'guide__name--visually-hidden']}>
                  {p.brand.name}
                </h3>
                <span class="guide__tag">{p.tag}</span>
              </div>
              <p class="guide__body">{p.body}</p>
              <dl class="guide__facts">
                {p.facts.map(([k, v]) => (
                  <div class="guide__fact">
                    <dt>{k}</dt>
                    <dd>{v}</dd>
                  </div>
                ))}
              </dl>
            </article>
          ))
        }
      </div>

      <!-- Side banner module — sticky, reserved 300×600 footprint -->
      <aside class="guides__rail">
        <Ad variant="skyscraper" />
      </aside>
    </div>
  </section>

  <!-- ── Hook-writing callout ─────────────────────────────────────────── -->
  <section id="hook-guide" class="container-page">
    <div class="hookband">
      <div class="hookband__mesh mesh-gradient" aria-hidden="true"></div>
      <div class="hookband__inner">
        <div>
          <p class="section-eyebrow">{t.hookband.eyebrow}</p>
          <h2 class="hookband__title">{t.hookband.title}</h2>
        </div>
        <p class="hookband__body">{t.hookband.body}</p>
      </div>
    </div>
  </section>

  <!-- ── FAQ (FAQPage structured data generated in Layout head) ────────── -->
  <section id="faq" class="container-page faq">
    <header class="faq__head">
      <p class="section-eyebrow">{t.faq.eyebrow}</p>
      <h2 class="section-title">{t.faq.title}</h2>
    </header>
    <div class="faq__list">
      {
        faqs.map((f) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span>{f.q}</span>
              <span class="faq__chev" aria-hidden="true">+</span>
            </summary>
            <p class="faq__a">{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Re-scroll to URL hash after the Dashboard island finishes rendering.
       Problem: the Preact island (<astro-island>) is an empty shell in initial
       HTML. Once Preact hydrates, the page grows ~8 000 px and the browser's
       native hash-scroll lands far above the intended section.

       Fix strategy:
       1. MutationObserver detects when Preact mounts into the island.
       2. After hydration starts, poll scrollHeight until it stabilises (layout done).
       3. Scroll with behavior:'instant' to bypass CSS scroll-behavior:smooth on
          <html>, which would otherwise animate from the wrong position. -->
  <script is:inline>
    (function () {
      var hash = window.location.hash;
      if (!hash || hash === '#') return;
      var el = document.querySelector(hash);
      if (!el) return;

      // No island on this page → browser's native hash scroll is sufficient.
      var island = document.querySelector('astro-island');
      if (!island) return;

      /** Scroll to target once page layout has fully settled. */
      function waitThenScroll() {
        var lastH = document.documentElement.scrollHeight;
        var stable = 0;
        var ticks  = 0;
        var MAX    = 150; // ~2.5 s safety cap at 60 fps

        function tick() {
          ticks++;
          var h = document.documentElement.scrollHeight;
          if (h !== lastH) { lastH = h; stable = 0; }
          else              { stable++; }

          if (stable >= 5 || ticks >= MAX) {
            // Use 'instant' to skip the CSS smooth-scroll animation; otherwise
            // scroll-behavior:smooth on <html> conflicts with the native hash
            // scroll and the corrective scroll never visibly lands.
            el.scrollIntoView({ block: 'start', behavior: 'instant' });
            return;
          }
          requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }

      // Island already hydrated (fast connection / bfcache)?
      if (island.children.length > 0) {
        waitThenScroll();
        return;
      }

      // Wait for Preact to mount its first child into the island.
      var obs = new MutationObserver(function () {
        if (island.children.length > 0) {
          obs.disconnect();
          waitThenScroll();
        }
      });
      obs.observe(island, { childList: true });

      // Hard fallback: if island never hydrates, scroll anyway after 6 s.
      setTimeout(function () { obs.disconnect(); waitThenScroll(); }, 6000);
    })();
  </script>
</Layout>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-hairline);
    background: var(--color-canvas);
  }
  .hero__mesh {
    position: absolute;
    inset: -40% 0 auto 0;
    height: 130%;
    opacity: 0.16;
    filter: blur(8px);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    padding-top: 88px;
    padding-bottom: 72px;
    text-align: center;
  }
  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  .hero__title {
    margin: 16px auto 0;
    max-width: 760px;
    font-size: clamp(34px, 6vw, 56px);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -2.4px;
    color: var(--color-ink);
  }
  .hero__lede {
    margin: 20px auto 0;
    max-width: 600px;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }
  .hero__cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .hero__primary,
  .hero__secondary,
  .hero__tertiary {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 24px;
    border-radius: var(--radius-pill);
    font-size: 16px;
    font-weight: 500;
    transition: transform 100ms ease, opacity 0.15s ease, background 0.15s ease,
      box-shadow 0.15s ease;
  }
  .hero__primary {
    background: var(--color-ink);
    color: var(--color-on-primary);
  }
  .hero__primary:hover {
    opacity: 0.88;
  }
  .hero__primary:active {
    transform: scale(0.955);
    opacity: 0.82;
  }
  .hero__secondary {
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-e1);
  }
  .hero__secondary:hover {
    background: var(--color-canvas-soft-2);
  }
  .hero__secondary:active {
    transform: scale(0.955);
    box-shadow: var(--shadow-e1);
    background: var(--color-canvas-soft-2);
  }
  .hero__tertiary {
    background: transparent;
    color: var(--color-body);
    font-size: 14px;
    height: 40px;
    padding: 0 12px;
  }
  .hero__tertiary:hover {
    color: var(--color-ink);
  }
  .hero__tertiary:active {
    transform: scale(0.96);
  }

  /* ── Workspace ──────────────────────────────────────────────────────── */
  .workspace {
    scroll-margin-top: 80px;
    padding-top: 48px;
  }
  .workspace__head {
    margin-bottom: 24px;
  }
  .workspace__title {
    font-size: 24px;
    font-weight: 600;
    letter-spacing: -0.96px;
    color: var(--color-ink);
  }
  .workspace__sub {
    margin-top: 6px;
    font-size: 14px;
    color: var(--color-body);
  }

  /* ── Shared section type ────────────────────────────────────────────── */
  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  .section-title {
    margin-top: 12px;
    font-size: 32px;
    font-weight: 600;
    line-height: 40px;
    letter-spacing: -1.28px;
    color: var(--color-ink);
  }
  .section-lede {
    margin-top: 12px;
    max-width: 520px;
    font-size: 16px;
    line-height: 24px;
    color: var(--color-body);
  }

  /* ── Platform guides ────────────────────────────────────────────────── */
  .guides {
    scroll-margin-top: 80px;
    padding-top: 96px;
  }
  .guides__layout {
    display: grid;
    gap: 48px;
    justify-items: center;
  }
  .guides__head {
    margin-bottom: 32px;
    text-align: center;
  }
  .guides__head .section-lede {
    margin-inline: auto;
  }
  .guides__list {
    display: grid;
    gap: 20px;
    width: 100%;
    max-width: 960px;
    margin-inline: auto;
  }
  .guide {
    --guide-brand: var(--color-ink);
    scroll-margin-top: 80px;
    border-radius: var(--radius-lg);
    background: var(--color-canvas);
    padding: 32px 40px;
    box-shadow: var(--shadow-e2);
    text-align: center;
  }
  .guide[data-brand='linkedin'] {
    --guide-brand: #0a66c2;
  }
  .guide[data-brand='facebook'] {
    --guide-brand: #1877f2;
  }
  .guide__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 8px 12px;
  }
  .guide__brand-logo {
    display: inline-flex;
    width: 24px;
    height: 24px;
    color: var(--guide-brand);
    transform: translateY(3px);
  }
  .guide__brand-logo :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
    fill: currentColor;
  }
  .guide__name {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.6px;
    color: var(--guide-brand);
  }
  .guide__name--visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
  .guide[data-brand='instagram'] .guide__name {
    background: linear-gradient(90deg, #833ab4 0%, #c13584 32%, #e1306c 52%, #f77737 76%, #fcaf45 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .guide__tag {
    flex-basis: 100%;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-mute);
  }
  .guide__body {
    margin: 18px auto 0;
    max-width: none;
    font-size: 15px;
    line-height: 26px;
    color: var(--color-body);
  }
  .guide__facts {
    margin-top: 28px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px 24px;
  }
  .guide__fact {
    border-top: 1px solid var(--color-hairline);
    padding-top: 14px;
  }
  .guide__fact dt {
    font-size: 12px;
    line-height: 18px;
    color: var(--color-mute);
  }
  .guide__fact dd {
    margin-top: 4px;
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    color: var(--color-ink);
  }
  .guides__rail {
    display: none;
  }

  /* ── Hook band ──────────────────────────────────────────────────────── */
  .hookband {
    scroll-margin-top: 80px;
    margin-top: 96px;
    max-width: 960px;
    margin-inline: auto;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--color-ink);
    color: var(--color-on-primary);
    padding: 48px 40px;
  }
  /* Same brand mesh as the hero, faded so the dark slab still reads as dark. */
  .hookband__mesh {
    position: absolute;
    inset: -40% 0 auto 0;
    height: 180%;
    opacity: 0.22;
    filter: blur(8px);
    pointer-events: none;
  }
  .hookband__inner {
    position: relative;
    display: grid;
    gap: 20px;
    text-align: center;
    justify-items: center;
    max-width: 880px;
    margin-inline: auto;
  }
  .hookband__title {
    font-size: 28px;
    font-weight: 600;
    line-height: 34px;
    letter-spacing: -1px;
  }
  .hookband__body {
    max-width: none;
    font-size: 16px;
    line-height: 26px;
    color: #d4d4d4;
  }

  /* ── FAQ ────────────────────────────────────────────────────────────── */
  .faq {
    scroll-margin-top: 80px;
