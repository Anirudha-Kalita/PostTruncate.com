---
import Layout from '../../../layouts/Layout.astro';
import Ad from '../../../components/Ad.astro';
import Dashboard from '../../../components/island/Dashboard.tsx';
import StructuredData from '../../../components/StructuredData.astro';
import { getTranslations } from '../../../i18n';
import { interp } from '../../../i18n/interp';
import { LOCALES, getLocale } from '../../../i18n/config';
import { tools } from '../../../data/tools';
import { getFeaturedFaqs } from '../../../data/faq';
import PlatformBanner from '../../../components/PlatformBanner.astro';
import HeroPreviewCard from '../../../components/HeroPreviewCard.astro';
import WhyPostTruncate from '../../../components/WhyPostTruncate.astro';
import HowTruncationWorks from '../../../components/HowTruncationWorks.astro';
import PlatformCharacterLimits from '../../../components/PlatformCharacterLimits.astro';

// One statically-rendered landing page per locale at the keyword-rich slug
// (/en/character-counter/, /de/zeichenzaehler/, …). Slug values come from the
// LOCALES registry so they stay in sync with Nav, Footer, and hreflang tags.
export function getStaticPaths() {
  return LOCALES.map((l) => ({ params: { lang: l.code, slug: l.slug } }));
}

const { lang } = Astro.params as { lang: string };
const t = getTranslations(lang);
const locale = getLocale(lang);

// Resolve locale-specific slugs for the platform sub-tool pages.
const toolSlugs: Record<string, string> = {};
for (const tool of tools) {
  toolSlugs[tool.id] = tool.slugs[lang] ?? tool.slugs['en'];
}

// Build a per-tool { href, label } lookup used by seoCopy and guide card links.
const toolLinks: Record<string, { href: string; label: string }> = {};
for (const tool of tools) {
  const slug = toolSlugs[tool.id];
  if (slug) {
    toolLinks[tool.id] = {
      href: `/${lang}/${slug}/`,
      label: tool.schemaName[lang] ?? tool.schemaName['en'],
    };
  }
}

// Parallel to t.seoCopy.sections — maps section index → tool ID (undefined = no link).
const SECTION_TOOL_IDS: (string | undefined)[] = [
  undefined,    // "A character counter built for social media"
  'sms',        // "SMS encoding and segment counting"
  'twitter',    // "X (Twitter) limits and automatic thread splitting"
  'instagram',  // "Instagram and Facebook character limits"
  undefined,    // "Word count, readability, and platform analytics"
];

// Referral banner: the ?platform= param is only known at runtime (static page),
// so we pass all translated platform data to the client script via data attributes.
const bannerPlatforms = {
  linkedin:  { name: t.guides.items.linkedin.name,  logoAlt: interp(t.images.platformLogo, { platform: t.guides.items.linkedin.name }),  cardId: 'platform-card-linkedin', logo: '/logos/linkedin.svg',  color: '#0A66C2' },
  twitter:   { name: t.guides.items.twitter.name,   logoAlt: interp(t.images.platformLogo, { platform: t.guides.items.twitter.name }),   cardId: 'platform-card-twitter',  logo: '/logos/twitter.svg',   color: '#000000' },
  instagram: { name: t.guides.items.instagram.name, logoAlt: interp(t.images.platformLogo, { platform: t.guides.items.instagram.name }), cardId: 'platform-card-meta',     logo: '/logos/instagram.svg', color: '#E1306C' },
  facebook:  { name: t.guides.items.facebook.name,  logoAlt: interp(t.images.platformLogo, { platform: t.guides.items.facebook.name }),  cardId: 'platform-card-meta',     logo: '/logos/facebook.svg',  color: '#1877F2' },
  threads:   { name: t.guides.items.threads.name,   logoAlt: interp(t.images.platformLogo, { platform: t.guides.items.threads.name }),   cardId: 'platform-card-threads',  logo: '/logos/threads.svg',   color: '#101010' },
};



// Curated homepage subset from the shared FAQ registry (src/data/faq.ts).
// The full list — and the site's FAQPage JSON-LD — lives on /[lang]/faq/.
const faqs = getFeaturedFaqs(t);

// Canonical URL for this locale's keyword-rich homepage — passed to the schema.
const site = Astro.site ?? new URL('https://posttruncate.com');
const pageUrl = new URL(`/${lang}/${locale.slug}/`, site).href;

---

<Layout lang={lang} path="/">
  {/* FAQPage JSON-LD intentionally omitted here — /[lang]/faq/ is the
      canonical FAQ surface and owns that schema for the whole site. */}
  <StructuredData
    slot="head"
    type="home"
    name={locale.toolName}
    url={pageUrl}
    description={t.seo.description}
    inLanguage={lang}
  />
  <PlatformBanner
    platforms={bannerPlatforms}
    textTemplate={t.banner.text}
    closeLabel={t.banner.close}
  />
  <!-- ── Hero ──────────────────────────────────────────────────────────
       Calm two-column hero. Left: H1 → lede → one primary CTA + one quiet
       text link → muted trust line. Right: an illustrative post-preview
       card showing text cut at the "…see more" fold, with small brand-logo
       chips orbiting it. The visual is one labelled image for assistive
       tech (role="img"); its strings reuse translated island labels so no
       new i18n keys are needed. Stacks copy-first on mobile. -->
  <section class="hero">
    <div class="hero__mesh mesh-gradient" aria-hidden="true"></div>
    <div class="container-page hero__inner">
      <div class="hero__copy">
        <div class="hero__badge">
          <svg viewBox="0 0 24 24" aria-hidden="true" width="14" height="14" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
          </svg>
          <span>{t.hero.badge}</span>
        </div>
        <h1 class="hero__title">{t.hero.title}</h1>
        <p class="hero__lede">{t.hero.lede}</p>
        <div class="hero__cta">
          <a href="#workspace" class="hero__primary">{t.hero.primary}</a>
          <a href={`/${lang}/platform-limits/`} class="hero__secondary">{t.hero.secondary}</a>
        </div>
        <p class="hero__trust">
          100% free — no sign-up · Text never leaves your browser · 10+ platform limits covered
        </p>
      </div>

      <HeroPreviewCard
        seeMoreLabel={t.island.linkedin.seeMore}
        ariaLabel={t.island.hook.foldAria}
      />
    </div>
  </section>

  <!-- ── Interactive workspace (the island) — the page's centerpiece,
       directly under the hero. Container/position styling only: the island
       itself (editor left, live previews right, stacking editor-first on
       mobile) is untouched. -->
  <main id="workspace" class="container-page workspace">
    <div class="workspace__head">
      <h2 class="workspace__title">{t.workspace.title}</h2>
      <p class="workspace__sub">{t.workspace.sub}</p>
    </div>
    <Dashboard client:load lang={lang} strings={t.island} toolSlugs={toolSlugs} />
  </main>

  <WhyPostTruncate s={t.whyPostTruncate} />
  <HowTruncationWorks s={t.howTruncationWorks} lang={lang} />
  <PlatformCharacterLimits s={t.platformCharacterLimits} lang={lang} />

  <!-- ── Top leaderboard ad (reserved height → 0 CLS) ─────────────────── -->
  <div class="container-page">
    <Ad variant="leaderboard" />
  </div>

  <!-- ── Long-form SEO copy ───────────────────────────────────────────────
       Localized keyword body. Headings are plain text; paragraphs carry inline
       <strong> keyword markup, so they render with set:html. Placed right below
       the editor so it sits in the main content flow for crawlers. -->
  <section class="seo-copy container-page" aria-label={t.seoCopy.ariaLabel}>
    <article class="seo-prose">
      {
        t.seoCopy.sections.map((s, i) => {
          const link = SECTION_TOOL_IDS[i] ? toolLinks[SECTION_TOOL_IDS[i]!] : undefined;
          return (
            <Fragment>
              <h2>{s.heading}</h2>
              {s.paragraphs.map((p) => (
                <p set:html={p} />
              ))}
              {link && (
                <p class="seo-copy__tool-link">
                  <a href={link.href}>{link.label}</a>
                </p>
              )}
            </Fragment>
          );
        })
      }
    </article>
  </section>



  <!-- ── Hook-writing callout ─────────────────────────────────────────── -->
  <section id="hook-guide" class="container-page">
    <div class="hookband">
      <div class="hookband__mesh mesh-gradient" aria-hidden="true"></div>
      <div class="hookband__inner">
        <div>
          <p class="section-eyebrow">{t.hookband.eyebrow}</p>
          <h2 class="hookband__title">{t.hookband.title}</h2>
        </div>
        <p class="hookband__body">{t.hookband.body}</p>
      </div>
    </div>
  </section>

  <!-- ── FAQ — curated subset of the shared registry; the full list (and the
       site's FAQPage JSON-LD) lives on the dedicated /faq page. ──────────── -->
  <section id="faq" class="container-page faq">
    <header class="faq__head">
      <p class="section-eyebrow">{t.faq.eyebrow}</p>
      <h2 class="section-title">{t.faq.title}</h2>
    </header>
    <div class="faq__list">
      {
        faqs.map((f) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span>{f.q}</span>
              <svg
                class="faq__chev"
                width="14"
                height="14"
                viewBox="0 0 10 10"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M2.5 3.5 5 6.5 7.5 3.5" />
              </svg>
            </summary>
            <p class="faq__a">{f.a}</p>
          </details>
        ))
      }
    </div>
    <p class="faq__all">
      <a href={`/${lang}/faq/`}>{t.faq.viewAll} →</a>
    </p>
  </section>

  <!-- Re-scroll to URL hash after the Dashboard island finishes rendering.
       Problem: the Preact island (<astro-island>) is an empty shell in initial
       HTML. Once Preact hydrates, the page grows ~8 000 px and the browser's
       native hash-scroll lands far above the intended section.

       Fix strategy:
       1. MutationObserver detects when Preact mounts into the island.
       2. After hydration starts, poll scrollHeight until it stabilises (layout done).
       3. Scroll with behavior:'instant' to bypass CSS scroll-behavior:smooth on
          <html>, which would otherwise animate from the wrong position. -->
  <script is:inline>
    (function () {
      var hash = window.location.hash;
      if (!hash || hash === '#') return;
      var el = document.querySelector(hash);
      if (!el) return;

      // No island on this page → browser's native hash scroll is sufficient.
      var island = document.querySelector('astro-island');
      if (!island) return;

      /** Scroll to target once page layout has fully settled. */
      function waitThenScroll() {
        var lastH = document.documentElement.scrollHeight;
        var stable = 0;
        var ticks  = 0;
        var MAX    = 150; // ~2.5 s safety cap at 60 fps

        function tick() {
          ticks++;
          var h = document.documentElement.scrollHeight;
          if (h !== lastH) { lastH = h; stable = 0; }
          else              { stable++; }

          if (stable >= 5 || ticks >= MAX) {
            // Use 'instant' to skip the CSS smooth-scroll animation; otherwise
            // scroll-behavior:smooth on <html> conflicts with the native hash
            // scroll and the corrective scroll never visibly lands.
            el.scrollIntoView({ block: 'start', behavior: 'instant' });
            return;
          }
          requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      }

      // Island already hydrated (fast connection / bfcache)?
      if (island.children.length > 0) {
        waitThenScroll();
        return;
      }

      // Wait for Preact to mount its first child into the island.
      var obs = new MutationObserver(function () {
        if (island.children.length > 0) {
          obs.disconnect();
          waitThenScroll();
        }
      });
      obs.observe(island, { childList: true });

      // Hard fallback: if island never hydrates, scroll anyway after 6 s.
      setTimeout(function () { obs.disconnect(); waitThenScroll(); }, 6000);
    })();
  </script>
</Layout>

<style>
  /* ── Hero ───────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    overflow: hidden;
    border-bottom: 1px solid var(--color-hairline);
    background: var(--color-canvas);
  }
  .hero__mesh {
    position: absolute;
    inset: -40% 0 auto 0;
    height: 130%;
    /* Toned down from 0.16 — the calm hero keeps the brand mesh as a
       whisper rather than a wash. */
    opacity: 0.08;
    filter: blur(8px);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    display: grid;
    align-items: center;
    gap: var(--spacing-flow);
    padding-top: var(--spacing-section);
    padding-bottom: var(--spacing-section);
    /* Mobile-first: centered single column; the ≥1024px block below
       switches to the two-column editorial layout. */
    text-align: center;
  }
  .hero__badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-inline: auto;
    margin-bottom: 24px;
    padding: 6px 16px;
    border-radius: var(--radius-pill);
    background: var(--color-link-bg-soft);
    color: var(--color-link-deep);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.2px;
    white-space: nowrap;
    box-shadow: 0 0 24px 2px rgba(0, 112, 243, 0.3);
    border: 1px solid rgba(0, 112, 243, 0.1);
  }
  .hero__badge svg {
    filter: drop-shadow(0 0 3px var(--color-link));
  }
  .hero__title {
    margin-inline: auto;
    max-width: var(--max-width-narrow);
    font-size: clamp(34px, 4.8vw, 52px);
    font-weight: 600;
    line-height: 1.04;
    /* em-based so the signature tight tracking scales with the clamp. */
    letter-spacing: -0.042em;
    color: var(--color-ink);
  }
  .hero__lede {
    margin: 24px auto 0;
    max-width: 600px;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }
  .hero__cta {
    margin-top: var(--spacing-flow-sm);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }
  .hero__primary {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 28px;
    border-radius: var(--radius-pill);
    font-size: 16px;
    font-weight: 500;
    /* bg link / text on-primary flips to bright-blue + dark text in dark
       mode automatically, keeping AA contrast in both themes. */
    background: var(--color-link);
    color: var(--color-on-primary);
    transition: transform 100ms ease, background 0.15s ease;
  }
  .hero__primary:hover {
    background: var(--color-link-deep);
  }
  .hero__primary:active {
    transform: scale(0.955);
  }
  .hero__primary:focus-visible {
    /* Global ring is link-blue — invisible against this blue pill. */
    outline-color: var(--color-ink);
  }
  .hero__secondary {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 8px;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-body);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: transform 100ms ease, color 0.15s ease;
  }
  .hero__secondary:hover {
    color: var(--color-ink);
  }
  .hero__secondary:active {
    transform: scale(0.96);
  }
  .hero__trust {
    margin-top: var(--spacing-stack);
    font-size: 13px;
    line-height: 20px;
    color: var(--color-mute);
  }

  /* ── Two-column editorial layout — text left, preview card right ──── */
  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
      gap: var(--spacing-section-sm);
      text-align: left;
    }
    .hero__title,
    .hero__lede,
    .hero__badge {
      margin-inline: 0;
    }
    .hero__cta {
      justify-content: flex-start;
    }
  }

  /* ── Workspace — the centerpiece container under the hero ───────────────
     The island renders its own rounded panel; this section just constrains
     and centers it (narrower than the 1400px page container, per mockup). */
  .workspace {
    scroll-margin-top: 80px;
    padding-top: var(--spacing-flow);
    max-width: var(--max-width-page);
  }
  .workspace__head {
    margin-bottom: var(--spacing-stack);
    text-align: center;
  }
  .workspace__title {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -1px;
    color: var(--color-ink);
  }
  .workspace__sub {
    margin-top: 6px;
    font-size: 15px;
    color: var(--color-body);
  }

  /* ── Shared section type ────────────────────────────────────────────── */
  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  .section-title {
    margin-top: 12px;
    font-size: 32px;
    font-weight: 600;
    line-height: 40px;
    letter-spacing: -1.28px;
    color: var(--color-ink);
  }
  .section-lede {
    margin-top: 12px;
    max-width: 520px;
    font-size: 16px;
    line-height: 24px;
    color: var(--color-body);
  }



  /* ── Hook band ──────────────────────────────────────────────────────── */
  .hookband {
    scroll-margin-top: 80px;
    margin-top: 96px;
    max-width: 960px;
    margin-inline: auto;
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--color-ink);
    color: var(--color-on-primary);
    padding: 48px 40px;
  }
  /* Same brand mesh as the hero, faded so the dark slab still reads as dark. */
  .hookband__mesh {
    position: absolute;
    inset: -40% 0 auto 0;
    height: 180%;
    opacity: 0.22;
    filter: blur(8px);
    pointer-events: none;
  }
  .hookband__inner {
    position: relative;
    display: grid;
    gap: 20px;
    text-align: center;
    justify-items: center;
    max-width: 880px;
    margin-inline: auto;
  }
  .hookband__title {
    font-size: 28px;
    font-weight: 600;
    line-height: 34px;
    letter-spacing: -1px;
  }
  .hookband__body {
    max-width: none;
    font-size: 16px;
    line-height: 26px;
    color: #d4d4d4;
  }

  /* ── FAQ ────────────────────────────────────────────────────────────── */
  .faq {
    scroll-margin-top: 80px;
    padding-top: 96px;
  }
  .faq__head {
    margin-bottom: 32px;
    text-align: center;
  }
  .faq__list {
    display: grid;
    gap: 12px;
    max-width: 760px;
    margin-inline: auto;
  }
  .faq__item {
    border-radius: var(--radius-lg);
    background: var(--color-canvas);
    box-shadow: var(--shadow-e1);
    overflow: hidden;
  }
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    padding: 18px 20px;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-ink);
    list-style: none;
    transition: transform 100ms ease, background 0.15s ease;
  }
  .faq__q:active {
    transform: scale(0.985);
    background: var(--color-canvas-soft-2);
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__chev {
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.2s ease;
  }
  .faq__item[open] .faq__chev {
    transform: rotate(180deg);
  }
  .faq__a {
    padding: 0 20px 18px;
    font-size: 15px;
    line-height: 24px;
    color: var(--color-body);
  }
  .faq__all {
    margin-top: 24px;
    text-align: center;
  }
  .faq__all a {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .faq__all a:hover {
    opacity: 0.75;
  }

  /* ── Long-form SEO copy ─────────────────────────────────────────────────
     Readable measure (~4xl), tokenised colours so dark mode is automatic. */
  .seo-copy {
    scroll-margin-top: 80px;
    padding-top: 24px;
  }
  .seo-prose {
    max-width: 56rem;
    margin-inline: auto;
  }
  .seo-prose h2 {
    margin-top: 40px;
    font-size: 22px;
    font-weight: 600;
    line-height: 30px;
    letter-spacing: -0.6px;
    color: var(--color-ink);
  }
  .seo-prose h2:first-child {
    margin-top: 0;
  }
  .seo-prose p {
    margin-top: 14px;
    font-size: 16px;
    line-height: 28px;
    color: var(--color-body);
  }
  .seo-prose strong {
    font-weight: 600;
    color: var(--color-ink);
  }
  .seo-copy__tool-link {
    margin-top: 20px;
  }
  .seo-copy__tool-link a {
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .seo-copy__tool-link a:hover {
    opacity: 0.75;
  }

  /* ── Responsive ─────────────────────────────────────────────────────── */
  @media (min-width: 1100px) {
    /* Cards stay centered on the page; the side banner stacks centered below
       the list rather than pinning to a right-hand rail (which offset the
       cards from page-center). */
    .guides__rail {
      display: block;
    }
  }

  /* Tablet & below — pull the generous desktop rhythm in so sections aren't
     separated by a screenful of dead space on smaller viewports. */
  @media (max-width: 768px) {
    .hero__inner {
      padding-top: var(--spacing-section-sm);
      padding-bottom: var(--spacing-section-sm);
    }
    .workspace {
      padding-top: var(--spacing-flow-sm);
    }
    .guides,
    .faq {
      padding-top: 64px;
    }
    .hookband {
      margin-top: 64px;
    }
    .section-title {
      font-size: 26px;
      line-height: 32px;
      letter-spacing: -1px;
    }
  }

  @media (max-width: 520px) {
    .guide__facts {
      grid-template-columns: 1fr;
    }
    .hookband {
      padding: 32px 24px;
    }
    .guide {
      padding: 20px;
    }
    .hookband__title {
      font-size: 24px;
      line-height: 30px;
    }
  }

  /* ── Dark theme — targeted fixes for elements the token swap can't carry ──
     :global() is required because Astro would otherwise scope these selectors
     to this component, and <html> (rendered by Layout) has no scope hash.

     The hook band is `bg ink / text on-primary` in light mode, so the token
     swap would flip it to a glaring near-white block. It's too large to read
     as an inverted pill, so we re-express it as the most-elevated dark card. */
  :global(html[data-theme='dark']) .hookband {
    background: var(--color-canvas-soft-2);
    color: var(--color-ink);
    box-shadow: var(--shadow-e2);
  }
  :global(html[data-theme='dark']) .hookband__body {
    color: var(--color-body);
  }
  :global(html[data-theme='dark']) .guide[data-brand='twitter'],
  :global(html[data-theme='dark']) .guide[data-brand='threads'] {
    --guide-brand: #ffffff;
  }
  /* Bright mesh stops need a lift over near-black, but stay a whisper. */
  :global(html[data-theme='dark']) .hero__mesh {
    opacity: 0.16;
