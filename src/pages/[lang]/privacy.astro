---
import Layout from '../../layouts/Layout.astro';
import PrivacyContent from '../../components/PrivacyContent.astro';
import { getTranslations } from '../../i18n';
import { interp } from '../../i18n/interp';
import { LOCALE_CODES } from '../../i18n/config';

// One static Privacy page per locale (/en/privacy/, /da/privacy/, …).
export function getStaticPaths() {
  return LOCALE_CODES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const t = getTranslations(lang);
const page = t.pages.privacy;
const lastUpdated = interp(t.pages.common.lastUpdated, {
  date: t.pages.common.lastUpdatedDate,
});
---

<Layout
  lang={lang}
  path="/privacy/"
  title={page.title}
  description={page.description}
  footerVariant="minimal"
>
  <PrivacyContent
    lang={lang}
    page={page}
    lastUpdated={lastUpdated}
    lastUpdatedDate={t.pages.common.lastUpdatedDate}
    backHome={t.pages.common.backHome}
  />
</Layout>
