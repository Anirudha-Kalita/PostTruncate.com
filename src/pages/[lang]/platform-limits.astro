---
import Layout from '../../layouts/Layout.astro';
import ToolCta from '../../components/ToolCta.astro';
import { getTranslations } from '../../i18n';
import { interp } from '../../i18n/interp';
import { LOCALE_CODES, getLocale } from '../../i18n/config';
import { LIMITS, FOLDS, SMS_LIMITS } from '../../lib/textTools';
import { tools } from '../../data/tools';
import { calculators } from '../../data/calculators';

// One static reference page per locale (/en/platform-limits/, …): the full
// character-limit table plus per-platform truncation rules. Every number is
// interpolated from textTools.ts constants — the same values the live editor
// checks against — so the page can never drift from the engine.
export function getStaticPaths() {
  return LOCALE_CODES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const t = getTranslations(lang);
const locale = getLocale(lang);
const home = `/${lang}/${locale.slug}/`;
const nf = new Intl.NumberFormat(lang);

// Per-tool localized URLs so each table row links to its dedicated tool page.
const toolHref: Record<string, string> = {};
for (const tool of tools) {
  toolHref[tool.id] = `/${lang}/${tool.slugs[lang] ?? tool.slugs['en']}/`;
}
for (const calc of calculators) {
  toolHref[calc.id] = `/${lang}/tools/${calc.slugs[lang] ?? calc.slugs['en']}/`;
}

const L = t.limitsPage;

// Heading accent: blue-tint the phrase after the first comma (per the design).
const [headHead, ...headRestParts] = L.heading.split(',');
const headTail = headRestParts.join(',').trim();

// Brand names stay untranslated (site-wide convention). `logo` maps to a file
// under /public/logos/ (branded tiles, so the table + timeline read at a glance).
const rows = [
  {
    name: 'LinkedIn',
    logo: 'linkedin',
    href: toolHref['linkedin'],
    limit: nf.format(LIMITS.LINKEDIN_POST),
    foldMobile: `~${nf.format(FOLDS.linkedin.mobile)}`,
    foldDesktop: `~${nf.format(FOLDS.linkedin.desktop)}`,
    note: L.notes.linkedin,
  },
  {
    name: 'X (Twitter)',
    logo: 'twitter',
    href: toolHref['twitter'],
    limit: nf.format(LIMITS.TWEET),
    foldMobile: L.noFold,
    foldDesktop: L.noFold,
    note: interp(L.notes.twitter, { limit: nf.format(LIMITS.TWEET), url: nf.format(LIMITS.URL_WEIGHT) }),
  },
  {
    name: 'Threads',
    logo: 'threads',
    href: toolHref['threads'],
    limit: nf.format(LIMITS.THREADS),
    foldMobile: `~${nf.format(FOLDS.threads.mobile)}`,
    foldDesktop: nf.format(FOLDS.threads.desktop),
    note: interp(L.notes.threads, { limit: nf.format(LIMITS.THREADS) }),
  },
  {
    name: 'Instagram',
    logo: 'instagram',
    href: toolHref['instagram'],
    limit: nf.format(LIMITS.INSTAGRAM_CAPTION),
    foldMobile: `~${nf.format(FOLDS.instagram.mobile)}`,
    foldDesktop: `~${nf.format(FOLDS.instagram.desktop)}`,
    note: interp(L.notes.instagram, {
      hashtags: nf.format(LIMITS.INSTAGRAM_HASHTAGS_RECOMMENDED),
      hashtagMax: nf.format(LIMITS.INSTAGRAM_HASHTAGS_MAX),
    }),
  },
  {
    name: 'Facebook',
    logo: 'facebook',
    href: toolHref['facebook'],
    limit: nf.format(LIMITS.FACEBOOK_POST),
    foldMobile: `~${nf.format(FOLDS.facebook.mobile)}`,
    foldDesktop: `~${nf.format(FOLDS.facebook.desktop)}`,
    note: L.notes.facebook,
  },
  {
    name: 'TikTok',
    logo: 'tiktok',
    href: toolHref['tiktok-guide'],
    limit: nf.format(LIMITS.TIKTOK_CAPTION_MAX),
    foldMobile: `~${nf.format(FOLDS.tiktok.mobile)}`,
    foldDesktop: `~${nf.format(FOLDS.tiktok.desktop)}`,
    note: L.notes.tiktok,
  },
  {
    name: 'SMS (GSM 7-bit)',
    logo: 'sms',
    href: toolHref['sms'],
    limit: nf.format(SMS_LIMITS.GSM.singlePart),
    foldMobile: L.noFold,
    foldDesktop: L.noFold,
    note: interp(L.notes.smsGsm, {
      single: nf.format(SMS_LIMITS.GSM.singlePart),
      multi: nf.format(SMS_LIMITS.GSM.multipart),
    }),
  },
  {
    name: 'SMS (Unicode)',
    logo: 'sms',
    href: toolHref['sms'],
    limit: nf.format(SMS_LIMITS.UNICODE.singlePart),
    foldMobile: L.noFold,
    foldDesktop: L.noFold,
    note: L.notes.smsUnicode,
  },
];

// Detailed truncation-rule sections, numbers injected from the same constants.
const ruleSections = [
  {
    name: 'LinkedIn',
    logo: 'linkedin',
    href: toolHref['linkedin'],
    body: interp(L.rules.linkedin, {
      limit: nf.format(LIMITS.LINKEDIN_POST),
      mobile: nf.format(FOLDS.linkedin.mobile),
      desktop: nf.format(FOLDS.linkedin.desktop),
    }),
  },
  {
    name: 'X (Twitter)',
    logo: 'twitter',
    href: toolHref['twitter'],
    body: interp(L.rules.twitter, {
      limit: nf.format(LIMITS.TWEET),
      url: nf.format(LIMITS.URL_WEIGHT),
    }),
  },
  {
    name: 'Threads',
    logo: 'threads',
    href: toolHref['threads'],
    body: interp(L.rules.threads, {
      limit: nf.format(LIMITS.THREADS),
      mobile: nf.format(FOLDS.threads.mobile),
    }),
  },
  {
    name: 'Instagram',
    logo: 'instagram',
    href: toolHref['instagram'],
    body: interp(L.rules.instagram, {
      limit: nf.format(LIMITS.INSTAGRAM_CAPTION),
      mobile: nf.format(FOLDS.instagram.mobile),
      hashtags: nf.format(LIMITS.INSTAGRAM_HASHTAGS_RECOMMENDED),
      hashtagMax: nf.format(LIMITS.INSTAGRAM_HASHTAGS_MAX),
    }),
  },
  {
    name: 'Facebook',
    logo: 'facebook',
    href: toolHref['facebook'],
    body: interp(L.rules.facebook, {
      limit: nf.format(LIMITS.FACEBOOK_POST),
      mobile: nf.format(FOLDS.facebook.mobile),
      desktop: nf.format(FOLDS.facebook.desktop),
    }),
  },
  {
    name: 'TikTok',
    logo: 'tiktok',
    href: toolHref['tiktok-guide'],
    body: interp(L.rules.tiktok, {
      limit: nf.format(LIMITS.TIKTOK_CAPTION_MAX),
      safe: nf.format(LIMITS.TIKTOK_CAPTION_SAFE),
      fold: nf.format(FOLDS.tiktok.mobile),
    }),
  },
  {
    name: 'SMS',
    logo: 'sms',
    href: toolHref['sms'],
    body: interp(L.rules.sms, {
      gsmSingle: nf.format(SMS_LIMITS.GSM.singlePart),
      gsmMulti: nf.format(SMS_LIMITS.GSM.multipart),
      uniSingle: nf.format(SMS_LIMITS.UNICODE.singlePart),
      uniMulti: nf.format(SMS_LIMITS.UNICODE.multipart),
    }),
  },
];

const cta = t.toolPage.cta;
const site = Astro.site ?? new URL('https://posttruncate.com');
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.breadcrumbs.home, item: new URL(home, site).href },
    { '@type': 'ListItem', position: 2, name: L.heading, item: new URL(`/${lang}/platform-limits/`, site).href },
  ],
};
---

<Layout
  lang={lang}
  path="/platform-limits/"
  title={L.title}
  description={L.description}
  jsonLd={[breadcrumbJsonLd]}
>
  <section class="lp container-page">
    <nav class="lp__crumbs" aria-label={L.heading}>
        <a href={home}>{t.breadcrumbs.home}</a>
        <span aria-hidden="true">›</span>
        <span>{L.eyebrow}</span>
        <span aria-hidden="true">›</span>
        <span aria-current="page">{L.heading}</span>
      </nav>

      {/* ── Hero ──────────────────────────────────────────────────────── */}
      <header class="lp-hero">
        <div class="lp-hero__copy">
          <span class="lp-hero__eyebrow">{L.eyebrow}</span>
          <h1 class="lp-hero__title">
            <span>{headHead}{headTail ? ',' : ''}</span>
            {headTail && <> <span class="lp-hero__accent">{headTail}</span></>}
          </h1>
          <p class="lp-hero__lede">{L.lede}</p>
        </div>

        <div class="lp-hero__art" aria-hidden="true">
          <span class="lp-hero__blob"></span>
          <span class="lp-hero__dots"></span>
          <div class="lp-hero__doc">
            <div class="lp-hero__doc-head">
              <span class="lp-hero__doc-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 8h8M9 12h8M9 16h5"></path>
                  <circle cx="5.5" cy="8" r="0.9" fill="#fff" stroke="none"></circle>
                  <circle cx="5.5" cy="12" r="0.9" fill="#fff" stroke="none"></circle>
                  <circle cx="5.5" cy="16" r="0.9" fill="#fff" stroke="none"></circle>
                </svg>
              </span>
              <div class="lp-hero__doc-headlines">
                <span></span>
                <span></span>
              </div>
            </div>
            <div class="lp-hero__grid">
              <span class="lp-hero__bar lp-hero__bar--1"></span>
              <span class="lp-hero__bar lp-hero__bar--2"></span>
              <div class="lp-hero__row"><span></span><span></span><span></span></div>
              <div class="lp-hero__row"><span></span><span></span><span></span></div>
              <div class="lp-hero__row"><span></span><span></span><span></span></div>
            </div>
          </div>

          <span class="lp-hero__badge lp-hero__badge--chart">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18"></path><path d="M7 21v-6M12 21V9M17 21v-9"></path></svg>
          </span>
          <span class="lp-hero__badge lp-hero__badge--chat">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
          </span>
          <span class="lp-hero__badge lp-hero__badge--hash">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"></path></svg>
          </span>
        </div>
      </header>

      <div class="lp__inner">
      {/* ── Limits table ──────────────────────────────────────────────── */}
      <div class="lp-table__wrap">
        <table class="lp-table">
          <caption class="sr-only">{L.table.caption}</caption>
          <thead>
            <tr>
              <th scope="col">{L.table.platform}</th>
              <th scope="col">{L.table.limit}</th>
              <th scope="col">{L.table.foldMobile}</th>
              <th scope="col">{L.table.foldDesktop}</th>
              <th scope="col">{L.table.notes}</th>
            </tr>
          </thead>
          <tbody>
            {
              rows.map((r) => (
                <tr>
                  <th scope="row" data-label={L.table.platform}>
                    <a href={r.href}>
                      <img class="lp-logo" src={`/logos/${r.logo}.svg`} width="24" height="24" alt="" loading="lazy" />
                      <span>{r.name}</span>
                    </a>
                  </th>
                  <td class="lp-num" data-label={L.table.limit}>{r.limit}</td>
                  <td class="lp-num" data-label={L.table.foldMobile}>{r.foldMobile}</td>
                  <td class="lp-num" data-label={L.table.foldDesktop}>{r.foldDesktop}</td>
                  <td data-label={L.table.notes}>{r.note}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      {/* ── Per-platform truncation rules (timeline) ──────────────────── */}
      <h2 class="lp-rules__heading">{L.rulesHeading}</h2>
      <ol class="lp-rules">
        {
          ruleSections.map((s) => (
            <li class="lp-rule">
              <span class="lp-rule__marker">
                <img src={`/logos/${s.logo}.svg`} width="30" height="30" alt="" loading="lazy" />
              </span>
              <div class="lp-rule__content">
                <h3><a href={s.href}>{s.name}</a></h3>
                <p>{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <a class="lp-faq-btn" href={`/${lang}/faq/`}>{t.faq.viewAll} →</a>

      {/* ── Closing CTA — the shared card used across the site ─────────── */}
      <ToolCta heading={cta.heading} blurb={cta.blurb} button={cta.button} href={`${home}#workspace`} />
    </div>
  </section>
</Layout>

<style>
  .lp {
    scroll-margin-top: 80px;
    padding-top: 48px;
    /* Closes on the ToolCta card — sit tight to the footer (adjacent sibling,
       so the negative margin collapses with the footer's 96px top margin). */
    padding-bottom: 24px;
    margin-bottom: -96px;
  }
  .lp__inner {
    max-width: 64rem;
    margin-inline: auto;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  /* ── Breadcrumb ──────────────────────────────────────────────────────── */
  .lp__crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-bottom: 20px;
    font-size: 13px;
    color: var(--color-mute);
  }
  .lp__crumbs a {
    color: var(--color-body);
    transition: color 0.15s ease;
  }
  .lp__crumbs a:hover {
    color: var(--color-ink);
  }

  /* ── Hero ────────────────────────────────────────────────────────────── */
  .lp-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: start;
    margin-bottom: 48px;
  }
  .lp-hero__eyebrow {
    display: inline-block;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-link-bg-soft);
    color: var(--color-link-deep);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .lp-hero__title {
    margin-top: 18px;
    font-size: clamp(30px, 5vw, 44px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -1.6px;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .lp-hero__accent {
    color: var(--color-link);
  }
  .lp-hero__lede {
    margin-top: 16px;
    max-width: 34rem;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }

  /* Hero illustration — document/table card with floating badges. */
  .lp-hero__art {
    position: relative;
    display: none;
    aspect-ratio: 7 / 5;
    max-width: 480px;
    width: 100%;
    margin-inline: auto;
  }
  /* Soft blue shape peeking from behind the card. */
  .lp-hero__blob {
    position: absolute;
    right: 4%;
    top: 20%;
    width: 56%;
    aspect-ratio: 0.92;
    border-radius: 34px;
    background: color-mix(in srgb, var(--color-link) 9%, var(--color-canvas-soft));
  }
  .lp-hero__dots {
    position: absolute;
    left: 1%;
    top: 12%;
    width: 78px;
    height: 78px;
    background-image: radial-gradient(currentColor 1.4px, transparent 1.4px);
    background-size: 12px 12px;
    color: color-mix(in srgb, var(--color-link) 28%, transparent);
  }
  .lp-hero__doc {
    position: absolute;
    top: 50%;
    left: 52%;
    transform: translate(-50%, -50%);
    width: 60%;
    display: flex;
    flex-direction: column;
    gap: 18px;
    padding: 22px 20px;
    border-radius: 22px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
    z-index: 1;
  }
  .lp-hero__doc-head {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .lp-hero__doc-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    flex-shrink: 0;
    border-radius: 14px;
    background: linear-gradient(145deg, #5c8cf5 0%, #3b6be6 100%);
  }
  .lp-hero__doc-icon svg {
    width: 26px;
    height: 26px;
  }
  .lp-hero__doc-headlines {
    display: flex;
    flex-direction: column;
    gap: 7px;
    flex: 1;
  }
  .lp-hero__doc-headlines span {
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas-soft-2);
  }
  .lp-hero__doc-headlines span:first-child {
    width: 72%;
  }
  .lp-hero__doc-headlines span:last-child {
    width: 48%;
  }
  /* Table-grid skeleton — all light blue, like rows of cells. */
  .lp-hero__grid {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .lp-hero__bar {
    height: 9px;
    border-radius: var(--radius-pill);
    background: var(--color-link-bg-soft);
  }
  .lp-hero__bar--1 {
    width: 82%;
  }
  .lp-hero__bar--2 {
    width: 60%;
  }
  .lp-hero__row {
    display: flex;
    gap: 8px;
  }
  .lp-hero__row span {
    height: 9px;
    flex: 1;
    border-radius: var(--radius-pill);
    background: var(--color-link-bg-soft);
  }
  .lp-hero__badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 15px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
    color: var(--color-link);
    z-index: 2;
  }
  .lp-hero__badge svg {
    width: 24px;
    height: 24px;
  }
  /* Chart badge (left) — soft-blue with a downward speech tail. */
  .lp-hero__badge--chart {
    left: 1%;
    top: 46%;
    background: color-mix(in srgb, var(--color-link) 10%, var(--color-canvas));
  }
  .lp-hero__badge--chart::after {
    content: '';
    position: absolute;
    bottom: -5px;
    left: 50%;
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--color-link) 10%, var(--color-canvas));
    transform: translateX(-50%) rotate(45deg);
  }
  .lp-hero__badge--chat {
    right: 1%;
    top: 8%;
    background: color-mix(in srgb, var(--color-link) 10%, var(--color-canvas));
  }
  .lp-hero__badge--hash {
    right: 5%;
    bottom: 12%;
  }

  /* ── Limits table ────────────────────────────────────────────────────── */
  .lp-table__wrap {
    overflow-x: auto;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-e2);
    background: var(--color-canvas);
  }
  .lp-table {
    width: 100%;
    min-width: 680px;
    border-collapse: collapse;
    font-size: 14px;
    line-height: 20px;
  }
  .lp-table thead th {
    padding: 16px 18px;
    text-align: left;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-mute);
    background: var(--color-canvas-soft);
    border-bottom: 1px solid var(--color-hairline);
    white-space: nowrap;
  }
  .lp-table tbody th,
  .lp-table tbody td {
    padding: 16px 18px;
    text-align: left;
    vertical-align: middle;
    border-bottom: 1px solid var(--color-hairline);
    color: var(--color-body);
  }
  .lp-table tbody tr:last-child th,
  .lp-table tbody tr:last-child td {
    border-bottom: none;
  }
  .lp-table tbody tr {
    transition: background 0.15s ease;
  }
  .lp-table tbody tr:hover {
    background: var(--color-canvas-soft);
  }
  .lp-table tbody th {
    font-weight: 600;
    color: var(--color-ink);
    white-space: nowrap;
  }
  .lp-table tbody th a {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: inherit;
    transition: color 0.15s ease;
  }
  .lp-table tbody th a:hover {
    color: var(--color-link);
  }
  .lp-logo {
    flex-shrink: 0;
    border-radius: 6px;
    display: block;
  }
  .lp-num {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    color: var(--color-ink);
    font-weight: 500;
  }

  /* ── Truncation-rule timeline ────────────────────────────────────────── */
  .lp-rules__heading {
    margin-top: 56px;
    margin-bottom: 28px;
    font-size: 26px;
    font-weight: 600;
    line-height: 32px;
    letter-spacing: -0.8px;
    color: var(--color-ink);
  }
  .lp-rules {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lp-rule {
    position: relative;
    display: flex;
    gap: 20px;
    padding-bottom: 30px;
  }
  .lp-rule:last-child {
    padding-bottom: 0;
  }
  /* Dashed connector between markers. */
  .lp-rule:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 50px;
    bottom: 4px;
    border-left: 2px dashed var(--color-hairline);
    transform: translateX(-1px);
  }
  .lp-rule__marker {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-canvas);
    box-shadow: var(--shadow-e2);
  }
  .lp-rule__marker img {
    width: 30px;
    height: 30px;
    border-radius: 7px;
    display: block;
  }
  .lp-rule__content {
    padding-top: 2px;
    min-width: 0;
  }
  .lp-rule__content h3 {
    font-size: 18px;
    font-weight: 600;
    line-height: 26px;
    letter-spacing: -0.4px;
    color: var(--color-ink);
  }
  .lp-rule__content h3 a {
    color: inherit;
    transition: color 0.15s ease;
  }
