---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths, Page } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import BlogStructuredData from '../../../components/BlogStructuredData.astro';
import { DEFAULT_LOCALE } from '../../../i18n/config';
import BlogCardGrid from '../../../components/BlogCardGrid.astro';
import BlogCategoryNav from '../../../components/BlogCategoryNav.astro';
import BlogPagination from '../../../components/BlogPagination.astro';
import PlatformLimitsPromo from '../../../components/PlatformLimitsPromo.astro';
import { BLOG_SEGMENT, getBlogStrings, isoDate } from '../../../lib/blogI18n';
import {
  blogCategories,
  getCategorySlug,
  getCategoryName,
} from '../../../data/blogCategories';

type BlogEntry = CollectionEntry<'blog'>;
type NavCategory = { name: string; href: string };

// One paginated index per locale that has at least one published post. Page 1
// lives at /{lang}/blog/, pages 2+ at /{lang}/blog/2/ (Astro's rest-param
// paginate() output). Empty locales produce no pages — no thin "coming soon"
// pages for the 9 unwritten languages until their content lands.
export const getStaticPaths = (async ({ paginate }) => {
  // 12 posts per page. Declared inside getStaticPaths because Astro evaluates
  // this function in isolation — module-scope frontmatter consts aren't visible.
  const PAGE_SIZE = 12;
  const posts = (await getCollection('blog')).filter(
    (p) => import.meta.env.DEV || !p.data.draft,
  );

  // Bucket posts by locale, newest first within each.
  const byLocale = new Map<string, BlogEntry[]>();
  for (const p of posts) {
    const group = byLocale.get(p.data.locale) ?? [];
    group.push(p);
    byLocale.set(p.data.locale, group);
  }
  for (const group of byLocale.values()) {
    group.sort(
      (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
    );
  }

  const site = 'https://posttruncate.com';
  // hreflang alternates: only locales that actually have an index page. These
  // are page-1 hrefs; the page maps them to the current page number for N>1.
  const localesWithPosts = [...byLocale.keys()];
  const alternates = localesWithPosts.map((code) => ({
    hreflang: code,
    href: `${site}/${code}/${BLOG_SEGMENT}/`,
  }));
  const xDefaultLocale = localesWithPosts.includes(DEFAULT_LOCALE)
    ? DEFAULT_LOCALE
    : localesWithPosts[0];
  if (xDefaultLocale) {
    alternates.push({
      hreflang: 'x-default',
      href: `${site}/${xDefaultLocale}/${BLOG_SEGMENT}/`,
    });
  }

  // Paginate each locale's posts independently, attaching the locale param and
  // the shared per-locale props (hreflang + the full category nav, which must
  // reflect every category in the locale, not just the current page's slice).
  return localesWithPosts.flatMap((code) => {
    const localePosts = byLocale.get(code)!;

    const categoriesWithPosts = new Set(localePosts.map((p) => p.data.category));
    const navCategories: NavCategory[] = blogCategories
      .filter((cat) => categoriesWithPosts.has(cat.id))
      .map((cat) => ({
        name: getCategoryName(cat, code),
        href: `/${code}/${BLOG_SEGMENT}/${getCategorySlug(cat, code)}/`,
      }));

    return paginate(localePosts, {
      pageSize: PAGE_SIZE,
      params: { lang: code },
      props: { hreflangUrls: alternates, navCategories },
    });
  });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<BlogEntry>;
  hreflangUrls: { hreflang: string; href: string }[];
  navCategories: NavCategory[];
}

const { page, hreflangUrls, navCategories } = Astro.props as Props;
const { lang } = Astro.params as { lang: string };

const s = getBlogStrings(lang);
const site = Astro.site ?? new URL('https://posttruncate.com');

const { currentPage, lastPage, data: posts } = page;
const basePath = `/${lang}/${BLOG_SEGMENT}/`;

// Per-page pathname: page 1 is the bare section base, pages 2+ append "N/".
const pagePath = (n: number) => (n <= 1 ? basePath : `${basePath}${n}/`);
const canonicalUrl = new URL(pagePath(currentPage), site).href;

// "Page N" title suffix for N>1 keeps page 1 as the clean section title.
const pageTitle =
  currentPage > 1 ? `${s.indexTitle} — Page ${currentPage}` : s.indexTitle;

// hreflang per page number: pages 2+ map to the same page number in other
// locales (English-first keeps the list short). Base hrefs end with "/".
const pageHreflangUrls = hreflangUrls.map((a) => ({
  hreflang: a.hreflang,
  href: currentPage > 1 ? `${a.href}${currentPage}/` : a.href,
}));

// rel=prev / rel=next absolute URLs for the <head> (crawl hints).
const prevUrl = currentPage > 1 ? new URL(pagePath(currentPage - 1), site).href : null;
const nextUrl =
  currentPage < lastPage ? new URL(pagePath(currentPage + 1), site).href : null;

// JSON-LD lists only THIS page's posts, scoped to the current page URL.
const schemaPosts = posts.map((p) => ({
  headline: p.data.title,
  description: p.data.description,
  datePublished: isoDate(p.data.publishDate),
  url: new URL(`/${lang}/${BLOG_SEGMENT}/${p.data.slug}/`, site).href,
}));
---

<Layout
  lang={lang}
  path={`/${BLOG_SEGMENT}/`}
  title={pageTitle}
  description={s.indexDescription}
  canonicalUrl={canonicalUrl}
  hreflangUrls={pageHreflangUrls}
>
  <BlogStructuredData
    slot="head"
    type="index"
    url={canonicalUrl}
    name={s.indexHeading}
    description={s.indexDescription}
    inLanguage={lang}
    posts={schemaPosts}
  />
  {prevUrl && <link slot="head" rel="prev" href={prevUrl} />}
  {nextUrl && <link slot="head" rel="next" href={nextUrl} />}
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title={s.indexTitle}
    href={`/${lang}/${BLOG_SEGMENT}/rss.xml`}
  />
  <section class="blog container-page">
    <header class="blog-hero">
      <div class="blog-hero__copy">
        <h1 class="blog-hero__title">{s.indexHeading}</h1>
        <p class="blog-hero__lede">{s.indexLede}</p>
      </div>
      <div class="blog-hero__art" aria-hidden="true">
        <svg viewBox="0 0 200 185" fill="none" xmlns="http://www.w3.org/2000/svg" role="presentation">
          <defs>
            <linearGradient id="gc-circle" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#efe9fc"></stop>
              <stop offset="1" stop-color="#e2d8f8"></stop>
            </linearGradient>
            <linearGradient id="gc-board" x1="0.3" y1="0" x2="0.7" y2="1">
              <stop offset="0" stop-color="#9479f6"></stop>
              <stop offset="1" stop-color="#7a5cf0"></stop>
            </linearGradient>
            <linearGradient id="gc-cap" x1="0.5" y1="0" x2="0.5" y2="1">
              <stop offset="0" stop-color="#6d4de8"></stop>
              <stop offset="1" stop-color="#5232c4"></stop>
            </linearGradient>
            <linearGradient id="gc-book" x1="0.5" y1="0" x2="0.5" y2="1">
              <stop offset="0" stop-color="#8064f2"></stop>
              <stop offset="1" stop-color="#5f42db"></stop>
            </linearGradient>
            <linearGradient id="gc-pages" x1="0.5" y1="0" x2="0.5" y2="1">
              <stop offset="0" stop-color="#fbf8ff"></stop>
              <stop offset="1" stop-color="#e6dcfa"></stop>
            </linearGradient>
          </defs>

          <circle cx="120" cy="66" r="60" fill="url(#gc-circle)"></circle>
          <ellipse cx="100" cy="160" rx="60" ry="7" fill="#5f42db" opacity="0.13"></ellipse>

          {/* Book */}
          <rect x="50" y="124" width="100" height="7" rx="3" fill="url(#gc-pages)"></rect>
          <rect x="46" y="130" width="108" height="24" rx="7" fill="url(#gc-book)"></rect>
          <path d="M46 148h108v0a6 6 0 0 1-6 6H52a6 6 0 0 1-6-6z" fill="#4e30c2" opacity="0.5"></path>

          {/* Cap dome */}
          <path d="M62 100q38 17 76 0l-4 17q-34 15-68 0z" fill="url(#gc-cap)"></path>

          {/* Mortarboard */}
          <path d="M30 72 100 100 170 72 170 80 100 108 30 80z" fill="#5836ce"></path>
          <path d="M100 44 170 72 100 100 30 72z" fill="url(#gc-board)"></path>
          <path d="M100 44 170 72 100 82 30 72z" fill="#a68af8" opacity="0.5"></path>

          {/* Button */}
          <circle cx="100" cy="65" r="5" fill="#4f31c2"></circle>
          <circle cx="100" cy="64" r="2" fill="#7c5cf0"></circle>

          {/* Tassel */}
          <path d="M100 65q50 4 66 9" stroke="#4f31c2" stroke-width="2.4" fill="none" stroke-linecap="round"></path>
          <path d="M166 74v22" stroke="#4f31c2" stroke-width="2.4" stroke-linecap="round"></path>
          <path d="M161 95h10l-2 13q-3 2-6 0z" fill="#efeafd"></path>

          {/* Accents */}
          <circle cx="180" cy="38" r="4.5" fill="#2fd0e6"></circle>
          <circle cx="28" cy="118" r="3.5" fill="#a68af8"></circle>
          <circle cx="170" cy="118" r="3" fill="#a68af8"></circle>
          <path d="M34 60l1.6 4 4 1.6-4 1.6-1.6 4-1.6-4-4-1.6 4-1.6z" fill="#c6b8f6"></path>
          <path d="M186 80l1.3 3.4 3.4 1.3-3.4 1.3-1.3 3.4-1.3-3.4-3.4-1.3 3.4-1.3z" fill="#c6b8f6"></path>
        </svg>
      </div>
    </header>

    <BlogCategoryNav categories={navCategories} allHref={basePath} allLabel={s.all} />

    <BlogCardGrid posts={posts} lang={lang} readMoreLabel={s.readMore} />

    <BlogPagination
      currentPage={currentPage}
      lastPage={lastPage}
      basePath={basePath}
      prevLabel={s.paginationPrev}
      nextLabel={s.paginationNext}
      navLabel={s.paginationNavLabel}
      statusTemplate={s.paginationStatus}
    />

    <div class="blog__promo">
      <PlatformLimitsPromo lang={lang} />
    </div>
  </section>
</Layout>

<style>
  .blog {
    padding-top: 48px;
    padding-bottom: 96px;
    /* Wide enough to land on a 4-up card grid (4 × 230px tracks + gaps). */
    max-width: 72rem;
  }
  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .blog-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: center;
    margin-bottom: 36px;
  }
  .blog-hero__title {
    font-size: clamp(38px, 6vw, 58px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -2px;
    color: var(--color-ink);
  }
  .blog-hero__lede {
    margin-top: 16px;
    max-width: 30rem;
    font-size: 17px;
    line-height: 27px;
    color: var(--color-body);
  }
  .blog-hero__art {
    display: none;
    justify-self: end;
    width: 100%;
    max-width: 300px;
  }
  .blog-hero__art svg {
    width: 100%;
    height: auto;
  }

  .blog__promo {
    margin-top: 48px;
  }

  @media (min-width: 900px) {
    .blog-hero {
      grid-template-columns: 1fr auto;
      gap: 40px;
    }
    .blog-hero__art {
      display: block;
    }
  }
</style>
