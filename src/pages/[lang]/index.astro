---
// Permanent redirect from the bare locale root (/en/, /es/, …) to the
// keyword-rich homepage slug (/en/character-counter/, etc.). Runs as a
// Cloudflare Worker so each locale code is validated server-side.
export const prerender = false;

import { getLocale, isLocale, DEFAULT_LOCALE } from '../../i18n/config';

const { lang } = Astro.params as { lang: string };
const target = isLocale(lang) ? lang : DEFAULT_LOCALE;
const { slug } = getLocale(target);

return Astro.redirect(`/${target}/${slug}/`, 301);
---
