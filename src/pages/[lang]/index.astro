---
// Permanent redirect from the bare locale root (/en/, /es/, …) to the
// keyword-rich homepage slug (/en/character-counter/, etc.). Statically
// generated so the edge can intercept and serve these as 301s without
// invoking the SSR worker.

import { LOCALE_CODES, getLocale } from '../../i18n/config';

export function getStaticPaths() {
  return LOCALE_CODES.map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: string };
const { slug } = getLocale(lang);

return Astro.redirect(`/${lang}/${slug}/`, 301);
---
