---
import Layout from '../../../layouts/Layout.astro';
import ToolPageContent from '../../../components/ToolPageContent.astro';
import { SeoPreview } from '../../../components/island/SeoPreview';
import { tools } from '../../../data/tools';
import type { ToolDefinition } from '../../../data/tools';
import { LOCALES, getLocale, DEFAULT_LOCALE } from '../../../i18n/config';
import { getTranslations } from '../../../i18n';
import StructuredData from '../../../components/StructuredData.astro';

export function getStaticPaths() {
  const paths: {
    params: { lang: string; tool: string };
    props: { tool: ToolDefinition; currentLang: string };
  }[] = [];

  for (const tool of tools) {
    for (const locale of LOCALES) {
      const slug = tool.slugs[locale.code] ?? tool.slugs[DEFAULT_LOCALE];
      paths.push({
        params: { lang: locale.code, tool: slug },
        props: { tool, currentLang: locale.code },
      });
    }
  }

  return paths;
}

const { tool, currentLang: lang } = Astro.props as {
  tool: ToolDefinition;
  currentLang: string;
};

// Locale-aware lookup with English fallback
const tStr = <T,>(record: Record<string, T>): T => record[lang] ?? record[DEFAULT_LOCALE];

const site = Astro.site ?? new URL('https://posttruncate.com');
const toolSlug = tool.slugs[lang] ?? tool.slugs[DEFAULT_LOCALE];
const canonicalUrl = new URL(`/${lang}/${toolSlug}/`, site).href;

// One hreflang entry per locale, each pointing at that locale's own slug.
// x-default resolves to the English URL per Google best practice.
const hreflangUrls = [
  ...LOCALES.map((l) => {
    const slug = tool.slugs[l.code] ?? tool.slugs[DEFAULT_LOCALE];
    return { hreflang: l.code, href: new URL(`/${l.code}/${slug}/`, site).href };
  }),
  {
    hreflang: 'x-default',
    href: new URL(`/${DEFAULT_LOCALE}/${tool.slugs[DEFAULT_LOCALE]}/`, site).href,
  },
];

const locale = getLocale(lang);
const t = getTranslations(lang);
const editorHref = `/${lang}/${locale.slug}/?platform=${tool.id}#${tool.editorAnchor}`;
const home = `/${lang}/${locale.slug}/`;

// BreadcrumbList trail for this sub-tool page: Home → Platform Guides → tool.
// Built here (not inside StructuredData) so the URLs stay tied to tool data.
const homeUrl = new URL(`/${lang}/${locale.slug}/`, site).href;
const breadcrumbs = [
  { name: t.breadcrumbs.home, item: homeUrl },
  { name: t.nav.links.guides, item: new URL(`/${lang}/platform-limits/`, site).href },
  { name: tStr(tool.schemaName), item: canonicalUrl },
];

// Inputs for the embedded editor on standalone platform pages.
const toolSlugs: Record<string, string> = {};
for (const entry of tools) toolSlugs[entry.id] = entry.slugs[lang] ?? entry.slugs[DEFAULT_LOCALE];
const homeHref = `${home}#workspace`;
// FAQ items feed both the on-page accordion and FAQPage JSON-LD. Locale-specific
// (no fallback) so a page only emits FAQPage when it actually renders that FAQ.
const faqItems = tool.faq?.[lang];

// SERP-page-specific data — only computed for the google-serp tool.
const isSerpPage = tool.id === 'google-serp';
const translations = isSerpPage ? getTranslations(lang) : null;

const PROMO_IDS = ['twitter', 'instagram', 'linkedin', 'facebook', 'threads', 'sms'] as const;
const promoItems = isSerpPage
  ? PROMO_IDS.map((id) => {
      const pt = tools.find((tool) => tool.id === id)!;
      const promo = translations!.serpPage.crossPromo.platforms[id];
      return {
        id,
        name: promo.name,
        desc: promo.desc,
        href: `/${lang}/${pt.slugs[lang] ?? pt.slugs[DEFAULT_LOCALE]}/`,
      };
    })
  : [];
---

<Layout
  lang={lang}
  path="/tool/"
  title={tStr(tool.titles)}
  description={tStr(tool.metaDescriptions)}
  canonicalUrl={canonicalUrl}
  hreflangUrls={hreflangUrls}
>
  <StructuredData
    slot="head"
    type="platform"
    name={tStr(tool.schemaName)}
    url={canonicalUrl}
    description={tStr(tool.metaDescriptions)}
    inLanguage={lang}
    breadcrumbs={breadcrumbs}
    faqItems={faqItems}
  />
  <ToolPageContent
    tool={tool}
    lang={lang}
    editorHref={editorHref}
    hideCta={isSerpPage}
    strings={t.island}
    toolSlugs={toolSlugs}
    homeHref={homeHref}
  >
    {isSerpPage && translations && (
      <section slot="tool" class="serp-island">
        <div class="serp-island__inner">
          <SeoPreview client:load s={translations.island} />
        </div>
      </section>
    )}
  </ToolPageContent>

  {isSerpPage && translations && (
    <>
      <section class="serp-xpromo container-page">
        <h2 class="serp-xpromo__heading">{translations.serpPage.crossPromo.heading}</h2>
        <div class="serp-xpromo__grid">
          {promoItems.map((item) => (
            <a href={item.href} class="serp-xpromo__card">
              <span class="serp-xpromo__name">{item.name}</span>
              <span class="serp-xpromo__desc">{item.desc}</span>
            </a>
          ))}
        </div>
        <p class="serp-xpromo__foot">
          <a href={`${home}#workspace`}>{translations.serpPage.crossPromo.editorLink}</a>
        </p>
      </section>
    </>
  )}
</Layout>

<style>
  /* ── Embedded SERP tool — sits above the prose body, below the page header ── */
  .serp-island {
    padding-bottom: 48px;
  }
  .serp-island__inner {
    max-width: 48rem;
    margin-inline: auto;
  }

  /* ── Cross-promotion section ─────────────────────────────────────────────── */
  .serp-xpromo {
    padding-top: 64px;
    padding-bottom: 80px;
  }
  .serp-xpromo__heading {
    max-width: 48rem;
    margin-inline: auto;
    margin-bottom: 24px;
    font-size: clamp(22px, 4vw, 30px);
    font-weight: 600;
    letter-spacing: -0.96px;
    color: var(--color-ink);
  }
  .serp-xpromo__grid {
    max-width: 48rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
  .serp-xpromo__card {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 18px 20px;
    border-radius: var(--radius-lg);
    background: var(--color-canvas);
    box-shadow: var(--shadow-e1);
    border: 1px solid var(--color-hairline);
    transition: box-shadow 0.15s ease, transform 100ms ease;
    text-decoration: none;
  }
  .serp-xpromo__card:hover {
    box-shadow: var(--shadow-e2);
  }
  .serp-xpromo__card:active {
    transform: scale(0.98);
  }
  .serp-xpromo__name {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
  }
  .serp-xpromo__desc {
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
  }
  .serp-xpromo__foot {
    max-width: 48rem;
    margin-inline: auto;
    margin-top: 28px;
  }
  .serp-xpromo__foot a {
    font-size: 14px;
    color: var(--color-body);
    transition: color 0.15s ease;
  }
  .serp-xpromo__foot a:hover {
    color: var(--color-ink);
  }

  @media (min-width: 560px) {
    .serp-xpromo__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
