---
import Layout from '../../../../layouts/Layout.astro';
import CalculatorPageContent from '../../../../components/CalculatorPageContent.astro';
import StructuredData from '../../../../components/StructuredData.astro';
import WordsPerPageCalculator from '../../../../components/island/WordsPerPageCalculator.tsx';
import ReadingTimeCalculator from '../../../../components/island/ReadingTimeCalculator.tsx';
import ByteCounterCalculator from '../../../../components/island/ByteCounterCalculator.tsx';
import EmojiDetector from '../../../../components/island/EmojiDetector.tsx';
import PlatformCounter from '../../../../components/island/PlatformCounter.tsx';
import SentenceCounter from '../../../../components/island/SentenceCounter.tsx';
import SmsCounterCalculator from '../../../../components/island/SmsCounterCalculator.tsx';
import { SeoPreview } from '../../../../components/island/SeoPreview.tsx';
import { PLATFORM_COUNTERS } from '../../../../data/platformCounters';
import { calculators } from '../../../../data/calculators';
import type { ToolDefinition } from '../../../../data/tools';
import { LOCALES, getLocale, DEFAULT_LOCALE } from '../../../../i18n/config';
import { getTranslations } from '../../../../i18n';

export function getStaticPaths() {
  const paths: {
    params: { lang: string; tool: string };
    props: { tool: ToolDefinition; currentLang: string };
  }[] = [];

  for (const tool of calculators) {
    for (const locale of LOCALES) {
      const slug = tool.slugs[locale.code] ?? tool.slugs[DEFAULT_LOCALE];
      paths.push({
        params: { lang: locale.code, tool: slug },
        props: { tool, currentLang: locale.code },
      });
    }
  }

  return paths;
}

const { tool, currentLang: lang } = Astro.props as {
  tool: ToolDefinition;
  currentLang: string;
};

const tStr = <T,>(record: Record<string, T>): T => record[lang] ?? record[DEFAULT_LOCALE];

const site = Astro.site ?? new URL('https://posttruncate.com');
const toolSlug = tool.slugs[lang] ?? tool.slugs[DEFAULT_LOCALE];
const canonicalUrl = new URL(`/${lang}/tools/${toolSlug}/`, site).href;

// One hreflang entry per locale, each pointing at that locale's own slug;
// x-default resolves to the English URL per Google best practice.
const hreflangUrls = [
  ...LOCALES.map((l) => {
    const slug = tool.slugs[l.code] ?? tool.slugs[DEFAULT_LOCALE];
    return { hreflang: l.code, href: new URL(`/${l.code}/tools/${slug}/`, site).href };
  }),
  {
    hreflang: 'x-default',
    href: new URL(`/${DEFAULT_LOCALE}/tools/${tool.slugs[DEFAULT_LOCALE]}/`, site).href,
  },
];

const locale = getLocale(lang);
const t = getTranslations(lang);
const home = `/${lang}/${locale.slug}/`;
const homeHref = `${home}#workspace`;

// BreadcrumbList trail: Home → this tool.
const breadcrumbs = [
  { name: t.breadcrumbs.home, item: new URL(home, site).href },
  { name: tStr(tool.schemaName), item: canonicalUrl },
];

const faqItems = tool.faq?.[lang];
---

<Layout
  lang={lang}
  path="/tools/"
  title={tStr(tool.titles)}
  description={tStr(tool.metaDescriptions)}
  canonicalUrl={canonicalUrl}
  hreflangUrls={hreflangUrls}
>
  <StructuredData
    slot="head"
    type="platform"
    name={tStr(tool.schemaName)}
    url={canonicalUrl}
    description={tStr(tool.metaDescriptions)}
    inLanguage={lang}
    breadcrumbs={breadcrumbs}
    faqItems={faqItems}
  />
  <CalculatorPageContent tool={tool} lang={lang} homeHref={homeHref} breadcrumbs={breadcrumbs}>
    {/* Each calculator's live island is a static reference so Astro can resolve
        its hydration script. New tools add a branch here. */}
    {tool.id === 'words-per-page' && (
      <WordsPerPageCalculator client:load s={t.island} lang={lang} />
    )}
    {tool.id === 'reading-time' && (
      <ReadingTimeCalculator client:load s={t.island} lang={lang} />
    )}
    {tool.id === 'byte-counter' && (
      <ByteCounterCalculator client:load s={t.island} lang={lang} />
    )}
    {tool.id === 'emoji-counter' && (
      <EmojiDetector client:load s={t.island} lang={lang} />
    )}
    {PLATFORM_COUNTERS[tool.id] && (
      <PlatformCounter client:load platform={tool.id} s={t.island} lang={lang} />
    )}
    {tool.id === 'sentence-counter' && (
      <SentenceCounter client:load s={t.island} lang={lang} />
    )}
    {tool.id === 'sms' && (
      <SmsCounterCalculator client:load s={t.island} lang={lang} />
    )}
    {tool.id === 'google-serp' && (
      <SeoPreview client:load s={t.island} lang={lang} />
    )}
  </CalculatorPageContent>
</Layout>
