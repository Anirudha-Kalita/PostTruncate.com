---
// Two-column marketing hero for the standalone LinkedIn character-counter page.
// Left: a blue eyebrow badge, headline (with the phrase after the em-dash tinted
// LinkedIn blue) + lede + on-this-page pills. Right: the LinkedIn-logo tile on
// dashed orbit rings with floating stat cards.
//
// Like Instagram, the LinkedIn title highlights a text phrase whose wording and
// position vary per locale, so the accent is everything after the "—" — a
// language-agnostic split. The illustration is decorative (aria-hidden) and
// keeps its stylised English micro-labels.
import type { SectionAnchor } from '../lib/headingAnchors';

interface Props {
  title: string;
  intro: string;
  sections: SectionAnchor[];
  onThisPageLabel: string;
}

const { title, intro, sections, onThisPageLabel } = Astro.props;

const dashIndex = title.indexOf('—');
const titleHead = dashIndex >= 0 ? title.slice(0, dashIndex + 1) : title;
const titleTail = dashIndex >= 0 ? title.slice(dashIndex + 1).trim() : '';

// The "in" monogram (letters + dot), used small for the eyebrow.
const IN_GLYPH =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452z';

// Section navigation icons matching ICON_SETS.linkedin in ToolSectionCards.astro
const ICONS = [
  '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>',
  '<rect x="2" y="4" width="14" height="11" rx="1"/><path d="M6 19h6M9 15v4"/><rect x="17" y="9" width="5" height="12" rx="1"/>',
  '<path d="M22 7 13.5 15.5 8.5 10.5 2 17"/><path d="M16 7h6v6"/>',
];
---

<header class="lhero">
  <div class="lhero__copy">
    <span class="lhero__eyebrow">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
        <path d={IN_GLYPH}></path>
      </svg>
      LinkedIn tool
    </span>

    <h1 class="lhero__title">
      <span>{titleHead}</span>
      {titleTail && <><br /><span class="lhero__accent">{titleTail}</span></>}
    </h1>
    {intro && <p class="lhero__lede">{intro}</p>}
    
    {/* Jump navigation: mobile dropdown / desktop pills */}
    {sections.length > 0 && (
      <nav class="lhero__jump" aria-label={onThisPageLabel}>
        {/* Mobile dropdown */}
        <details class="lhero__mobile-nav">
          <summary class="lhero__mobile-toggle">
            <span class="lhero__mobile-label">{onThisPageLabel}</span>
            <svg class="lhero__mobile-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <ul class="lhero__mobile-list">
            {sections.map((section) => (
              <li>
                <a class="lhero__mobile-link" href={`#${section.id}`}>{section.label}</a>
              </li>
            ))}
          </ul>
        </details>

        {/* Desktop pills row */}
        <div class="lhero__desktop-nav">
          <span class="lhero__desktop-label">{onThisPageLabel}</span>
          <div class="lhero__pills">
            {sections.map((sec, idx) => (
              <a href={`#${sec.id}`} class="lhero__pill">
                <span class="lhero__pill-icon" set:html={`<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">${ICONS[idx % ICONS.length]}</svg>`} />
                <span>{sec.label}</span>
              </a>
            ))}
          </div>
        </div>
      </nav>
    )}
  </div>

  <div class="lhero__art" aria-hidden="true">
    <svg class="lhero__orbits" viewBox="0 0 100 100" fill="none" preserveAspectRatio="xMidYMid meet">
      <circle class="lhero__ring" cx="50" cy="50" r="46" stroke-width="0.5" stroke-dasharray="2 3" />
      <circle class="lhero__ring" cx="50" cy="50" r="34" stroke-width="0.5" stroke-dasharray="2 3" />
    </svg>

    <div class="lhero__logo">
      <svg viewBox="0 0 24 24" role="presentation">
        <path fill="#fff" d={IN_GLYPH}></path>
      </svg>
    </div>

    <div class="lhero__card lhero__card--chars">
      <span class="lhero__num">3000</span>
      <span class="lhero__label">Characters</span>
    </div>

    <div class="lhero__card lhero__card--desktop">
      <span class="lhero__num">210</span>
      <span class="lhero__label">Desktop fold</span>
    </div>

    <div class="lhero__card lhero__card--mobile">
      <span class="lhero__num">140</span>
      <span class="lhero__label">Mobile fold</span>
    </div>
  </div>
</header>

<style>
  .lhero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 40px;
  }

  /* ── Left column: copy ──────────────────────────────────────────────── */
  .lhero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-link-bg-soft);
    color: var(--color-link-deep);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lhero__title {
    font-size: clamp(30px, 5vw, 46px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -1.8px;
    color: var(--color-ink);
    }

  .lhero__accent {
    color: var(--color-link);
  }

  .lhero__lede {
    margin-top: 18px;
    max-width: 34rem;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }

  /* ── Jump menu: responsive mobile / desktop ──────────────────────────── */
  .lhero__jump {
    margin-top: 24px;
  }

  .lhero__mobile-nav {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
  }

  .lhero__mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .lhero__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .lhero__mobile-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .lhero__mobile-chevron {
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.15s ease;
  }

  .lhero__mobile-nav[open] .lhero__mobile-chevron {
    transform: rotate(180deg);
  }

  .lhero__mobile-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0 8px 8px;
    list-style: none;
    border-top: 1px solid var(--color-hairline);
  }

  .lhero__mobile-link {
    display: block;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .lhero__mobile-link:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }

  .lhero__desktop-nav {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .lhero__desktop-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .lhero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .lhero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-body);
    transition: all 0.15s ease;
  }

  .lhero__pill:hover {
    border-color: var(--color-link);
    color: var(--color-link-deep);
    box-shadow: var(--shadow-e1);
  }

  .lhero__pill-icon {
    display: inline-flex;
    align-items: center;
    color: var(--color-link);
  }

  @media (min-width: 640px) {
    .lhero__mobile-nav {
      display: none;
    }
    .lhero__desktop-nav {
      display: flex;
    }
  }

  /* ── Right column: decorative illustration ──────────────────────────── */
  .lhero__art {
    position: relative;
    display: none;
    aspect-ratio: 5 / 4;
    max-width: 460px;
    margin-inline: auto;
    width: 100%;
  }

  .lhero__orbits {
    position: absolute;
    inset: 4% 0;
    width: 100%;
    height: 92%;
    margin: auto;
  }

  .lhero__ring {
    fill: none;
    stroke: var(--color-link-bg-soft);
  }

  /* LinkedIn tile — the brand blue lives on the wrapper (gradient lighting) so
     the white "in" glyph sits above it with 3D depth: stacked blue-tinted
     shadows plus inset highlight/shade. Branded (fixed blue) in both themes. */
  .lhero__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44%;
    aspect-ratio: 1;
    border-radius: 26%;
    background: linear-gradient(158deg, #3b8ae5 0%, #0a66c2 52%, #064a94 100%);
    box-shadow:
      0 3px 4px rgba(5, 58, 120, 0.35),
      0 12px 22px -6px rgba(5, 58, 120, 0.5),
      0 32px 50px -14px rgba(5, 58, 120, 0.5),
      inset 0 3px 6px rgba(255, 255, 255, 0.4),
      inset 0 -8px 14px rgba(4, 45, 110, 0.45);
  }

  .lhero__logo svg {
    display: block;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 3px 4px rgba(4, 45, 110, 0.45));
  }

  /* Floating cards share a soft elevated surface that adapts to dark mode. */
  .lhero__card {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 18px;
    border-radius: var(--radius-xl);
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
  }

  .lhero__card--chars {
    top: 4%;
    right: 2%;
  }
  .lhero__card--desktop {
    top: 46%;
    left: 0;
  }
  .lhero__card--mobile {
    bottom: 8%;
    right: 0;
  }

  .lhero__num {
    font-size: 30px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -1px;
    color: var(--color-link);
  }

  .lhero__label {
    font-size: 12px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-mute);
  }

  /* ── Responsive: two columns + illustration only on wider viewports ──── */
  @media (min-width: 900px) {
    .lhero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
      margin-bottom: 48px;
    }

    .lhero__art {
      display: block;
    }
  }
</style>
