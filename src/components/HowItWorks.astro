---
// HowItWorks.astro — Three-step explainer cards placed above the editor workspace.
// Uses inline Tabler outline SVGs: ti-pencil, ti-device-laptop, ti-eye.
// No npm icon dependency; paths match Tabler v3 outline set.
import { getTranslations } from '../i18n';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const { howItWorks } = getTranslations(lang);

const ICONS = [
  // Step 1 — pencil/edit
  '<path d="M4 20h4l10.5-10.5a2.828 2.828 0 1 0-4-4L4 16v4"/><path d="M13.5 6.5l4 4"/>',
  // Step 2 — laptop/device
  '<path d="M3 19h18"/><path d="M5 6a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v9H5V6z"/>',
  // Step 3 — eye
  '<path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0-4 0"/><path d="M21 12c-2.4 4-5.4 6-9 6c-3.6 0-6.6-2-9-6c2.4-4 5.4-6 9-6c3.6 0 6.6 2 9 6"/>',
] as const;
---

<section class="how-it-works container-page" aria-labelledby="hiw-heading">
  <h2 id="hiw-heading" class="sr-only">{howItWorks.heading}</h2>

  <ol class="hiw-grid" role="list">
    {howItWorks.steps.map((step, i) => (
      <li class="hiw-card">
        <div class="hiw-card__top">
          <span class="hiw-card__step" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div class="hiw-card__icon" aria-hidden="true">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18" height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={ICONS[i]}
            />
          </div>
        </div>
        <h3 class="hiw-card__title">{step.name}</h3>
        <p class="hiw-card__body">{step.text}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  /* ── Section wrapper ────────────────────────────────────────────────────── */
  .how-it-works {
    padding-top: 32px;
    padding-bottom: 0;
  }

  /* Visually hidden but discoverable by assistive technology */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }

  /* ── 3-up horizontal card grid ──────────────────────────────────────────── */
  .hiw-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* ── Individual step card ───────────────────────────────────────────────── */
  .hiw-card {
    background: var(--color-canvas);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-e2);
    padding: 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Step number + icon row */
  .hiw-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .hiw-card__step {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.04em;
    color: var(--color-mute);
  }

  /* Small icon container — canvas-soft fill with hairline border */
  .hiw-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-sm);
    background: var(--color-canvas-soft);
    border: 1px solid var(--color-hairline);
    color: var(--color-body);
    flex-shrink: 0;
  }

  .hiw-card__title {
    font-size: 14px;
    font-weight: 600;
    line-height: 20px;
    letter-spacing: -0.28px;
    color: var(--color-ink);
  }

  .hiw-card__body {
    font-size: 13px;
    line-height: 19px;
    color: var(--color-body);
  }

  /* ── Responsive ─────────────────────────────────────────────────────────── */
  @media (max-width: 680px) {
    .hiw-grid {
      grid-template-columns: 1fr;
    }

    .how-it-works {
      padding-top: 24px;
    }
  }
</style>
