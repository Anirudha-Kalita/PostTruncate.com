---
/**
 * TrustBar — slim social-proof strip between the hero and the editor.
 * Inline Tabler outline SVGs (ti-lock, ti-shield, ti-device-mobile);
 * no npm dependency required.
 *
 * Copy is English-only. To localise later: add trustBar.{ free, privacy,
 * platforms } to the Translations interface and pass as Astro.props.
 */
---

<div class="trust-bar">
  <div class="container-page">
    <ul class="trust-bar__list" role="list">

      <li class="trust-bar__item">
        <!-- ti-lock -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14" height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 13a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2v-6z"/>
          <path d="M11 16a1 1 0 1 0 2 0a1 1 0 0 0-2 0"/>
          <path d="M8 11V7a4 4 0 0 1 8 0v4"/>
        </svg>
        100% free — no sign-up
      </li>

      <li class="trust-bar__sep" aria-hidden="true">·</li>

      <li class="trust-bar__item">
        <!-- ti-shield -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14" height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 3a12 12 0 0 0 8.5 3a12 12 0 0 1-8.5 15a12 12 0 0 1-8.5-15a12 12 0 0 0 8.5-3"/>
        </svg>
        Privacy-first — text never leaves your browser
      </li>

      <li class="trust-bar__sep" aria-hidden="true">·</li>

      <li class="trust-bar__item">
        <!-- ti-device-mobile -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14" height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M6 5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V5z"/>
          <path d="M11 4h2"/>
          <path d="M12 17v.01"/>
        </svg>
        10+ platform limits covered
      </li>

    </ul>
  </div>
</div>

<style>
  .trust-bar {
    background: var(--color-canvas-soft);
    border-top: 1px solid var(--color-hairline);
    border-bottom: 1px solid var(--color-hairline);
  }

  .trust-bar__list {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0 1.75rem;
    list-style: none;
    margin: 0;
    padding-block: 0.625rem; /* ~10 px — slim but not cramped */
  }

  .trust-bar__item {
    display: flex;
    align-items: center;
    gap: 0.375rem;        /* 6 px between icon and label */
    font-size: 0.8125rem; /* 13 px */
    line-height: 1.25rem;
    color: var(--color-mute);
    white-space: nowrap;
  }

  .trust-bar__sep {
    color: var(--color-hairline);
    font-size: 1.125rem;
    line-height: 1;
    user-select: none;
    list-style: none;
  }

  /* Narrow viewports: drop separators, let items soft-wrap */
  @media (max-width: 640px) {
    .trust-bar__sep  { display: none; }
    .trust-bar__list { gap: 0.25rem 0.875rem; padding-block: 0.5rem; }
    .trust-bar__item { font-size: 0.75rem; white-space: normal; }
  }
</style>
