---
// Two-column marketing hero for the Pinterest character-counter page. Left: a
// red eyebrow badge, headline (with the phrase after the em-dash in a red
// gradient) + lede + on-this-page pills. Right: a Pin-card mockup with the
// Pinterest logo, skeleton copy and an image placeholder, plus floating "Aa" and
// analytics badges over dotted-grid + soft-red decoration.
//
// The accent is everything after the "—" so it stays language-agnostic across
// all 10 locales. The illustration is decorative (aria-hidden).
import type { SectionAnchor } from '../lib/headingAnchors';

interface Props {
  title: string;
  intro: string;
  sections: SectionAnchor[];
  onThisPageLabel: string;
}

const { title, intro, sections, onThisPageLabel } = Astro.props;

const dashIndex = title.indexOf('—');
const titleHead = dashIndex >= 0 ? title.slice(0, dashIndex + 1) : title;
const titleTail = dashIndex >= 0 ? title.slice(dashIndex + 1).trim() : '';

// Section navigation icons matching ICON_SETS.pinterest in ToolSectionCards.astro
const ICONS = [
  '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>',
  '<circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/>',
  '<path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9z"/><circle cx="7.5" cy="7.5" r="1.2"/>',
  '<path d="M12 3l8 3v5c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/>',
];

const PIN_GLYPH =
  'M12.3 5.5c-3.8 0-5.7 2.7-5.7 5 0 1.4.5 2.6 1.7 3 .2.1.4 0 .4-.2l.2-.7c.1-.2 0-.3-.1-.4-.4-.5-.7-1.1-.7-2 0-2.5 1.9-4.8 5-4.8 2.7 0 4.2 1.7 4.2 3.9 0 2.9-1.3 5.4-3.2 5.4-1.1 0-1.8-.9-1.6-2 .3-1.3.9-2.6.9-3.5 0-.8-.4-1.5-1.3-1.5-1.1 0-1.9 1.1-1.9 2.6 0 .9.3 1.6.3 1.6l-1.3 5.4c-.4 1.6-.1 3.6 0 3.8 0 .1.2.2.3.1.1-.1 1.4-1.7 1.8-3.3l.7-2.7c.4.7 1.4 1.3 2.5 1.3 3.3 0 5.6-3 5.6-7.1 0-3.1-2.6-5.9-6.3-5.9z';
---

<header class="pihero">
  <div class="pihero__copy">
    <span class="pihero__eyebrow">
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
        <circle cx="12" cy="12" r="12" fill="currentColor"></circle>
        <path fill="#fff" d={PIN_GLYPH}></path>
      </svg>
      Pinterest tool
    </span>

    <h1 class="pihero__title">
      <span>{titleHead}</span>
      {titleTail && <><br /><span class="pihero__accent">{titleTail}</span></>}
    </h1>
    {intro && <p class="pihero__lede">{intro}</p>}
    {/* Jump navigation: mobile dropdown / desktop pills */}
    {sections.length > 0 && (
      <nav class="pihero__jump" aria-label={onThisPageLabel}>
        {/* Mobile dropdown */}
        <details class="pihero__mobile-nav">
          <summary class="pihero__mobile-toggle">
            <span class="pihero__mobile-label">{onThisPageLabel}</span>
            <svg class="pihero__mobile-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <ul class="pihero__mobile-list">
            {sections.map((section) => (
              <li>
                <a class="pihero__mobile-link" href={`#${section.id}`}>{section.label}</a>
              </li>
            ))}
          </ul>
        </details>

        {/* Desktop pills row */}
        <div class="pihero__desktop-nav">
          <span class="pihero__desktop-label">{onThisPageLabel}</span>
          <div class="pihero__pills">
            {sections.map((sec, idx) => (
              <a href={`#${sec.id}`} class="pihero__pill">
                <span class="pihero__pill-icon" set:html={`<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">${ICONS[idx % ICONS.length]}</svg>`} />
                <span>{sec.label}</span>
              </a>
            ))}
          </div>
        </div>
      </nav>
    )}
  </div>

  <div class="pihero__art" aria-hidden="true">
    <span class="pihero__blob"></span>
    <span class="pihero__dots"></span>

    <div class="pihero__card">
      <div class="pihero__logo">
        <svg width="100%" height="100%" viewBox="0 0 24 24" role="presentation">
          <circle cx="12" cy="12" r="12" fill="#E60023"></circle>
          <path fill="#fff" d={PIN_GLYPH}></path>
        </svg>
      </div>
      <div class="pihero__lines">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="pihero__image">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="16" rx="2"></rect><circle cx="8.5" cy="9" r="1.5"></circle><path d="m4 18 5-5 4 4 3-3 4 4"></path>
        </svg>
      </div>
    </div>

    <span class="pihero__badge pihero__badge--aa">Aa</span>
    <span class="pihero__badge pihero__badge--chart">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 21h18"></path><path d="M7 21v-6M12 21V9M17 21v-9"></path>
      </svg>
    </span>
  </div>
</header>

<style>
  .pihero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 40px;
  }

  /* ── Left column: copy (Pinterest red) ──────────────────────────────── */
  .pihero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, #e60023 12%, transparent);
    color: #c9001f;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pihero__title {
    font-size: clamp(30px, 5vw, 46px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -1.8px;
    color: var(--color-ink);
    }

  .pihero__accent {
    background: linear-gradient(96deg, #e60023 0%, #ff5478 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .pihero__lede {
    margin-top: 18px;
    max-width: 34rem;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }

  /* ── Jump menu: responsive mobile / desktop ──────────────────────────── */
  .pihero__jump {
    margin-top: 24px;
  }

  .pihero__mobile-nav {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
  }

  .pihero__mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .pihero__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .pihero__mobile-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .pihero__mobile-chevron {
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.15s ease;
  }

  .pihero__mobile-nav[open] .pihero__mobile-chevron {
    transform: rotate(180deg);
  }

  .pihero__mobile-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0 8px 8px;
    list-style: none;
    border-top: 1px solid var(--color-hairline);
  }

  .pihero__mobile-link {
    display: block;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .pihero__mobile-link:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }

  .pihero__desktop-nav {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .pihero__desktop-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .pihero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pihero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-body);
    transition: all 0.15s ease;
  }

  .pihero__pill:hover {
    border-color: #e60023;
    color: #c9001f;
    box-shadow: var(--shadow-e1);
  }

  .pihero__pill-icon {
    display: inline-flex;
    align-items: center;
    color: #e60023;
  }

  @media (min-width: 640px) {
    .pihero__mobile-nav {
      display: none;
    }
    .pihero__desktop-nav {
      display: flex;
    }
  }

  /* ── Right column: Pinterest card mockup ────────────────────────────── */
  .pihero__art {
    position: relative;
    display: none;
    aspect-ratio: 1 / 1;
    max-width: 440px;
    margin-inline: auto;
    width: 100%;
  }

  .pihero__blob {
    position: absolute;
    left: 4%;
    top: 22%;
    width: 28%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, #e60023 14%, transparent), transparent 70%);
  }
  .pihero__dots {
    position: absolute;
    right: 4%;
    top: 12%;
    width: 74px;
    height: 60px;
    background-image: radial-gradient(currentColor 1.3px, transparent 1.3px);
    background-size: 11px 11px;
    color: color-mix(in srgb, #e60023 26%, transparent);
  }

  /* Pin card */
  .pihero__card {
    position: absolute;
    top: 50%;
    left: 52%;
    transform: translate(-50%, -50%);
    width: 58%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 18px;
    border-radius: 18px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
  }
  .pihero__logo {
    align-self: center;
    width: 30%;
    aspect-ratio: 1;
    margin-bottom: 4px;
    filter: drop-shadow(0 6px 12px rgba(201, 0, 31, 0.28));
  }
  .pihero__logo svg {
    width: 100%;
    height: 100%;
  }
  .pihero__lines {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .pihero__lines span {
    height: 7px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, #e60023 16%, transparent);
  }
  .pihero__lines span:nth-child(1) {
    width: 90%;
  }
  .pihero__lines span:nth-child(2) {
    width: 74%;
  }
  .pihero__lines span:nth-child(3) {
    width: 58%;
  }
  .pihero__image {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 9;
    margin-top: 4px;
    border-radius: 10px;
    background: var(--color-canvas-soft-2);
    color: var(--color-hairline-strong);
  }
  .pihero__image svg {
    width: 34px;
    height: 34px;
  }

  /* Floating badges */
  .pihero__badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: color-mix(in srgb, #e60023 10%, var(--color-canvas));
    box-shadow: var(--shadow-e5);
    color: #e60023;
  }
  .pihero__badge svg {
    width: 24px;
    height: 24px;
  }
  .pihero__badge--aa {
    right: 0;
    top: 24%;
    font-size: 22px;
    font-weight: 700;
  }
  .pihero__badge--chart {
    right: 3%;
    bottom: 24%;
  }

  /* ── Responsive: two columns + illustration only on wider viewports ──── */
  @media (min-width: 900px) {
    .pihero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
      margin-bottom: 48px;
    }

    .pihero__art {
      display: block;
    }
  }
</style>
