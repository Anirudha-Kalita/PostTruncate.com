---
// Two-column marketing hero for the standalone TikTok caption-checker page.
// Left: a magenta eyebrow badge, headline (with the "4,000" figure accented in
// TikTok magenta) + lede + on-this-page pills. Right: a CSS-3D black TikTok tile
// with the signature cyan/magenta chromatic note, on a soft glow with floating
// stat cards. Brand palette: cyan #25F4EE, magenta #FE2C55, black #010101.
//
// The figure is written with locale-specific thousands separators (4,000 / 4.000
// / 4 000), so the accent is matched with a regex rather than a literal split —
// keeping it language-agnostic across all 10 locales. The illustration is
// decorative (aria-hidden) with stylised English micro-labels.
import type { SectionAnchor } from '../lib/headingAnchors';

interface Props {
  title: string;
  intro: string;
  sections: SectionAnchor[];
  onThisPageLabel: string;
}

const { title, intro, sections, onThisPageLabel } = Astro.props;

// Match "4,000" / "4.000" / "4 000" (comma, period or any whitespace separator).
const numMatch = title.match(/4[.,\s]000/);
const numIndex = numMatch?.index ?? -1;
const titleHead = numIndex >= 0 ? title.slice(0, numIndex) : title;
const accentNum = numMatch?.[0] ?? '';
const titleTail = numIndex >= 0 ? title.slice(numIndex + accentNum.length) : '';

const TIKTOK_GLYPH =
  'M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.59 2.59 0 0 1-2.59-2.59 2.59 2.59 0 0 1 3.39-2.46V9.69a5.66 5.66 0 0 0-.8-.06A5.69 5.69 0 0 0 4.17 15.31 5.69 5.69 0 0 0 13.94 19.3a5.69 5.69 0 0 0 1.6-3.96V9.01a7.34 7.34 0 0 0 4.29 1.37V7.3a4.28 4.28 0 0 1-3.23-1.48z';

// Section navigation icons matching ICON_SETS.tiktok in ToolSectionCards.astro
const ICONS = [
  '<path d="M4 6h16M4 12h10M4 18h13"/>',
  '<circle cx="5" cy="12" r="1.5" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/><circle cx="19" cy="12" r="1.5" fill="currentColor" stroke="none"/>',
  '<rect x="6" y="3" width="12" height="18" rx="2"/><path d="M10.5 9 15 12l-4.5 3z"/>',
  '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
];
---

<header class="tthero">
  <div class="tthero__copy">
    <span class="tthero__eyebrow">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
        <path d={TIKTOK_GLYPH}></path>
      </svg>
      TikTok tool
    </span>

    <h1 class="tthero__title">
      {titleHead}<span class="tthero__accent">{accentNum}</span>{titleTail}
    </h1>
    {intro && <p class="tthero__lede">{intro}</p>}
    {/* Jump navigation: mobile dropdown / desktop pills */}
    {sections.length > 0 && (
      <nav class="tthero__jump" aria-label={onThisPageLabel}>
        {/* Mobile dropdown */}
        <details class="tthero__mobile-nav">
          <summary class="tthero__mobile-toggle">
            <span class="tthero__mobile-label">{onThisPageLabel}</span>
            <svg class="tthero__mobile-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <ul class="tthero__mobile-list">
            {sections.map((section) => (
              <li>
                <a class="tthero__mobile-link" href={`#${section.id}`}>{section.label}</a>
              </li>
            ))}
          </ul>
        </details>

        {/* Desktop pills row */}
        <div class="tthero__desktop-nav">
          <span class="tthero__desktop-label">{onThisPageLabel}</span>
          <div class="tthero__pills">
            {sections.map((sec, idx) => (
              <a href={`#${sec.id}`} class="tthero__pill">
                <span class="tthero__pill-icon" set:html={`<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">${ICONS[idx % ICONS.length]}</svg>`} />
                <span>{sec.label}</span>
              </a>
            ))}
          </div>
        </div>
      </nav>
    )}
  </div>

  <div class="tthero__art" aria-hidden="true">
    <svg width="100%" height="100%" class="tthero__orbits" viewBox="0 0 100 100" fill="none" preserveAspectRatio="xMidYMid meet">
      <circle class="tthero__ring" cx="50" cy="50" r="45" stroke-width="0.5" />
    </svg>
    <span class="tthero__glow"></span>

    {/* CSS-3D black tile with the offset cyan/magenta/white chromatic note.
        Fills are set in CSS — var()/color-mix don't resolve in SVG attributes. */}
    <div class="tthero__logo">
      <svg width="100%" height="100%" viewBox="0 0 24 24" role="presentation">
        <path class="tthero__note tthero__note--cyan" transform="translate(-0.7 -0.5)" d={TIKTOK_GLYPH}></path>
        <path class="tthero__note tthero__note--magenta" transform="translate(0.7 0.5)" d={TIKTOK_GLYPH}></path>
        <path class="tthero__note tthero__note--white" d={TIKTOK_GLYPH}></path>
      </svg>
    </div>

    <div class="tthero__card tthero__card--chars">
      <span class="tthero__num">4,000</span>
      <span class="tthero__label">Characters</span>
    </div>

    <div class="tthero__card tthero__card--api">
      <span class="tthero__num">2,200</span>
      <span class="tthero__label">Via API</span>
    </div>

    <div class="tthero__card tthero__card--canvas">
      <span class="tthero__num">9:16</span>
      <span class="tthero__label">Canvas</span>
    </div>

    <div class="tthero__card tthero__card--heart">
      <svg viewBox="0 0 24 24" class="tthero__heart" width="24" height="24">
        <path d="M12 21s-8-4.5-8-10a4 4 0 0 1 8-1 4 4 0 0 1 8 1c0 5.5-8 10-8 10z"></path>
      </svg>
    </div>
  </div>
</header>

<style>
  .tthero {
    --tt-cyan: #25f4ee;
    --tt-magenta: #fe2c55;
    --tt-magenta-deep: color-mix(in srgb, var(--tt-magenta) 82%, #000);
    --tt-black: #010101;

    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 40px;
  }

  /* ── Left column: copy ──────────────────────────────────────────────── */
  .tthero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--tt-magenta) 12%, transparent);
    color: var(--tt-magenta-deep);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tthero__title {
    font-size: clamp(30px, 5vw, 46px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -1.8px;
    color: var(--color-ink);
    }

  .tthero__accent {
    color: var(--tt-magenta);
  }

  .tthero__lede {
    margin-top: 18px;
    max-width: 34rem;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }

  /* ── Jump menu: responsive mobile / desktop ──────────────────────────── */
  .tthero__jump {
    margin-top: 24px;
  }

  .tthero__mobile-nav {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
  }

  .tthero__mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .tthero__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .tthero__mobile-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .tthero__mobile-chevron {
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.15s ease;
  }

  .tthero__mobile-nav[open] .tthero__mobile-chevron {
    transform: rotate(180deg);
  }

  .tthero__mobile-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0 8px 8px;
    list-style: none;
    border-top: 1px solid var(--color-hairline);
  }

  .tthero__mobile-link {
    display: block;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .tthero__mobile-link:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }

  .tthero__desktop-nav {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .tthero__desktop-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .tthero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tthero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-body);
    transition: all 0.15s ease;
  }

  .tthero__pill:hover {
    border-color: var(--tt-magenta);
    color: var(--tt-magenta-deep);
    box-shadow: var(--shadow-e1);
  }

  .tthero__pill-icon {
    display: inline-flex;
    align-items: center;
    color: var(--tt-magenta);
  }

  @media (min-width: 640px) {
    .tthero__mobile-nav {
      display: none;
    }
    .tthero__desktop-nav {
      display: flex;
    }
  }

  /* ── Right column: decorative illustration ──────────────────────────── */
  .tthero__art {
    position: relative;
    display: none;
    aspect-ratio: 5 / 4;
    max-width: 460px;
    margin-inline: auto;
    width: 100%;
  }

  .tthero__orbits {
    position: absolute;
    inset: 4% 0;
    width: 100%;
    height: 92%;
    margin: auto;
  }

  .tthero__ring {
    fill: none;
    stroke: color-mix(in srgb, var(--tt-magenta) 20%, transparent);
  }

  .tthero__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 62%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--tt-magenta) 22%, transparent) 0%,
      color-mix(in srgb, var(--tt-cyan) 14%, transparent) 46%,
      transparent 70%
    );
  }

  /* CSS-3D black tile — subtle gradient, stacked shadows and inset highlights
     fake the glossy depth of the reference render. */
  .tthero__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 27%;
    background: linear-gradient(158deg, #2c2c2c 0%, var(--tt-black) 62%);
    box-shadow:
      0 2px 3px rgba(0, 0, 0, 0.4),
      0 10px 20px -6px rgba(0, 0, 0, 0.5),
      0 30px 48px -14px rgba(0, 0, 0, 0.45),
      inset 0 3px 6px rgba(255, 255, 255, 0.14),
      inset 0 -8px 14px rgba(0, 0, 0, 0.55);
  }

  .tthero__logo svg {
    width: 54%;
    height: 54%;
  }

  .tthero__note--cyan {
    fill: var(--tt-cyan);
  }
  .tthero__note--magenta {
    fill: var(--tt-magenta);
  }
  .tthero__note--white {
    fill: #fff;
  }

  .tthero__heart {
    fill: var(--tt-magenta);
  }

  /* Floating cards share a soft elevated surface that adapts to dark mode. */
  .tthero__card {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 18px;
    border-radius: var(--radius-xl);
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
  }

  .tthero__card--chars {
    top: 2%;
    right: 3%;
  }
  .tthero__card--api {
    top: 46%;
    left: 0;
  }
  .tthero__card--canvas {
    bottom: 8%;
    right: 0;
  }

  .tthero__card--heart {
    bottom: 0;
    left: 44%;
    padding: 12px;
    border-radius: var(--radius-lg);
  }

  .tthero__num {
    font-size: 30px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -1px;
    color: var(--tt-magenta);
  }

  .tthero__label {
    font-size: 12px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-mute);
  }

  /* ── Responsive: two columns + illustration only on wider viewports ──── */
  @media (min-width: 900px) {
    .tthero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
      margin-bottom: 48px;
    }

    .tthero__art {
      display: block;
    }
  }
</style>
