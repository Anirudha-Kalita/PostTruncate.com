---
// Shared body for the About page, used by BOTH about routes:
//   • /[lang]/about/          (src/pages/[lang]/about.astro)
//   • /[lang]/<slug>/about/   (src/pages/[lang]/[slug]/about.astro — nav-linked)
// A marketing hero (with a 3D "document + eye" illustration) plus the four
// content sections rendered as icon cards. Privacy/Terms keep the plain Prose
// renderer; only About uses this richer layout.
import type { ContentPage } from '../i18n/types';
import { getLocale } from '../i18n/config';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  lang: string;
  page: ContentPage;
  backHome: string;
  authorImage?: string;
  authorImageAlt?: string;
  authorImageSectionIndex?: number;
}

const {
  lang,
  page,
  backHome,
  authorImage,
  authorImageAlt,
  authorImageSectionIndex = 1,
} = Astro.props;
const home = `/${lang}/${getLocale(lang).slug}/`;

// Per-section icon + colour tint, by index (the About sections are fixed).
const EDIT = '<path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>';
const PERSON = '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>';
const TARGET = '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/>';
const SHIELD = '<path d="M12 3l8 3v5c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/>';
const SECTION_META = [
  { icon: EDIT, tint: 'tint-violet' },
  { icon: PERSON, tint: 'tint-violet' },
  { icon: TARGET, tint: 'tint-green' },
  { icon: SHIELD, tint: 'tint-blue' },
];
const metaFor = (i: number) => SECTION_META[i] ?? { icon: EDIT, tint: 'tint-violet' };
---

<section class="ab container-page">
  <div class="ab__inner">
    {/* ── Hero ────────────────────────────────────────────────────────── */}
    <header class="ab-hero">
      <div class="ab-hero__copy">
        <span class="ab-hero__eyebrow">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>
          {page.title}
        </span>
        <h1 class="ab-hero__title">{page.title}</h1>
        <p class="ab-hero__intro">{page.intro}</p>
      </div>

      <div class="ab-hero__art" aria-hidden="true">
        <svg viewBox="0 0 230 210" fill="none" xmlns="http://www.w3.org/2000/svg" role="presentation">
          <defs>
            <linearGradient id="ab-doc" x1="0.5" y1="0" x2="0.5" y2="1">
              <stop offset="0" stop-color="#ffffff"></stop>
              <stop offset="1" stop-color="#edeff7"></stop>
            </linearGradient>
            <linearGradient id="ab-eye" x1="0.2" y1="0" x2="0.8" y2="1">
              <stop offset="0" stop-color="#8464f2"></stop>
              <stop offset="1" stop-color="#5b34c9"></stop>
            </linearGradient>
          </defs>

          <g transform="rotate(4 120 104)">
            <rect x="72" y="28" width="122" height="152" rx="15" fill="url(#ab-doc)"></rect>
            <rect x="90" y="50" width="72" height="9" rx="4.5" fill="#dfe1ee"></rect>
            <rect x="90" y="66" width="52" height="9" rx="4.5" fill="#e9ebf4"></rect>
            <path d="M82 92h102" stroke="#7c5cf0" stroke-width="3" stroke-dasharray="9 7" stroke-linecap="round"></path>
            <rect x="90" y="108" width="86" height="9" rx="4.5" fill="#d7dae8"></rect>
            <rect x="90" y="124" width="66" height="9" rx="4.5" fill="#e3e5f1"></rect>
            <rect x="90" y="140" width="76" height="9" rx="4.5" fill="#e3e5f1"></rect>
            <rect x="90" y="156" width="44" height="9" rx="4.5" fill="#e9ebf4"></rect>
          </g>

          <rect x="150" y="150" width="58" height="58" rx="18" fill="url(#ab-eye)"></rect>
          <g transform="translate(179 179)">
            <path d="M-13 0s5-8 13-8 13 8 13 8-5 8-13 8-13-8-13-8z" fill="none" stroke="#ffffff" stroke-width="2.4"></path>
            <circle cx="0" cy="0" r="3.4" fill="#ffffff"></circle>
          </g>

          <path d="M124 40h12M130 34v12" stroke="#ff4d97" stroke-width="3.5" stroke-linecap="round"></path>
          <path d="M198 70h10M203 65v10" stroke="#2fd0e6" stroke-width="3" stroke-linecap="round"></path>
          <circle cx="104" cy="92" r="4.5" fill="#7c5cf0"></circle>
          <circle cx="206" cy="126" r="3.5" fill="#a68af8"></circle>
          <circle cx="116" cy="198" r="3" fill="#2fb0f0"></circle>
        </svg>
      </div>
    </header>

    {/* ── Content sections ────────────────────────────────────────────── */}
    {
      page.sections.map((s, i) => {
        const meta = metaFor(i);
        const isAuthor = authorImage && i === authorImageSectionIndex;
        return isAuthor ? (
          <section class={`ab-card ab-card--author ${meta.tint}`}>
            <ResponsiveImage
              src={authorImage}
              alt={authorImageAlt ?? ''}
              class="ab-card__photo"
              sizes="(max-width: 600px) 120px, 148px"
              loading="lazy"
              decoding="async"
            />
            <div class="ab-card__content">
              <div class="ab-card__head">
                <span class="ab-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={meta.icon} /></span>
                <h2 class="ab-card__title">{s.heading}</h2>
              </div>
              {s.paragraphs.map((p) => <p class="ab-card__p" set:html={p} />)}
            </div>
          </section>
        ) : (
          <section class={`ab-card ${meta.tint}`}>
            <span class="ab-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={meta.icon} /></span>
            <div class="ab-card__content">
              <h2 class="ab-card__title">{s.heading}</h2>
              {s.paragraphs.map((p) => <p class="ab-card__p" set:html={p} />)}
            </div>
          </section>
        );
      })
    }

    <a class="ab-back" href={`${home}#workspace`}>{backHome}</a>
  </div>
</section>

<style>
  .ab {
    scroll-margin-top: 80px;
    padding-top: 44px;
    padding-bottom: 96px;
  }
  .ab__inner {
    max-width: 60rem;
    margin-inline: auto;
  }

  /* ── Tint tokens ──────────────────────────────────────────────────────── */
  .tint-violet {
    --soft: var(--color-violet-soft);
    --fg: var(--color-violet-deep);
  }
  .tint-green {
    --soft: var(--color-cyan-soft);
    --fg: var(--color-cyan-deep);
  }
  .tint-blue {
    --soft: var(--color-link-bg-soft);
    --fg: var(--color-link);
  }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .ab-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    align-items: center;
    margin-bottom: 44px;
  }
  .ab-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-violet-soft);
    color: var(--color-violet-deep);
    font-size: 13px;
    font-weight: 600;
  }
  .ab-hero__title {
    margin-top: 18px;
    font-size: clamp(34px, 5.4vw, 52px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -1.9px;
    color: var(--color-ink);
  }
  .ab-hero__intro {
    margin-top: 16px;
    max-width: 34rem;
    font-size: 17px;
    line-height: 27px;
    color: var(--color-body);
  }
  .ab-hero__art {
    display: none;
    justify-self: end;
    width: 100%;
    max-width: 320px;
  }
  .ab-hero__art svg {
    width: 100%;
    height: auto;
  }

  /* ── Content cards ────────────────────────────────────────────────────── */
  .ab-card {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    margin-top: 24px;
    padding: 28px;
    border-radius: var(--radius-xl);
    background: var(--color-canvas);
    box-shadow: var(--shadow-e1);
    border: 1px solid var(--color-hairline);
    transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }
  .ab-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-e4);
  }
  .ab-card:not(.ab-card--author):hover {
    border-color: var(--color-hairline-strong);
  }
  .ab-card:hover .ab-card__icon {
    transform: scale(1.06);
  }
  .ab-card__icon {
    transition: transform 0.2s ease;
  }
  .ab-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--soft);
    color: var(--fg);
  }
  .ab-card__icon svg {
    width: 21px;
    height: 21px;
  }
  .ab-card__content {
    flex: 1;
    min-width: 0;
  }
  .ab-card__title {
    font-size: 22px;
    font-weight: 600;
    line-height: 30px;
    letter-spacing: -0.6px;
    color: var(--color-ink);
  }
  .ab-card__p {
    margin-top: 14px;
    font-size: 16px;
    line-height: 28px;
    color: var(--color-body);
  }
  .ab-card__p :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }
  .ab-card__p :global(a) {
    color: var(--color-violet-deep);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Author card — soft-violet, with the photo on the left. */
  .ab-card--author {
    align-items: center;
    background: color-mix(in srgb, var(--color-violet) 6%, var(--color-canvas-soft));
    border-color: transparent;
  }
  .ab-card--author :global(.ab-card__photo) {
    flex-shrink: 0;
    width: 148px;
    height: 148px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 4px var(--color-canvas), var(--shadow-e3);
  }
  .ab-card__head {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ab-card--author .ab-card__title {
    font-size: 20px;
    line-height: 28px;
  }

  .ab-back {
    display: inline-block;
    margin-top: 36px;
    padding-top: 24px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-body);
    border-top: 1px solid var(--color-hairline);
    transition: color 0.15s ease;
  }
  .ab-back:hover {
    color: var(--color-ink);
  }

  @media (min-width: 900px) {
    .ab-hero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 40px;
    }
    .ab-hero__art {
      display: block;
    }
  }

  @media (max-width: 600px) {
    .ab-card {
      flex-direction: column;
      gap: 14px;
      padding: 22px 20px;
    }
    .ab-card--author {
      align-items: center;
      text-align: center;
    }
    .ab-card--author .ab-card__content {
      text-align: left;
    }
    .ab-card__head {
      justify-content: center;
    }
  }
</style>
