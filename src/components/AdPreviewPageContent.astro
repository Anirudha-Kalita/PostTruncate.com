---
// Shared body for the Ad Previews silo pages (/[lang]/ad-previews/<slug>/).
//
// Layout: intro lede → on-this-page jump nav → embedded live simulator island
// (the default <slot>) → keyword prose → FAQ accordion → last-updated → CTA
// back to the home editor. Mirrors CalculatorPageContent.astro, minus the
// sibling-calculator cross-promo.
import OnThisPage from './OnThisPage.astro';
import InstagramAdsHero from './InstagramAdsHero.astro';
import FacebookAdsHero from './FacebookAdsHero.astro';
import LinkedInAdsHero from './LinkedInAdsHero.astro';
import GoogleAdsHero from './GoogleAdsHero.astro';
import TikTokAdsHero from './TikTokAdsHero.astro';
import ToolSectionCards from './ToolSectionCards.astro';
import ToolCta from './ToolCta.astro';
import PlatformFaqBlog from './PlatformFaqBlog.astro';
import type { ToolDefinition } from '../data/tools';
import { DEFAULT_LOCALE } from '../i18n/config';
import { getTranslations } from '../i18n';
import { interp } from '../i18n/interp';
import { buildCanonicalSlugs, prepareToolContent, splitToolSections } from '../lib/headingAnchors';
import { formatLocaleDate } from '../lib/contentDates';
import { BLOG_SEGMENT, getBlogStrings, getPublishedPosts } from '../lib/blogI18n';
import { getCategoryById, getCategorySlug } from '../data/blogCategories';

interface Props {
  tool: ToolDefinition;
  lang: string;
  /** Full home editor URL for the closing CTA (e.g. /en/character-counter/#workspace). */
  homeHref: string;
  /** Simulator platform key ('facebook'|'google'|…) — themes the section cards. */
  platformKey?: string;
  /** Ordered breadcrumb trail to render above the page title. */
  breadcrumbs?: { name: string; item: string }[];
}

const { tool, lang, homeHref, platformKey, breadcrumbs = [] } = Astro.props;

const tStr = <T,>(record: Record<string, T>): T => record[lang] ?? record[DEFAULT_LOCALE];
const globalT = getTranslations(lang);

const canonicalSlugs = buildCanonicalSlugs(tool.content[DEFAULT_LOCALE] ?? '');
const { html: bodyHtml, sections } = prepareToolContent(tStr(tool.content), canonicalSlugs);
const cardSections = splitToolSections(bodyHtml);
const lastUpdatedLine = interp(globalT.toolPage.lastUpdated, {
  date: formatLocaleDate(tool.lastUpdated, lang),
});

const introText = tool.intro?.[lang] ?? tool.intro?.[DEFAULT_LOCALE] ?? '';
const faqItems = tool.faq?.[lang] ?? tool.faq?.[DEFAULT_LOCALE] ?? [];
const cta = globalT.toolPage.cta;

// ── FAQ + Blog row (mirrors the platform-guide pages) ─────────────────────────
// Each ad page borrows its base platform's blog category: Facebook Ads →
// Facebook, Instagram Ads → Instagram, etc. Google Ads has no social platform,
// so it maps to the SEO & SERP category (where the Google Ads posts live).
const AD_BASE_CATEGORY: Record<string, string> = {
  facebook: 'facebook',
  instagram: 'instagram',
  linkedin: 'linkedin',
  tiktok: 'tiktok',
  google: 'seo-serp',
};

const blogStrings = getBlogStrings(lang);
const allPosts = await getPublishedPosts();

// Forward-looking provision: the moment a dedicated ad category (e.g.
// `facebook-ads`) is added to the blog registry, this page switches to it and
// the base platform category (`facebook`) drops off — automatically, no code
// change here. Posts are matched on the same category the "view all" hub links
// to, so the row stays coherent.
const adCategoryId = platformKey ? `${platformKey}-ads` : undefined;
const categoryId =
  adCategoryId && getCategoryById(adCategoryId) !== undefined
    ? adCategoryId
    : platformKey
      ? AD_BASE_CATEGORY[platformKey]
      : undefined;

const relatedPosts = allPosts
  .filter((p) => p.data.locale === lang && p.data.category === categoryId)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const faqBlogPosts = relatedPosts.slice(0, 2);

const blogCategory = categoryId ? getCategoryById(categoryId) : undefined;
const blogCategoryHref = blogCategory
  ? `/${lang}/${BLOG_SEGMENT}/${getCategorySlug(blogCategory, lang)}/`
  : `/${lang}/${BLOG_SEGMENT}/`;

// FAQ/Blog icon accent — matches each ad page's theme (blue base; IG/TikTok pop).
const FAQ_BLOG_ACCENT: Record<string, { bg: string; fg: string }> = {
  facebook: { bg: 'var(--color-link-bg-soft)', fg: 'var(--color-link)' },
  linkedin: { bg: 'var(--color-link-bg-soft)', fg: 'var(--color-link)' },
  google: { bg: 'var(--color-link-bg-soft)', fg: 'var(--color-link)' },
  instagram: {
    bg: 'color-mix(in srgb, var(--color-highlight-pink) 14%, transparent)',
    fg: 'var(--color-highlight-magenta)',
  },
  tiktok: {
    bg: 'color-mix(in srgb, #fe2c55 14%, transparent)',
    fg: 'color-mix(in srgb, #fe2c55 82%, #000)',
  },
};
const faqBlogAccent = (platformKey && FAQ_BLOG_ACCENT[platformKey]) || {
  bg: 'var(--color-violet-soft)',
  fg: 'var(--color-violet-deep)',
};
---

<section class="tool-page container-page tool-page--cta-tight">
  {breadcrumbs.length > 0 && (
    <nav class:list={['tool-page__crumbs']} aria-label="Breadcrumb">
      {breadcrumbs.map((crumb, i) => (
        <>
          {i > 0 && <span aria-hidden="true">→</span>}
          {i === breadcrumbs.length - 1 ? (
            <span aria-current="page">{crumb.name}</span>
          ) : (
            <a href={crumb.item}>{crumb.name}</a>
          )}
        </>
      ))}
    </nav>
  )}

  {tool.id === 'instagram-ads' ? (
    <InstagramAdsHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : tool.id === 'facebook-ads' ? (
    <FacebookAdsHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : tool.id === 'linkedin-ads' ? (
    <LinkedInAdsHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : tool.id === 'google-ads' ? (
    <GoogleAdsHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : tool.id === 'tiktok-ads' ? (
    <TikTokAdsHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : (
    <header class="tool-page__prose tool-page__head">
      <h1 class="tool-page__title">{tStr(tool.titles)}</h1>
      {introText && <p class="tool-page__lede">{introText}</p>}
      <OnThisPage label={globalT.toolPage.onThisPage} sections={sections} />
    </header>
  )}

  {/* Live simulator island, supplied by the route via the default slot. */}
  <div class="tool-page__tool">
    <slot />
  </div>

  {/* Keyword prose reframed as hover-active, platform-themed section cards. */}
  <ToolSectionCards sections={cardSections} theme={platformKey} />

  {faqItems.length > 0 && (
    <PlatformFaqBlog
      lang={lang}
      faqItems={faqItems}
      faqTitle={globalT.faq.title}
      faqViewAll={globalT.faq.viewAll}
      faqHref={`/${lang}/faq/`}
      posts={faqBlogPosts}
      blogHeading={blogStrings.latestHeading}
      blogViewAll={blogStrings.viewAll}
      blogHref={blogCategoryHref}
      readMoreLabel={blogStrings.readMore}
      iconBg={faqBlogAccent.bg}
      iconFg={faqBlogAccent.fg}
    />
  )}

  <p class="tool-page__updated">{lastUpdatedLine}</p>

  {/* Closing CTA — the shared centered card used across the platform pages. */}
  <ToolCta heading={cta.heading} blurb={cta.blurb} button={cta.button} href={homeHref} />
</section>

<style>
  .tool-page__crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    margin-bottom: 24px;
    color: var(--color-mute);
  }
  .tool-page__crumbs a {
    color: var(--color-body);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .tool-page__crumbs a:hover {
    color: var(--color-ink);
  }

  .tool-page {
    scroll-margin-top: 80px;
    padding-top: 64px;
    padding-bottom: 64px;
  }

  /* This page closes on the ToolCta card — sit tight to the footer: trim the
     bottom padding and cancel the footer's 96px top margin (adjacent siblings
     under <body>, so the negative margin collapses with it). */
  .tool-page.tool-page--cta-tight {
    padding-bottom: 24px;
    margin-bottom: -96px;
  }

  .tool-page__prose {
    max-width: 48rem;
    margin-inline: auto;
  }

  .tool-page__head {
    margin-bottom: 32px;
  }

  .tool-page__head :global(.on-page) {
    margin-top: 20px;
  }

  .tool-page__title {
    font-size: clamp(30px, 5vw, 44px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -1.6px;
    color: var(--color-ink);
  }

  .tool-page__lede {
    margin-top: 16px;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }

  /* Embedded simulator — spans the full page container (like the platform
     pages), giving the 60-40 editor/preview shell room to breathe. */
  .tool-page__tool {
    scroll-margin-top: 80px;
    margin: 8px auto 56px;
    max-width: none;
  }

  .tool-page__body :global(h2) {
    scroll-margin-top: 80px;
    margin-top: 40px;
    font-size: 22px;
    font-weight: 600;
    line-height: 30px;
    letter-spacing: -0.6px;
    color: var(--color-ink);
  }

  .tool-page__body :global(h2:first-child) {
    margin-top: 0;
  }

  .tool-page__body :global(p) {
    margin-top: 14px;
    font-size: 16px;
    line-height: 28px;
    color: var(--color-body);
  }

  .tool-page__body :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }

  .tool-page__body :global(ul),
  .tool-page__body :global(ol) {
    margin-top: 14px;
    padding-left: 1.5rem;
    font-size: 16px;
    line-height: 28px;
    color: var(--color-body);
  }

  .tool-page__body :global(li) {
    margin-top: 6px;
  }

  .tool-page__updated {
    margin-top: 32px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .tool-page__cta {
    margin-top: 24px;
    padding-top: 32px;
    border-top: 1px solid var(--color-hairline);
  }

  .tool-page__cta-heading {
    font-size: 22px;
    font-weight: 600;
    line-height: 30px;
    letter-spacing: -0.6px;
    color: var(--color-ink);
  }

  .tool-page__cta-blurb {
    margin-top: 12px;
    font-size: 16px;
    line-height: 28px;
    color: var(--color-body);
    max-width: 44rem;
  }

  .tool-page__cta-btn {
    margin-top: 20px;
  }

  .tool-page__btn {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 24px;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-on-primary);
    font-size: 16px;
    font-weight: 500;
    transition: opacity 0.15s ease, transform 100ms ease;
  }

  .tool-page__btn:hover {
    opacity: 0.88;
  }

  .tool-page__btn:active {
    transform: scale(0.955);
    opacity: 0.82;
  }

  .tool-page__faq {
    margin-top: 48px;
  }

  .tool-page__faq-heading {
    font-size: 22px;
    font-weight: 600;
    line-height: 30px;
    letter-spacing: -0.6px;
    color: var(--color-ink);
    margin-bottom: 20px;
  }

  .faq__list {
    display: grid;
    gap: 12px;
  }

  .faq__item {
    border-radius: var(--radius-lg);
    background: var(--color-canvas);
    box-shadow: var(--shadow-e1);
    overflow: hidden;
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    padding: 18px 20px;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-ink);
    list-style: none;
    transition: transform 100ms ease, background 0.15s ease;
  }

  .faq__q:active {
    transform: scale(0.985);
    background: var(--color-canvas-soft-2);
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__chev {
    font-size: 20px;
    color: var(--color-mute);
    transition: transform 0.2s ease;
    line-height: 1;
  }

  .faq__item[open] .faq__chev {
    transform: rotate(45deg);
  }

  .faq__a {
    padding: 0 20px 18px;
    font-size: 15px;
    line-height: 24px;
    color: var(--color-body);
  }

  @media (max-width: 768px) {
    .tool-page {
      padding-top: 48px;
      padding-bottom: 48px;
    }
  }
</style>
