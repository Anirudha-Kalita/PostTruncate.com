---
// Two-column marketing hero for the Discord character-counter page. Left: a
// blurple eyebrow badge, headline (with the phrase after the em-dash in a
// blurple gradient) + lede + on-this-page pills. Right: a Discord message-card
// mockup with the logo, skeleton copy and a blurple typing bubble, plus floating
// "2,000 chars limit" and shield badges over dotted-grid decoration.
//
// The accent is everything after the "—" so it stays language-agnostic across
// all 10 locales. The illustration is decorative (aria-hidden).
import type { SectionAnchor } from '../lib/headingAnchors';

interface Props {
  title: string;
  intro: string;
  sections: SectionAnchor[];
  onThisPageLabel: string;
}

const { title, intro, sections, onThisPageLabel } = Astro.props;

const dashIndex = title.indexOf('—');
const titleHead = dashIndex >= 0 ? title.slice(0, dashIndex + 1) : title;
const titleTail = dashIndex >= 0 ? title.slice(dashIndex + 1).trim() : '';

// Section navigation icons matching ICON_SETS.discord in ToolSectionCards.astro
const ICONS = [
  '<path d="M4 7V5h16v2M9 19h6M12 5v14"/>',
  '<path d="M9 17H7A5 5 0 0 1 7 7h2M15 7h2a5 5 0 0 1 0 10h-2M8 12h8"/>',
  '<path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"/>',
  '<path d="M12 3l8 3v5c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/>',
];

const DISCORD_GLYPH =
  'M18.9 7.3a15.9 15.9 0 0 0-3.9-1.2l-.2.4a14.7 14.7 0 0 1 3.4 1.1 12.4 12.4 0 0 0-10.5 0A14.7 14.7 0 0 1 11 6.5l-.2-.4a15.9 15.9 0 0 0-3.9 1.2C4.4 11 3.8 14.5 4.1 18a16 16 0 0 0 4.9 2.5l.6-1a10.4 10.4 0 0 1-1.6-.8l.4-.3a11.4 11.4 0 0 0 9.7 0l.4.3a10.4 10.4 0 0 1-1.6.8l.6 1a16 16 0 0 0 4.9-2.5c.4-4.1-.6-7.6-2.5-10.7zM9.7 15.6c-.9 0-1.7-.9-1.7-1.9s.8-1.9 1.7-1.9 1.7.9 1.7 1.9-.8 1.9-1.7 1.9zm4.6 0c-.9 0-1.7-.9-1.7-1.9s.8-1.9 1.7-1.9 1.7.9 1.7 1.9-.8 1.9-1.7 1.9z';
---

<header class="dhero">
  <div class="dhero__copy">
    <span class="dhero__eyebrow">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
        <path d={DISCORD_GLYPH}></path>
      </svg>
      Discord tool
    </span>

    <h1 class="dhero__title">
      <span>{titleHead}</span>
      {titleTail && <><br /><span class="dhero__accent">{titleTail}</span></>}
    </h1>
    {intro && <p class="dhero__lede">{intro}</p>}
    {/* Jump navigation: mobile dropdown / desktop pills */}
    {sections.length > 0 && (
      <nav class="dhero__jump" aria-label={onThisPageLabel}>
        {/* Mobile dropdown */}
        <details class="dhero__mobile-nav">
          <summary class="dhero__mobile-toggle">
            <span class="dhero__mobile-label">{onThisPageLabel}</span>
            <svg class="dhero__mobile-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <ul class="dhero__mobile-list">
            {sections.map((section) => (
              <li>
                <a class="dhero__mobile-link" href={`#${section.id}`}>{section.label}</a>
              </li>
            ))}
          </ul>
        </details>

        {/* Desktop pills row */}
        <div class="dhero__desktop-nav">
          <span class="dhero__desktop-label">{onThisPageLabel}</span>
          <div class="dhero__pills">
            {sections.map((sec, idx) => (
              <a href={`#${sec.id}`} class="dhero__pill">
                <span class="dhero__pill-icon" set:html={`<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">${ICONS[idx % ICONS.length]}</svg>`} />
                <span>{sec.label}</span>
              </a>
            ))}
          </div>
        </div>
      </nav>
    )}
  </div>

  <div class="dhero__art" aria-hidden="true">
    <span class="dhero__blob"></span>
    <span class="dhero__dots"></span>

    <div class="dhero__card">
      <div class="dhero__logo">
        <svg width="100%" height="100%" viewBox="0 0 24 24" role="presentation">
          <circle cx="12" cy="12" r="12" fill="#5865F2"></circle>
          <path fill="#fff" d={DISCORD_GLYPH}></path>
        </svg>
      </div>
      <div class="dhero__lines">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <div class="dhero__bubble">
        <i></i><i></i><i></i>
      </div>
    </div>

    <div class="dhero__badge dhero__badge--count">
      <span class="dhero__num">2,000</span>
      <span class="dhero__label">chars limit</span>
    </div>
    <span class="dhero__badge dhero__badge--shield">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3l8 3v5c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"></path><path d="M9 12l2 2 4-4"></path>
      </svg>
    </span>
  </div>
</header>

<style>
  .dhero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 40px;
  }

  /* ── Left column: copy (Discord blurple) ────────────────────────────── */
  .dhero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, #5865f2 15%, transparent);
    color: #4752c4;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dhero__title {
    font-size: clamp(30px, 5vw, 46px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -1.8px;
    color: var(--color-ink);
    }

  .dhero__accent {
    background: linear-gradient(96deg, #5865f2 0%, #8763ea 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .dhero__lede {
    margin-top: 18px;
    max-width: 34rem;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }

  /* ── Jump menu: responsive mobile / desktop ──────────────────────────── */
  .dhero__jump {
    margin-top: 24px;
  }

  .dhero__mobile-nav {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
  }

  .dhero__mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .dhero__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .dhero__mobile-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .dhero__mobile-chevron {
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.15s ease;
  }

  .dhero__mobile-nav[open] .dhero__mobile-chevron {
    transform: rotate(180deg);
  }

  .dhero__mobile-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0 8px 8px;
    list-style: none;
    border-top: 1px solid var(--color-hairline);
  }

  .dhero__mobile-link {
    display: block;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .dhero__mobile-link:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }

  .dhero__desktop-nav {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .dhero__desktop-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .dhero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .dhero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-body);
    transition: all 0.15s ease;
  }

  .dhero__pill:hover {
    border-color: #5865f2;
    color: #4752c4;
    box-shadow: var(--shadow-e1);
  }

  .dhero__pill-icon {
    display: inline-flex;
    align-items: center;
    color: #5865f2;
  }

  @media (min-width: 640px) {
    .dhero__mobile-nav {
      display: none;
    }
    .dhero__desktop-nav {
      display: flex;
    }
  }

  /* ── Right column: Discord card mockup ──────────────────────────────── */
  .dhero__art {
    position: relative;
    display: none;
    aspect-ratio: 1 / 1;
    max-width: 440px;
    margin-inline: auto;
    width: 100%;
  }

  .dhero__blob {
    position: absolute;
    right: 2%;
    bottom: 12%;
    width: 26%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, #5865f2 16%, transparent), transparent 70%);
  }
  .dhero__dots {
    position: absolute;
    right: 4%;
    top: 8%;
    width: 74px;
    height: 60px;
    background-image: radial-gradient(currentColor 1.3px, transparent 1.3px);
    background-size: 11px 11px;
    color: color-mix(in srgb, #5865f2 28%, transparent);
  }

  /* Message card */
  .dhero__card {
    position: absolute;
    top: 50%;
    left: 48%;
    transform: translate(-50%, -50%);
    width: 62%;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 18px;
    border-radius: 18px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
  }
  .dhero__logo {
    width: 34%;
    aspect-ratio: 1;
    filter: drop-shadow(0 6px 12px rgba(71, 82, 196, 0.3));
  }
  .dhero__logo svg {
    width: 100%;
    height: 100%;
  }
  .dhero__lines {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .dhero__lines span {
    height: 7px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas-soft-2);
  }
  .dhero__lines span:nth-child(1) {
    width: 90%;
  }
  .dhero__lines span:nth-child(2) {
    width: 72%;
  }
  .dhero__lines span:nth-child(3) {
    width: 54%;
  }
  .dhero__bubble {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 12px 16px;
    border-radius: 16px 16px 16px 4px;
    background: #5865f2;
  }
  .dhero__bubble i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #fff;
    opacity: 0.9;
  }

  /* Floating badges */
  .dhero__badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-lg);
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
    color: #5865f2;
  }
  .dhero__badge--count {
    top: 22%;
    right: 0;
    flex-direction: column;
    gap: 2px;
    padding: 12px 16px;
    border-radius: var(--radius-xl);
  }
  .dhero__num {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -1px;
    color: #4752c4;
  }
  .dhero__label {
    font-size: 11px;
    font-weight: 500;
    color: var(--color-mute);
  }
  .dhero__badge--shield {
    right: 6%;
    bottom: 16%;
    width: 52px;
    height: 52px;
  }
  .dhero__badge svg {
    width: 24px;
    height: 24px;
  }

  /* ── Responsive: two columns + illustration only on wider viewports ──── */
  @media (min-width: 900px) {
    .dhero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
      margin-bottom: 48px;
    }

    .dhero__art {
      display: block;
    }
  }
</style>
