---
// Two-column marketing hero for the standalone Facebook character-counter page.
// Left: a blue eyebrow badge, headline (with the phrase after the em-dash tinted
// Facebook blue) + lede + on-this-page pills. Right: a CSS-3D Facebook-logo tile
// on dashed orbit rings with floating stat cards and a few sparkle accents.
//
// Like Instagram/LinkedIn, the title highlights a phrase whose wording/position
// vary per locale, so the accent is everything after the "—" — a language-
// agnostic split. The illustration is decorative (aria-hidden) with stylised
// English micro-labels.
import type { SectionAnchor } from '../lib/headingAnchors';

interface Props {
  title: string;
  intro: string;
  sections: SectionAnchor[];
  onThisPageLabel: string;
}

const { title, intro, sections, onThisPageLabel } = Astro.props;

const dashIndex = title.indexOf('—');
const titleHead = dashIndex >= 0 ? title.slice(0, dashIndex + 1) : title;
const titleTail = dashIndex >= 0 ? title.slice(dashIndex + 1).trim() : '';

// Section navigation icons matching ICON_SETS.facebook in ToolSectionCards.astro
const ICONS = [
  '<path d="M16 3 21 8 8 21 3 16 16 3z"/><path d="M9 9l2 2M12 6l2 2M6 12l2 2"/>',
  '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  '<path d="M3 21h18"/><rect x="5" y="10" width="3" height="8"/><rect x="10.5" y="5" width="3" height="13"/><rect x="16" y="13" width="3" height="5"/>',
  '<path d="M4 7V5h16v2M9 19h6M12 5v14"/>',
];
---

<header class="fhero">
  <div class="fhero__copy">
    <span class="fhero__eyebrow">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
        <path d="M15 8.5h-2.2c-.3 0-.5.2-.5.7V11h2.8l-.4 2.8h-2.4V21h-3v-7.2H7.5V11H9.3V9c0-2.1 1.3-3.5 3.5-3.5H15V8.5z"></path>
      </svg>
      Facebook tool
    </span>

    <h1 class="fhero__title">
      <span>{titleHead}</span>
      {titleTail && <><br /><span class="fhero__accent">{titleTail}</span></>}
    </h1>
    {intro && <p class="fhero__lede">{intro}</p>}
    {/* Jump navigation: mobile dropdown / desktop pills */}
    {sections.length > 0 && (
      <nav class="fhero__jump" aria-label={onThisPageLabel}>
        {/* Mobile dropdown */}
        <details class="fhero__mobile-nav">
          <summary class="fhero__mobile-toggle">
            <span class="fhero__mobile-label">{onThisPageLabel}</span>
            <svg class="fhero__mobile-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <ul class="fhero__mobile-list">
            {sections.map((section) => (
              <li>
                <a class="fhero__mobile-link" href={`#${section.id}`}>{section.label}</a>
              </li>
            ))}
          </ul>
        </details>

        {/* Desktop pills row */}
        <div class="fhero__desktop-nav">
          <span class="fhero__desktop-label">{onThisPageLabel}</span>
          <div class="fhero__pills">
            {sections.map((sec, idx) => (
              <a href={`#${sec.id}`} class="fhero__pill">
                <span class="fhero__pill-icon" set:html={`<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">${ICONS[idx % ICONS.length]}</svg>`} />
                <span>{sec.label}</span>
              </a>
            ))}
          </div>
        </div>
      </nav>
    )}
  </div>

  <div class="fhero__art" aria-hidden="true">
    <svg class="fhero__orbits" viewBox="0 0 100 100" fill="none" preserveAspectRatio="xMidYMid meet">
      <circle class="fhero__ring" cx="50" cy="50" r="46" stroke-width="0.5" stroke-dasharray="2 3" />
      <circle class="fhero__ring" cx="50" cy="50" r="34" stroke-width="0.5" stroke-dasharray="2 3" />
    </svg>

    <span class="fhero__spark fhero__spark--1">✦</span>
    <span class="fhero__spark fhero__spark--2">✦</span>
    <span class="fhero__spark fhero__spark--3">✦</span>

    {/* CSS-3D tile: gradient lighting + layered shadows + inset highlight. */}
    <div class="fhero__logo">
      <svg viewBox="0 0 24 24" class="fhero__f" role="presentation">
        <path fill="#fff" d="M15.5 7.7h-2.6c-.4 0-.7.3-.7.9v2.1h3.3l-.5 3.3h-2.8V23h-3.5v-9H6.3v-3.3h2.9V8.4c0-2.6 1.6-4.2 4.2-4.2h2.1v3.5z"></path>
      </svg>
    </div>

    <div class="fhero__card fhero__card--feed">
      <span class="fhero__num">~480</span>
      <span class="fhero__label">Feed fold</span>
    </div>

    <div class="fhero__card fhero__card--engage">
      <span class="fhero__num">80+</span>
      <span class="fhero__label">Better<br />engagement</span>
    </div>

    <div class="fhero__card fhero__card--safe">
      <span class="fhero__num">Safe</span>
      <span class="fhero__label">Unicode<br />fonts</span>
    </div>
  </div>
</header>

<style>
  .fhero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 40px;
  }

  /* ── Left column: copy ──────────────────────────────────────────────── */
  .fhero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-link-bg-soft);
    color: var(--color-link-deep);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .fhero__title {
    font-size: clamp(30px, 5vw, 46px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -1.8px;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .fhero__accent {
    color: var(--color-link);
  }

  .fhero__lede {
    margin-top: 18px;
    max-width: 34rem;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }

  /* ── Jump menu: responsive mobile / desktop ──────────────────────────── */
  .fhero__jump {
    margin-top: 24px;
  }

  .fhero__mobile-nav {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
  }

  .fhero__mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .fhero__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .fhero__mobile-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .fhero__mobile-chevron {
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.15s ease;
  }

  .fhero__mobile-nav[open] .fhero__mobile-chevron {
    transform: rotate(180deg);
  }

  .fhero__mobile-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0 8px 8px;
    list-style: none;
    border-top: 1px solid var(--color-hairline);
  }

  .fhero__mobile-link {
    display: block;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .fhero__mobile-link:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }

  .fhero__desktop-nav {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .fhero__desktop-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .fhero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .fhero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-body);
    transition: all 0.15s ease;
  }

  .fhero__pill:hover {
    border-color: var(--color-link);
    color: var(--color-link);
    box-shadow: var(--shadow-e1);
  }

  .fhero__pill-icon {
    display: inline-flex;
    align-items: center;
    color: var(--color-link);
  }

  @media (min-width: 640px) {
    .fhero__mobile-nav {
      display: none;
    }
    .fhero__desktop-nav {
      display: flex;
    }
  }

  /* ── Right column: decorative illustration ──────────────────────────── */
  .fhero__art {
    position: relative;
    display: none;
    aspect-ratio: 5 / 4;
    max-width: 460px;
    margin-inline: auto;
    width: 100%;
  }

  .fhero__orbits {
    position: absolute;
    inset: 4% 0;
    width: 100%;
    height: 92%;
    margin: auto;
  }

  .fhero__ring {
    fill: none;
    stroke: var(--color-link-bg-soft);
  }

  .fhero__spark {
    position: absolute;
    color: var(--color-link);
    opacity: 0.55;
    font-size: 14px;
    line-height: 1;
  }
  .fhero__spark--1 {
    top: 20%;
    left: 20%;
    font-size: 12px;
    opacity: 0.4;
  }
  .fhero__spark--2 {
    top: 52%;
    right: 20%;
  }
  .fhero__spark--3 {
    bottom: 16%;
    left: 34%;
    font-size: 10px;
    opacity: 0.4;
  }

  /* CSS-3D Facebook tile — gradient lighting, stacked coloured shadows and an
     inset top highlight fake the glossy depth of the reference render. Brand
     colours are fixed (like the other logo tiles) in both themes. */
  .fhero__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 46%;
    aspect-ratio: 1;
    border-radius: 27%;
    background: linear-gradient(158deg, #5b93ff 0%, #1877f2 52%, #0e63dd 100%);
    box-shadow:
      0 2px 3px rgba(11, 74, 173, 0.35),
      0 10px 20px -6px rgba(11, 74, 173, 0.5),
      0 30px 48px -14px rgba(11, 74, 173, 0.5),
      inset 0 3px 6px rgba(255, 255, 255, 0.4),
      inset 0 -8px 14px rgba(9, 58, 140, 0.45);
  }

  /* The "f" sits flush to the tile's bottom edge, lifted with a soft shadow. */
  .fhero__f {
    width: 84%;
    height: 84%;
    filter: drop-shadow(0 3px 4px rgba(9, 58, 140, 0.45));
  }

  /* Floating cards share a soft elevated surface that adapts to dark mode. */
  .fhero__card {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 18px;
    border-radius: var(--radius-xl);
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
  }

  .fhero__card--feed {
    top: 2%;
    right: 3%;
  }
  .fhero__card--engage {
    top: 44%;
    left: 0;
  }
  .fhero__card--safe {
    bottom: 6%;
    right: 0;
  }

  .fhero__num {
    font-size: 30px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -1px;
    color: var(--color-link);
  }

  .fhero__label {
    font-size: 12px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-mute);
  }

  /* ── Responsive: two columns + illustration only on wider viewports ──── */
  @media (min-width: 900px) {
    .fhero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
      margin-bottom: 48px;
    }

    .fhero__art {
      display: block;
    }
  }
</style>
