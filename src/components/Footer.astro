---
// Column footer used on every route (Tools · Learn · Legal · Platform Guides ·
// Character Counters). Mono-caps eyebrow labels, body-sm link rows. All copy is
// localized via the `footer` dictionary; link labels come from the dictionary
// while their hrefs (anchors + the locale-prefixed home) are wired here.
import { interp } from '../i18n/interp';
import { getLocale } from '../i18n/config';
import { getTranslations } from '../i18n';
import type { Translations } from '../i18n/types';
import { tools } from '../data/tools';
import { calculators } from '../data/calculators';
import { adPreviews } from '../data/adPreviews';
import { PLATFORM_COUNTERS } from '../data/platformCounters';
import { BLOG_SEGMENT, getBlogStrings, getBlogLocales } from '../lib/blogI18n';

interface Props {
  lang: string;
  footer: Translations['footer'];
  /** Tightens the top margin on the landing page (its content sits closer to
      the footer). The footer's columns are identical on every route. */
  isHome?: boolean;
}

const { lang, footer, isHome = false } = Astro.props;
const year = 2026;
const locale = getLocale(lang);
const images = getTranslations(lang).images;
const home = `/${lang}/${locale.slug}/`;

// Blog link — English-first, en-fallback label (same pattern as blogI18n.ts).
// Only shown when this locale actually has a published post, mirroring the
// "empty locales produce nothing" rule used by the blog routes themselves.
const blogLink = (await getBlogLocales()).has(lang)
  ? { label: getBlogStrings(lang).footerLink, href: `/${lang}/${BLOG_SEGMENT}/` }
  : null;

// Hrefs paired positionally with each column's translated labels. Anchors are
// home-prefixed so they resolve from every route; the legal column points at
// real standalone routes, which are locale-prefixed.
const columnHrefs = {
  learn: [
    `/${lang}/platform-limits/`,
    `/${lang}/faq/`,
    // Absolute (home-prefixed) so the in-page hook-guide anchor resolves from
    // every route, not just the landing page where that section lives.
    `${home}#hook-guide`,
    // "Accessibility" → the fancy-fonts accessibility answer on the FAQ page.
    `/${lang}/faq/#fancy-fonts`,
  ],
  legal: [
    `${home}privacy/`,
    `${home}terms/`,
    `${home}about/`,
    `${home}contact/`,
  ],
};

const columns = (
  ['learn', 'legal'] as const
).map((key) => {
  const links = footer.columns[key].links.map((label, i) => ({
    label,
    href: columnHrefs[key][i] ?? '#',
  }));
  // The blog index lives under the "Learn" column when this locale has posts.
  if (key === 'learn' && blogLink) links.push(blogLink);
  return { title: footer.columns[key].title, links };
});

// Platform Guides column: URLs come from tools.ts (single source of truth);
// display labels come from the locale's footer.columns.guides.links array.
const guidesLinks = tools.map((tool, i) => ({
  label: footer.columns.guides.links[i],
  href: `/${lang}/${tool.slugs[lang] ?? tool.slugs['en']}/`,
}));

guidesLinks.push({
  label: getTranslations(lang).nav.links.limits,
  href: `/${lang}/platform-limits/`,
});

// Calculators split into two columns the same way the nav does — generic
// "Tools" vs. per-platform "Character Counters" (ids in PLATFORM_COUNTERS).
// Tool labels come from each calculator's localized schemaName.
const toolsTitle = getTranslations(lang).nav.links.tools;
const countersTitle = getTranslations(lang).nav.links.counters;
const homeToolsLinks = calculators
  .filter((tool) => !PLATFORM_COUNTERS[tool.id])
  .map((tool) => ({
    label: tool.schemaName[lang] ?? tool.schemaName['en'],
    href: `/${lang}/tools/${tool.slugs[lang] ?? tool.slugs['en']}/`,
  }));
// Counter labels use just the bare platform name (e.g. "YouTube", "TikTok")
// from PLATFORM_COUNTERS.brand — the "Character Counter" suffix in schemaName
// is redundant under a column already titled "Character Counters".
const homeCounterLinks = calculators
  .filter((tool) => PLATFORM_COUNTERS[tool.id])
  .map((tool) => ({
    label: PLATFORM_COUNTERS[tool.id].brand,
    href: `/${lang}/tools/${tool.slugs[lang] ?? tool.slugs['en']}/`,
  }));

// Ad Previews column — mirrors the "Tools" column. Title from nav.links; URLs
// from adPreviews.ts. Labels are shortened to the bare platform brand (like the
// Character Counters column) so they stay compact in the narrow footer column.
const adPreviewsTitle = getTranslations(lang).nav.links.adPreviews;
const AD_PREVIEW_SHORT_LABELS: Record<string, string> = {
  'facebook-ads': 'Facebook Ads',
  'google-ads': 'Google Ads',
  'instagram-ads': 'Instagram Ads',
  'tiktok-ads': 'TikTok Ads',
};
const homeAdPreviewLinks = adPreviews.map((tool) => ({
  label: AD_PREVIEW_SHORT_LABELS[tool.id] ?? tool.schemaName[lang] ?? tool.schemaName['en'],
  href: `/${lang}/ad-previews/${tool.slugs[lang] ?? tool.slugs['en']}/`,
}));
---

<footer class="footer" class:list={{ 'footer--home': isHome }}>
  <div class="footer__mesh mesh-gradient" aria-hidden="true"></div>
  <div class="container-page footer__inner">
    <div class="footer__brand">
      <a href={home} class="footer__logo" aria-label={footer.homeAria}>
        <img class="footer__logo-img footer__logo-img--light" src="/logo.webp" alt={images.logoAlt} width="172" height="35" />
        <img class="footer__logo-img footer__logo-img--dark" src="/logo-dark.webp" alt={images.logoAlt} width="172" height="35" />
      </a>
      <p class="footer__tag">{footer.tag}</p>
    </div>

    <div class="footer__cols">
      <div class="footer__col">
        <p class="footer__eyebrow">{toolsTitle}</p>
        <ul class="footer__list">
          {homeToolsLinks.map((l) => (
            <li>
              <a href={l.href} class="footer__link">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
      {columns.map((col) => (
        <div class="footer__col">
          <p class="footer__eyebrow">{col.title}</p>
          <ul class="footer__list">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="footer__link">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div class="footer__col">
        <p class="footer__eyebrow">{footer.columns.guides.title}</p>
        <ul class="footer__list">
          {guidesLinks.map((l) => (
            <li>
              <a href={l.href} class="footer__link">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="footer__col">
        <p class="footer__eyebrow">{countersTitle}</p>
        <ul class="footer__list">
          {homeCounterLinks.map((l) => (
            <li>
              <a href={l.href} class="footer__link">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
      <div class="footer__col">
        <p class="footer__eyebrow">{adPreviewsTitle}</p>
        <ul class="footer__list">
          {homeAdPreviewLinks.map((l) => (
            <li>
              <a href={l.href} class="footer__link">{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="container-page footer__bar">
    <p>{interp(footer.copyright, { year })}</p>
    <p class="footer__note">{footer.disclaimer}</p>
  </div>
</footer>

<style>
  .footer {
    /* Footer shares the hero's surface: canvas hue + a faded brand mesh, so it
       reads as the same "bookend" plane rather than a black slab. Tokens resolve
       through the global palette, so it swaps with the theme like the hero. */
    position: relative;
    overflow: hidden;
    margin-top: 96px;
    background: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }
  .footer--home {
    margin-top: 48px;
  }
  /* Same brand mesh as the hero, same low opacity fade. */
  .footer__mesh {
    position: absolute;
    inset: 0;
    opacity: 0.16;
    filter: blur(8px);
    pointer-events: none;
  }
  .footer__inner {
    position: relative;
    display: grid;
    gap: 48px;
    padding-top: 64px;
    padding-bottom: 48px;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.4px;
  }
  .footer__logo-img {
    height: 35px;
    width: auto;
    display: block;
  }
  .footer__logo-img--dark {
    display: none;
  }
  :global(html[data-theme='dark']) .footer__logo-img--light {
    display: none;
  }
  :global(html[data-theme='dark']) .footer__logo-img--dark {
    display: block;
  }
  .footer__tag {
    margin-top: 12px;
    max-width: 320px;
    color: var(--color-body);
    font-size: 14px;
    line-height: 20px;
    letter-spacing: -0.28px;
  }

  /* Mobile: multi-column flow rather than a row-based grid. A 2-col grid sized
     each row to its tallest cell, so a short column (e.g. Legal) sitting beside
     a tall one (Platform Guides) left a dead gap before the next row. Multicol
     packs each block directly under the previous one, so there's no gap. */
  .footer__cols {
    columns: 2;
    column-gap: 32px;
  }
  .footer__col {
    break-inside: avoid;
    margin-bottom: 32px;
  }
  .footer__eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
    margin-bottom: 12px;
  }
  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .footer__link {
    color: var(--color-body);
    font-size: 14px;
    letter-spacing: -0.28px;
    transition: color 0.15s ease;
  }
  .footer__link:hover {
    color: var(--color-ink);
  }

  .footer__bar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    padding-top: 24px;
    padding-bottom: 40px;
    border-top: 1px solid var(--color-hairline);
    color: var(--color-mute);
    font-size: 12px;
    line-height: 16px;
  }
  .footer__note {
    max-width: 420px;
  }

  @media (min-width: 720px) {
    .footer__inner {
      grid-template-columns: 1.2fr 2fr;
    }
    /* Wider viewports: revert to an aligned grid (multicol props are inert on a
       grid container). All columns share a baseline, so no row-gap problem. */
    .footer__cols {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 32px;
    }
    .footer__col {
      margin-bottom: 0;
    }
  }

  @media (min-width: 1100px) {
    .footer__cols {
      grid-template-columns: repeat(6, 1fr);
    }
  }
</style>
