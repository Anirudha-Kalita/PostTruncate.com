---
// Four-column footer. Mono-caps eyebrow labels, body-sm link rows. All copy is
// localized via the `footer` dictionary; link labels come from the dictionary
// while their hrefs (anchors + the locale-prefixed home) are wired here.
import { interp } from '../i18n/interp';
import type { Translations } from '../i18n/types';

interface Props {
  lang: string;
  footer: Translations['footer'];
}

const { lang, footer } = Astro.props;
const year = 2026;
const home = `/${lang}/`;

// Hrefs paired positionally with each column's translated labels. In-page
// anchors resolve within the current language page, so they need no prefix.
const columnHrefs = {
  tool: ['#workspace', '#platforms', '#workspace', '#workspace'],
  platforms: [
    '#linkedin-guide',
    '#twitter-guide',
    '#threads-guide',
    '#instagram-guide',
    '#facebook-guide',
  ],
  learn: ['#platforms', '#faq', '#hook-guide', '#faq'],
  legal: ['#', '#', '#'],
};

const columns = (
  ['tool', 'platforms', 'learn', 'legal'] as const
).map((key) => ({
  title: footer.columns[key].title,
  links: footer.columns[key].links.map((label, i) => ({
    label,
    href: columnHrefs[key][i] ?? '#',
  })),
}));
---

<footer class="footer">
  <div class="container-page footer__inner">
    <div class="footer__brand">
      <a href={home} class="footer__logo" aria-label={footer.homeAria}>
        <img class="footer__mark" src="/favicon.svg" alt="" aria-hidden="true" width="20" height="20" />
        <span>PostTruncate</span>
      </a>
      <p class="footer__tag">{footer.tag}</p>
    </div>

    <div class="footer__cols">
      {
        columns.map((col) => (
          <div class="footer__col">
            <p class="footer__eyebrow">{col.title}</p>
            <ul class="footer__list">
              {col.links.map((l) => (
                <li>
                  <a href={l.href} class="footer__link">
                    {l.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div class="container-page footer__bar">
    <p>{interp(footer.copyright, { year })}</p>
    <p class="footer__note">{footer.disclaimer}</p>
  </div>
</footer>

<style>
  .footer {
    /* Footer reads as a dark slab so it separates cleanly from the light page.
       Re-mapping the surface/ink tokens locally means every var(--color-*)
       reference inside the footer resolves to this dark palette — no per-element
       colour overrides needed (same approach the hook band uses). */
    --color-canvas: #131313;
    --color-ink: #fafafa;
    --color-body: #a3a3a3;
    --color-mute: #737373;
    --color-hairline: #2a2a2a;

    margin-top: 96px;
    background: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }
  .footer__inner {
    display: grid;
    gap: 48px;
    padding-top: 64px;
    padding-bottom: 48px;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.4px;
  }
  .footer__mark {
    width: 20px;
    height: 20px;
    border-radius: var(--radius-sm);
    display: block;
  }
  .footer__tag {
    margin-top: 12px;
    max-width: 320px;
    color: var(--color-body);
    font-size: 14px;
    line-height: 20px;
    letter-spacing: -0.28px;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
  .footer__eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
    margin-bottom: 12px;
  }
  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .footer__link {
    color: var(--color-body);
    font-size: 14px;
    letter-spacing: -0.28px;
    transition: color 0.15s ease;
  }
  .footer__link:hover {
    color: var(--color-ink);
  }

  .footer__bar {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    padding-top: 24px;
    padding-bottom: 40px;
    border-top: 1px solid var(--color-hairline);
    color: var(--color-mute);
    font-size: 12px;
    line-height: 16px;
  }
  .footer__note {
    max-width: 420px;
  }

  @media (min-width: 720px) {
    .footer__inner {
      grid-template-columns: 1.2fr 2fr;
    }
    .footer__cols {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
