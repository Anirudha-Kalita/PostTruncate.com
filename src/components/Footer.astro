---
// Four-column footer. Mono-caps eyebrow labels, body-sm link rows. All copy is
// localized via the `footer` dictionary; link labels come from the dictionary
// while their hrefs (anchors + the locale-prefixed home) are wired here.
import { interp } from '../i18n/interp';
import { getLocale } from '../i18n/config';
import { getTranslations } from '../i18n';
import type { Translations } from '../i18n/types';
import { tools } from '../data/tools';

interface Props {
  lang: string;
  footer: Translations['footer'];
  /** Show the in-page "Tool" column only on the landing page; its anchors
      (#workspace, #platforms) don't exist on standalone routes. */
  isHome?: boolean;
}

const { lang, footer, isHome = false } = Astro.props;
const year = 2026;
const locale = getLocale(lang);
const images = getTranslations(lang).images;
const home = `/${lang}/${locale.slug}/`;

// Hrefs paired positionally with each column's translated labels. In-page
// anchors resolve within the current language page, so they need no prefix.
// The legal column points at real standalone routes, which are locale-prefixed.
const columnHrefs = {
  tool: ['#workspace', '#platforms', '#workspace', '#workspace', `/${lang}/embed-widget/`],
  platforms: [
    '#linkedin-guide',
    '#twitter-guide',
    '#threads-guide',
    '#instagram-guide',
    '#facebook-guide',
  ],
  learn: ['#platforms', '#faq', '#hook-guide', '#faq'],
  legal: [
    `${home}privacy/`,
    `${home}terms/`,
    `${home}about/`,
    `${home}contact/`,
  ],
};

const columns = (
  ['tool', 'platforms', 'learn', 'legal'] as const
).map((key) => ({
  title: footer.columns[key].title,
  links: footer.columns[key].links.map((label, i) => ({
    label,
    href: columnHrefs[key][i] ?? '#',
  })),
}));

// Standalone (non-home) pages drop the in-page Tool/Platforms/Learn anchors
// entirely — those sections only exist on the landing page. Only the Legal
// links carry over, laid out as a single balanced row beside the brand.
const legalLinks = footer.columns.legal.links.map((label, i) => ({
  label,
  href: columnHrefs.legal[i] ?? '#',
}));

// Platform Guides column: URLs come from tools.ts (single source of truth);
// display labels come from the locale's footer.columns.guides.links array.
const guidesLinks = tools.map((tool, i) => ({
  label: footer.columns.guides.links[i],
  href: `/${lang}/${tool.slugs[lang] ?? tool.slugs['en']}/`,
}));
---

<footer class="footer" class:list={{ 'footer--compact': !isHome }}>
  <div class="footer__mesh mesh-gradient" aria-hidden="true"></div>
  {
    isHome ? (
      <div class="container-page footer__inner">
        <div class="footer__brand">
          <a href={home} class="footer__logo" aria-label={footer.homeAria}>
            <img class="footer__mark" src="/favicon.svg" alt={images.logoAlt} width="20" height="20" />
            <span>PostTruncate</span>
          </a>
          <p class="footer__tag">{footer.tag}</p>
        </div>

        <div class="footer__cols">
          {columns.map((col) => (
            <div class="footer__col">
              <p class="footer__eyebrow">{col.title}</p>
              <ul class="footer__list">
                {col.links.map((l) => (
                  <li>
                    <a href={l.href} class="footer__link">
                      {l.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
          <div class="footer__col">
            <p class="footer__eyebrow">{footer.columns.guides.title}</p>
            <ul class="footer__list">
              {guidesLinks.map((l) => (
                <li>
                  <a href={l.href} class="footer__link">{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    ) : (
      <div class="container-page footer__inner footer__inner--compact">
        <div class="footer__brand">
          <a href={home} class="footer__logo" aria-label={footer.homeAria}>
            <img class="footer__mark" src="/favicon.svg" alt={images.logoAlt} width="20" height="20" />
            <span>PostTruncate</span>
          </a>
          <p class="footer__tag">{footer.tag}</p>
        </div>
        <div class="footer__link-groups">
          <nav class="footer__link-row" aria-label={footer.columns.legal.title}>
            {legalLinks.map((l) => (
              <a href={l.href} class="footer__link">{l.label}</a>
            ))}
          </nav>
          <nav class="footer__link-row" aria-label={footer.columns.guides.title}>
            {guidesLinks.map((l) => (
              <a href={l.href} class="footer__link">{l.label}</a>
            ))}
          </nav>
        </div>
      </div>
    )
  }

  <div class="container-page footer__bar">
    <p>{interp(footer.copyright, { year })}</p>
    <p class="footer__note">{footer.disclaimer}</p>
  </div>
</footer>

<style>
  .footer {
    /* Footer shares the hero's surface: canvas hue + a faded brand mesh, so it
       reads as the same "bookend" plane rather than a black slab. Tokens resolve
       through the global palette, so it swaps with the theme like the hero. */
    position: relative;
    overflow: hidden;
    margin-top: 96px;
    background: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }
  /* Same brand mesh as the hero, same low opacity fade. */
  .footer__mesh {
    position: absolute;
    inset: 0;
    opacity: 0.16;
    filter: blur(8px);
    pointer-events: none;
  }
  .footer__inner {
    position: relative;
    display: grid;
    gap: 48px;
    padding-top: 64px;
    padding-bottom: 48px;
  }

  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.4px;
  }
  .footer__mark {
    width: 20px;
    height: 20px;
    border-radius: var(--radius-sm);
    display: block;
  }
  .footer__tag {
    margin-top: 12px;
    max-width: 320px;
    color: var(--color-body);
    font-size: 14px;
    line-height: 20px;
    letter-spacing: -0.28px;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 32px;
  }
  .footer__eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
    margin-bottom: 12px;
  }
  .footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 10px;
  }
  .footer__link {
    color: var(--color-body);
    font-size: 14px;
    letter-spacing: -0.28px;
    transition: color 0.15s ease;
  }
  .footer__link:hover {
    color: var(--color-ink);
  }

  .footer__bar {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
    padding-top: 24px;
    padding-bottom: 40px;
    border-top: 1px solid var(--color-hairline);
    color: var(--color-mute);
    font-size: 12px;
    line-height: 16px;
  }
  .footer__note {
    max-width: 420px;
  }

  /* Compact layout for standalone pages: brand left, two horizontal link rows right. */
  .footer__inner--compact {
    padding-top: 48px;
    padding-bottom: 40px;
  }

  /* Two stacked rows of inline links — Legal on top, Guides below. */
  .footer__link-groups {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
  }
  .footer__link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    align-items: center;
  }

  @media (min-width: 720px) {
    .footer__inner {
      grid-template-columns: 1.2fr 2fr;
    }
    .footer__cols {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .footer__cols {
      grid-template-columns: repeat(5, 1fr);
    }
  }
</style>
