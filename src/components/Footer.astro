---
// Column footer used on every route (Tools · Learn · Legal · Platform Guides ·
// Character Counters · Ad Previews). Redesigned into: a brand block with trust
// chips + social links, six icon-headed link columns, a "Stay updated"
// newsletter band, and a copyright bar with a back-to-top control. All copy is
// localized via the `footer` dictionary; hrefs (anchors + locale-prefixed home)
// are wired here. Palette is unchanged — everything resolves through the same
// neutral + link tokens the old footer used, so it still theme-swaps.
import { interp } from '../i18n/interp';
import { getLocale } from '../i18n/config';
import { getTranslations } from '../i18n';
import type { Translations } from '../i18n/types';
import { tools } from '../data/tools';
import { calculators } from '../data/calculators';
import { adPreviews } from '../data/adPreviews';
import { PLATFORM_COUNTERS } from '../data/platformCounters';
import { BLOG_SEGMENT, getBlogStrings, getBlogLocales } from '../lib/blogI18n';
import ResponsiveImage from './ResponsiveImage.astro';

interface Props {
  lang: string;
  footer: Translations['footer'];
  /** Tightens the top margin on the landing page (its content sits closer to
      the footer). The footer's columns are identical on every route. */
  isHome?: boolean;
}

const { lang, footer, isHome = false } = Astro.props;
const year = 2026;
const locale = getLocale(lang);
const images = getTranslations(lang).images;
const home = `/${lang}/${locale.slug}/`;

// ── Newsletter endpoint (Mailchimp classic embed) ──────────────────────────
// Posts the email to the PostTruncate Mailchimp audience. The email field must
// be named EMAIL; the hidden `b_*` input is Mailchimp's bot honeypot (kept
// off-screen and empty); the classic embed opens its confirmation in a new tab.
const NEWSLETTER_ACTION =
  'https://posttruncate.us16.list-manage.com/subscribe/post?u=a1bd7cbf73e882228eae06fbb&id=808861a069&f_id=006f27e1f0';
const NEWSLETTER_HONEYPOT = 'b_a1bd7cbf73e882228eae06fbb_808861a069';

// Blog link — English-first, en-fallback label (same pattern as blogI18n.ts).
const blogLink = (await getBlogLocales()).has(lang)
  ? { label: getBlogStrings(lang).footerLink, href: `/${lang}/${BLOG_SEGMENT}/` }
  : null;

// Hrefs paired positionally with each column's translated labels.
const columnHrefs = {
  learn: [
    `/${lang}/platform-limits/`,
    `/${lang}/faq/`,
    `${home}#hook-guide`,
    `/${lang}/faq/#fancy-fonts`,
  ],
  legal: [
    `${home}privacy/`,
    `${home}terms/`,
    `${home}about/`,
    `${home}contact/`,
  ],
};

const learnLegal = (['learn', 'legal'] as const).map((key) => {
  const links = footer.columns[key].links.map((label, i) => ({
    label,
    href: columnHrefs[key][i] ?? '#',
  }));
  if (key === 'learn' && blogLink) links.push(blogLink);
  return { title: footer.columns[key].title, links };
});

// Platform Guides column: URLs from tools.ts, labels from footer dictionary.
const guidesLinks = tools.map((tool, i) => ({
  label: footer.columns.guides.links[i],
  href: `/${lang}/${tool.slugs[lang] ?? tool.slugs['en']}/`,
}));
guidesLinks.push({
  label: getTranslations(lang).nav.links.limits,
  href: `/${lang}/platform-limits/`,
});

// Calculators split like the nav: generic "Tools" vs. per-platform "Counters".
const toolsTitle = getTranslations(lang).nav.links.tools;
const countersTitle = getTranslations(lang).nav.links.counters;
const homeToolsLinks = calculators
  .filter((tool) => !PLATFORM_COUNTERS[tool.id])
  .map((tool) => ({
    label: tool.schemaName[lang] ?? tool.schemaName['en'],
    href: `/${lang}/tools/${tool.slugs[lang] ?? tool.slugs['en']}/`,
  }));
homeToolsLinks.push({
  label: footer.columns.tool.links[4],
  href: `/${lang}/embed-widget/`,
});
const homeCounterLinks = calculators
  .filter((tool) => PLATFORM_COUNTERS[tool.id])
  .map((tool) => ({
    label: PLATFORM_COUNTERS[tool.id].brand,
    href: `/${lang}/tools/${tool.slugs[lang] ?? tool.slugs['en']}/`,
  }));

// Ad Previews column — mirrors "Tools". Brand names stay untranslated.
const adPreviewsTitle = getTranslations(lang).nav.links.adPreviews;
const AD_PREVIEW_BRANDS: Record<string, string> = {
  'facebook-ads': 'Facebook',
  'google-ads': 'Google',
  'linkedin-ads': 'LinkedIn',
  'instagram-ads': 'Instagram',
  'tiktok-ads': 'TikTok',
};
const adsLabel: Record<string, (brand: string) => string> = {
  en: (b) => `${b} Ads`,
  es: (b) => `Anuncios de ${b}`,
  de: (b) => `${b} Anzeigen`,
  fr: (b) => `Annonces ${b}`,
  pt: (b) => `Anúncios do ${b}`,
  it: (b) => `Annunci ${b}`,
  nl: (b) => `${b}-advertenties`,
  ja: (b) => `${b}広告`,
  zh: (b) => `${b} 广告`,
  da: (b) => `${b}-annoncer`,
};
const fmtAds = adsLabel[lang] ?? adsLabel.en;
const homeAdPreviewLinks = adPreviews.map((tool) => ({
  label: fmtAds(AD_PREVIEW_BRANDS[tool.id] ?? tool.schemaName['en']),
  href: `/${lang}/ad-previews/${tool.slugs[lang] ?? tool.slugs['en']}/`,
}));

// Unified column model with a per-column header icon key (order matches the
// reference: Tools · Learn · Legal · Platform Guides · Character Counters · Ads).
const navColumns = [
  { icon: 'tools', title: toolsTitle, links: homeToolsLinks },
  { icon: 'learn', title: learnLegal[0].title, links: learnLegal[0].links },
  { icon: 'legal', title: learnLegal[1].title, links: learnLegal[1].links },
  { icon: 'guides', title: footer.columns.guides.title, links: guidesLinks },
  { icon: 'counters', title: countersTitle, links: homeCounterLinks },
  { icon: 'ads', title: adPreviewsTitle, links: homeAdPreviewLinks },
] as const;

const features = [
  { icon: 'bolt', label: footer.features.realtime },
  { icon: 'shield', label: footer.features.privacy },
  { icon: 'lock', label: footer.features.noData },
  { icon: 'globe', label: footer.features.everywhere },
] as const;

const socials = [
  { name: 'LinkedIn', href: 'https://www.linkedin.com/company/posttruncate/', icon: 'linkedin' },
  { name: 'X', href: 'https://x.com/posttruncate77', icon: 'x' },
  { name: 'Instagram', href: 'https://www.instagram.com/posttruncate77/', icon: 'instagram' },
  { name: 'Facebook', href: 'https://www.facebook.com/PostTruncate/', icon: 'facebook' },
] as const;
---

<footer class="footer" class:list={{ 'footer--home': isHome }}>
  <div class="footer__mesh mesh-gradient" aria-hidden="true"></div>

  <div class="container-page footer__inner">
    <!-- Brand block: logo, tagline, trust chips, social links -->
    <div class="footer__brand">
      <a href={home} class="footer__logo" aria-label={footer.homeAria}>
        <ResponsiveImage class="footer__logo-img footer__logo-img--light" src="/logo.webp" alt={images.logoAlt} sizes="172px" />
        <ResponsiveImage class="footer__logo-img footer__logo-img--dark" src="/logo-dark.webp" alt={images.logoAlt} sizes="172px" />
      </a>
      <p class="footer__tag">{footer.tag}</p>

      <ul class="footer__features">
        {features.map((f) => (
          <li class="footer__chip">
            <span class="footer__chip-icon">
              {f.icon === 'bolt' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M13 2 3 14h9l-1 8 10-12h-9l1-8z" /></svg>
              )}
              {f.icon === 'shield' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" /></svg>
              )}
              {f.icon === 'lock' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
              )}
              {f.icon === 'globe' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20" /></svg>
              )}
            </span>
            <span class="footer__chip-label">{f.label}</span>
          </li>
        ))}
      </ul>

      <div class="footer__social">
        <p class="footer__social-label">{footer.followUs}</p>
        <div class="footer__socials">
          {socials.map((s) => (
            <a class="footer__social-link" href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.name}>
              {s.icon === 'linkedin' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.75V1.75C24 .78 23.2 0 22.22 0Z" /></svg>
              )}
              {s.icon === 'x' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z" /></svg>
              )}
              {s.icon === 'instagram' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23a3.7 3.7 0 0 1-.9 1.38 3.7 3.7 0 0 1-1.38.9c-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16M12 0C8.74 0 8.33.01 7.05.07 5.78.13 4.9.33 4.14.63a5.86 5.86 0 0 0-2.12 1.38A5.86 5.86 0 0 0 .63 4.13c-.3.76-.5 1.64-.56 2.91C.01 8.33 0 8.74 0 12s.01 3.67.07 4.95c.06 1.27.26 2.15.56 2.91a5.86 5.86 0 0 0 1.38 2.12c.66.66 1.33 1.07 2.12 1.38.76.3 1.64.5 2.91.56C8.33 23.99 8.74 24 12 24s3.67-.01 4.95-.07c1.27-.06 2.15-.26 2.91-.56a5.86 5.86 0 0 0 2.12-1.38 5.86 5.86 0 0 0 1.38-2.12c.3-.76.5-1.64.56-2.91.06-1.28.07-1.69.07-4.95s-.01-3.67-.07-4.95c-.06-1.27-.26-2.15-.56-2.91a5.86 5.86 0 0 0-1.38-2.12A5.86 5.86 0 0 0 19.86.63c-.76-.3-1.64-.5-2.91-.56C15.67.01 15.26 0 12 0Zm0 5.84a6.16 6.16 0 1 0 0 12.32 6.16 6.16 0 0 0 0-12.32ZM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8Zm6.4-10.85a1.44 1.44 0 1 0 0 2.88 1.44 1.44 0 0 0 0-2.88Z" /></svg>
              )}
              {s.icon === 'facebook' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07Z" /></svg>
              )}
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Six icon-headed link columns -->
    <div class="footer__cols">
      {navColumns.map((col) => (
        <div class="footer__col">
          <p class="footer__eyebrow">
            <span class="footer__eyebrow-icon">
              {col.icon === 'tools' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" /></svg>
              )}
              {col.icon === 'learn' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 10 12 5 2 10l10 5 10-5z" /><path d="M6 12v5c3 3 9 3 12 0v-5" /></svg>
              )}
              {col.icon === 'legal' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /></svg>
              )}
              {col.icon === 'guides' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" /><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" /></svg>
              )}
              {col.icon === 'counters' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 9h16" /><path d="M4 15h16" /><path d="M10 3 8 21" /><path d="M16 3l-2 18" /></svg>
              )}
              {col.icon === 'ads' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 11 18-5v12L3 14v-3z" /><path d="M11.6 16.8a3 3 0 1 1-5.8-1.6" /></svg>
              )}
            </span>
            {col.title}
          </p>
          <ul class="footer__list">
            {col.links.map((l) => (
              <li>
                <a href={l.href} class="footer__link">{l.label}</a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <!-- Stay-updated newsletter band -->
  <div class="container-page">
    <section class="footer__news" aria-labelledby="footer-news-heading">
      <div class="footer__news-copy">
        <span class="footer__news-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" /></svg>
        </span>
        <div>
          <p id="footer-news-heading" class="footer__news-title">{footer.newsletter.heading}</p>
          <p class="footer__news-sub">{footer.newsletter.sub}</p>
        </div>
      </div>
      {/* Submits to Mailchimp in the background (JSONP) via the script below, so
          no external page opens; target="_blank" is the no-JS fallback only. */}
      <form
        class="footer__news-form"
        method="post"
        action={NEWSLETTER_ACTION}
        target="_blank"
        data-success={footer.newsletter.success}
        data-already={footer.newsletter.already}
        data-error={footer.newsletter.error}
      >
        {/* Popup banner — sits above the input; shown after a subscribe attempt. */}
        <div class="footer__toast" role="status" aria-live="polite" data-tone="success">
          <span class="footer__toast-emoji" aria-hidden="true"></span>
          <span class="footer__toast-msg"></span>
        </div>
        <input
          class="footer__news-input"
          type="email"
          name="EMAIL"
          required
          autocomplete="email"
          placeholder={footer.newsletter.placeholder}
          aria-label={footer.newsletter.placeholder}
        />
        {/* Mailchimp bot honeypot — must stay off-screen and empty. */}
        <div aria-hidden="true" style="position:absolute;left:-5000px;">
          <input type="text" name={NEWSLETTER_HONEYPOT} tabindex="-1" value="" autocomplete="off" />
        </div>
        <button type="submit" name="subscribe" class="footer__news-btn">
          <span class="footer__news-btn-text">{footer.newsletter.button}</span>
          <span class="footer__news-btn-spinner" aria-hidden="true"></span>
        </button>
      </form>
    </section>
  </div>

  <div class="container-page footer__bar">
    <p>{interp(footer.copyright, { year })}</p>
    <p class="footer__note">{footer.disclaimer}</p>
  </div>
</footer>

<script>
  // Newsletter: subscribe in the background via Mailchimp's JSONP endpoint
  // (its /post-json variant accepts a `c` callback), so no external thank-you
  // page opens — we show an in-page popup banner instead. With JS disabled the
  // plain <form> still posts to Mailchimp's page (target="_blank") as a fallback.
  const form = document.querySelector<HTMLFormElement>('.footer__news-form');
  const toast = document.querySelector<HTMLElement>('.footer__toast');
  if (form && toast) {
    const emojiEl = toast.querySelector<HTMLElement>('.footer__toast-emoji');
    const msgEl = toast.querySelector<HTMLElement>('.footer__toast-msg');
    const btn = form.querySelector<HTMLButtonElement>('.footer__news-btn');
    let hideTimer: number | undefined;

    // Toggle the button's spinner + disabled state while a request is in flight.
    const setLoading = (on: boolean) => {
      form.classList.toggle('is-loading', on);
      if (btn) btn.disabled = on;
    };

    const showToast = (message: string, tone: 'success' | 'error') => {
      if (msgEl) msgEl.textContent = message;
      if (emojiEl) emojiEl.textContent = tone === 'success' ? '👍' : '⚠️';
      toast.dataset.tone = tone;
      toast.classList.add('is-visible');
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => toast.classList.remove('is-visible'), 4500);
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = form.querySelector<HTMLInputElement>('input[name="EMAIL"]');
      if (!email || !email.checkValidity()) {
        email?.reportValidity();
        return;
      }

      setLoading(true);

      // Swap /post? → /post-json? and carry every existing param (u, id, f_id).
      const url = new URL((form.getAttribute('action') || '').replace('/post?', '/post-json?'));
      url.searchParams.set('EMAIL', email.value.trim());
      const honeypot = form.querySelector<HTMLInputElement>('input[tabindex="-1"]');
      if (honeypot) url.searchParams.set(honeypot.name, '');
      const cb = 'mcjsonp_' + Date.now();
      url.searchParams.set('c', cb);

      const script = document.createElement('script');
      let settled = false;
      let failTimer: number | undefined;
      // Run the outcome once — from the JSONP callback, a load error, or the
      // timeout — and always clear the spinner first.
      const settle = (run: () => void) => {
        if (settled) return;
        settled = true;
        window.clearTimeout(failTimer);
        delete (window as unknown as Record<string, unknown>)[cb];
        script.remove();
        setLoading(false);
        run();
      };

      (window as unknown as Record<string, unknown>)[cb] = (data: { result?: string; msg?: string }) =>
        settle(() => {
          if (data && data.result === 'success') {
            form.reset();
            showToast(form.dataset.success || '', 'success');
          } else if (data && /already/i.test(data.msg || '')) {
            // "Already subscribed" isn't a failure for the visitor — treat it kindly.
            showToast(form.dataset.already || '', 'success');
          } else {
            showToast(form.dataset.error || '', 'error');
          }
        });
      script.onerror = () => settle(() => showToast(form.dataset.error || '', 'error'));
      // Safety net: if the JSONP never calls back, fail after 10s.
      failTimer = window.setTimeout(() => settle(() => showToast(form.dataset.error || '', 'error')), 10000);
      script.src = url.toString();
      document.body.appendChild(script);
    });
  }
</script>

<style>
  .footer {
    /* Footer shares the hero's surface: canvas hue + a faded brand mesh. Tokens
       resolve through the global palette, so it swaps with the theme. */
    position: relative;
    overflow: hidden;
    margin-top: 96px;
    background: var(--color-canvas);
    border-top: 1px solid var(--color-hairline);
  }
  .footer--home {
    margin-top: 48px;
  }
  .footer__mesh {
    position: absolute;
    inset: 0;
    opacity: 0.16;
    filter: blur(8px);
    pointer-events: none;
  }
  .footer__inner {
    position: relative;
    display: grid;
    gap: 48px;
    padding-top: 64px;
    padding-bottom: 40px;
  }

  /* ── Brand block ─────────────────────────────────────────────────────── */
  .footer__logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.4px;
  }
  .footer__logo :global(.footer__logo-img) {
    height: 35px;
    width: auto;
    display: block;
  }
  .footer__logo :global(.footer__logo-img--dark) {
    display: none;
  }
  :global(html[data-theme='dark']) .footer__logo :global(.footer__logo-img--light) {
    display: none;
  }
  :global(html[data-theme='dark']) .footer__logo :global(.footer__logo-img--dark) {
    display: block;
  }
  .footer__tag {
    margin-top: 12px;
    max-width: 300px;
    color: var(--color-body);
    font-size: 14px;
    line-height: 20px;
    letter-spacing: -0.28px;
  }

  /* Trust chips */
  .footer__features {
    list-style: none;
    margin: 24px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
