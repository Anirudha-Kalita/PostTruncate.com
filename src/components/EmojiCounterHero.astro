---
// Two-column marketing hero for the Emoji Counter page. Left: a
// blue eyebrow badge, headline (with the accent tail in a blue gradient)
// + lede + on-this-page pills. Right: a document/emoji mockup illustration
// with a smiley emoji face, selection bounds box, code badge, and magnifying glass.
//
// The accent tail is custom styled to stay clean across locales.
import type { SectionAnchor } from '../lib/headingAnchors';

interface Props {
  title: string;
  intro: string;
  sections: SectionAnchor[];
  onThisPageLabel: string;
}

const { title, intro, sections, onThisPageLabel } = Astro.props;

const dashIndex = title.indexOf('—');
const titleHead = dashIndex >= 0 ? title.slice(0, dashIndex + 1) : title;
const titleTail = dashIndex >= 0 ? title.slice(dashIndex + 1).trim() : '';

// Helper to resolve custom icons for each section in the Jump Links list
const getLinkIcon = (id: string) => {
  if (id.includes('counting-')) {
    // 1st: Smiley face icon
    return '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"/></svg>';
  }
  if (id.includes('what-')) {
    // 2nd: Slash eye icon
    return '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24M1 1l22 22"/></svg>';
  }
  if (id.includes('why-')) {
    // 3rd: Shield alert icon
    return '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>';
  }
  if (id.includes('count-detect') || id.includes('clean') || id.includes('private')) {
    // 4th: Security lock icon
    return '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>';
  }
  // Default fallback (Smiley face)
  return '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"/></svg>';
};
---

<header class="echero">
  <div class="echero__copy">
    <span class="echero__eyebrow">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"></path>
      </svg>
      Free Online Tool
    </span>

    <h1 class="echero__title">
      <span>{titleHead}</span>
      {titleTail && <><br /><span class="echero__accent">{titleTail}</span></>}
    </h1>
    {intro && <p class="echero__lede">{intro}</p>}
    
    {/* Jump navigation: mobile dropdown / desktop pills */}
    {sections.length > 0 && (
      <nav class="echero__jump" aria-label={onThisPageLabel}>
        {/* Mobile dropdown */}
        <details class="echero__mobile-nav">
          <summary class="echero__mobile-toggle">
            <span class="echero__mobile-label">{onThisPageLabel}</span>
            <svg class="echero__mobile-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <ul class="echero__mobile-list">
            {sections.map((section) => (
              <li>
                <a class="echero__mobile-link" href={`#${section.id}`}>{section.label}</a>
              </li>
            ))}
          </ul>
        </details>

        {/* Desktop pills row */}
        <div class="echero__desktop-nav">
          <span class="echero__desktop-label">{onThisPageLabel}</span>
          <div class="echero__pills">
            {sections.map((sec) => (
              <a href={`#${sec.id}`} class="echero__pill">
                <span class="echero__pill-icon" set:html={getLinkIcon(sec.id)} />
                <span>{sec.label}</span>
              </a>
            ))}
          </div>
        </div>
      </nav>
    )}
  </div>

  <div class="echero__art" aria-hidden="true">
    <span class="echero__blob echero__blob--1"></span>
    <span class="echero__blob echero__blob--2"></span>
    <span class="echero__dots"></span>

    {/* Connecting Guideline Lines */}
    <span class="echero__line-connect echero__line-connect--horizontal"></span>
    <span class="echero__line-connect echero__line-connect--vertical"></span>

    {/* Document mockup card */}
    <div class="echero__card">
      <div class="echero__card-inner">
        {/* Smiley emoji badge */}
        <div class="echero__smiley-wrap">
          <span class="echero__smiley-emoji">😊</span>
        </div>
        {/* Skeleton lines representing document text */}
        <div class="echero__lines">
          <span class="echero__line echero__line--full"></span>
          {/* Highlight Selection Box */}
          <div class="echero__selection-box">
            <span class="echero__line echero__line--medium echero__line--highlight"></span>
            <span class="echero__line echero__line--short echero__line--highlight"></span>
            <span class="echero__cursor"></span>
          </div>
          <span class="echero__line echero__line--full"></span>
        </div>
      </div>
    </div>

    {/* Floating Code badge (right) */}
    <div class="echero__badge echero__badge--code">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="16 18 22 12 16 6"></polyline>
        <polyline points="8 6 2 12 8 18"></polyline>
      </svg>
    </div>

    {/* Floating Magnifying search badge (bottom right) */}
    <div class="echero__badge echero__badge--search">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-link">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
    </div>
  </div>
</header>

<style>
  .echero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
    margin-bottom: 40px;
  }

  /* ── Left column copy ────────────────────────────────────────────────── */
  .echero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, #2563eb 12%, transparent);
    color: #2563eb;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .echero__title {
    font-size: clamp(30px, 5vw, 44px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -1.6px;
    color: var(--color-ink);
    }

  .echero__accent {
    background: linear-gradient(96deg, #2563eb 0%, #4f86f7 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .echero__lede {
    margin-top: 18px;
    max-width: 35rem;
    font-size: 17px;
    line-height: 27px;
    color: var(--color-body);
  }

  /* ── Jump menu: responsive mobile / desktop ──────────────────────────── */
  .echero__jump {
    margin-top: 32px;
  }

  .echero__mobile-nav {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
  }

  .echero__mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .echero__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .echero__mobile-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .echero__mobile-chevron {
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.15s ease;
  }

  .echero__mobile-nav[open] .echero__mobile-chevron {
    transform: rotate(180deg);
  }

  .echero__mobile-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0 8px 8px;
    list-style: none;
    border-top: 1px solid var(--color-hairline);
  }

  .echero__mobile-link {
    display: block;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .echero__mobile-link:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }

  .echero__desktop-nav {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .echero__desktop-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .echero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .echero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-body);
    transition: all 0.15s ease;
  }

  .echero__pill:hover {
    border-color: var(--color-link);
    color: var(--color-link);
    box-shadow: var(--shadow-e1);
  }

  .echero__pill-icon {
    display: inline-flex;
    align-items: center;
    color: var(--color-link);
  }

  @media (min-width: 640px) {
    .echero__mobile-nav {
      display: none;
    }
    .echero__desktop-nav {
      display: flex;
    }
  }

  /* ── Right column illustration ───────────────────────────────────────── */
  .echero__art {
    position: relative;
    display: none;
    aspect-ratio: 1.1 / 1;
    max-width: 460px;
    margin-inline: auto;
    width: 100%;
  }

  .echero__blob {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, #2563eb 12%, transparent), transparent 70%);
  }
  .echero__blob--1 {
    left: 2%;
    top: 15%;
    width: 32%;
    aspect-ratio: 1;
  }
  .echero__blob--2 {
    right: 2%;
    bottom: 10%;
    width: 25%;
    aspect-ratio: 1;
    opacity: 0.6;
  }
  .echero__dots {
    position: absolute;
    right: 6%;
    top: 5%;
    width: 76px;
    height: 50px;
    background-image: radial-gradient(currentColor 1.3px, transparent 1.3px);
    background-size: 11px 11px;
    color: color-mix(in srgb, #2563eb 22%, transparent);
  }

  /* Connecting guideline lines */
  .echero__line-connect {
    position: absolute;
    background: color-mix(in srgb, var(--color-link) 15%, transparent);
    z-index: 1;
  }
  .echero__line-connect--horizontal {
    left: 45%;
    bottom: 25%;
    width: 35%;
    height: 2px;
  }
  .echero__line-connect--vertical {
    left: 24%;
    bottom: 16%;
    width: 2px;
    height: 18%;
  }

  /* Document card */
  .echero__card {
    position: absolute;
    top: 50%;
    left: 44%;
    transform: translate(-50%, -50%);
    width: 54%;
    padding: 24px;
    border-radius: 20px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
    z-index: 2;
  }
  .echero__card-inner {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* Smiley emoji badge */
  .echero__smiley-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #fef08a; /* Soft yellow */
    border: 2px solid #facc15;
    flex-shrink: 0;
    box-shadow: var(--shadow-e1);
  }
  .echero__smiley-emoji {
    font-size: 24px;
  }

  /* Skeleton text lines */
  .echero__lines {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .echero__line {
    height: 7px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas-soft-2);
  }
  .echero__line--full   { width: 100%; }
  .echero__line--medium { width: 68%; }
  .echero__line--short  { width: 45%; }

  /* Selection box styling */
  .echero__selection-box {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 10px;
    border-radius: var(--radius-md);
    border: 1.5px dashed var(--color-link);
    background: color-mix(in srgb, var(--color-link) 5%, transparent);
  }

  .echero__line--highlight {
    background: color-mix(in srgb, var(--color-link) 25%, transparent);
  }

  /* Cursor point indicator */
  .echero__cursor {
    position: absolute;
    bottom: -6px;
    right: 15%;
    width: 14px;
    height: 14px;
    background: var(--color-link);
    clip-path: polygon(0 0, 0 100%, 30% 70%, 70% 70%);
    box-shadow: var(--shadow-e2);
  }

  /* Floating badges */
  .echero__badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-e3);
    z-index: 3;
    border: 1px solid var(--color-hairline);
  }
  .echero__badge--code {
    right: 4%;
    top: 38%;
    width: 44px;
    height: 44px;
    color: var(--color-body);
    animation: echero-float 3.8s ease-in-out infinite;
  }
  .echero__badge--search {
    right: 12%;
    bottom: 12%;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    animation: echero-float 4.2s ease-in-out 0.4s infinite;
  }

  /* Floating animation */
  @keyframes echero-float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-5px); }
  }

  /* ── Responsive breakpoints ─────────────────────────────────────────── */
  @media (min-width: 900px) {
    .echero {
      grid-template-columns: 1.150fr 0.850fr;
      gap: 48px;
      margin-bottom: 48px;
    }

    .echero__art {
      display: block;
    }
  }
</style>
