---
// Sticky brand navigation. Logo left · anchor links center · actions right
// (language switcher + theme toggle always visible; CTA on desktop, hamburger
// on mobile). Both disclosure menus are CSS-first <details> elements; the
// script below only adds close-on-navigate / outside-tap / Escape as polish.
import { LOCALES, getLocale } from '../i18n/config';
import type { Translations } from '../i18n/types';

interface Props {
  /** Active locale code — drives the localized links and current-language UI. */
  lang: string;
  /** Translated nav strings. */
  nav: Translations['nav'];
}

const { lang, nav } = Astro.props;
const current = getLocale(lang);

// Section anchors are made absolute (prefixed with the locale home) so they
// resolve from any page — on a standalone route like /about/ a bare "#faq"
// would point nowhere. About/Contact are real locale-prefixed routes.
const home = `/${lang}/`;
const links = [
  { href: `${home}#workspace`, label: nav.links.editor },
  { href: `${home}#platforms`, label: nav.links.guides },
  { href: `${home}#faq`, label: nav.links.faq },
  { href: `${home}about/`, label: nav.links.about },
  { href: `${home}contact/`, label: nav.links.contact },
];
---

<header class="nav">
  <div class="container-page nav__inner">
    <a href={home} class="nav__brand" aria-label={nav.homeAria}>
      <img class="nav__mark" src="/favicon.svg" alt="" aria-hidden="true" width="22" height="22" />
      <span class="nav__word">PostTruncate</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => <a href={l.href} class="nav__link">{l.label}</a>)}
    </nav>

    <div class="nav__actions">
      <!-- Language switcher (shown at every breakpoint). CSS-only <details>;
           closes on navigate / outside-tap / Escape via the script below. -->
      <details class="nav__lang">
        <summary class="nav__lang-toggle" aria-label={nav.languageAria}>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18"></path>
            <path d="M12 3a14 14 0 0 1 0 18 14 14 0 0 1 0-18"></path>
          </svg>
          <span class="nav__lang-code">{current.code.toUpperCase()}</span>
        </summary>
        <div class="nav__lang-panel">
          <p class="nav__lang-heading">{nav.language}</p>
          <ul class="nav__lang-list">
            {
              LOCALES.map((l) => (
                <li>
                  <a
                    href={`/${l.code}/`}
                    class="nav__lang-link"
                    hreflang={l.code}
                    lang={l.code}
                    aria-current={l.code === lang ? 'true' : undefined}
                  >
                    <span class="nav__lang-option">
                      <img
                        class="nav__lang-flag"
                        src={l.flagSrc}
                        alt=""
                        width="22"
                        height="16"
                        loading="lazy"
                        decoding="async"
                        aria-hidden="true"
                      />
                      <span class="nav__lang-name">{l.label}</span>
                    </span>
                    <span class="nav__lang-tag">{l.code.toUpperCase()}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </details>

      <button
        type="button"
        class="nav__theme"
        aria-label={nav.themeToDark}
        aria-pressed="false"
        data-to-dark={nav.themeToDark}
        data-to-light={nav.themeToLight}
      >
        <svg
          class="nav__sun"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
          ></path>
        </svg>
        <svg
          class="nav__moon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <div class="nav__cta">
        <a href={`${home}#workspace`} class="nav__pill">{nav.cta}</a>
      </div>

      <!-- Mobile disclosure menu (shown < md). CSS-only baseline; the script
           below just closes it on navigate / outside tap as enhancement. -->
      <details class="nav__menu">
        <summary class="nav__toggle" aria-label={nav.menuAria}>
          <span class="nav__bars" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
        </summary>
        <div class="nav__panel">
          <nav class="nav__panel-links" aria-label="Primary mobile">
            {links.map((l) => <a href={l.href} class="nav__panel-link">{l.label}</a>)}
          </nav>
          <a href={`${home}#workspace`} class="nav__pill nav__pill--block">{nav.cta}</a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Close-on-navigate / outside-tap / Escape for every CSS-first disclosure in
  // the nav (the mobile menu and the language switcher share this behavior).
  const disclosures = Array.from(
    document.querySelectorAll<HTMLDetailsElement>('.nav__menu, .nav__lang')
  );
  const LANGUAGE_COOKIE = 'preferred_locale';

  const persistLanguagePreference = (link: HTMLAnchorElement) => {
    const lang = link.getAttribute('hreflang')?.toLowerCase();
    if (!lang) return;

    try {
      localStorage.setItem('lang', lang);
    } catch {}

    document.cookie =
      LANGUAGE_COOKIE +
      '=' +
      encodeURIComponent(lang) +
      '; Path=/; Max-Age=31536000; SameSite=Lax';
  };

  for (const d of disclosures) {
    d.querySelectorAll('a').forEach((a) =>
      a.addEventListener('click', () => {
        if (a.matches('.nav__lang-link')) persistLanguagePreference(a);
        d.removeAttribute('open');
      })
    );
  }
  document.addEventListener('click', (e) => {
    for (const d of disclosures) {
      if (d.open && !d.contains(e.target as Node)) d.removeAttribute('open');
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape')
      for (const d of disclosures) d.removeAttribute('open');
  });

  // ── Theme toggle ────────────────────────────────────────────────────────
  // The initial theme is applied pre-paint by the inline script in Layout
  // (no flash). Here we only handle the click: flip data-theme, persist the
  // choice, and keep the button's a11y state + the address-bar theme-color
  // in sync. Stored value wins over the OS preference once the user chooses.
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>('.nav__theme');
  const meta = document.querySelector<HTMLMetaElement>('meta[name="theme-color"]');
  const THEME_COLOR = { light: '#ffffff', dark: '#0a0a0a' } as const;
  // Localized aria-labels handed down from the server (avoids hardcoding English).
  const LABELS = {
    toDark: btn?.dataset.toDark ?? 'Switch to dark theme',
    toLight: btn?.dataset.toLight ?? 'Switch to light theme',
  };

  const syncButton = (theme: 'light' | 'dark') => {
    if (!btn) return;
    const dark = theme === 'dark';
    btn.setAttribute('aria-pressed', String(dark));
    btn.setAttribute('aria-label', dark ? LABELS.toLight : LABELS.toDark);
    if (meta) meta.setAttribute('content', THEME_COLOR[theme]);
  };

  syncButton(root.dataset.theme === 'dark' ? 'dark' : 'light');

  btn?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    syncButton(next);
  });

  // Follow OS changes only while the user hasn't made an explicit choice.
  window
    .matchMedia('(prefers-color-scheme: dark)')
    .addEventListener('change', (e) => {
      let stored: string | null = null;
      try {
        stored = localStorage.getItem('theme');
      } catch {}
      if (stored) return;
      const theme = e.matches ? 'dark' : 'light';
      root.dataset.theme = theme;
      syncButton(theme);
    });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 64px;
    background: color-mix(in srgb, var(--color-canvas) 80%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--color-hairline);
  }
  .nav__inner {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-weight: 600;
    font-size: 16px;
    letter-spacing: -0.4px;
    flex-shrink: 0;
  }
  .nav__mark {
    width: 22px;
    height: 22px;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-e1);
    display: block;
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: 4px;
  }
  .nav__link {
    padding: 8px 12px;
    border-radius: var(--radius-pill);
    color: var(--color-body);
    font-size: 14px;
    letter-spacing: -0.28px;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav__link:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }

  /* Right-side actions cluster — language + theme (always shown) + CTA / menu. */
  .nav__actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  /* ── Language switcher ──────────────────────────────────────────────── */
  .nav__lang {
    position: relative;
    flex-shrink: 0;
  }
  .nav__lang-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 40px;
    padding: 0 10px;
    border-radius: var(--radius-md);
    cursor: pointer;
    list-style: none;
    color: var(--color-body);
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav__lang-toggle:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }
  .nav__lang-toggle::-webkit-details-marker {
    display: none;
  }
  .nav__lang-code {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    font-variant-numeric: tabular-nums;
  }
  .nav__lang-panel {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 220px;
    max-height: min(70vh, 420px);
    overflow-y: auto;
    padding: 8px;
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-e4);
  }
  .nav__lang-heading {
    padding: 6px 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  .nav__lang-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .nav__lang-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 10px;
    border-radius: var(--radius-md);
    color: var(--color-ink);
    font-size: 14px;
    transition: background 0.15s ease;
  }
  .nav__lang-link:hover {
    background: var(--color-canvas-soft-2);
  }
  .nav__lang-link[aria-current='true'] {
    background: var(--color-canvas-soft-2);
    font-weight: 600;
  }
  .nav__lang-option {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    gap: 10px;
  }
  .nav__lang-flag {
    width: 22px;
    height: 16px;
    flex-shrink: 0;
    display: block;
    object-fit: cover;
    border-radius: 2px;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-ink) 12%, transparent);
  }
  .nav__lang-name {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  .nav__lang-tag {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-mute);
    font-variant-numeric: tabular-nums;
  }

  /* Theme toggle — shown at every breakpoint. Sun in light, moon in dark. */
  .nav__theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    color: var(--color-body);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.15s ease, background 0.15s ease;
  }
  .nav__theme:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }
  .nav__moon {
    display: none;
  }
  :global(html[data-theme='dark']) .nav__sun {
    display: none;
  }
  :global(html[data-theme='dark']) .nav__moon {
    display: block;
  }

  /* Desktop CTA — hidden on mobile, where it lives inside the menu panel. */
  .nav__cta {
    display: none;
    flex-shrink: 0;
  }
  .nav__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 36px;
    padding: 0 16px;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-on-primary);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.28px;
    transition: opacity 0.15s ease;
  }
  .nav__pill:hover {
    opacity: 0.88;
  }
  .nav__pill--block {
    width: 100%;
    height: 44px;
  }

  /* ── Mobile disclosure menu (< md) ──────────────────────────────────── */
  .nav__menu {
    flex-shrink: 0;
  }
  .nav__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-md);
    cursor: pointer;
    list-style: none;
    color: var(--color-ink);
    transition: background 0.15s ease;
  }
  .nav__toggle:hover {
    background: var(--color-canvas-soft-2);
  }
  /* Strip the native disclosure triangle across engines. */
  .nav__toggle::-webkit-details-marker {
    display: none;
  }
  .nav__bars {
    position: relative;
    display: block;
    width: 18px;
    height: 12px;
  }
  .nav__bars span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .nav__bars span:nth-child(1) { top: 0; }
  .nav__bars span:nth-child(2) { top: 5px; }
  .nav__bars span:nth-child(3) { top: 10px; }
  /* Morph to an X when open. */
  .nav__menu[open] .nav__bars span:nth-child(1) { transform: translateY(5px) rotate(45deg); }
  .nav__menu[open] .nav__bars span:nth-child(2) { opacity: 0; }
  .nav__menu[open] .nav__bars span:nth-child(3) { transform: translateY(-5px) rotate(-45deg); }

  .nav__panel {
    position: absolute;
    top: 64px;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px 16px 16px;
    background: var(--color-canvas);
    border-bottom: 1px solid var(--color-hairline);
    box-shadow: var(--shadow-e3);
  }
  .nav__panel-links {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 8px;
  }
  .nav__panel-link {
    padding: 12px 12px;
    border-radius: var(--radius-md);
    color: var(--color-ink);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.28px;
    transition: background 0.15s ease;
  }
  .nav__panel-link:hover {
    background: var(--color-canvas-soft-2);
  }

  @media (min-width: 768px) {
    .nav__links {
      display: flex;
    }
    .nav__cta {
      display: block;
    }
    .nav__menu {
      display: none;
    }
  }
</style>
