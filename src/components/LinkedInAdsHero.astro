---
// Two-column marketing hero for the LinkedIn Ads preview page. Left: a blue
// eyebrow badge, headline (with the phrase after the em-dash tinted LinkedIn
// blue) + lede + on-this-page pills. Right: a LinkedIn Sponsored Content card
// mockup — the "in" logo, skeleton copy and a blue progress bar — with floating
// audience + analytics badges over dotted-grid decoration.
//
// Color scheme mirrors the LinkedIn platform page (blue base). The accent is
// everything after the "—" so it stays language-agnostic across all 10 locales.
// The illustration is decorative (aria-hidden).
import type { SectionAnchor } from '../lib/headingAnchors';

interface Props {
  title: string;
  intro: string;
  sections: SectionAnchor[];
  onThisPageLabel: string;
}

const { title, intro, sections, onThisPageLabel } = Astro.props;

const dashIndex = title.indexOf('—');
const titleHead = dashIndex >= 0 ? title.slice(0, dashIndex + 1) : title;
const titleTail = dashIndex >= 0 ? title.slice(dashIndex + 1).trim() : '';

const IN_GLYPH =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452z';

// Section navigation icons matching ICON_SETS.linkedin in ToolSectionCards.astro
const ICONS = [
  '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>',
  '<rect x="2" y="4" width="14" height="11" rx="1"/><path d="M6 19h6M9 15v4"/><rect x="17" y="9" width="5" height="12" rx="1"/>',
  '<path d="M22 7 13.5 15.5 8.5 10.5 2 17"/><path d="M16 7h6v6"/>',
];
---

<header class="lahero">
  <div class="lahero__copy">
    <span class="lahero__eyebrow">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
        <path d={IN_GLYPH}></path>
      </svg>
      LinkedIn tool
    </span>

    <h1 class="lahero__title">
      <span>{titleHead}</span>
      {titleTail && <><br /><span class="lahero__accent">{titleTail}</span></>}
    </h1>
    {intro && <p class="lahero__lede">{intro}</p>}
    {/* Jump navigation: mobile dropdown / desktop pills */}
    {sections.length > 0 && (
      <nav class="lahero__jump" aria-label={onThisPageLabel}>
        {/* Mobile dropdown */}
        <details class="lahero__mobile-nav">
          <summary class="lahero__mobile-toggle">
            <span class="lahero__mobile-label">{onThisPageLabel}</span>
            <svg class="lahero__mobile-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <ul class="lahero__mobile-list">
            {sections.map((section) => (
              <li>
                <a class="lahero__mobile-link" href={`#${section.id}`}>{section.label}</a>
              </li>
            ))}
          </ul>
        </details>

        {/* Desktop pills row */}
        <div class="lahero__desktop-nav">
          <span class="lahero__desktop-label">{onThisPageLabel}</span>
          <div class="lahero__pills">
            {sections.map((sec, idx) => (
              <a href={`#${sec.id}`} class="lahero__pill">
                <span class="lahero__pill-icon" set:html={`<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">${ICONS[idx % ICONS.length]}</svg>`} />
                <span>{sec.label}</span>
              </a>
            ))}
          </div>
        </div>
      </nav>
    )}
  </div>

  <div class="lahero__art" aria-hidden="true">
    <span class="lahero__blob"></span>
    <span class="lahero__dots"></span>
    <svg class="lahero__spark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3l2 7 7 2-7 2-2 7-2-7-7-2 7-2z"></path>
    </svg>

    <div class="lahero__card">
      <div class="lahero__cardhead">
        <span class="lahero__hbar lahero__hbar--wide"></span>
        <span class="lahero__hbar"></span>
        <span class="lahero__hbar"></span>
      </div>

      <div class="lahero__media">
        <svg width="100%" height="100%" viewBox="0 0 24 24" class="lahero__in" role="presentation">
          <circle cx="12" cy="12" r="12" fill="#0A66C2"></circle>
          <path fill="#fff" d={IN_GLYPH}></path>
        </svg>
      </div>

      <div class="lahero__lines">
        <span></span>
        <span></span>
      </div>

      <div class="lahero__progress"><span></span></div>
    </div>

    <span class="lahero__badge lahero__badge--people">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"></path>
      </svg>
    </span>
    <span class="lahero__badge lahero__badge--stats">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 3v18h18"></path>
        <path d="M8 17v-4M13 17V9M18 17V7"></path>
      </svg>
    </span>
  </div>
</header>

<style>
  .lahero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 40px;
  }

  /* ── Left column: copy (blue base, matching the LinkedIn platform page) ── */
  .lahero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-link-bg-soft);
    color: var(--color-link-deep);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lahero__title {
    font-size: clamp(30px, 5vw, 46px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -1.8px;
    color: var(--color-ink);
    }

  .lahero__accent {
    color: var(--color-link);
  }

  .lahero__lede {
    margin-top: 18px;
    max-width: 34rem;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }

  /* ── Jump menu: responsive mobile / desktop ──────────────────────────── */
  .lahero__jump {
    margin-top: 24px;
  }

  .lahero__mobile-nav {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
  }

  .lahero__mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .lahero__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .lahero__mobile-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .lahero__mobile-chevron {
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.15s ease;
  }

  .lahero__mobile-nav[open] .lahero__mobile-chevron {
    transform: rotate(180deg);
  }

  .lahero__mobile-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0 8px 8px;
    list-style: none;
    border-top: 1px solid var(--color-hairline);
  }

  .lahero__mobile-link {
    display: block;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .lahero__mobile-link:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }

  .lahero__desktop-nav {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .lahero__desktop-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .lahero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .lahero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-body);
    transition: all 0.15s ease;
  }

  .lahero__pill:hover {
    border-color: var(--color-link);
    color: var(--color-link-deep);
    box-shadow: var(--shadow-e1);
  }

  .lahero__pill-icon {
    display: inline-flex;
    align-items: center;
    color: var(--color-link);
  }

  @media (min-width: 640px) {
    .lahero__mobile-nav {
      display: none;
    }
    .lahero__desktop-nav {
      display: flex;
    }
  }

  /* ── Right column: LinkedIn card mockup ─────────────────────────────── */
  .lahero__art {
    position: relative;
    display: none;
    aspect-ratio: 1 / 1;
    max-width: 440px;
    margin-inline: auto;
    width: 100%;
  }

  .lahero__blob {
    position: absolute;
    left: 2%;
    top: 42%;
    width: 30%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-link-bg-soft) 85%, transparent), transparent 70%);
  }

  .lahero__dots {
    position: absolute;
    left: 4%;
    top: 14%;
    width: 78px;
    height: 66px;
    background-image: radial-gradient(currentColor 1.3px, transparent 1.3px);
    background-size: 11px 11px;
    color: color-mix(in srgb, var(--color-link) 28%, transparent);
  }

  .lahero__spark {
    position: absolute;
    right: 6%;
    top: 24%;
    width: 26px;
    height: 26px;
    color: color-mix(in srgb, var(--color-link) 55%, transparent);
  }

  /* Sponsored-content card */
  .lahero__card {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 62%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 16px;
    border-radius: 18px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
  }

  .lahero__cardhead {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .lahero__hbar {
    height: 8px;
    width: 14%;
    border-radius: var(--radius-pill);
    background: var(--color-canvas-soft-2);
  }
  .lahero__hbar--wide {
    width: 44%;
    margin-right: auto;
  }

  .lahero__media {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 10;
    border-radius: 10px;
    background: var(--color-canvas-soft-2);
  }
  .lahero__in {
    width: 40%;
    height: 40%;
    filter: drop-shadow(0 3px 6px rgba(4, 45, 110, 0.3));
  }

  .lahero__lines {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .lahero__lines span {
    height: 7px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas-soft-2);
  }
  .lahero__lines span:first-child {
    width: 88%;
  }
  .lahero__lines span:last-child {
    width: 62%;
  }

  .lahero__progress {
    height: 12px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas-soft-2);
    overflow: hidden;
  }
  .lahero__progress span {
    display: block;
    width: 64%;
    height: 100%;
    border-radius: var(--radius-pill);
    background: linear-gradient(90deg, #2a86ff 0%, #0a66c2 100%);
  }

  /* Floating badges (both blue, per the platform base) */
  .lahero__badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-lg);
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
  }
  .lahero__badge svg {
    width: 24px;
    height: 24px;
  }
  .lahero__badge--people {
    left: 0;
    top: 48%;
    color: var(--color-link);
  }
  .lahero__badge--stats {
    right: 4%;
    bottom: 12%;
    color: var(--color-link-deep);
  }

  /* ── Responsive: two columns + illustration only on wider viewports ──── */
  @media (min-width: 900px) {
    .lahero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
      margin-bottom: 48px;
    }

    .lahero__art {
      display: block;
    }
  }
</style>
