---
// Shared renderer for the 404 and 500 pages. Both build to a single root-level
// file (/404.html, /500.html) that a host serves for ANY path in ANY language,
// so unlike the /[lang]/ routes we can't pre-render one file per locale.
//
// Strategy: render the DEFAULT_LOCALE (English) copy server-side so the page is
// correct with JS off, but embed every locale's error strings and swap to the
// visitor's language client-side — same resolution order as the root redirect
// (localStorage 'lang' → navigator.languages → en). Chrome (nav/footer) stays
// in English; only the error message localizes, and it's tagged with its own
// `lang` so screen readers announce it correctly. The CTA points at "/", which
// the root redirect then forwards to the visitor's language.
import Layout from '../layouts/Layout.astro';
import { getTranslations } from '../i18n';
import { LOCALE_CODES, DEFAULT_LOCALE } from '../i18n/config';

interface Props {
  /** Which error dictionary entry to render. */
  kind: 'notFound' | 'serverError';
  /** In-locale path used for the (noindex) page; e.g. "/404/". */
  path: string;
}

const { kind, path } = Astro.props;

// English copy for the server render (no-JS baseline).
const en = getTranslations(DEFAULT_LOCALE).errors[kind];

// Every locale's copy for this error kind, keyed by code — handed to the
// client script so it can swap text to the visitor's language.
const byLocale = Object.fromEntries(
  LOCALE_CODES.map((code) => [code, getTranslations(code).errors[kind]]),
);

const brand = 'PostTruncate';
---

<Layout
  lang={DEFAULT_LOCALE}
  path={path}
  title={`${en.title} · ${brand}`}
  description={en.description}
  noindex
>
  <section class="error" lang={DEFAULT_LOCALE}>
    <div class="error__mesh mesh-gradient" aria-hidden="true"></div>
    <div class="container-page error__inner">
      <div class="error__card">
        <div class="error__art" aria-hidden="true">
          <svg viewBox="0 0 240 210" fill="none" xmlns="http://www.w3.org/2000/svg" role="presentation">
            <defs>
              <linearGradient id="ep-win" x1="0.5" y1="0" x2="0.5" y2="1">
                <stop offset="0" stop-color="#ffffff"></stop>
                <stop offset="1" stop-color="#eaf2fc"></stop>
              </linearGradient>
              <linearGradient id="ep-bar" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#4a97f4"></stop>
                <stop offset="1" stop-color="#0066e0"></stop>
              </linearGradient>
              <linearGradient id="ep-doc" x1="0.5" y1="0" x2="0.5" y2="1">
                <stop offset="0" stop-color="#ffffff"></stop>
                <stop offset="1" stop-color="#eaf1fb"></stop>
              </linearGradient>
            </defs>

            <ellipse cx="150" cy="184" rx="66" ry="11" fill="#0066e0" opacity="0.12"></ellipse>

            <path d="M42 150 C 78 128, 96 172, 132 150 S 196 120, 226 146" stroke="#b9d6f6" stroke-width="1.6" stroke-dasharray="1.5 6" stroke-linecap="round"></path>
            <circle cx="230" cy="146" r="3.2" fill="none" stroke="#b9d6f6" stroke-width="1.6"></circle>
            <circle cx="38" cy="150" r="2.6" fill="#b9d6f6"></circle>

            <rect x="60" y="40" width="132" height="110" rx="13" fill="url(#ep-win)"></rect>
            <path d="M60 53 a13 13 0 0 1 13 -13 h106 a13 13 0 0 1 13 13 v11 H60 Z" fill="url(#ep-bar)"></path>
            <circle cx="76" cy="52" r="3.6" fill="#ff6b5e"></circle>
            <circle cx="89" cy="52" r="3.6" fill="#ffb340"></circle>
            <circle cx="102" cy="52" r="3.6" fill="#37d67a"></circle>

            <g transform="rotate(5 160 122)">
              <path d="M137 83 H188 L200 95 V162 a9 9 0 0 1 -9 9 H137 a9 9 0 0 1 -9 -9 V92 a9 9 0 0 1 9 -9 Z" fill="#0a4fa0" opacity="0.12"></path>
              <path d="M133 78 H184 L196 90 V157 a9 9 0 0 1 -9 9 H133 a9 9 0 0 1 -9 -9 V87 a9 9 0 0 1 9 -9 Z" fill="url(#ep-doc)"></path>
              <path d="M184 78 V90 H196 Z" fill="#cfe2fa"></path>
              <path d="M184 78 L196 90" stroke="#b9d6f6" stroke-width="1.4"></path>
              <path d="M143 104l8 8M151 104l-8 8" stroke="#0066e0" stroke-width="3.2" stroke-linecap="round"></path>
              <path d="M167 104l8 8M175 104l-8 8" stroke="#0066e0" stroke-width="3.2" stroke-linecap="round"></path>
              <path d="M150 138 Q160 126 170 138" stroke="#0066e0" stroke-width="3.2" fill="none" stroke-linecap="round"></path>
            </g>

            <path d="M44 96h9M48.5 91.5v9" stroke="#8fbdf4" stroke-width="2.4" stroke-linecap="round"></path>
            <path d="M210 70h9M214.5 65.5v9" stroke="#8fbdf4" stroke-width="2.4" stroke-linecap="round"></path>
            <path d="M206 150h8M210 146v8" stroke="#8fbdf4" stroke-width="2.4" stroke-linecap="round"></path>
            <circle cx="120" cy="196" r="2.6" fill="#a9cef5"></circle>
            <circle cx="196" cy="120" r="2.4" fill="#a9cef5"></circle>
          </svg>
        </div>
        <p class="error__code">{en.code}</p>
        <h1 class="error__title">{en.heading}</h1>
        <p class="error__lede">{en.body}</p>
        <div class="error__cta">
          <a href="/" class="error__primary">
            <svg class="error__arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"></path></svg>
            <span class="error__cta-label">{en.cta}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Inline (define:vars makes it inline) and placed AFTER the section, so the
      elements above already exist when it runs — the text swaps during parse,
      before load, minimizing any flash of English. Mirrors the locale pick in
      src/pages/index.astro. */}
  <script is:inline define:vars={{ byLocale, codes: LOCALE_CODES, brand }}>
    (function () {
      try {
        var pick = function () {
          // 1. URL path prefix — the strongest signal for an error page. A
          //    broken link like /da/whatever still leaves "da" in
          //    location.pathname even though the host served the shared
          //    /404.html, so this is what actually localizes the page.
          var seg = location.pathname.split('/')[1];
          if (seg && codes.indexOf(seg) !== -1) return seg;

          // 2. A previously stored choice (same key the root redirect reads).
          var stored = null;
          try {
            stored = localStorage.getItem('lang');
          } catch (e) {}
          if (stored && codes.indexOf(stored) !== -1) return stored;

          // 3. The browser's preferred languages.
          var prefs = navigator.languages || [navigator.language || ''];
          for (var i = 0; i < prefs.length; i++) {
            var base = String(prefs[i]).toLowerCase().split('-')[0];
            if (codes.indexOf(base) !== -1) return base;
          }
          return null;
        };

        var lang = pick();
        // English is already on the page — nothing to swap.
        if (!lang || lang === 'en') return;
        var t = byLocale[lang];
        if (!t) return;

        var setText = function (sel, text) {
          var el = document.querySelector(sel);
          if (el) el.textContent = text;
        };
        setText('.error__code', t.code);
        setText('.error__title', t.heading);
        setText('.error__lede', t.body);
        setText('.error__cta-label', t.cta);

        document.title = t.title + ' · ' + brand;
        var desc = document.querySelector('meta[name="description"]');
        if (desc) desc.setAttribute('content', t.description);
        // Re-tag the localized region so assistive tech reads it correctly
        // (the surrounding chrome stays English).
        var sec = document.querySelector('.error');
        if (sec) sec.setAttribute('lang', lang);
      } catch (e) {}
    })();
  </script>
</Layout>

<style>
  .error {
    position: relative;
    overflow: hidden;
    background: var(--color-canvas);
    min-height: clamp(360px, 50vh, 520px);
    display: grid;
    place-items: center;
    /* Cancel most of the footer's 96px margin-top to tighten the gap. */
    margin-bottom: -56px;
  }
  .error__mesh {
    position: absolute;
    inset: -40% 0 auto 0;
    height: 160%;
    opacity: 0.16;
    filter: blur(8px);
    pointer-events: none;
  }
  .error__inner {
    position: relative;
    padding-top: 32px;
    padding-bottom: 28px;
    display: grid;
    place-items: center;
  }
  .error__card {
    width: 100%;
    max-width: 720px;
    padding: clamp(22px, 3.5vw, 40px) clamp(24px, 5vw, 64px) clamp(26px, 3.5vw, 44px);
    border-radius: var(--radius-xl);
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    box-shadow: var(--shadow-e4);
    text-align: center;
  }
  .error__art {
    width: 100%;
    max-width: clamp(120px, 22vw, 156px);
    margin: 0 auto 4px;
  }
  .error__art svg {
    width: 100%;
    height: auto;
  }
  .error__code {
    font-size: clamp(56px, 11vw, 96px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -3px;
    color: var(--color-ink);
  }
  .error__title {
    margin: 2px auto 0;
    max-width: 560px;
    font-size: clamp(24px, 4.4vw, 34px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -1.4px;
    color: var(--color-ink);
  }
  .error__lede {
    margin: 12px auto 0;
    max-width: 480px;
    font-size: 16px;
    line-height: 25px;
    color: var(--color-body);
  }
  .error__cta {
    margin-top: 22px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
  .error__primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 48px;
    padding: 0 28px;
    border-radius: var(--radius-lg);
    background: var(--color-link);
    color: #ffffff;
    font-size: 16px;
    font-weight: 600;
    box-shadow: var(--shadow-e2);
    transition: background 0.15s ease, transform 100ms ease, box-shadow 0.15s ease;
  }
  .error__primary:hover {
    background: var(--color-link-deep);
    box-shadow: var(--shadow-e3);
  }
  .error__primary:active {
    transform: scale(0.97);
  }
  .error__arrow {
    flex-shrink: 0;
  }

  /* Bright mesh stops read washed-out at 0.16 over near-black; lift them. */
  :global(html[data-theme='dark']) .error__mesh {
    opacity: 0.3;
  }
</style>
