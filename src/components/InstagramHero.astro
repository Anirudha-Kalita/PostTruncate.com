---
// Two-column marketing hero for the standalone Instagram character-counter
// page. Left: a pink eyebrow badge, headline (with the phrase after the em-dash
// set in the Instagram gradient) + lede + on-this-page pills. Right: the
// gradient Instagram-logo tile on a soft glow with floating stat cards.
//
// The Instagram title highlights a text phrase (not a number) whose wording and
// position vary per locale, so the accent is everything after the "—" — a
// language-agnostic split that works across all 10 locales. The illustration is
// decorative (aria-hidden) and keeps its stylised English micro-labels.
import type { SectionAnchor } from '../lib/headingAnchors';

interface Props {
  title: string;
  intro: string;
  sections: SectionAnchor[];
  onThisPageLabel: string;
}

const { title, intro, sections, onThisPageLabel } = Astro.props;

// Accent the segment after the em-dash (kept with its leading dash on the head).
const dashIndex = title.indexOf('—');
const titleHead = dashIndex >= 0 ? title.slice(0, dashIndex + 1) : title;
const titleTail = dashIndex >= 0 ? title.slice(dashIndex + 1).trim() : '';

// Section navigation icons matching ICON_SETS.instagram in ToolSectionCards.astro
const ICONS = [
  '<path d="M4 6h16M4 12h10M4 18h13"/>',
  '<circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M20 4 8.12 15.88M14.47 14.48 20 20M8.12 8.12 12 12"/>',
  '<path d="M4 9h16M4 15h16M10 3 8 21M16 3l-2 18"/>',
  '<path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>',
];
---

<header class="ihero">
  <div class="ihero__copy">
    <span class="ihero__eyebrow">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="3" width="18" height="18" rx="5"></rect>
        <circle cx="12" cy="12" r="4"></circle>
        <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
      </svg>
      Instagram tool
    </span>

    <h1 class="ihero__title">
      <span>{titleHead}</span>
      {titleTail && <><br /><span class="ihero__accent">{titleTail}</span></>}
    </h1>
    {intro && <p class="ihero__lede">{intro}</p>}
    
    {/* Jump navigation: mobile dropdown / desktop pills */}
    {sections.length > 0 && (
      <nav class="ihero__jump" aria-label={onThisPageLabel}>
        {/* Mobile dropdown */}
        <details class="ihero__mobile-nav">
          <summary class="ihero__mobile-toggle">
            <span class="ihero__mobile-label">{onThisPageLabel}</span>
            <svg class="ihero__mobile-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <ul class="ihero__mobile-list">
            {sections.map((section) => (
              <li>
                <a class="ihero__mobile-link" href={`#${section.id}`}>{section.label}</a>
              </li>
            ))}
          </ul>
        </details>

        {/* Desktop pills row */}
        <div class="ihero__desktop-nav">
          <span class="ihero__desktop-label">{onThisPageLabel}</span>
          <div class="ihero__pills">
            {sections.map((sec, idx) => (
              <a href={`#${sec.id}`} class="ihero__pill">
                <span class="ihero__pill-icon" set:html={`<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">${ICONS[idx % ICONS.length]}</svg>`} />
                <span>{sec.label}</span>
              </a>
            ))}
          </div>
        </div>
      </nav>
    )}
  </div>

  <div class="ihero__art" aria-hidden="true">
    <span class="ihero__glow"></span>

    <div class="ihero__logo">
      <svg width="24" height="24" viewBox="0 0 24 24" role="presentation">
        <rect x="4.5" y="4.5" width="15" height="15" rx="4.5" fill="none" stroke="#fff" stroke-width="1.5"></rect>
        <circle cx="12" cy="12" r="3.75" fill="none" stroke="#fff" stroke-width="1.5"></circle>
        <circle cx="17" cy="7" r="1.1" fill="#fff"></circle>
      </svg>
    </div>

    <div class="ihero__card ihero__card--chars">
      <span class="ihero__num">2200</span>
      <span class="ihero__label">Characters</span>
    </div>

    <div class="ihero__card ihero__card--fold">
      <span class="ihero__num">125</span>
      <span class="ihero__label">More<br />fold</span>
    </div>

    <div class="ihero__card ihero__card--tags">
      <span class="ihero__num">30</span>
      <span class="ihero__label">Hashtags<br />Max</span>
    </div>
  </div>
</header>

<style>
  .ihero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
    margin-bottom: 40px;
  }

  /* ── Left column: copy ──────────────────────────────────────────────── */
  .ihero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--color-highlight-pink) 12%, transparent);
    color: var(--color-highlight-magenta);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ihero__title {
    font-size: clamp(30px, 5vw, 46px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -1.8px;
    color: var(--color-ink);
    }

  .ihero__accent {
    background: linear-gradient(
      96deg,
      var(--color-violet) 2%,
      var(--color-highlight-pink) 48%,
      var(--color-warning) 98%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .ihero__lede {
    margin-top: 18px;
    max-width: 34rem;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }

  /* ── Jump menu: responsive mobile / desktop ──────────────────────────── */
  .ihero__jump {
    margin-top: 24px;
  }

  .ihero__mobile-nav {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
  }

  .ihero__mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .ihero__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .ihero__mobile-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .ihero__mobile-chevron {
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.15s ease;
  }

  .ihero__mobile-nav[open] .ihero__mobile-chevron {
    transform: rotate(180deg);
  }

  .ihero__mobile-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0 8px 8px;
    list-style: none;
    border-top: 1px solid var(--color-hairline);
  }

  .ihero__mobile-link {
    display: block;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .ihero__mobile-link:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }

  .ihero__desktop-nav {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .ihero__desktop-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .ihero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ihero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-body);
    transition: all 0.15s ease;
  }

  .ihero__pill:hover {
    border-color: var(--color-highlight-pink);
    color: var(--color-highlight-magenta);
    box-shadow: var(--shadow-e1);
  }

  .ihero__pill-icon {
    display: inline-flex;
    align-items: center;
    color: var(--color-highlight-magenta);
  }

  @media (min-width: 640px) {
    .ihero__mobile-nav {
      display: none;
    }
    .ihero__desktop-nav {
      display: flex;
    }
  }

  /* ── Right column: decorative illustration ──────────────────────────── */
  .ihero__art {
    position: relative;
    display: none;
    aspect-ratio: 5 / 4;
    max-width: 460px;
    margin-inline: auto;
    width: 100%;
  }

  .ihero__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 60%;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-highlight-pink) 30%, transparent) 0%,
      color-mix(in srgb, var(--color-warning) 18%, transparent) 45%,
      transparent 70%
    );
  }

  /* Gradient Instagram tile — the brand radial gradient lives on the wrapper so
     the white camera glyph can sit above it with 3D depth: stacked brand-tinted
     shadows plus inset highlight/shade. Branded (fixed gradient) in both themes. */
  .ihero__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44%;
    aspect-ratio: 1;
    border-radius: 26%;
    background: radial-gradient(
      circle at 30% 107%,
      #ffdd55 0%,
      #ffad55 10%,
      #ff543e 50%,
      #c837ab 70%,
      #3f5bd9 100%
    );
    box-shadow:
      0 3px 4px rgba(120, 30, 110, 0.3),
      0 12px 22px -6px rgba(200, 55, 171, 0.45),
      0 32px 50px -14px rgba(120, 30, 110, 0.4),
      inset 0 3px 6px rgba(255, 255, 255, 0.45),
      inset 0 -8px 16px rgba(90, 20, 80, 0.4);
  }

  .ihero__logo svg {
    display: block;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 2px 4px rgba(90, 20, 80, 0.45));
  }

  /* Floating cards share a soft elevated surface that adapts to dark mode. */
  .ihero__card {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 18px;
    border-radius: var(--radius-xl);
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
  }

  .ihero__card--chars {
    top: 2%;
    right: 0;
  }
  .ihero__card--fold {
    top: 44%;
    left: 0;
  }
  .ihero__card--tags {
    bottom: 4%;
    right: 3%;
  }

  .ihero__num {
    font-size: 30px;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -1px;
    color: var(--color-highlight-magenta);
  }

  .ihero__label {
    font-size: 12px;
    font-weight: 500;
    line-height: 1.25;
    color: var(--color-mute);
  }

  /* ── Responsive: two columns + illustration only on wider viewports ──── */
  @media (min-width: 900px) {
    .ihero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
      margin-bottom: 48px;
    }

    .ihero__art {
      display: block;
    }
  }
</style>
