---
import type { Translations } from '../i18n/types';

interface Props {
  s: Translations['whyPostTruncate'];
}

const { s } = Astro.props;
---
<section class="container-page why-section">
  <div class="why-grid">
    <div class="why-left">
      <p class="section-eyebrow">{s.eyebrow}</p>
      <h2 class="why-title" set:html={s.title}></h2>
      <p class="why-text">{s.p1}</p>
      <p class="why-text">{s.p2}</p>
    </div>
    <div class="why-right">
      <div class="feature-card">
        <div class="feature-icon icon-blue">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
          </svg>
        </div>
        <h3 class="feature-title">{s.features.realTime.title}</h3>
        <p class="feature-desc">{s.features.realTime.desc}</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon icon-purple">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <circle cx="10" cy="13" r="2"></circle>
            <path d="m11.5 14.5 3 3"></path>
          </svg>
        </div>
        <h3 class="feature-title">{s.features.insights.title}</h3>
        <p class="feature-desc">{s.features.insights.desc}</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon icon-green">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            <path d="m9 12 2 2 4-4"></path>
          </svg>
        </div>
        <h3 class="feature-title">{s.features.privacy.title}</h3>
        <p class="feature-desc">{s.features.privacy.desc}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .why-section {
    padding-top: 96px;
    scroll-margin-top: 80px;
  }
  .why-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
    align-items: center;
  }
  @media (min-width: 1024px) {
    .why-grid {
      grid-template-columns: 0.9fr 1.1fr;
      gap: 80px;
    }
  }
  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
    margin-bottom: 12px;
    font-weight: 600;
  }
  .why-title {
    font-size: 32px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -1px;
    color: var(--color-ink);
    margin-bottom: 24px;
  }
  .why-text {
    font-size: 16px;
    line-height: 26px;
    color: var(--color-body);
    margin-bottom: 16px;
  }
  .why-right {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  @media (min-width: 768px) {
    .why-right {
      flex-direction: row;
      gap: 24px;
    }
  }
  .feature-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }
  .feature-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
  }
  .feature-icon svg {
    width: 28px;
    height: 28px;
  }
  .icon-blue {
    background: #E8F2FF;
    color: #0A66C2;
  }
  .icon-purple {
    background: #F4E8FF;
    color: #9333EA;
  }
  .icon-green {
    background: #E8F8F0;
    color: #16A34A;
  }
  :global(html[data-theme='dark']) .icon-blue {
    background: rgba(10, 102, 194, 0.2);
    color: #60A5FA;
  }
  :global(html[data-theme='dark']) .icon-purple {
    background: rgba(147, 51, 234, 0.2);
    color: #C084FC;
  }
  :global(html[data-theme='dark']) .icon-green {
    background: rgba(22, 163, 74, 0.2);
    color: #4ADE80;
  }
  .feature-title {
    font-size: 17px;
    font-weight: 600;
    color: var(--color-ink);
  }
  .feature-desc {
    font-size: 15px;
    line-height: 24px;
    color: var(--color-body);
  }
</style>
