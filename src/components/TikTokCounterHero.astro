---
// Two-column marketing hero for the TikTok character-counter page. Left: a blue
// eyebrow badge, headline (with the phrase after the em-dash in a blue gradient)
// + lede + on-this-page pills. Right: a caption-card mockup with the black
// TikTok logo tile and skeleton copy, plus floating "Aa" and profile badges over
// dotted-grid decoration.
//
// This counter page follows a blue accent scheme (per the reference) while
// keeping TikTok's black brand logo. The accent is everything after the "—" so
// it stays language-agnostic across all 10 locales. Illustration is aria-hidden.
import type { SectionAnchor } from '../lib/headingAnchors';

interface Props {
  title: string;
  intro: string;
  sections: SectionAnchor[];
  onThisPageLabel: string;
}

const { title, intro, sections, onThisPageLabel } = Astro.props;

const dashIndex = title.indexOf('—');
const titleHead = dashIndex >= 0 ? title.slice(0, dashIndex + 1) : title;
const titleTail = dashIndex >= 0 ? title.slice(dashIndex + 1).trim() : '';

// Section navigation icons matching ICON_SETS['tiktok-counter'] in ToolSectionCards.astro
const ICONS = [
  '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>',
  '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  '<path d="M12 3l8 3v5c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/>',
];

const TIKTOK_GLYPH =
  'M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.59 2.59 0 0 1-2.59-2.59 2.59 2.59 0 0 1 3.39-2.46V9.69a5.66 5.66 0 0 0-.8-.06A5.69 5.69 0 0 0 4.17 15.31 5.69 5.69 0 0 0 13.94 19.3a5.69 5.69 0 0 0 1.6-3.96V9.01a7.34 7.34 0 0 0 4.29 1.37V7.3a4.28 4.28 0 0 1-3.23-1.48z';
---

<header class="tchero">
  <div class="tchero__copy">
    <span class="tchero__eyebrow">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
        <path d={TIKTOK_GLYPH}></path>
      </svg>
      TikTok tool
    </span>

    <h1 class="tchero__title">
      <span>{titleHead}</span>
      {titleTail && <><br /><span class="tchero__accent">{titleTail}</span></>}
    </h1>
    {intro && <p class="tchero__lede">{intro}</p>}
    {/* Jump navigation: mobile dropdown / desktop pills */}
    {sections.length > 0 && (
      <nav class="tchero__jump" aria-label={onThisPageLabel}>
        {/* Mobile dropdown */}
        <details class="tchero__mobile-nav">
          <summary class="tchero__mobile-toggle">
            <span class="tchero__mobile-label">{onThisPageLabel}</span>
            <svg class="tchero__mobile-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <ul class="tchero__mobile-list">
            {sections.map((section) => (
              <li>
                <a class="tchero__mobile-link" href={`#${section.id}`}>{section.label}</a>
              </li>
            ))}
          </ul>
        </details>

        {/* Desktop pills row */}
        <div class="tchero__desktop-nav">
          <span class="tchero__desktop-label">{onThisPageLabel}</span>
          <div class="tchero__pills">
            {sections.map((sec, idx) => (
              <a href={`#${sec.id}`} class="tchero__pill">
                <span class="tchero__pill-icon" set:html={`<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">${ICONS[idx % ICONS.length]}</svg>`} />
                <span>{sec.label}</span>
              </a>
            ))}
          </div>
        </div>
      </nav>
    )}
  </div>

  <div class="tchero__art" aria-hidden="true">
    <span class="tchero__dots"></span>

    <div class="tchero__card">
      <div class="tchero__logo">
        <svg width="100%" height="100%" viewBox="0 0 24 24" role="presentation">
          <path class="tchero__note tchero__note--cyan" transform="translate(-0.7 -0.5)" d={TIKTOK_GLYPH}></path>
          <path class="tchero__note tchero__note--magenta" transform="translate(0.7 0.5)" d={TIKTOK_GLYPH}></path>
          <path class="tchero__note tchero__note--white" d={TIKTOK_GLYPH}></path>
        </svg>
      </div>
      <div class="tchero__lines">
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
        <span></span>
      </div>
    </div>

    <span class="tchero__aa">Aa</span>
    <span class="tchero__person">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path>
      </svg>
    </span>
  </div>
</header>

<style>
  .tchero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 40px;
  }

  /* ── Left column: copy (blue accent, black brand logo) ──────────────── */
  .tchero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, #2f6bfe 14%, transparent);
    color: #2359d6;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tchero__title {
    font-size: clamp(30px, 5vw, 46px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -1.8px;
    color: var(--color-ink);
    }

  .tchero__accent {
    background: linear-gradient(96deg, #2f6bfe 0%, #5b8bff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .tchero__lede {
    margin-top: 18px;
    max-width: 34rem;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }

  /* ── Jump menu: responsive mobile / desktop ──────────────────────────── */
  .tchero__jump {
    margin-top: 24px;
  }

  .tchero__mobile-nav {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
  }

  .tchero__mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .tchero__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .tchero__mobile-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .tchero__mobile-chevron {
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.15s ease;
  }

  .tchero__mobile-nav[open] .tchero__mobile-chevron {
    transform: rotate(180deg);
  }

  .tchero__mobile-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0 8px 8px;
    list-style: none;
    border-top: 1px solid var(--color-hairline);
  }

  .tchero__mobile-link {
    display: block;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .tchero__mobile-link:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }

  .tchero__desktop-nav {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .tchero__desktop-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .tchero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tchero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-body);
    transition: all 0.15s ease;
  }

  .tchero__pill:hover {
    border-color: var(--color-link);
    color: var(--color-link-deep);
    box-shadow: var(--shadow-e1);
  }

  .tchero__pill-icon {
    display: inline-flex;
    align-items: center;
    color: var(--color-link);
  }

  @media (min-width: 640px) {
    .tchero__mobile-nav {
      display: none;
    }
    .tchero__desktop-nav {
      display: flex;
    }
  }

  /* ── Right column: caption-card mockup ──────────────────────────────── */
  .tchero__art {
    position: relative;
    display: none;
    aspect-ratio: 1 / 1;
    max-width: 440px;
    margin-inline: auto;
    width: 100%;
  }

  .tchero__dots {
    position: absolute;
    right: 2%;
    top: 20%;
    width: 66px;
    height: 66px;
    background-image: radial-gradient(currentColor 1.3px, transparent 1.3px);
    background-size: 11px 11px;
    color: color-mix(in srgb, #2f6bfe 30%, transparent);
  }

  /* Caption card — tall, logo at the top, paragraph skeleton below. */
  .tchero__card {
    position: absolute;
    top: 50%;
    left: 52%;
    transform: translate(-50%, -50%);
    width: 48%;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 22px 20px;
    border-radius: 20px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
  }

  /* Black TikTok tile with the offset cyan/magenta/white note. */
  .tchero__logo {
    align-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42%;
    aspect-ratio: 1;
    margin-top: 4px;
    border-radius: 24%;
    background: linear-gradient(158deg, #2c2c2c 0%, #010101 62%);
    box-shadow:
      0 2px 3px rgba(0, 0, 0, 0.4),
      0 10px 18px -6px rgba(0, 0, 0, 0.5),
      inset 0 2px 4px rgba(255, 255, 255, 0.14),
      inset 0 -6px 10px rgba(0, 0, 0, 0.55);
  }
  .tchero__logo svg {
    width: 56%;
    height: 56%;
  }
  .tchero__note--cyan {
    fill: #25f4ee;
  }
  .tchero__note--magenta {
    fill: #fe2c55;
  }
  .tchero__note--white {
    fill: #fff;
  }

  .tchero__lines {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .tchero__lines span {
    height: 7px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas-soft-2);
  }
  .tchero__lines span:nth-child(1) {
    width: 96%;
  }
  .tchero__lines span:nth-child(2) {
    width: 88%;
  }
  .tchero__lines span:nth-child(3) {
    width: 92%;
  }
  .tchero__lines span:nth-child(4) {
    width: 80%;
  }
  .tchero__lines span:nth-child(5) {
    width: 90%;
  }
  .tchero__lines span:nth-child(6) {
    width: 58%;
  }

  /* "Aa" speech bubble (left) */
  .tchero__aa {
    position: absolute;
    left: 0;
    top: 44%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 64px;
    border-radius: 22px 22px 22px 5px;
    background: color-mix(in srgb, #2f6bfe 14%, var(--color-canvas));
    box-shadow: var(--shadow-e5);
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.5px;
    color: #2f6bfe;
  }

  /* Profile squircle (right) */
  .tchero__person {
    position: absolute;
    right: 2%;
    top: 34%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: 30%;
    background: color-mix(in srgb, var(--color-violet) 14%, var(--color-canvas));
    box-shadow: var(--shadow-e5);
    color: var(--color-violet-deep);
  }
  .tchero__person svg {
    width: 26px;
    height: 26px;
  }

  /* ── Responsive: two columns + illustration only on wider viewports ──── */
  @media (min-width: 900px) {
    .tchero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
      margin-bottom: 48px;
    }

    .tchero__art {
      display: block;
    }
  }
</style>
