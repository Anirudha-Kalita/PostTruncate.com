---
import type { Translations } from '../i18n/types';

interface Props {
  s: Translations['whoIsItFor'];
}

const { s } = Astro.props;

// Card model: card icon key + CTA icon key + accent (drives the tinted icon
// chip, the CTA pill, and the hover border via CSS custom props).
const roles = [
  { key: 'marketers', accent: 'blue', cardIcon: 'chart', ctaIcon: 'chart', title: s.roles.marketers.title, desc: s.roles.marketers.desc, cta: s.roles.marketers.cta },
  { key: 'creators', accent: 'purple', cardIcon: 'people', ctaIcon: 'heart', title: s.roles.creators.title, desc: s.roles.creators.desc, cta: s.roles.creators.cta },
  { key: 'agencies', accent: 'darkblue', cardIcon: 'briefcase', ctaIcon: 'people', title: s.roles.agencies.title, desc: s.roles.agencies.desc, cta: s.roles.agencies.cta },
  { key: 'founders', accent: 'green', cardIcon: 'rocket', ctaIcon: 'badge', title: s.roles.founders.title, desc: s.roles.founders.desc, cta: s.roles.founders.cta },
] as const;
---
<section class="container-page who-section">
  <div class="who-head">
    <p class="who-eyebrow">{s.eyebrow}</p>
    <h2 class="who-title" set:html={s.title}></h2>
    <p class="who-subtitle">{s.subtitle}</p>
  </div>

  <div class="who-grid">
    {roles.map((r) => (
      <article class={`who-card who-card--${r.accent}`}>
        <span class="who-icon">
          {r.cardIcon === 'chart' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 3v18h18" />
              <rect x="7" y="14" width="4" height="7" rx="1" />
              <rect x="15" y="7" width="4" height="14" rx="1" />
              <path d="M3 14l6-6 4 3 8-7" />
            </svg>
          )}
          {r.cardIcon === 'people' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
              <circle cx="9" cy="7" r="4" />
              <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
              <path d="M16 3.13a4 4 0 0 1 0 7.75" />
            </svg>
          )}
          {r.cardIcon === 'briefcase' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="7" width="20" height="14" rx="2" ry="2" />
              <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16" />
            </svg>
          )}
          {r.cardIcon === 'rocket' && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z" />
              <path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z" />
              <path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0" />
              <path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5" />
            </svg>
          )}
        </span>

        <h3 class="who-card-title">{r.title}</h3>
        <p class="who-card-desc">{r.desc}</p>

        <span class="who-divider" aria-hidden="true"></span>

        <span class="who-cta">
          <span class="who-cta-icon" aria-hidden="true">
            {r.ctaIcon === 'chart' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18" /><path d="m7 14 3-3 3 3 5-6" /></svg>
            )}
            {r.ctaIcon === 'heart' && (
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.7-10-9.3C.6 8.7 2 5 5.5 5c2 0 3.4 1.2 4.5 2.6C11.1 6.2 12.5 5 14.5 5 18 5 19.4 8.7 22 11.7 19.5 16.3 12 21 12 21z" /></svg>
            )}
            {r.ctaIcon === 'people' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
            )}
            {r.ctaIcon === 'badge' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="m8.5 12 2.5 2.5 4.5-5" /></svg>
            )}
          </span>
          {r.cta}
        </span>
      </article>
    ))}
  </div>
</section>

<style>
  .who-section {
    padding-top: 96px;
    scroll-margin-top: 80px;
  }
  .who-head {
    margin-bottom: 48px;
    text-align: center;
  }
  .who-eyebrow {
    display: inline-flex;
    align-items: center;
    margin-bottom: 20px;
    padding: 7px 16px;
    border-radius: var(--radius-pill);
    background: var(--color-link-bg-soft);
    color: var(--color-link-deep);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .who-title {
    font-size: clamp(30px, 4vw, 44px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -1.4px;
    color: var(--color-ink);
  }
  /* Injected via set:html, so it carries no scope hash → target with :global. */
  .who-title :global(.who-title__accent) {
    color: var(--color-link);
  }
  .who-subtitle {
    margin: 16px auto 0;
    max-width: 640px;
    font-size: 16px;
    line-height: 26px;
    color: var(--color-body);
  }

  .who-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }
  @media (min-width: 640px) {
    .who-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .who-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .who-card {
    /* Accent custom props set per-modifier below. */
    --accent: var(--color-link);
    --accent-soft: var(--color-link-bg-soft);
    display: flex;
    flex-direction: column;
    padding: 28px 24px;
    border-radius: var(--radius-xl);
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    box-shadow: var(--shadow-e1);
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .who-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-e3);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--color-hairline));
  }

  .who-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    margin-bottom: 20px;
    background: var(--accent-soft);
    color: var(--accent);
    transition: transform 0.18s ease;
  }
  .who-card:hover .who-icon {
    transform: scale(1.06);
  }
  .who-icon svg {
    width: 26px;
    height: 26px;
  }
  .who-card-title {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.3px;
    color: var(--color-ink);
    margin-bottom: 10px;
  }
  .who-card-desc {
    font-size: 15px;
    line-height: 24px;
    color: var(--color-body);
  }
  .who-divider {
    height: 1px;
    width: 100%;
    margin: 20px 0 16px;
    background: var(--color-hairline);
    /* Push the CTA to the bottom so cards with shorter copy still align. */
    margin-top: auto;
  }
  .who-cta {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: 8px;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: -0.2px;
    transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }
  .who-cta-icon {
    display: inline-flex;
  }
  .who-cta-icon svg {
    width: 16px;
    height: 16px;
  }
  .who-card:hover .who-cta {
    background: var(--accent);
    color: #ffffff;
    transform: translateX(3px);
  }

  /* Per-accent palettes (light) — same hues the section used before. */
  .who-card--blue     { --accent: #0a66c2; --accent-soft: #e8f2ff; }
  .who-card--purple   { --accent: #9333ea; --accent-soft: #f4e8ff; }
  .who-card--darkblue { --accent: #2563eb; --accent-soft: #eaf0f6; }
  .who-card--green    { --accent: #16a34a; --accent-soft: #e8f8f0; }

  /* Dark theme — lift the tints + colors for contrast. */
  :global(html[data-theme='dark']) .who-card--blue     { --accent: #60a5fa; --accent-soft: rgba(10, 102, 194, 0.2); }
  :global(html[data-theme='dark']) .who-card--purple   { --accent: #c084fc; --accent-soft: rgba(147, 51, 234, 0.2); }
  :global(html[data-theme='dark']) .who-card--darkblue { --accent: #60a5fa; --accent-soft: rgba(37, 99, 235, 0.2); }
  :global(html[data-theme='dark']) .who-card--green    { --accent: #4ade80; --accent-soft: rgba(22, 163, 74, 0.2); }
  :global(html[data-theme='dark']) .who-card:hover .who-cta {
    color: var(--color-canvas);
  }

  @media (prefers-reduced-motion: reduce) {
    .who-card,
    .who-icon,
    .who-cta {
      transition: background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
    }
    .who-card:hover {
      transform: none;
    }
    .who-card:hover .who-icon,
    .who-card:hover .who-cta {
      transform: none;
    }
  }
</style>
