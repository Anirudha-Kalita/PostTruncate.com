---
// Shared body for the Contact page, used by BOTH contact routes:
//   • /[lang]/contact/            (src/pages/[lang]/contact.astro)
//   • /[lang]/<slug>/contact/     (src/pages/[lang]/[slug]/contact.astro — the
//                                  slug-prefixed route the nav links to)
// Keeping the markup here means the two routes can never drift.
import { getTranslations } from "../i18n";
import { interp } from "../i18n/interp";
import { getLocale } from "../i18n/config";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const t = getTranslations(lang);
const page = t.pages.contact;

// ── Contact address + form endpoint ─────────────────────────────────────────
const CONTACT_EMAIL = "contact@posttruncate.com";
const CONTACT_FORM_ID = "xpqezyng"; // Formspree form ID
const formAction = `https://formspree.io/f/${CONTACT_FORM_ID}`;

const altBody = interp(page.altBody, { email: CONTACT_EMAIL });
const home = `/${lang}/${getLocale(lang).slug}/`;

// Per-field icon (violet chip) for the form.
const ICONS = {
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  doc: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>',
  chat: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
};
---

<section class="ct container-page">
  <div class="ct__inner">
    {/* ── Hero ────────────────────────────────────────────────────────── */}
    <header class="ct-hero">
      <div class="ct-hero__copy">
        <span class="ct-hero__eyebrow">
          <svg
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.9"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            ><path
              d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"
            ></path></svg
          >
          {page.eyebrow}
        </span>
        <h1 class="ct-hero__title">{page.title}</h1>
        <p class="ct-hero__intro">{page.intro}</p>
      </div>

      <div class="ct-hero__art" aria-hidden="true">
        <svg
          viewBox="0 0 240 200"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          role="presentation"
        >
          <defs>
            <linearGradient id="ce-body" x1="0.5" y1="0" x2="0.5" y2="1">
              <stop offset="0" stop-color="#ffffff"></stop>
              <stop offset="1" stop-color="#eceef6"></stop>
            </linearGradient>
            <linearGradient id="ce-flap" x1="0.5" y1="0" x2="0.5" y2="1">
              <stop offset="0" stop-color="#f4f5fb"></stop>
              <stop offset="1" stop-color="#e4e7f2"></stop>
            </linearGradient>
            <linearGradient id="ce-btn" x1="0.2" y1="0" x2="0.8" y2="1">
              <stop offset="0" stop-color="#8464f2"></stop>
              <stop offset="1" stop-color="#5b34c9"></stop>
            </linearGradient>
            <linearGradient id="ce-bg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#cbbaf7"></stop>
              <stop offset="1" stop-color="#b096f0"></stop>
            </linearGradient>
          </defs>

          <rect
            x="60"
            y="34"
            width="128"
            height="120"
            rx="22"
            fill="url(#ce-bg)"
            opacity="0.45"
            transform="rotate(-9 124 94)"></rect>

          <g transform="rotate(-4 130 106)">
            <rect x="98" y="44" width="84" height="52" rx="5" fill="#ffffff"
            ></rect>
            <rect x="106" y="55" width="50" height="4" rx="2" fill="#dde1ee"
            ></rect>
            <rect x="106" y="64" width="64" height="4" rx="2" fill="#e8ebf4"
            ></rect>
            <rect x="106" y="73" width="38" height="4" rx="2" fill="#e8ebf4"
            ></rect>

            <rect
              x="78"
              y="76"
              width="122"
              height="82"
              rx="13"
              fill="url(#ce-body)"></rect>
            <path
              d="M80 82 138 122 198 82 198 90 138 130 78 90 78 82z"
              fill="url(#ce-flap)"></path>
            <path
              d="M80 82 138 122 196 82"
              stroke="#d3d8e8"
              stroke-width="2.5"
              fill="none"
              stroke-linejoin="round"></path>
          </g>

          <circle cx="192" cy="150" r="26" fill="url(#ce-btn)"></circle>
          <path d="M204 140 181 149 191 151 193 160 197 153z" fill="#ffffff"
          ></path>

          <path
            d="M212 154c24-2 28-24 12-30-10-4-6 12 4 10"
            stroke="#b59bf1"
            stroke-width="2"
            stroke-dasharray="2.5 4.5"
            fill="none"
            stroke-linecap="round"></path>

          <circle cx="196" cy="38" r="5" fill="#2fb0f0"></circle>
          <circle cx="60" cy="66" r="4" fill="#a68af8"></circle>
          <circle cx="66" cy="150" r="4" fill="#3bb0f5"></circle>
          <circle cx="216" cy="92" r="3.5" fill="#a68af8"></circle>
          <path
            d="M50 96l1.4 3.6 3.6 1.4-3.6 1.4-1.4 3.6-1.4-3.6-3.6-1.4 3.6-1.4z"
            fill="#c6b8f6"></path>
          <path
            d="M182 178l1.2 3 3 1.2-3 1.2-1.2 3-1.2-3-3-1.2 3-1.2z"
            fill="#c6b8f6"></path>
        </svg>
      </div>
    </header>

    {/* ── Form ────────────────────────────────────────────────────────── */}
    <form
      class="ct-form contact__form"
      action={formAction}
      method="POST"
      data-sending={page.form.sending}
      data-success={page.form.success}
      data-error={page.form.error}
    >
      <div class="ct-field">
        <span class="ct-field__icon" aria-hidden="true"
          ><svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={ICONS.user}
          /></span
        >
        <div class="ct-field__main">
          <label class="ct-field__label" for="name">{page.form.name}</label>
          <input
            class="ct-field__input"
            id="name"
            name="name"
            type="text"
            autocomplete="name"
            required
          />
        </div>
      </div>

      <div class="ct-field">
        <span class="ct-field__icon" aria-hidden="true"
          ><svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={ICONS.mail}
          /></span
        >
        <div class="ct-field__main">
          <label class="ct-field__label" for="email">{page.form.email}</label>
          <input
            class="ct-field__input"
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
          />
        </div>
      </div>

      <div class="ct-field">
        <span class="ct-field__icon" aria-hidden="true"
          ><svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={ICONS.doc}
          /></span
        >
        <div class="ct-field__main">
          <label class="ct-field__label" for="subject"
            >{page.form.subject}</label
          >
          <input
            class="ct-field__input"
            id="subject"
            name="subject"
            type="text"
            required
          />
        </div>
      </div>

      <div class="ct-field ct-field--message">
        <span class="ct-field__icon" aria-hidden="true"
          ><svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            set:html={ICONS.chat}
          /></span
        >
        <div class="ct-field__main">
          <label class="ct-field__label" for="message"
            >{page.form.message}</label
          >
          <textarea
            class="ct-field__input ct-field__textarea"
            id="message"
            name="message"
            rows="6"
            required></textarea>
        </div>
      </div>

      <button type="submit" class="ct-submit contact__submit">
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          ><path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"></path></svg
        >
        <span class="contact__submit-label">{page.form.submit}</span>
      </button>

      <p
        class="ct-status contact__status"
        role="status"
        aria-live="polite"
        hidden
      >
      </p>
    </form>

    {/* ── Email fallback ──────────────────────────────────────────────── */}
    <aside class="ct-alt">
      <span class="ct-alt__icon" aria-hidden="true"
        ><svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          set:html={ICONS.mail}
        /></span
      >
      <div class="ct-alt__text">
        <h2 class="ct-alt__heading">{page.altHeading}</h2>
        <p class="ct-alt__body">
          <Fragment
            set:html={altBody.replace(
              CONTACT_EMAIL,
              `<a href="mailto:${CONTACT_EMAIL}">${CONTACT_EMAIL}</a>`,
            )}
          />
        </p>
      </div>
    </aside>

    <a class="ct-back" href={`${home}#workspace`}>{t.pages.common.backHome}</a>
  </div>
</section>

<script>
  // Progressive enhancement: the form is a real POST and works with JS off.
  // With JS, submit over fetch so we can show inline success/error without a
  // full page nav. Localized status copy comes from the form's data-* attrs.
  const form = document.querySelector<HTMLFormElement>(".contact__form");
  const status =
    document.querySelector<HTMLParagraphElement>(".contact__status");
  const submit = document.querySelector<HTMLButtonElement>(".contact__submit");
  const submitLabel = document.querySelector<HTMLSpanElement>(
    ".contact__submit-label",
  );

  if (form && status && submit && submitLabel) {
    const SENDING = form.dataset.sending ?? "Sending…";
    const SUCCESS =
      form.dataset.success ?? "Thanks — your message is on its way.";
    const ERROR =
      form.dataset.error ?? "Something went wrong. Please try again.";
    const restLabel = submitLabel.textContent ?? "";

    const showStatus = (text: string, ok: boolean) => {
      status.textContent = text;
      status.hidden = false;
      status.classList.toggle("contact__status--ok", ok);
      status.classList.toggle("contact__status--err", !ok);
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      submit.disabled = true;
      submitLabel.textContent = SENDING;
      status.hidden = true;

      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (res.ok) {
          form.reset();
          showStatus(SUCCESS, true);
        } else {
          showStatus(ERROR, false);
        }
      } catch {
        showStatus(ERROR, false);
      } finally {
        submit.disabled = false;
        submitLabel.textContent = restLabel;
      }
    });
  }
</script>

<style>
  .ct {
    scroll-margin-top: 80px;
    padding-top: 44px;
    padding-bottom: 96px;
  }
  .ct__inner {
    max-width: 60rem;
    margin-inline: auto;
  }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .ct-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    align-items: center;
    margin-bottom: 44px;
  }
  .ct-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 14px;
    border-radius: var(--radius-pill);
    background: var(--color-violet-soft);
    color: var(--color-violet-deep);
    font-size: 13px;
    font-weight: 600;
  }
  .ct-hero__title {
    margin-top: 18px;
    font-size: clamp(34px, 5.4vw, 50px);
    font-weight: 700;
    line-height: 1.03;
    letter-spacing: -1.8px;
    color: var(--color-ink);
  }
  .ct-hero__intro {
    margin-top: 14px;
    max-width: 32rem;
    font-size: 17px;
    line-height: 27px;
    color: var(--color-body);
  }
  .ct-hero__art {
    display: none;
    justify-self: end;
    width: 100%;
    max-width: 320px;
  }
  .ct-hero__art svg {
    width: 100%;
    height: auto;
  }

  /* ── Form ─────────────────────────────────────────────────────────────── */
  .ct-form {
    display: grid;
    gap: 22px;
    padding: 32px;
    border-radius: var(--radius-xl);
    background: var(--color-canvas);
    box-shadow: var(--shadow-e2);
    border: 1px solid var(--color-hairline);
  }
  .ct-field {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  .ct-field__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    margin-top: 22px;
    border-radius: 50%;
    background: var(--color-violet-soft);
    color: var(--color-violet-deep);
  }
  .ct-field--message .ct-field__icon {
    margin-top: 26px;
  }
  .ct-field__icon svg {
    width: 21px;
    height: 21px;
  }
  .ct-field__main {
    flex: 1;
    min-width: 0;
    display: grid;
    gap: 8px;
  }
  .ct-field__label {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.2px;
    color: var(--color-ink);
  }
  .ct-field__input {
    width: 100%;
    padding: 13px 15px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    color: var(--color-ink);
    font-size: 15px;
    line-height: 22px;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  .ct-field__input::placeholder {
    color: var(--color-mute);
  }
  .ct-field__input:focus {
    outline: none;
    border-color: var(--color-violet);
    box-shadow: 0 0 0 3px
      color-mix(in srgb, var(--color-violet) 16%, transparent);
  }
  .ct-field__textarea {
    resize: vertical;
    min-height: 130px;
    font-family: inherit;
  }

  .ct-submit {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 46px;
    margin-left: 60px;
    padding: 0 24px;
    border: none;
    border-radius: var(--radius-pill);
    background: var(--color-violet);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition:
      transform 100ms ease,
      opacity 0.15s ease;
  }
  .ct-submit:hover {
    opacity: 0.92;
  }
  .ct-submit:active:not(:disabled) {
    transform: scale(0.97);
  }
  .ct-submit:disabled {
    opacity: 0.6;
    cursor: default;
  }

  .ct-status {
    margin: 0 0 0 60px;
    font-size: 14px;
    line-height: 20px;
  }
  .contact__status--ok {
    color: var(--color-ink);
  }
  .contact__status--err {
    color: #dc2626;
  }

  /* ── Email fallback ───────────────────────────────────────────────────── */
  .ct-alt {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 36px;
    padding: 24px 28px;
    border-radius: var(--radius-xl);
    background: color-mix(
      in srgb,
      var(--color-violet) 7%,
      var(--color-canvas-soft)
    );
  }
  .ct-alt__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--color-canvas);
    box-shadow: var(--shadow-e2);
    color: var(--color-violet-deep);
  }
  .ct-alt__icon svg {
    width: 24px;
    height: 24px;
  }
  .ct-alt__heading {
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.4px;
    color: var(--color-ink);
  }
  .ct-alt__body {
    margin-top: 6px;
    font-size: 15px;
    line-height: 23px;
    color: var(--color-body);
  }
  .ct-alt__body :global(a) {
    color: var(--color-violet-deep);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .ct-back {
    display: inline-block;
    margin-top: 32px;
    padding-top: 24px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-body);
    border-top: 1px solid var(--color-hairline);
    transition: color 0.15s ease;
  }
  .ct-back:hover {
    color: var(--color-ink);
  }

  @media (min-width: 900px) {
    .ct-hero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 40px;
    }
    .ct-hero__art {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .ct {
      padding-top: 28px;
    }
    .ct-form {
      padding: 22px 18px;
    }
    .ct-field__icon {
      display: none;
    }
    .ct-submit,
    .ct-status {
      margin-left: 0;
    }
  }
</style>
