---
// Two-column marketing hero for the standalone X / Twitter character-counter
// page. Left: headline (with the "280" figure accented) + lede + on-this-page
// pills. Right: a decorative X-logo tile with floating stat cards. Shared across
// all 10 locales — every locale's title string contains the literal "280", so
// the accent split works language-agnostically. The right-hand illustration is
// purely decorative (aria-hidden) and keeps its stylised English micro-labels
// to match the brand mock across locales.
import type { SectionAnchor } from '../lib/headingAnchors';

interface Props {
  title: string;
  intro: string;
  sections: SectionAnchor[];
  onThisPageLabel: string;
}

const { title, intro, sections, onThisPageLabel } = Astro.props;

// Split the localized title on the universal "280" figure so it can be tinted.
const titleParts = title.split('280');

// Section navigation icons matching ICON_SETS.twitter in ToolSectionCards.astro
const ICONS = [
  '<path d="M12 13a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/><path d="M13.4 11 17 7"/><path d="M4.6 17a9 9 0 1 1 14.8 0"/>',
  '<path d="M9 17H7A5 5 0 0 1 7 7h2M15 7h2a5 5 0 0 1 0 10h-2M8 12h8"/>',
  '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z"/>',
  '<path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h16.9a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01"/>',
  '<path d="M12 2 2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>',
];
---

<header class="thero">
  <div class="thero__copy">
    <span class="thero__eyebrow">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.451-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"></path>
      </svg>
      X tool
    </span>

    <h1 class="thero__title">
      {titleParts.map((part, i) => (
        <>
          {part}
          {i < titleParts.length - 1 && <span class="thero__accent">280</span>}
        </>
      ))}
    </h1>
    {intro && <p class="thero__lede">{intro}</p>}
    
    {/* Jump navigation: mobile dropdown / desktop pills */}
    {sections.length > 0 && (
      <nav class="thero__jump" aria-label={onThisPageLabel}>
        {/* Mobile dropdown */}
        <details class="thero__mobile-nav">
          <summary class="thero__mobile-toggle">
            <span class="thero__mobile-label">{onThisPageLabel}</span>
            <svg class="thero__mobile-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <ul class="thero__mobile-list">
            {sections.map((section) => (
              <li>
                <a class="thero__mobile-link" href={`#${section.id}`}>{section.label}</a>
              </li>
            ))}
          </ul>
        </details>

        {/* Desktop pills row */}
        <div class="thero__desktop-nav">
          <span class="thero__desktop-label">{onThisPageLabel}</span>
          <div class="thero__pills">
            {sections.map((sec, idx) => (
              <a href={`#${sec.id}`} class="thero__pill">
                <span class="thero__pill-icon" set:html={`<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">${ICONS[idx % ICONS.length]}</svg>`} />
                <span>{sec.label}</span>
              </a>
            ))}
          </div>
        </div>
      </nav>
    )}
  </div>

  <div class="thero__art" aria-hidden="true">
    <div class="thero__glow"></div>

    <div class="thero__logo">
      <svg viewBox="0 0 24 24" width="112" height="112" role="presentation">
        <path
          fill="#fff"
          d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.746l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.451-6.231zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"
        ></path>
      </svg>
    </div>

    <div class="thero__card thero__card--count">
      <span class="thero__card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="6" cy="6" r="3"></circle>
          <circle cx="6" cy="18" r="3"></circle>
          <line x1="20" y1="4" x2="8.12" y2="15.88"></line>
          <line x1="14.47" y1="14.48" x2="20" y2="20"></line>
          <line x1="8.12" y1="8.12" x2="12" y2="12"></line>
        </svg>
      </span>
      <span class="thero__count-num">280</span>
      <span class="thero__count-label">Characters</span>
    </div>

    <div class="thero__card thero__card--heart">
      <svg viewBox="0 0 24 24" fill="currentColor" width="26" height="26">
        <path d="M12 21s-8-4.5-8-10a4 4 0 0 1 8-1 4 4 0 0 1 8 1c0 5.5-8 10-8 10z"></path>
      </svg>
    </div>

    <div class="thero__card thero__card--thread">
      <span class="thero__thread-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="6" cy="6" r="3"></circle>
          <circle cx="6" cy="18" r="3"></circle>
          <line x1="20" y1="4" x2="8.12" y2="15.88"></line>
          <line x1="14.47" y1="14.48" x2="20" y2="20"></line>
          <line x1="8.12" y1="8.12" x2="12" y2="12"></line>
        </svg>
      </span>
      <span class="thero__thread-text">Thread<br />Splitter</span>
    </div>
  </div>
</header>

<style>
  .thero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 40px;
  }

  /* ── Left column: copy ──────────────────────────────────────────────── */
  .thero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-link-bg-soft);
    color: var(--color-link);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .thero__title {
    font-size: clamp(30px, 5vw, 46px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -1.8px;
    color: var(--color-ink);
    }

  .thero__accent {
    color: var(--color-link);
  }

  .thero__lede {
    margin-top: 18px;
    max-width: 34rem;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }

  /* ── Jump menu: responsive mobile / desktop ──────────────────────────── */
  .thero__jump {
    margin-top: 24px;
  }

  .thero__mobile-nav {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
  }

  .thero__mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .thero__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .thero__mobile-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .thero__mobile-chevron {
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.15s ease;
  }

  .thero__mobile-nav[open] .thero__mobile-chevron {
    transform: rotate(180deg);
  }

  .thero__mobile-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0 8px 8px;
    list-style: none;
    border-top: 1px solid var(--color-hairline);
  }

  .thero__mobile-link {
    display: block;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .thero__mobile-link:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }

  .thero__desktop-nav {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .thero__desktop-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .thero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .thero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-body);
    transition: all 0.15s ease;
  }

  .thero__pill:hover {
    border-color: var(--color-link);
    color: var(--color-link);
    box-shadow: var(--shadow-e1);
  }

  .thero__pill-icon {
    display: inline-flex;
    align-items: center;
    color: var(--color-link);
  }

  @media (min-width: 640px) {
    .thero__mobile-nav {
      display: none;
    }
    .thero__desktop-nav {
      display: flex;
    }
  }

  /* ── Right column: decorative illustration ──────────────────────────── */
  .thero__art {
    position: relative;
    display: none;
    aspect-ratio: 5 / 4;
    max-width: 460px;
    margin-inline: auto;
    width: 100%;
  }

  .thero__glow {
    position: absolute;
    inset: 8% 4%;
    border-radius: 50%;
    background: radial-gradient(
      circle at 60% 45%,
      var(--color-link-bg-soft) 0%,
      color-mix(in srgb, var(--color-link-bg-soft) 40%, transparent) 45%,
      transparent 72%
    );
  }

  /* Black brand tile with the white X mark — 3D depth via gradient lighting,
     stacked shadows and inset highlights. Kept branded in both themes. */
  .thero__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-38%, -50%) rotate(-4deg);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 46%;
    aspect-ratio: 1;
    border-radius: var(--radius-xl);
    background: linear-gradient(158deg, #2c2c2c 0%, #050505 62%);
    box-shadow:
      0 3px 4px rgba(0, 0, 0, 0.4),
      0 12px 22px -6px rgba(0, 0, 0, 0.5),
      0 32px 50px -14px rgba(0, 0, 0, 0.45),
      inset 0 3px 6px rgba(255, 255, 255, 0.16),
      inset 0 -8px 14px rgba(0, 0, 0, 0.6);
  }

  .thero__logo svg {
    width: 52%;
    height: 52%;
    filter: drop-shadow(0 3px 4px rgba(0, 0, 0, 0.55));
  }

  /* Floating cards share a soft elevated surface that adapts to dark mode. */
  .thero__card {
    position: absolute;
    border-radius: var(--radius-lg);
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
  }

  .thero__card--count {
    top: 10%;
    left: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 14px 18px;
    border-radius: var(--radius-xl);
    background: var(--color-success);
    color: #fff;
    box-shadow: 0 18px 34px -12px color-mix(in srgb, var(--color-success) 55%, transparent),
      var(--shadow-e2);
  }

  .thero__card-icon {
    display: inline-flex;
    opacity: 0.9;
  }
  .thero__card-icon svg {
    width: 16px;
    height: 16px;
  }

  .thero__count-num {
    font-size: 30px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -1px;
  }

  .thero__count-label {
    font-size: 12px;
    font-weight: 500;
    opacity: 0.92;
  }

  .thero__card--heart {
    bottom: 8%;
    left: 12%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    color: var(--color-link);
  }

  .thero__card--thread {
    right: 0;
    bottom: 20%;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    color: var(--color-ink);
  }

  .thero__thread-icon {
    display: inline-flex;
    color: var(--color-link);
  }
  .thero__thread-icon svg {
    width: 22px;
    height: 22px;
  }

  .thero__thread-text {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.3px;
    color: var(--color-ink);
  }

  /* ── Responsive: two columns + illustration only on wider viewports ──── */
  @media (min-width: 900px) {
    .thero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
      margin-bottom: 48px;
    }

    .thero__art {
      display: block;
    }
  }
</style>
