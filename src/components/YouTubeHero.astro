---
// Two-column marketing hero for the YouTube character-counter page. Left: a red
// eyebrow badge, headline (with the phrase after the em-dash in a red gradient)
// + lede + on-this-page pills. Right: a YouTube video-card mockup with the logo,
// skeleton copy and a red progress bar, plus floating "Aa" (title) and analytics
// badges over dotted-grid + soft-red decoration.
//
// The accent is everything after the "—" so it stays language-agnostic across
// all 10 locales. The illustration is decorative (aria-hidden).
import type { SectionAnchor } from '../lib/headingAnchors';

interface Props {
  title: string;
  intro: string;
  sections: SectionAnchor[];
  onThisPageLabel: string;
}

const { title, intro, sections, onThisPageLabel } = Astro.props;

const dashIndex = title.indexOf('—');
const titleHead = dashIndex >= 0 ? title.slice(0, dashIndex + 1) : title;
const titleTail = dashIndex >= 0 ? title.slice(dashIndex + 1).trim() : '';

// Section navigation icons matching ICON_SETS.youtube in ToolSectionCards.astro
const ICONS = [
  '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>',
  '<path d="M12 3l2.6 6.3 6.8.5-5.2 4.4 1.6 6.6L12 17.8 6.2 21.3l1.6-6.6L2.6 9.8l6.8-.5z"/>',
  '<path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9z"/><circle cx="7.5" cy="7.5" r="1.2"/>',
  '<path d="M12 3l8 3v5c0 5-3.5 8-8 10-4.5-2-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/>',
];
---

<header class="ythero">
  <div class="ythero__copy">
    <span class="ythero__eyebrow">
      <svg viewBox="0 0 24 18" width="16" height="12" aria-hidden="true">
        <rect width="24" height="18" rx="5" fill="currentColor"></rect>
        <path d="M10 5.5 15.5 9 10 12.5z" fill="#fff"></path>
      </svg>
      YouTube tool
    </span>

    <h1 class="ythero__title">
      <span>{titleHead}</span>
      {titleTail && <><br /><span class="ythero__accent">{titleTail}</span></>}
    </h1>
    {intro && <p class="ythero__lede">{intro}</p>}
    {/* Jump navigation: mobile dropdown / desktop pills */}
    {sections.length > 0 && (
      <nav class="ythero__jump" aria-label={onThisPageLabel}>
        {/* Mobile dropdown */}
        <details class="ythero__mobile-nav">
          <summary class="ythero__mobile-toggle">
            <span class="ythero__mobile-label">{onThisPageLabel}</span>
            <svg class="ythero__mobile-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <ul class="ythero__mobile-list">
            {sections.map((section) => (
              <li>
                <a class="ythero__mobile-link" href={`#${section.id}`}>{section.label}</a>
              </li>
            ))}
          </ul>
        </details>

        {/* Desktop pills row */}
        <div class="ythero__desktop-nav">
          <span class="ythero__desktop-label">{onThisPageLabel}</span>
          <div class="ythero__pills">
            {sections.map((sec, idx) => (
              <a href={`#${sec.id}`} class="ythero__pill">
                <span class="ythero__pill-icon" set:html={`<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">${ICONS[idx % ICONS.length]}</svg>`} />
                <span>{sec.label}</span>
              </a>
            ))}
          </div>
        </div>
      </nav>
    )}
  </div>

  <div class="ythero__art" aria-hidden="true">
    <span class="ythero__blob ythero__blob--1"></span>
    <span class="ythero__blob ythero__blob--2"></span>
    <span class="ythero__dots"></span>

    <div class="ythero__card">
      <div class="ythero__chrome">
        <i></i><i></i><i></i>
      </div>
      <div class="ythero__inner">
        <div class="ythero__thumb">
          <span class="ythero__logo">
            <svg width="28" height="20" viewBox="0 0 28 20" class="ythero__play" aria-hidden="true">
              <rect width="28" height="20" rx="5" fill="#FF0000"></rect>
              <path d="M11 5.5 19 10l-8 4.5z" fill="#fff"></path>
            </svg>
            <span class="ythero__word">YouTube</span>
          </span>
        </div>
        <div class="ythero__lines">
          <span></span>
          <span></span>
        </div>
        <div class="ythero__progress"><i></i></div>
      </div>
    </div>

    <span class="ythero__badge ythero__badge--aa">Aa</span>
    <span class="ythero__badge ythero__badge--chart">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 21h18"></path><path d="M7 21v-6M12 21V9M17 21v-9"></path>
      </svg>
    </span>
  </div>
</header>

<style>
  .ythero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: start;
    margin-bottom: 40px;
  }

  /* ── Left column: copy (YouTube red) ────────────────────────────────── */
  .ythero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, #ff0000 12%, transparent);
    color: #d10000;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ythero__title {
    font-size: clamp(30px, 5vw, 46px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -1.8px;
    color: var(--color-ink);
    }

  .ythero__accent {
    background: linear-gradient(96deg, #ff0000 0%, #ff4e6a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .ythero__lede {
    margin-top: 18px;
    max-width: 34rem;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }

  /* ── Jump menu: responsive mobile / desktop ──────────────────────────── */
  .ythero__jump {
    margin-top: 24px;
  }

  .ythero__mobile-nav {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
  }

  .ythero__mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .ythero__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .ythero__mobile-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .ythero__mobile-chevron {
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.15s ease;
  }

  .ythero__mobile-nav[open] .ythero__mobile-chevron {
    transform: rotate(180deg);
  }

  .ythero__mobile-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0 8px 8px;
    list-style: none;
    border-top: 1px solid var(--color-hairline);
  }

  .ythero__mobile-link {
    display: block;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .ythero__mobile-link:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }

  .ythero__desktop-nav {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .ythero__desktop-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .ythero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .ythero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-body);
    transition: all 0.15s ease;
  }

  .ythero__pill:hover {
    border-color: #ff0000;
    color: #d10000;
    box-shadow: var(--shadow-e1);
  }

  .ythero__pill-icon {
    display: inline-flex;
    align-items: center;
    color: #e00000;
  }

  @media (min-width: 640px) {
    .ythero__mobile-nav {
      display: none;
    }
    .ythero__desktop-nav {
      display: flex;
    }
  }

  /* ── Right column: YouTube card mockup ──────────────────────────────── */
  .ythero__art {
    position: relative;
    display: none;
    aspect-ratio: 1 / 1;
    max-width: 440px;
    margin-inline: auto;
    width: 100%;
  }

  .ythero__blob {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, #ff0000 16%, transparent), transparent 70%);
  }
  .ythero__blob--1 {
    left: 4%;
    top: 22%;
    width: 26%;
    aspect-ratio: 1;
  }
  .ythero__blob--2 {
    left: 8%;
    bottom: 12%;
    width: 20%;
    aspect-ratio: 1;
    opacity: 0.7;
  }
  .ythero__dots {
    position: absolute;
    right: 6%;
    top: 16%;
    width: 74px;
    height: 60px;
    background-image: radial-gradient(currentColor 1.3px, transparent 1.3px);
    background-size: 11px 11px;
    color: color-mix(in srgb, #ff0000 28%, transparent);
  }

  /* Video card */
  .ythero__card {
    position: absolute;
    top: 50%;
    left: 52%;
    transform: translate(-50%, -50%);
    width: 66%;
    padding: 12px;
    border-radius: 18px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
  }
  .ythero__chrome {
    display: flex;
    gap: 5px;
    padding: 2px 4px 10px;
  }
  .ythero__chrome i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-canvas-soft-2);
  }
  .ythero__inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 12px;
    border-radius: 12px;
    box-shadow: var(--shadow-e2);
  }
  .ythero__thumb {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 8;
    border-radius: 8px;
    background: var(--color-canvas-soft-2);
  }
  .ythero__logo {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .ythero__play {
    width: 34px;
    height: 24px;
    filter: drop-shadow(0 2px 4px rgba(200, 0, 0, 0.28));
  }
  .ythero__word {
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.6px;
    color: var(--color-ink);
  }
  .ythero__lines {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .ythero__lines span {
    height: 7px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas-soft-2);
  }
  .ythero__lines span:first-child {
    width: 88%;
  }
  .ythero__lines span:last-child {
    width: 62%;
  }
  .ythero__progress {
    height: 8px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas-soft-2);
    overflow: hidden;
  }
  .ythero__progress i {
    display: block;
    width: 58%;
    height: 100%;
    border-radius: var(--radius-pill);
    background: #ff0000;
  }

  /* Floating badges */
  .ythero__badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius-lg);
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
    color: #e00000;
  }
  .ythero__badge svg {
    width: 24px;
    height: 24px;
  }
  .ythero__badge--aa {
    right: 2%;
    top: 22%;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.5px;
  }
  .ythero__badge--chart {
    right: 6%;
    bottom: 16%;
  }

  /* ── Responsive: two columns + illustration only on wider viewports ──── */
  @media (min-width: 900px) {
    .ythero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
      margin-bottom: 48px;
    }

    .ythero__art {
      display: block;
    }
  }
</style>
