---
// Two-column marketing hero for the standalone Threads character-counter page.
// Left: an eyebrow badge, headline (with the "500" figure accented) + lede +
// on-this-page pills. Right: a gradient Threads-logo tile on dashed orbit rings
// with floating stat cards. Shared across all 10 locales — every locale's title
// string contains the literal "500", so the accent split is language-agnostic.
// The right-hand illustration is decorative (aria-hidden) and keeps its stylised
// English micro-labels to match the brand mock across locales.
import OnThisPage from './OnThisPage.astro';
import type { SectionAnchor } from '../lib/headingAnchors';

interface Props {
  title: string;
  intro: string;
  sections: SectionAnchor[];
  onThisPageLabel: string;
}

const { title, intro, sections, onThisPageLabel } = Astro.props;

// Split the localized title on the universal "500" figure so it can be tinted.
const titleParts = title.split('500');

const THREADS_GLYPH =
  'M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.291 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.781 3.631 2.695 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.36-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.32.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.235-11.587c-.336 0-.679.01-1.024.029-1.838.103-2.978.95-2.913 2.122.063 1.235 1.435 1.81 2.756 1.737 1.211-.066 2.79-.534 3.058-3.71-.59-.124-1.215-.181-1.876-.181Z';
---

<header class="thero">
  <div class="thero__copy">
    <span class="thero__eyebrow">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true">
        <path d={THREADS_GLYPH}></path>
      </svg>
      Threads tool
    </span>

    <h1 class="thero__title">
      {titleParts.map((part, i) => (
        <>
          {part}
          {i < titleParts.length - 1 && <span class="thero__accent">500</span>}
        </>
      ))}
    </h1>
    {intro && <p class="thero__lede">{intro}</p>}
    <OnThisPage label={onThisPageLabel} sections={sections} />
  </div>

  <div class="thero__art" aria-hidden="true">
    <svg class="thero__orbits" viewBox="0 0 100 100" fill="none" preserveAspectRatio="xMidYMid meet">
      <circle class="thero__ring" cx="50" cy="50" r="46" stroke-width="0.5" stroke-dasharray="2 3" />
      <circle class="thero__ring" cx="50" cy="50" r="34" stroke-width="0.5" stroke-dasharray="2 3" />
    </svg>

    <div class="thero__logo">
      <svg viewBox="0 0 24 24" role="presentation">
        <path fill="#fff" d={THREADS_GLYPH}></path>
      </svg>
    </div>

    <div class="thero__card thero__card--count">
      <span class="thero__count-num">500</span>
      <span class="thero__count-label">Characters</span>
    </div>

    <div class="thero__card thero__card--chain">
      <span class="thero__card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 17H7A5 5 0 0 1 7 7h2M15 7h2a5 5 0 0 1 0 10h-2M8 12h8"></path>
        </svg>
      </span>
      <span class="thero__card-title">Auto-chain</span>
      <span class="thero__card-sub">Long posts</span>
    </div>

    <div class="thero__card thero__card--live">
      <span class="thero__card-icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12h4l3 8 4-16 3 8h4"></path>
        </svg>
      </span>
      <span class="thero__card-title">Live</span>
      <span class="thero__card-sub">Counting</span>
    </div>
  </div>
</header>

<style>
  .thero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 40px;
  }

  /* ── Left column: copy ──────────────────────────────────────────────── */
  .thero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-violet-soft);
    color: var(--color-violet-deep);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .thero__title {
    font-size: clamp(30px, 5vw, 46px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -1.8px;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .thero__accent {
    color: var(--color-link);
  }

  .thero__lede {
    margin-top: 18px;
    max-width: 34rem;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }

  .thero__copy :global(.on-page) {
    margin-top: 24px;
  }

  /* ── Right column: decorative illustration ──────────────────────────── */
  .thero__art {
    position: relative;
    display: none;
    aspect-ratio: 5 / 4;
    max-width: 460px;
    margin-inline: auto;
    width: 100%;
  }

  .thero__orbits {
    position: absolute;
    inset: 4% 0;
    width: 100%;
    height: 92%;
    margin: auto;
  }

  .thero__ring {
    fill: none;
    stroke: var(--color-violet-soft);
  }

  /* Black Threads tile with the white glyph — the platform's real brand colors,
     with 3D depth from gradient lighting, stacked shadows and inset highlights.
     Kept branded (fixed black/white) in both light and dark themes. */
  .thero__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44%;
    aspect-ratio: 1;
    border-radius: 26%;
    background: linear-gradient(158deg, #2b2b2b 0%, #050505 62%);
    box-shadow:
      0 3px 4px rgba(0, 0, 0, 0.4),
      0 12px 22px -6px rgba(0, 0, 0, 0.5),
      0 32px 50px -14px rgba(0, 0, 0, 0.45),
      inset 0 3px 6px rgba(255, 255, 255, 0.16),
      inset 0 -8px 14px rgba(0, 0, 0, 0.6);
  }

  .thero__logo svg {
    width: 56%;
    height: 56%;
    filter: drop-shadow(0 3px 4px rgba(0, 0, 0, 0.55));
  }

  /* Floating cards share a soft elevated surface that adapts to dark mode. */
  .thero__card {
    position: absolute;
    display: flex;
    flex-direction: column;
    padding: 14px 18px;
    border-radius: var(--radius-xl);
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
  }

  .thero__card--count {
    top: 4%;
    right: 0;
    gap: 2px;
  }

  .thero__count-num {
    font-size: 30px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -1px;
    color: var(--color-violet-deep);
  }

  .thero__count-label {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-mute);
  }

  .thero__card--chain {
    top: 40%;
    left: 0;
    gap: 8px;
  }

  .thero__card--live {
    bottom: 6%;
    right: 6%;
    gap: 8px;
  }

  .thero__card-icon {
    display: inline-flex;
    color: var(--color-violet-deep);
  }
  .thero__card-icon svg {
    width: 22px;
    height: 22px;
  }

  .thero__card-title {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: -0.3px;
    color: var(--color-ink);
  }

  .thero__card-sub {
    font-size: 12px;
    font-weight: 500;
    color: var(--color-mute);
  }

  /* ── Responsive: two columns + illustration only on wider viewports ──── */
  @media (min-width: 900px) {
    .thero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
      margin-bottom: 48px;
    }

    .thero__art {
      display: block;
    }
  }
</style>
