---
// Two-column marketing hero for the Byte Counter page. Left: a
// blue eyebrow badge, headline (with the phrase after the em-dash in a blue
// gradient) + lede + on-this-page pills. Right: a document/code mockup illustration
// with a code badge, skeleton lines, a floating hash badge, and a floating binary text card.
//
// The accent is everything after the "—" so it stays language-agnostic across
// all 10 locales. The illustration is decorative (aria-hidden).
import type { SectionAnchor } from '../lib/headingAnchors';

interface Props {
  title: string;
  intro: string;
  sections: SectionAnchor[];
  onThisPageLabel: string;
}

const { title, intro, sections, onThisPageLabel } = Astro.props;

const dashIndex = title.indexOf('—');
const titleHead = dashIndex >= 0 ? title.slice(0, dashIndex + 1) : title;
const titleTail = dashIndex >= 0 ? title.slice(dashIndex + 1).trim() : '';

// Helper to resolve custom icons for each section in the Jump Links list
const getLinkIcon = (id: string) => {
  if (id.includes('why') || id.includes('matter')) {
    // Database disk icon
    return '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path><path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"></path></svg>';
  }
  if (id.includes('character') || id.includes('point')) {
    // Characters breakdown icon
    return '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7V4h16v3M9 20h6M12 4v16"></path></svg>';
  }
  if (id.includes('private') || id.includes('instant')) {
    // Secure shield icon
    return '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>';
  }
  // Code brackets / default bytes count icon
  return '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>';
};
---

<header class="bchero">
  <div class="bchero__copy">
    <span class="bchero__eyebrow">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="16 18 22 12 16 6"></polyline>
        <polyline points="8 6 2 12 8 18"></polyline>
      </svg>
      Developer Tool
    </span>

    <h1 class="bchero__title">
      <span>{titleHead}</span>
      {titleTail && <><br /><span class="bchero__accent">{titleTail}</span></>}
    </h1>
    {intro && <p class="bchero__lede">{intro}</p>}
    
    {/* Jump navigation: mobile dropdown / desktop pills */}
    {sections.length > 0 && (
      <nav class="bchero__jump" aria-label={onThisPageLabel}>
        {/* Mobile dropdown */}
        <details class="bchero__mobile-nav">
          <summary class="bchero__mobile-toggle">
            <span class="bchero__mobile-label">{onThisPageLabel}</span>
            <svg class="bchero__mobile-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <ul class="bchero__mobile-list">
            {sections.map((section) => (
              <li>
                <a class="bchero__mobile-link" href={`#${section.id}`}>{section.label}</a>
              </li>
            ))}
          </ul>
        </details>

        {/* Desktop pills row */}
        <div class="bchero__desktop-nav">
          <span class="bchero__desktop-label">{onThisPageLabel}</span>
          <div class="bchero__pills">
            {sections.map((sec) => (
              <a href={`#${sec.id}`} class="bchero__pill">
                <span class="bchero__pill-icon" set:html={getLinkIcon(sec.id)} />
                <span>{sec.label}</span>
              </a>
            ))}
          </div>
        </div>
      </nav>
    )}
  </div>

  <div class="bchero__art" aria-hidden="true">
    <span class="bchero__blob bchero__blob--1"></span>
    <span class="bchero__blob bchero__blob--2"></span>
    <span class="bchero__dots"></span>

    <!-- Connecting visuals -->
    <span class="bchero__line-connect bchero__line-connect--horizontal"></span>
    <span class="bchero__line-connect bchero__line-connect--vertical"></span>

    <!-- Document mockup card -->
    <div class="bchero__card">
      <div class="bchero__card-inner">
        <!-- Blue code tag tile -->
        <div class="bchero__code-wrap">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polyline points="16 18 22 12 16 6"></polyline>
            <polyline points="8 6 2 12 8 18"></polyline>
          </svg>
        </div>
        <!-- Skeleton lines representing document text -->
        <div class="bchero__lines">
          <span class="bchero__line bchero__line--full"></span>
          <span class="bchero__line bchero__line--long"></span>
          <span class="bchero__line bchero__line--medium"></span>
          <span class="bchero__line bchero__line--full"></span>
          <span class="bchero__line bchero__line--short"></span>
        </div>
      </div>
    </div>

    <!-- Floating Hash Badge (lower left) -->
    <div class="bchero__badge bchero__badge--hash">
      <span class="bchero__hash">#</span>
    </div>

    <!-- Floating Binary Stats Card (right) -->
    <div class="bchero__binary-card">
      <div class="bchero__binary-line">01001001</div>
      <div class="bchero__binary-line">11000021</div>
      <div class="bchero__binary-line">10100010</div>
    </div>
  </div>
</header>

<style>
  .bchero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 40px;
  }

  /* ── Left column copy ────────────────────────────────────────────────── */
  .bchero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, #2563eb 12%, transparent);
    color: #2563eb;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bchero__title {
    font-size: clamp(30px, 5vw, 44px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -1.6px;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .bchero__accent {
    background: linear-gradient(96deg, #2563eb 0%, #4f86f7 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .bchero__lede {
    margin-top: 18px;
    max-width: 35rem;
    font-size: 17px;
    line-height: 27px;
    color: var(--color-body);
  }

  /* ── Jump menu: responsive mobile / desktop ──────────────────────────── */
  .bchero__jump {
    margin-top: 32px;
  }

  .bchero__mobile-nav {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
  }

  .bchero__mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .bchero__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .bchero__mobile-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .bchero__mobile-chevron {
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.15s ease;
  }

  .bchero__mobile-nav[open] .bchero__mobile-chevron {
    transform: rotate(180deg);
  }

  .bchero__mobile-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0 8px 8px;
    list-style: none;
    border-top: 1px solid var(--color-hairline);
  }

  .bchero__mobile-link {
    display: block;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .bchero__mobile-link:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }

  .bchero__desktop-nav {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .bchero__desktop-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .bchero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .bchero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-body);
    transition: all 0.15s ease;
  }

  .bchero__pill:hover {
    border-color: var(--color-link);
    color: var(--color-link);
    box-shadow: var(--shadow-e1);
  }

  .bchero__pill-icon {
    display: inline-flex;
    align-items: center;
    color: var(--color-link);
  }

  @media (min-width: 640px) {
    .bchero__mobile-nav {
      display: none;
    }
    .bchero__desktop-nav {
      display: flex;
    }
  }

  /* ── Right column illustration ───────────────────────────────────────── */
  .bchero__art {
    position: relative;
    display: none;
    aspect-ratio: 1.1 / 1;
    max-width: 460px;
    margin-inline: auto;
    width: 100%;
  }

  .bchero__blob {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, #2563eb 12%, transparent), transparent 70%);
  }
  .bchero__blob--1 {
    left: 2%;
    top: 15%;
    width: 32%;
    aspect-ratio: 1;
  }
  .bchero__blob--2 {
    right: 2%;
    bottom: 10%;
    width: 25%;
    aspect-ratio: 1;
    opacity: 0.6;
  }
  .bchero__dots {
    position: absolute;
    right: 6%;
    top: 5%;
    width: 76px;
    height: 50px;
    background-image: radial-gradient(currentColor 1.3px, transparent 1.3px);
    background-size: 11px 11px;
    color: color-mix(in srgb, #2563eb 22%, transparent);
  }

  /* Connecting guideline lines */
  .bchero__line-connect {
    position: absolute;
    background: color-mix(in srgb, var(--color-link) 15%, transparent);
    z-index: 1;
  }
  .bchero__line-connect--horizontal {
    left: 45%;
    bottom: 25%;
    width: 35%;
    height: 2px;
  }
  .bchero__line-connect--vertical {
    left: 24%;
    bottom: 16%;
    width: 2px;
    height: 18%;
  }

  /* Document card */
  .bchero__card {
    position: absolute;
    top: 50%;
    left: 44%;
    transform: translate(-50%, -50%);
    width: 54%;
    padding: 24px;
    border-radius: 20px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
    z-index: 2;
  }
  .bchero__card-inner {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  /* Blue code tag tile icon */
  .bchero__code-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: color-mix(in srgb, #2563eb 15%, transparent);
    color: #2563eb;
    flex-shrink: 0;
  }

  /* Skeleton text lines */
  .bchero__lines {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .bchero__line {
    height: 7px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas-soft-2);
  }
  .bchero__line--full   { width: 100%; }
  .bchero__line--long   { width: 85%; }
  .bchero__line--medium { width: 68%; }
  .bchero__line--short  { width: 45%; }

  /* Floating badges */
  .bchero__badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-e3);
    z-index: 3;
  }
  .bchero__badge--hash {
    left: 12%;
    bottom: 12%;
    border: 1px solid var(--color-hairline);
    animation: bchero-float 3.8s ease-in-out infinite;
  }
  .bchero__hash {
    font-size: 20px;
    font-weight: 700;
    color: #2563eb;
  }

  /* Floating binary panel */
  .bchero__binary-card {
    position: absolute;
    top: 40%;
    right: 4%;
    padding: 16px 20px;
    border-radius: 18px;
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    box-shadow: var(--shadow-e4);
    z-index: 3;
    animation: bchero-float 4.2s ease-in-out 0.4s infinite;
  }
  
  .bchero__binary-line {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.8;
    color: var(--color-mute);
    letter-spacing: 0.05em;
  }

  /* Floating animation */
  @keyframes bchero-float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-5px); }
  }

  /* ── Responsive breakpoints ─────────────────────────────────────────── */
  @media (min-width: 900px) {
    .bchero {
      grid-template-columns: 1.150fr 0.850fr;
      gap: 48px;
      margin-bottom: 48px;
    }

    .bchero__art {
      display: block;
    }
  }
</style>
