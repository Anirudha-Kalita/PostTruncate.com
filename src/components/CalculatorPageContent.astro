---
// Shared body for the utility/calculator "Tools" pages (/[lang]/tools/<slug>/).
//
// Layout: intro lede → on-this-page jump nav → embedded live calculator (the
// default <slot>) → keyword prose → FAQ accordion → last-updated → CTA back to
// the home editor. Mirrors the standalone platform template's look, but without
// the platform Dashboard or platform cross-promo.
import OnThisPage from './OnThisPage.astro';
import YouTubeHero from './YouTubeHero.astro';
import WhatsAppHero from './WhatsAppHero.astro';
import DiscordHero from './DiscordHero.astro';
import BlueskyHero from './BlueskyHero.astro';
import RedditHero from './RedditHero.astro';
import PinterestHero from './PinterestHero.astro';
import TikTokCounterHero from './TikTokCounterHero.astro';
import WordsPerPageHero from './WordsPerPageHero.astro';
import ReadingTimeHero from './ReadingTimeHero.astro';
import ByteCounterHero from './ByteCounterHero.astro';
import EmojiCounterHero from './EmojiCounterHero.astro';
import SentenceCounterHero from './SentenceCounterHero.astro';
import SmsHero from './SmsHero.astro';
import GoogleSerpHero from './GoogleSerpHero.astro';
import ToolSectionCards from './ToolSectionCards.astro';
import ToolCta from './ToolCta.astro';
import type { ToolDefinition } from '../data/tools';
import { calculators } from '../data/calculators';
import { PLATFORM_COUNTERS } from '../data/platformCounters';
import { DEFAULT_LOCALE } from '../i18n/config';
import { getTranslations } from '../i18n';
import { interp } from '../i18n/interp';
import { buildCanonicalSlugs, prepareToolContent, splitToolSections } from '../lib/headingAnchors';
import { formatLocaleDate } from '../lib/contentDates';

interface Props {
  tool: ToolDefinition;
  lang: string;
  /** Full home editor URL for the closing CTA (e.g. /en/character-counter/#workspace). */
  homeHref: string;
}

const { tool, lang, homeHref } = Astro.props;

const tStr = <T,>(record: Record<string, T>): T => record[lang] ?? record[DEFAULT_LOCALE];
const globalT = getTranslations(lang);

const canonicalSlugs = buildCanonicalSlugs(tool.content[DEFAULT_LOCALE] ?? '');
const { html: bodyHtml, sections } = prepareToolContent(tStr(tool.content), canonicalSlugs);

// The 7 per-platform character counters get the redesigned treatment: prose
// body reframed as hover-active, brand-themed icon cards + the shared CTA card.
const isCounter = !!PLATFORM_COUNTERS[tool.id];
// Words-per-page, Reading-time, Byte-counter, Emoji-counter, Sentence-counter, SMS and Google SERP get the card-body + ToolCta design.
const isWppCards = tool.id === 'words-per-page' || tool.id === 'reading-time' || tool.id === 'byte-counter' || tool.id === 'emoji-counter' || tool.id === 'sentence-counter' || tool.id === 'sms' || tool.id === 'google-serp';
const cardSections = (isCounter || isWppCards) ? splitToolSections(bodyHtml) : [];

// Per-counter brand accent — themes the closing CTA card (and, in future, the
// hero) for each character-counter platform.
const COUNTER_ACCENT: Record<string, string> = {
  youtube: '#ff0000',
  // The TikTok counter page uses a blue accent scheme (per its design), not the
  // TikTok magenta the platform + ad-preview pages use.
  tiktok: '#2f6bfe',
  pinterest: '#e60023',
  reddit: '#ff4500',
  bluesky: '#1185fe',
  discord: '#5865f2',
  whatsapp: '#25d366',
};
const ctaAccent = COUNTER_ACCENT[tool.id];
// Card palette key: TikTok's counter uses a dedicated blue theme so it doesn't
// collide with the shared magenta 'tiktok' key. Google SERP uses the 'google' theme.
const cardTheme = tool.id === 'tiktok' ? 'tiktok-counter' : tool.id === 'google-serp' ? 'google' : tool.id;
// Blue accent for the words-per-page ToolCta card.
const wppAccent = '#2563eb';
const lastUpdatedLine = interp(globalT.toolPage.lastUpdated, {
  date: formatLocaleDate(tool.lastUpdated, lang),
});

const introText = tool.intro?.[lang] ?? tool.intro?.[DEFAULT_LOCALE] ?? '';
const faqItems = tool.faq?.[lang] ?? tool.faq?.[DEFAULT_LOCALE] ?? [];
const cta = globalT.toolPage.cta;

// Cross-promo to a sibling calculator. The blurb is authored per tool; the link
// label + URL are resolved from the related tool's localized schemaName + slug.
const relatedTool = tool.related ? calculators.find((t) => t.id === tool.related!.id) : undefined;
const relatedHref = relatedTool
  ? `/${lang}/tools/${relatedTool.slugs[lang] ?? relatedTool.slugs[DEFAULT_LOCALE]}/`
  : undefined;
const relatedLabel = relatedTool
  ? relatedTool.schemaName[lang] ?? relatedTool.schemaName[DEFAULT_LOCALE]
  : undefined;
const relatedBlurb = tool.related
  ? tool.related.blurb[lang] ?? tool.related.blurb[DEFAULT_LOCALE]
  : undefined;

// Per-tool icon for the crosslink card. SVG path data only (24×24 viewBox,
// currentColor stroke, width 1.8, linecap/linejoin round).
const RELATED_ICON: Record<string, string> = {
  'reading-time': '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>',
  'words-per-page': '<rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 10h8M8 14h6"/><path d="M15 2v4h5"/>',
  'byte-counter': '<path d="M20 11A8 8 0 1 0 4 12"/><path d="M20 11V6h-5M4 12v5h5"/>',
  'sentence-counter': '<path d="M4 6h16M4 12h10M4 18h6"/>',
};
const relatedIconPath = tool.related ? (RELATED_ICON[tool.related.id] ?? '<path d="M5 12h14M12 5l7 7-7 7"/>') : '';
---

<section class:list={['tool-page container-page', { 'tool-page--cta-tight': isCounter || isWppCards, 'tool-page--counter': isCounter, 'tool-page--wpp': isWppCards && !isCounter }]}>
  {tool.id === 'words-per-page' ? (
    <WordsPerPageHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : tool.id === 'reading-time' ? (
    <ReadingTimeHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : tool.id === 'byte-counter' ? (
    <ByteCounterHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : tool.id === 'emoji-counter' ? (
    <EmojiCounterHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : tool.id === 'sentence-counter' ? (
    <SentenceCounterHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : tool.id === 'sms' ? (
    <SmsHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : tool.id === 'google-serp' ? (
    <GoogleSerpHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : tool.id === 'youtube' ? (
    <YouTubeHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : tool.id === 'whatsapp' ? (
    <WhatsAppHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : tool.id === 'discord' ? (
    <DiscordHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : tool.id === 'bluesky' ? (
    <BlueskyHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : tool.id === 'reddit' ? (
    <RedditHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : tool.id === 'pinterest' ? (
    <PinterestHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : tool.id === 'tiktok' ? (
    <TikTokCounterHero
      title={tStr(tool.titles)}
      intro={introText}
      sections={sections}
      onThisPageLabel={globalT.toolPage.onThisPage}
    />
  ) : (
    <header class="tool-page__prose tool-page__head">
      <h1 class="tool-page__title">{tStr(tool.titles)}</h1>
      {introText && <p class="tool-page__lede">{introText}</p>}
      <OnThisPage label={globalT.toolPage.onThisPage} sections={sections} />
    </header>
  )}

  {/* Live calculator island, supplied by the route via the default slot. The
      YouTube editor recolors its link-accent (focus rings) to brand red by
      overriding the link tokens on this wrapper — scoped to this page only. */}
  <div
    class="tool-page__tool"
    style={ctaAccent
      ? `--color-link:${ctaAccent};--color-link-deep:color-mix(in srgb, ${ctaAccent} 78%, #000);--color-link-bg-soft:color-mix(in srgb, ${ctaAccent} 14%, transparent)`
      : undefined}
  >
    <slot />
  </div>

  <article class="tool-page__prose">
    {(isCounter || isWppCards) ? (
      <ToolSectionCards sections={cardSections} theme={cardTheme} />
    ) : (
      <div class="tool-page__body" set:html={bodyHtml} />
    )}

    {faqItems.length > 0 && (
      <section class="tool-page__faq" aria-label={globalT.faq.title}>
        <h2 class="tool-page__faq-heading">{globalT.faq.title}</h2>
        <div class="faq__list">
          {faqItems.map((f) => (
            <details class="faq__item">
              <summary class="faq__q">
                <span>{f.q}</span>
                <span class="faq__chev" aria-hidden="true">+</span>
              </summary>
              <p class="faq__a">{f.a}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    {relatedTool && relatedHref && (
      <aside class="tool-page__crosslink" style={tool.id === 'sms' ? "--color-link: #059669; --color-link-bg-soft: rgba(16, 185, 129, 0.12); --color-link-deep: #047857;" : undefined}>
        <span class="tool-page__crosslink-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={relatedIconPath} />
        </span>
        <p class="tool-page__crosslink-text">{relatedBlurb}</p>
        <a href={relatedHref} class="tool-page__crosslink-link">
          <span>{relatedLabel}</span>
          <span class="tool-page__crosslink-arrow" aria-hidden="true">→</span>
        </a>
      </aside>
    )}

    <p class="tool-page__updated">{lastUpdatedLine}</p>

    {isCounter ? (
      <ToolCta heading={cta.heading} blurb={cta.blurb} button={cta.button} href={homeHref} accent={ctaAccent} />
    ) : tool.id === 'sms' ? (
      <ToolCta heading={cta.heading} blurb={cta.blurb} button={cta.button} href={homeHref} accent="#10b981" />
    ) : tool.id === 'google-serp' ? (
      <ToolCta heading={cta.heading} blurb={cta.blurb} button={cta.button} href={homeHref} accent="#1a73e8" />
    ) : isWppCards ? (
      <ToolCta heading={cta.heading} blurb={cta.blurb} button={cta.button} href={homeHref} accent={wppAccent} />
    ) : (
      <div class="tool-page__cta">
        <h2 class="tool-page__cta-heading">{cta.heading}</h2>
        <p class="tool-page__cta-blurb">{cta.blurb}</p>
        <a href={homeHref} class="tool-page__btn tool-page__cta-btn">{cta.button}</a>
      </div>
    )}
  </article>
</section>

<style>
  .tool-page {
    scroll-margin-top: 80px;
    padding-top: 64px;
    padding-bottom: 64px;
  }

  /* Counter pages close on the ToolCta card — sit tight to the footer: trim the
     bottom padding and cancel the footer's 96px top margin (adjacent siblings
     under <body>, so the negative margin collapses with it). */
  .tool-page.tool-page--cta-tight {
    padding-bottom: 24px;
    margin-bottom: -96px;
  }

  /* Counter pages align the editor + content to the same measure as the hero. */
  .tool-page--counter .tool-page__tool,
  .tool-page--counter .tool-page__prose {
    max-width: 64rem;
  }

  /* Words-per-page: same wider card measure, but keeps its own footer spacing. */
  .tool-page--wpp .tool-page__tool,
  .tool-page--wpp .tool-page__prose {
    max-width: 64rem;
  }

  .tool-page__prose {
    max-width: 48rem;
    margin-inline: auto;
  }

  .tool-page__head {
    margin-bottom: 32px;
  }

  .tool-page__head :global(.on-page) {
    margin-top: 20px;
  }

  .tool-page__title {
    font-size: clamp(30px, 5vw, 44px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -1.6px;
    color: var(--color-ink);
  }

  .tool-page__lede {
    margin-top: 16px;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }

  /* Embedded calculator — constrained to the prose measure and centered. */
  .tool-page__tool {
    scroll-margin-top: 80px;
    margin: 8px auto 56px;
    max-width: 48rem;
  }

  /* Prose body — same rhythm as the platform tool pages and homepage SEO copy. */
  .tool-page__body :global(h2) {
    scroll-margin-top: 80px;
    margin-top: 40px;
    font-size: 22px;
    font-weight: 600;
    line-height: 30px;
    letter-spacing: -0.6px;
    color: var(--color-ink);
  }

  .tool-page__body :global(h2:first-child) {
    margin-top: 0;
  }

  .tool-page__body :global(p) {
    margin-top: 14px;
    font-size: 16px;
    line-height: 28px;
    color: var(--color-body);
  }

  .tool-page__body :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }

  .tool-page__body :global(ul),
  .tool-page__body :global(ol) {
    margin-top: 14px;
    padding-left: 1.5rem;
    font-size: 16px;
    line-height: 28px;
    color: var(--color-body);
  }

  .tool-page__body :global(li) {
    margin-top: 6px;
  }

  .tool-page__updated {
    margin-top: 32px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .tool-page__cta {
    margin-top: 24px;
    padding-top: 32px;
    border-top: 1px solid var(--color-hairline);
  }

  .tool-page__cta-heading {
    font-size: 22px;
    font-weight: 600;
    line-height: 30px;
    letter-spacing: -0.6px;
    color: var(--color-ink);
  }

  .tool-page__cta-blurb {
    margin-top: 12px;
    font-size: 16px;
    line-height: 28px;
    color: var(--color-body);
    max-width: 44rem;
  }

  .tool-page__cta-btn {
    margin-top: 20px;
  }

  .tool-page__btn {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 24px;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-on-primary);
    font-size: 16px;
    font-weight: 500;
    transition: opacity 0.15s ease, transform 100ms ease;
  }

  .tool-page__btn:hover {
    opacity: 0.88;
  }

  .tool-page__btn:active {
    transform: scale(0.955);
    opacity: 0.82;
  }

  /* ── FAQ accordion — identical look to the platform tool pages ──────────── */
  .tool-page__faq {
    margin-top: 48px;
  }

  .tool-page__faq-heading {
    font-size: 22px;
    font-weight: 600;
    line-height: 30px;
    letter-spacing: -0.6px;
    color: var(--color-ink);
    margin-bottom: 20px;
  }

  .faq__list {
    display: grid;
    gap: 12px;
  }

  .faq__item {
    border-radius: var(--radius-lg);
    background: var(--color-canvas);
    box-shadow: var(--shadow-e1);
    overflow: hidden;
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    padding: 18px 20px;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-ink);
    list-style: none;
    transition: transform 100ms ease, background 0.15s ease;
  }

  .faq__q:active {
    transform: scale(0.985);
    background: var(--color-canvas-soft-2);
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__chev {
    font-size: 20px;
    color: var(--color-mute);
    transition: transform 0.2s ease;
    line-height: 1;
  }

  .faq__item[open] .faq__chev {
    transform: rotate(45deg);
  }

  .faq__a {
    padding: 0 20px 18px;
    font-size: 15px;
    line-height: 24px;
    color: var(--color-body);
  }

  /* ── Cross-promo to a sibling calculator ────────────────────────────────── */
  .tool-page__crosslink {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 48px;
    padding: 20px 24px;
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--color-link-bg-soft) 55%, var(--color-canvas));
    border: 1px solid color-mix(in srgb, var(--color-link-bg-soft) 80%, transparent);
    transition: box-shadow 0.2s ease;
  }

  .tool-page__crosslink:hover {
    box-shadow: var(--shadow-e2);
  }

  /* Icon tile */
  .tool-page__crosslink-icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--color-link-bg-soft) 90%, transparent);
    color: var(--color-link);
  }

  .tool-page__crosslink-icon svg {
    width: 22px;
    height: 22px;
  }

  /* Body text — takes remaining space */
  .tool-page__crosslink-text {
    flex: 1;
    min-width: 0;
    font-size: 15px;
    line-height: 24px;
    color: var(--color-body);
  }

  /* Arrow link — kept on the right, never wraps */
  .tool-page__crosslink-link {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 700;
    color: var(--color-link);
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  .tool-page__crosslink-link:hover {
    color: var(--color-link-deep);
  }

  .tool-page__crosslink-arrow {
    transition: transform 0.15s ease;
  }

  .tool-page__crosslink-link:hover .tool-page__crosslink-arrow {
    transform: translateX(3px);
  }

  /* On narrow screens, stack vertically — icon stays, link goes below text */
  @media (max-width: 640px) {
    .tool-page__crosslink {
      flex-wrap: wrap;
      gap: 14px;
    }
    .tool-page__crosslink-text {
      flex-basis: calc(100% - 58px); /* fill row beside icon */
    }
    .tool-page__crosslink-link {
      margin-left: 58px; /* align with text column */
    }
  }

  @media (max-width: 768px) {
    .tool-page {
      padding-top: 48px;
      padding-bottom: 48px;
    }
  }
</style>
