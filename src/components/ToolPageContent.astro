---
// Shared body component for all tool sub-pages.
//
// Two layouts, switched by whether the tool defines a `faq` block:
//   • Standalone (platform pages with faq): intro lede → embedded scoped editor
//     → prose → FAQ accordion → cross-promo to the full home editor.
//   • Classic (everything else, e.g. google-serp): heading → prose → CTA.
import OnThisPage from './OnThisPage.astro';
import TwitterHero from './TwitterHero.astro';
import ThreadsHero from './ThreadsHero.astro';
import InstagramHero from './InstagramHero.astro';
import LinkedInHero from './LinkedInHero.astro';
import FacebookHero from './FacebookHero.astro';
import TikTokHero from './TikTokHero.astro';
import ToolCta from './ToolCta.astro';
import ToolSectionCards from './ToolSectionCards.astro';
import BlogCardGrid from './BlogCardGrid.astro';
import PlatformFaqBlog from './PlatformFaqBlog.astro';
import Dashboard from './island/Dashboard.tsx';
import type { ToolDefinition } from '../data/tools';
import type { IslandStrings } from '../i18n/types';
import { DEFAULT_LOCALE } from '../i18n/config';
import { getTranslations } from '../i18n';
import { interp } from '../i18n/interp';
import { buildCanonicalSlugs, prepareToolContent, splitToolSections } from '../lib/headingAnchors';
import { formatLocaleDate } from '../lib/contentDates';
import { BLOG_SEGMENT, getBlogStrings, getPublishedPosts } from '../lib/blogI18n';
import { getCategoryById, getCategorySlug } from '../data/blogCategories';

interface Props {
  tool: ToolDefinition;
  lang: string;
  /** Absolute or root-relative URL that deep-links to this tool in the editor. */
  editorHref: string;
  /** When true, suppresses the "Start writing" CTA button (classic layout only). */
  hideCta?: boolean;
  /** Island strings for the embedded editor (standalone platform pages). */
  strings?: IslandStrings;
  /** Locale tool-page slugs for the embedded editor's contextual links. */
  toolSlugs?: Record<string, string>;
  /** Full home editor URL for the cross-promo CTA (e.g. /en/character-counter/#workspace). */
  homeHref?: string;
}

const { tool, lang, editorHref, hideCta = false, strings, toolSlugs, homeHref } = Astro.props;

const tStr = <T,>(record: Record<string, T>): T => record[lang] ?? record[DEFAULT_LOCALE];
const globalT = getTranslations(lang);

const canonicalSlugs = buildCanonicalSlugs(tool.content[DEFAULT_LOCALE] ?? '');
const { html: bodyHtml, sections } = prepareToolContent(tStr(tool.content), canonicalSlugs);

// Platform pages that have been migrated to the redesigned layout: full-width
// editor + content, prose body reframed as hover-active icon cards, and the
// centered CTA card. Rolled out one platform at a time (hero is handled
// separately and stays on the default header until each hero is redesigned).
const REDESIGNED_TOOL_IDS = new Set(['twitter', 'instagram', 'linkedin', 'facebook', 'threads', 'tiktok-guide']);
const useCards = REDESIGNED_TOOL_IDS.has(tool.id);
const cardSections = useCards ? splitToolSections(bodyHtml) : [];
const lastUpdatedLine = interp(globalT.toolPage.lastUpdated, {
  date: formatLocaleDate(tool.lastUpdated, lang),
});

// Platforms whose editor can be embedded as a standalone platform page. Most
// tools use their id directly as the Dashboard `focus` key; TikTok's guide uses
// a distinct id (`tiktok-guide`) to avoid colliding with the legacy tiktok
// calculator, so it maps to the `tiktok` focus key here.
type FocusPlatform = 'twitter' | 'instagram' | 'linkedin' | 'facebook' | 'threads' | 'tiktok';
const FOCUS_BY_TOOL_ID: Record<string, FocusPlatform> = {
  twitter: 'twitter',
  instagram: 'instagram',
  linkedin: 'linkedin',
  facebook: 'facebook',
  threads: 'threads',
  'tiktok-guide': 'tiktok',
};
const focus = FOCUS_BY_TOOL_ID[tool.id];

// Brand name for the {platform} slot in the cross-promo copy (not translated).
const PLATFORM_LABEL: Record<string, string> = {
  twitter: 'X',
  instagram: 'Instagram',
  linkedin: 'LinkedIn',
  facebook: 'Facebook',
  threads: 'Threads',
  'tiktok-guide': 'TikTok',
};
const platformLabel = PLATFORM_LABEL[tool.id] ?? '';

// Switch to the standalone template only where THIS locale has its own intro +
// faq (no English fallback) — otherwise a partly-translated page would mix
// languages. Untranslated locales keep the classic layout until templated.
const introText = tool.intro?.[lang] ?? '';
const faqItems = tool.faq?.[lang] ?? [];

// The locale-native faq block is the switch into the richer standalone template.
const isStandalone = focus !== undefined && faqItems.length > 0;
const cta = globalT.toolPage.cta;

// Related blog posts for this platform, newest first. Only this locale's posts,
// so untranslated locales (no posts yet) render nothing. English-only today.
// Match on the focus platform, not the raw tool id, so TikTok's `tiktok-guide`
// id resolves to the `tiktok` posts (focus === tool.id for every other page;
// classic non-platform tools fall back to the raw id).
const relatedPlatformKey = focus ?? tool.id;
const blogStrings = getBlogStrings(lang);
const relatedPosts = (await getPublishedPosts())
  .filter((p) => p.data.locale === lang && p.data.relatedPlatform === relatedPlatformKey)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

// "View all articles" target: this platform's blog category hub. Falls back to
// the blog index if the focus has no category (never happens for the 6 pages).
const FOCUS_TO_CATEGORY: Record<string, string> = {
  twitter: 'twitter-x',
  instagram: 'instagram',
  linkedin: 'linkedin',
  facebook: 'facebook',
  threads: 'threads',
  tiktok: 'tiktok',
};
const blogCategory = focus ? getCategoryById(FOCUS_TO_CATEGORY[focus]) : undefined;
const blogCategoryHref = blogCategory
  ? `/${lang}/${BLOG_SEGMENT}/${getCategorySlug(blogCategory, lang)}/`
  : `/${lang}/${BLOG_SEGMENT}/`;
// The redesigned FAQ+Blog row shows the two latest posts (a single 2-up row).
const faqBlogPosts = relatedPosts.slice(0, 2);

// Per-platform theme colors for the FAQ/Blog section icons — mirrors each hero's
// accent (soft tile fill + glyph), keyed by tool id.
const FAQ_BLOG_ACCENT: Record<string, { bg: string; fg: string }> = {
  twitter: { bg: 'var(--color-link-bg-soft)', fg: 'var(--color-link)' },
  linkedin: { bg: 'var(--color-link-bg-soft)', fg: 'var(--color-link)' },
  facebook: { bg: 'var(--color-link-bg-soft)', fg: 'var(--color-link)' },
  instagram: {
    bg: 'color-mix(in srgb, var(--color-highlight-pink) 14%, transparent)',
    fg: 'var(--color-highlight-magenta)',
  },
  threads: { bg: 'var(--color-violet-soft)', fg: 'var(--color-violet-deep)' },
  'tiktok-guide': {
    bg: 'color-mix(in srgb, #fe2c55 14%, transparent)',
    fg: 'color-mix(in srgb, #fe2c55 82%, #000)',
  },
};
const faqBlogAccent = FAQ_BLOG_ACCENT[tool.id] ?? {
  bg: 'var(--color-violet-soft)',
  fg: 'var(--color-violet-deep)',
};
---

{isStandalone ? (
  <section class:list={['tool-page container-page', { 'tool-page--wide': useCards, 'tool-page--cta-tight': useCards }]}>
    {tool.id === 'twitter' ? (
      <TwitterHero
        title={tStr(tool.titles)}
        intro={introText}
        sections={sections}
        onThisPageLabel={globalT.toolPage.onThisPage}
      />
    ) : tool.id === 'threads' ? (
      <ThreadsHero
        title={tStr(tool.titles)}
        intro={introText}
        sections={sections}
        onThisPageLabel={globalT.toolPage.onThisPage}
      />
    ) : tool.id === 'instagram' ? (
      <InstagramHero
        title={tStr(tool.titles)}
        intro={introText}
        sections={sections}
        onThisPageLabel={globalT.toolPage.onThisPage}
      />
    ) : tool.id === 'linkedin' ? (
      <LinkedInHero
        title={tStr(tool.titles)}
        intro={introText}
        sections={sections}
        onThisPageLabel={globalT.toolPage.onThisPage}
      />
    ) : tool.id === 'facebook' ? (
      <FacebookHero
        title={tStr(tool.titles)}
        intro={introText}
        sections={sections}
        onThisPageLabel={globalT.toolPage.onThisPage}
      />
    ) : tool.id === 'tiktok-guide' ? (
      <TikTokHero
        title={tStr(tool.titles)}
        intro={introText}
        sections={sections}
        onThisPageLabel={globalT.toolPage.onThisPage}
      />
    ) : (
      <header class="tool-page__prose tool-page__head">
        <h1 class="tool-page__title">{tStr(tool.titles)}</h1>
        {introText && <p class="tool-page__lede">{introText}</p>}
        <OnThisPage label={globalT.toolPage.onThisPage} sections={sections} />
      </header>
    )}

    {/* Live tool — scoped to this platform, with workspace heading matching the homepage. */}
    <div class="tool-page__tool">
      <div class="tool-page__workspace-head">
        <h2 class="tool-page__workspace-title">
          {platformLabel ? `Your ${platformLabel} live workspace` : globalT.workspace.title}
        </h2>
        <p class="tool-page__workspace-sub">{globalT.workspace.sub}</p>
      </div>
      <Dashboard client:load lang={lang} strings={strings!} toolSlugs={toolSlugs!} focus={focus} />
    </div>

    <article class="tool-page__prose">
      {useCards ? (
        <ToolSectionCards sections={cardSections} theme={focus} />
      ) : (
        <div class="tool-page__body" set:html={bodyHtml} />
      )}

      {useCards ? (
        <PlatformFaqBlog
          lang={lang}
          faqItems={faqItems}
          faqTitle={globalT.faq.title}
          faqViewAll={globalT.faq.viewAll}
          faqHref={`/${lang}/faq/`}
          posts={faqBlogPosts}
          blogHeading={blogStrings.latestHeading}
          blogViewAll={blogStrings.viewAll}
          blogHref={blogCategoryHref}
          readMoreLabel={blogStrings.readMore}
          iconBg={faqBlogAccent.bg}
          iconFg={faqBlogAccent.fg}
        />
      ) : (
        <>
          {relatedPosts.length > 0 && (
            <section class="tool-page__related" aria-label={blogStrings.relatedHeading}>
              <h2 class="tool-page__related-heading">{blogStrings.relatedHeading}</h2>
              <BlogCardGrid posts={relatedPosts} lang={lang} readMoreLabel={blogStrings.readMore} />
            </section>
          )}

          <section class="tool-page__faq" aria-label={globalT.faq.title}>
            <h2 class="tool-page__faq-heading">{globalT.faq.title}</h2>
            <div class="faq__list">
              {faqItems.map((f) => (
                <details class="faq__item">
                  <summary class="faq__q">
                    <span>{f.q}</span>
                    <span class="faq__chev" aria-hidden="true">+</span>
                  </summary>
                  <p class="faq__a">{f.a}</p>
                </details>
              ))}
            </div>
          </section>
        </>
      )}

      <p class="tool-page__updated">{lastUpdatedLine}</p>

      {/* CTA: give context then send users to the full home editor. */}
      {useCards ? (
        <ToolCta heading={cta.heading} blurb={cta.blurb} button={cta.button} href={homeHref} />
      ) : (
        <aside class="tool-page__xpromo">
          <h2 class="tool-page__cta-heading">{cta.heading}</h2>
          <p class="tool-page__cta-blurb">{cta.blurb}</p>
          <a href={homeHref} class="tool-page__btn tool-page__cta-btn">{cta.button}</a>
        </aside>
      )}
    </article>
  </section>
) : (
  <section class="tool-page container-page">
    <header class="tool-page__head tool-page__prose">
      <h1 class="tool-page__title">{tStr(tool.titles)}</h1>
      <OnThisPage label={globalT.toolPage.onThisPage} sections={sections} />
    </header>

    {/* Optional embedded tool, rendered above the prose body (e.g. google-serp). */}
    <slot name="tool" />

    <article class="tool-page__prose">
      <div class="tool-page__body" set:html={bodyHtml} />

      {relatedPosts.length > 0 && (
        <section class="tool-page__related" aria-label={blogStrings.relatedHeading}>
          <h2 class="tool-page__related-heading">{blogStrings.relatedHeading}</h2>
          <BlogCardGrid posts={relatedPosts} lang={lang} readMoreLabel={blogStrings.readMore} />
        </section>
      )}

      <p class="tool-page__updated">{lastUpdatedLine}</p>

      {!hideCta && (
        <div class="tool-page__cta">
          <h2 class="tool-page__cta-heading">{cta.heading}</h2>
          <p class="tool-page__cta-blurb">{cta.blurb}</p>
          <a href={editorHref} class="tool-page__btn tool-page__cta-btn">
            {cta.button}
          </a>
        </div>
      )}
    </article>
  </section>
)}

<style>
  .tool-page {
    scroll-margin-top: 80px;
    padding-top: 64px;
    padding-bottom: 64px;
  }

  /* Pages that close on the ToolCta card sit tight to the footer: trim the
     section's bottom padding and cancel the footer's 96px top margin (they are
     adjacent siblings under <body>, so the negative margin collapses with it). */
  .tool-page.tool-page--cta-tight {
    padding-bottom: 24px;
    margin-bottom: -96px;
  }

  .tool-page__prose {
    max-width: 48rem;
    margin-inline: auto;
  }

  /* Redesigned platform pages: editor island + content sections span the full
     (container-page) width, so the whole page reads as one consistent column.
     The hero header is deliberately excluded — it keeps its measure until its
     own redesign, and on not-yet-redesigned heroes it is a .tool-page__prose. */
  .tool-page--wide .tool-page__tool,
  .tool-page--wide .tool-page__prose:not(.tool-page__head) {
    max-width: none;
  }

  .tool-page__head {
    margin-bottom: 32px;
  }

  .tool-page__head :global(.on-page) {
    margin-top: 20px;
  }

  .tool-page__title {
    font-size: clamp(30px, 5vw, 44px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -1.6px;
    color: var(--color-ink);
  }

  /* Intro lede above the embedded tool */
  .tool-page__lede {
    margin-top: 16px;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }

  /* Embedded editor — constrained to the same width as the homepage workspace
     (--max-width-page = 1200px) and centered, matching the home editor exactly. */
  .tool-page__tool {
    scroll-margin-top: 80px;
    margin: 8px auto 56px;
    max-width: var(--max-width-page);
  }

  /* Workspace heading block above the embedded tool — mirrors the homepage style. */
  .tool-page__workspace-head {
    margin-bottom: 20px;
    text-align: center;
  }
  .tool-page__workspace-title {
    font-size: 28px;
    font-weight: 600;
    letter-spacing: -1px;
    color: var(--color-ink);
  }
  .tool-page__workspace-sub {
    margin-top: 6px;
    font-size: 15px;
    color: var(--color-body);
  }

  /* Prose body — same rhythm as the homepage SEO copy block */
  .tool-page__body :global(h2) {
    scroll-margin-top: 80px;
    margin-top: 40px;
    font-size: 22px;
    font-weight: 600;
    line-height: 30px;
    letter-spacing: -0.6px;
    color: var(--color-ink);
  }

  .tool-page__body :global(h2:first-child) {
    margin-top: 0;
  }

  .tool-page__body :global(p) {
    margin-top: 14px;
    font-size: 16px;
    line-height: 28px;
    color: var(--color-body);
  }

  .tool-page__body :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }

  .tool-page__body :global(ul),
  .tool-page__body :global(ol) {
    margin-top: 14px;
    padding-left: 1.5rem;
    font-size: 16px;
    line-height: 28px;
    color: var(--color-body);
  }

  .tool-page__body :global(li) {
    margin-top: 6px;
  }

  .tool-page__updated {
    margin-top: 32px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .tool-page__cta {
    margin-top: 24px;
    padding-top: 32px;
    border-top: 1px solid var(--color-hairline);
  }

  .tool-page__cta-heading {
    font-size: 22px;
    font-weight: 600;
    line-height: 30px;
    letter-spacing: -0.6px;
    color: var(--color-ink);
  }

  .tool-page__cta-blurb {
    margin-top: 12px;
    font-size: 16px;
    line-height: 28px;
    color: var(--color-body);
    max-width: 44rem;
  }

  .tool-page__cta-btn {
    margin-top: 20px;
  }

  .tool-page__btn {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 24px;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-on-primary);
    font-size: 16px;
    font-weight: 500;
    transition: opacity 0.15s ease, transform 100ms ease;
  }

  .tool-page__btn:hover {
    opacity: 0.88;
  }

  .tool-page__btn:active {
    transform: scale(0.955);
    opacity: 0.82;
  }

  /* ── FAQ accordion — identical look to the homepage FAQ ─────────────────── */
  .tool-page__faq {
    margin-top: 48px;
  }

  .tool-page__faq-heading {
    font-size: 22px;
    font-weight: 600;
    line-height: 30px;
    letter-spacing: -0.6px;
    color: var(--color-ink);
    margin-bottom: 20px;
  }

  .faq__list {
    display: grid;
    gap: 12px;
  }

  .faq__item {
    border-radius: var(--radius-lg);
    background: var(--color-canvas);
    box-shadow: var(--shadow-e1);
    overflow: hidden;
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    cursor: pointer;
    padding: 18px 20px;
    font-size: 16px;
    font-weight: 500;
    color: var(--color-ink);
    list-style: none;
    transition: transform 100ms ease, background 0.15s ease;
  }

  .faq__q:active {
    transform: scale(0.985);
    background: var(--color-canvas-soft-2);
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__chev {
    font-size: 20px;
    color: var(--color-mute);
    transition: transform 0.2s ease;
    line-height: 1;
  }

  .faq__item[open] .faq__chev {
    transform: rotate(45deg);
  }

  .faq__a {
    padding: 0 20px 18px;
    font-size: 15px;
    line-height: 24px;
    color: var(--color-body);
  }

  /* ── Related blog posts ─────────────────────────────────────────────────── */
  .tool-page__related {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--color-hairline);
  }

  .tool-page__related-heading {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.6px;
    color: var(--color-ink);
    margin-bottom: 16px;
  }

  /* ── Cross-promo block (replaces the classic CTA on standalone pages) ────── */
  .tool-page__xpromo {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--color-hairline);
  }

  .tool-page__xpromo-heading {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.6px;
    color: var(--color-ink);
  }

  .tool-page__xpromo-text {
    margin-top: 12px;
    font-size: 16px;
    line-height: 28px;
    color: var(--color-body);
  }

  .tool-page__xpromo .tool-page__btn {
    margin-top: 20px;
  }

  @media (max-width: 768px) {
    .tool-page {
      padding-top: 48px;
      padding-bottom: 48px;
    }
  }
</style>
