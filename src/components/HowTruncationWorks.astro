---
import type { Translations } from '../i18n/types';
import { getTranslations } from '../i18n';
import { LIMITS, FOLDS } from '../lib/textTools';

interface Props {
  s: Translations['howTruncationWorks'];
  lang: string;
}

const { s, lang } = Astro.props;
const t = getTranslations(lang);
const L = t.limitsPage;
const nf = new Intl.NumberFormat(lang);
---

<section class="container-page truncation-section">
  <div class="truncation-head">
    <p class="section-eyebrow">{s.eyebrow}</p>
    <p class="truncation-desc">{s.description}</p>
  </div>

  <div class="platforms-grid">
    <div class="platform-card">
      <div class="platform-header">
        <svg class="icon-linkedin" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#0a66c2"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
        <span class="platform-name">{s.platforms.linkedin.name}</span>
      </div>
      <p class="platform-desc">
        {L.table.foldMobile}: ~{nf.format(FOLDS.linkedin.mobile)}<br/>
        {L.table.foldDesktop}: ~{nf.format(FOLDS.linkedin.desktop)}
      </p>
    </div>

    <div class="platform-card">
      <div class="platform-header">
        <svg class="icon-x" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        <span class="platform-name">{s.platforms.twitter.name}</span>
      </div>
      <p class="platform-desc">
        {L.noFold}<br/>
        {L.table.limit}: {nf.format(LIMITS.TWEET)}
      </p>
    </div>

    <div class="platform-card">
      <div class="platform-header">
        <svg class="icon-instagram" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5.5" fill="none" stroke="#E4405F" stroke-width="2" /><circle cx="12" cy="12" r="4.2" fill="none" stroke="#E4405F" stroke-width="2" /><circle cx="17.4" cy="6.6" r="1.2" fill="#E4405F" /></svg>
        <span class="platform-name">{s.platforms.instagram.name}</span>
      </div>
      <p class="platform-desc">
        {L.table.foldMobile}: ~{nf.format(FOLDS.instagram.mobile)}<br/>
        {L.table.foldDesktop}: ~{nf.format(FOLDS.instagram.desktop)}
      </p>
    </div>

    <div class="platform-card">
      <div class="platform-header">
        <svg class="icon-facebook" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="#1877f2"><path d="M9 8h-3v4h3v12h5v-12h3.642l.358-4h-4v-1.667c0-.955.192-1.333 1.115-1.333h2.885v-5h-3.808c-3.596 0-5.192 1.583-5.192 4.615v3.385z"/></svg>
        <span class="platform-name">{s.platforms.facebook.name}</span>
      </div>
      <p class="platform-desc">
        {L.table.foldMobile}: ~{nf.format(FOLDS.facebook.mobile)}<br/>
        {L.table.foldDesktop}: ~{nf.format(FOLDS.facebook.desktop)}
      </p>
    </div>

    <div class="platform-card">
      <div class="platform-header">
        <svg class="icon-threads" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-ink" aria-hidden="true"><path d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.291 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.781 3.631 2.695 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.36-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.32.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.235-11.587c-.336 0-.679.01-1.024.029-1.838.103-2.978.95-2.913 2.122.063 1.235 1.435 1.81 2.756 1.737 1.211-.066 2.79-.534 3.058-3.71-.59-.124-1.215-.181-1.876-.181Z" /></svg>
        <span class="platform-name">{s.platforms.threads.name}</span>
      </div>
      <p class="platform-desc">
        {L.table.foldMobile}: ~{nf.format(FOLDS.threads.mobile)}<br/>
        {L.table.foldDesktop}: {nf.format(FOLDS.threads.desktop)}
      </p>
    </div>

    <div class="platform-card">
      <div class="platform-header">
        <svg class="icon-tiktok" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="text-ink" aria-hidden="true"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.59 2.59 0 0 1-2.59-2.59 2.59 2.59 0 0 1 3.39-2.46V9.69a5.66 5.66 0 0 0-.8-.06A5.69 5.69 0 0 0 4.17 15.31 5.69 5.69 0 0 0 13.94 19.3a5.69 5.69 0 0 0 1.6-3.96V9.01a7.34 7.34 0 0 0 4.29 1.37V7.3a4.28 4.28 0 0 1-3.23-1.48z"/></svg>
        <span class="platform-name">{s.platforms.tiktok.name}</span>
      </div>
      <p class="platform-desc">
        {L.table.foldMobile}: ~{nf.format(FOLDS.tiktok.mobile)}<br/>
        {L.table.foldDesktop}: ~{nf.format(FOLDS.tiktok.desktop)}
      </p>
    </div>
  </div>
</section>

<svg width="0" height="0" class="hidden" style="display:none">
  <defs>
    <linearGradient id="ig-grad" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#fd5949" />
      <stop offset="50%" stop-color="#d6249f" />
      <stop offset="100%" stop-color="#285AEB" />
    </linearGradient>
  </defs>
</svg>

<style>
  .truncation-section {
    padding-top: 96px;
    padding-bottom: 0px;
  }
  .truncation-head {
    margin-bottom: 32px;
    max-width: 800px;
  }
  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink);
    margin-bottom: 12px;
    font-weight: 700;
  }
  .truncation-desc {
    font-size: 15px;
    line-height: 24px;
    color: var(--color-body);
  }
  .platforms-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
  .platform-card {
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: 12px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: var(--shadow-e3);
    transition: box-shadow 0.15s ease, transform 0.15s ease;
  }
  .platform-card:hover {
    box-shadow: var(--shadow-e4);
    transform: translateY(-2px);
  }
  @media (min-width: 640px) {
    .platforms-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .platforms-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }
  .platform-header {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .platform-name {
    font-size: 15px;
    font-weight: 600;
    color: var(--color-ink);
  }
  .platform-desc {
    font-size: 13px;
    line-height: 20px;
    color: var(--color-body);
  }
  .icon-x, .icon-threads {
    color: var(--color-ink);
  }
  .icon-instagram {
    stroke: url(#ig-grad);
  }
</style>
