---
// BreadcrumbList JSON-LD for /[lang]/[tool]/ sub-tool pages.
// Reads locale, tool metadata, and translated labels at build time.
import type { ToolDefinition } from '../data/tools';
import { getLocale } from '../i18n/config';
import { getTranslations } from '../i18n';
import { buildToolBreadcrumbList, stringifyJsonLd } from '../lib/toolBreadcrumbSchema';

interface Props {
  lang: string;
  tool: ToolDefinition;
  /** Site origin — defaults to Astro.site or posttruncate.com. */
  site?: URL;
}

const { lang, tool, site = Astro.site ?? new URL('https://posttruncate.com') } = Astro.props;
const locale = getLocale(lang);
const t = getTranslations(lang);

const schema = buildToolBreadcrumbList({
  site,
  lang,
  localeSlug: locale.slug,
  tool,
  labels: {
    home: t.breadcrumbs.home,
    platformGuides: t.nav.links.guides,
  },
});
---

<script type="application/ld+json" set:html={stringifyJsonLd(schema)} />
