---
// Article share row for blog posts. Static-first: the network buttons are plain
// share-intent links (work with JS off); "Copy link" and the native Web Share
// button are progressive enhancements wired up by the inline script below and
// only appear/function when their browser API exists. Rendered once per post by
// the [slug] template, so every current and future article gets it for free.
import { interp } from '../i18n/interp';
import type { BlogStrings } from '../lib/blogI18n';

interface Props {
  /** Canonical, absolute URL of the article. */
  url: string;
  /** Article title, used as the share text / native-share title. */
  title: string;
  /** Blog chrome strings (en-fallback) for the labels. */
  strings: BlogStrings;
}

const { url, title, strings } = Astro.props as Props;

const enc = encodeURIComponent;
const networks = [
  {
    name: 'X',
    href: `https://twitter.com/intent/tweet?text=${enc(title)}&url=${enc(url)}`,
  },
  {
    name: 'LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`,
  },
  {
    name: 'Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${enc(url)}`,
  },
] as const;
---

<section class="blog-share" data-url={url} data-title={title} aria-label={strings.shareHeading}>
  <span class="blog-share__label">{strings.shareHeading}</span>

  <div class="blog-share__buttons">
    {networks.map((n) => (
      <a
        class="blog-share__btn"
        href={n.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={interp(strings.shareOn, { platform: n.name })}
      >
        {n.name === 'X' && (
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.66l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.45-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z" />
          </svg>
        )}
        {n.name === 'LinkedIn' && (
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.75V1.75C24 .78 23.2 0 22.22 0Z" />
          </svg>
        )}
        {n.name === 'Facebook' && (
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M24 12.07C24 5.4 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.05V9.41c0-3.02 1.79-4.7 4.53-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.51c-1.49 0-1.96.93-1.96 1.89v2.26h3.33l-.53 3.49h-2.8V24C19.61 23.1 24 18.1 24 12.07Z" />
          </svg>
        )}
        <span class="blog-share__btn-name">{n.name}</span>
      </a>
    ))}

    {/* Copy link — enhanced by the script; label swaps to "Copied!" briefly. */}
    <button type="button" class="blog-share__btn blog-share__copy" aria-label={strings.shareCopy}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span class="blog-share__btn-name" data-copy-label={strings.shareCopy} data-copied-label={strings.shareCopied}>
        {strings.shareCopy}
      </span>
    </button>

    {/* Native share — hidden until the script confirms navigator.share exists. */}
    <button type="button" class="blog-share__btn blog-share__native" aria-label={strings.shareNative} hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="18" cy="5" r="3"></circle>
        <circle cx="6" cy="12" r="3"></circle>
        <circle cx="18" cy="19" r="3"></circle>
        <path d="m8.59 13.51 6.83 3.98M15.41 6.51l-6.82 3.98"></path>
      </svg>
      <span class="blog-share__btn-name">{strings.shareNative}</span>
    </button>
  </div>

  {/* Polite live region announces the copy confirmation to screen readers. */}
  <span class="blog-share__status" role="status" aria-live="polite"></span>
</section>

<script>
  // Progressive enhancement for the article share row: wire "Copy link" to the
  // Clipboard API and reveal the native share button only where Web Share exists.
  // Plain module script — Astro bundles + defers it; nothing blocks first paint.
  (() => {
    const root = document.querySelector<HTMLElement>('.blog-share');
    if (!root) return;

    const url = root.dataset.url ?? location.href;
    const title = root.dataset.title ?? document.title;
    const status = root.querySelector<HTMLElement>('.blog-share__status');

    // ── Copy link ──────────────────────────────────────────────────────────
    const copyBtn = root.querySelector<HTMLButtonElement>('.blog-share__copy');
    const copyLabel = copyBtn?.querySelector<HTMLElement>('.blog-share__btn-name');
    const idle = copyLabel?.dataset.copyLabel ?? 'Copy link';
    const done = copyLabel?.dataset.copiedLabel ?? 'Link copied!';
    let resetTimer: number | undefined;

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        // Clipboard blocked (permissions / insecure context) — fall back to a
        // hidden textarea + execCommand so the button still works.
        const ta = document.createElement('textarea');
        ta.value = url;
        ta.setAttribute('readonly', '');
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch {}
        document.body.removeChild(ta);
      }
      if (copyLabel) copyLabel.textContent = done;
      copyBtn.classList.add('is-copied');
      if (status) status.textContent = done;
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        if (copyLabel) copyLabel.textContent = idle;
        copyBtn.classList.remove('is-copied');
        if (status) status.textContent = '';
      }, 2000);
    });

    // ── Native share (mobile / supported browsers) ──────────────────────────
    const nativeBtn = root.querySelector<HTMLButtonElement>('.blog-share__native');
    if (nativeBtn && typeof navigator.share === 'function') {
      nativeBtn.hidden = false;
      nativeBtn.addEventListener('click', () => {
        navigator.share({ title, url }).catch(() => {});
      });
    }
  })();
</script>

<style>
  .blog-share {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 1px solid var(--color-hairline);
  }
  .blog-share__label {
    font-size: 14px;
    font-weight: 600;
    color: var(--color-ink);
  }
  .blog-share__buttons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .blog-share__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 36px;
    padding: 0 14px;
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-pill);
    background: var(--color-canvas);
    color: var(--color-body);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    text-decoration: none;
    transition: transform 100ms ease, color 0.15s ease, background 0.15s ease,
      border-color 0.15s ease;
  }
  .blog-share__btn:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
    border-color: var(--color-hairline-strong);
  }
  .blog-share__btn:active {
    transform: scale(0.96);
  }
  .blog-share__btn svg {
    flex-shrink: 0;
  }
  .blog-share__copy.is-copied {
    color: var(--color-link-deep);
    border-color: var(--color-link);
    background: var(--color-link-bg-soft);
  }
  /* Visually-hidden but present for the accessible name on very small screens. */
  .blog-share__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  /* On narrow viewports, drop the text labels to keep the row to one line. */
  @media (max-width: 480px) {
    .blog-share__btn-name {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    .blog-share__btn {
      padding: 0;
      width: 36px;
      justify-content: center;
    }
  }
</style>
