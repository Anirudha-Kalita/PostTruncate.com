  '<path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h16.9a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01"/>',
];
const icons = (theme && ICON_SETS[theme]) || DEFAULT_ICONS;

// Per-platform tile palettes (soft fill + saturated glyph). Cards cycle through
// them so each page's cards read in that platform's own colors. TikTok/Instagram
// mix brand hues; the blue networks vary blue/cyan shades; default = violet.
type Tint = { bg: string; fg: string };
const BLUE: Tint = { bg: 'var(--color-link-bg-soft)', fg: 'var(--color-link)' };
const BLUE_DEEP: Tint = { bg: 'var(--color-link-bg-soft)', fg: 'var(--color-link-deep)' };
const CYAN: Tint = { bg: 'var(--color-cyan-soft)', fg: 'var(--color-cyan-deep)' };
const VIOLET: Tint = { bg: 'var(--color-violet-soft)', fg: 'var(--color-violet-deep)' };
const AMBER: Tint = { bg: 'var(--color-warning-soft)', fg: 'var(--color-warning-deep)' };
const INK: Tint = { bg: 'var(--color-canvas-soft-2)', fg: 'var(--color-ink)' };
const PINK: Tint = {
  bg: 'color-mix(in srgb, var(--color-highlight-pink) 14%, transparent)',
  fg: 'var(--color-highlight-magenta)',
};
const TT_MAGENTA: Tint = {
  bg: 'color-mix(in srgb, #fe2c55 14%, transparent)',
  fg: 'color-mix(in srgb, #fe2c55 82%, #000)',
};
const TT_CYAN: Tint = {
  bg: 'color-mix(in srgb, #25f4ee 20%, transparent)',
  fg: 'color-mix(in srgb, #25f4ee 55%, #013b39)',
};

const GREEN: Tint = { bg: 'var(--color-cyan-soft)', fg: 'var(--color-cyan-deep)' };
const RED: Tint = { bg: 'var(--color-error-soft)', fg: 'var(--color-error-deep)' };

// Character-counter platform brand tints (soft fill + readable brand glyph).
const YT_RED: Tint = { bg: 'color-mix(in srgb, #ff0000 12%, transparent)', fg: '#c00' };
const PIN_RED: Tint = { bg: 'color-mix(in srgb, #e60023 12%, transparent)', fg: '#c9001f' };
const RD_ORANGE: Tint = { bg: 'color-mix(in srgb, #ff4500 14%, transparent)', fg: '#d93a00' };
const BSKY_BLUE: Tint = { bg: 'color-mix(in srgb, #1185fe 14%, transparent)', fg: '#0a6edb' };
const DISCORD: Tint = { bg: 'color-mix(in srgb, #5865f2 16%, transparent)', fg: '#4752c4' };
const WA_GREEN: Tint = { bg: 'color-mix(in srgb, #25d366 16%, transparent)', fg: '#128c4a' };

// SMS character counter specific tints
const SMS_GREEN: Tint = { bg: 'color-mix(in srgb, #10b981 12%, transparent)', fg: '#059669' };
const SMS_EMERALD: Tint = { bg: 'color-mix(in srgb, #059669 12%, transparent)', fg: '#047857' };
const SMS_TEAL: Tint = { bg: 'color-mix(in srgb, #0d9488 12%, transparent)', fg: '#0f766e' };
const SMS_MUTE: Tint = { bg: 'var(--color-canvas-soft-2)', fg: 'var(--color-ink)' };

const PALETTES: Record<string, Tint[]> = {
  twitter: [BLUE, INK, CYAN, BLUE_DEEP],
  linkedin: [BLUE, BLUE_DEEP, CYAN, BLUE],
  facebook: [BLUE, BLUE_DEEP, CYAN, BLUE],
  instagram: [VIOLET, PINK, AMBER, PINK],
  threads: [VIOLET, PINK, AMBER, VIOLET],
  tiktok: [TT_MAGENTA, TT_CYAN, INK, TT_MAGENTA],
  // Google's four-color brand: blue · red · amber · green.
  google: [BLUE, RED, AMBER, GREEN],
  // Character-counter platforms — each in its own brand color, alternated with ink.
  youtube: [YT_RED, AMBER, VIOLET, GREEN],
  pinterest: [PIN_RED, AMBER, VIOLET, GREEN],
  reddit: [RD_ORANGE, BLUE, VIOLET, GREEN],
  bluesky: [BSKY_BLUE, CYAN, VIOLET, GREEN],
  discord: [DISCORD, BLUE, DISCORD, CYAN],
  whatsapp: [WA_GREEN, WA_GREEN, WA_GREEN, WA_GREEN],
  // TikTok counter page uses a blue accent scheme (distinct from the magenta
  // 'tiktok' key that the platform + ad-preview pages share).
  'tiktok-counter': [BLUE, GREEN, VIOLET, AMBER],
  // Words-per-page: blue theme matching the hero accent.
  'words-per-page': [BLUE, CYAN, BLUE_DEEP, VIOLET],
  // Reading-time: blue theme matching the hero accent.
  'reading-time': [BLUE, CYAN, BLUE_DEEP, VIOLET],
  // Byte-counter: blue theme matching the developer blue.
  'byte-counter': [BLUE, CYAN, BLUE_DEEP, VIOLET],
  // Emoji-counter: blue theme matching the hero accent.
  'emoji-counter': [BLUE, CYAN, BLUE_DEEP, VIOLET],
  // Sentence-counter: blue theme matching the hero accent.
  'sentence-counter': [BLUE, CYAN, BLUE_DEEP, VIOLET],
  // SMS: green theme matching the hero accent.
  sms: [SMS_GREEN, SMS_EMERALD, SMS_TEAL, SMS_MUTE],
};
const palette = (theme && PALETTES[theme]) || [VIOLET, PINK, AMBER, BLUE];
---

<div class="cards">
  {sections.map((section, i) => {
    const tint = palette[i % palette.length];
    return (
      <article class="card">
        <span class="card__icon" aria-hidden="true" style={`background: ${tint.bg}; color: ${tint.fg};`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[i % icons.length]} />
        </span>
        <div class="card__content">
          <h2 class="card__title" id={section.id} set:html={section.headingHtml} />
          <div class="card__body" set:html={section.bodyHtml} />
        </div>
      </article>
    );
  })}
</div>

<style>
  .cards {
    display: grid;
    gap: 16px;
  }

  .card {
    display: flex;
    gap: 20px;
    padding: 24px;
    border-radius: var(--radius-xl);
    background: var(--color-canvas);
    box-shadow: var(--shadow-e2);
    scroll-margin-top: 88px;
    transition: box-shadow 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }

  /* Hover-active: lift + deepen the elevation, and warm the icon tile. */
  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-e4);
  }

  /* ── Icon tile ──────────────────────────────────────────────────────── */
  .card__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-lg);
    transition: transform 0.2s ease;
  }

  .card__icon svg {
    width: 22px;
    height: 22px;
  }

  .card:hover .card__icon {
    transform: scale(1.06);
  }

  /* ── Content column ─────────────────────────────────────────────────── */
  .card__content {
    min-width: 0;
    flex: 1;
  }

  .card__title {
    font-size: 20px;
    font-weight: 600;
    line-height: 28px;
    letter-spacing: -0.5px;
    color: var(--color-ink);
  }

  .card__body :global(p) {
    margin-top: 12px;
    font-size: 15.5px;
    line-height: 26px;
    color: var(--color-body);
  }

