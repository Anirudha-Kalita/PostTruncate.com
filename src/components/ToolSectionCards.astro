---
// Card layout for the prose body of redesigned standalone platform pages. Each
// <h2>-delimited section from the tool content becomes an elevated, hover-active
// card with a tinted icon tile on the left and the original heading + copy on
// the right. Text is preserved verbatim (set:html) — this is purely a visual
// reframe of the same content, so it stays translation-safe across all locales.
import type { ToolSection } from '../lib/headingAnchors';

interface Props {
  sections: ToolSection[];
  /** Platform key ('twitter'|'instagram'|…) selecting the icon-tile palette. */
  theme?: string;
}

const { sections, theme } = Astro.props;

