---
// Reserved-dimension AdSense slot. The whole point is zero Cumulative Layout
// Shift: the container reserves its exact pixel footprint in the static HTML,
// so when (or if) an ad fills in later, nothing on the page moves. No ad
// network is wired up yet — this renders a labeled placeholder of the right
// size. Drop the AdSense <ins> tag inside the slot when ready.

export interface Props {
  /** Which reserved footprint to render. */
  variant: 'leaderboard' | 'rectangle' | 'skyscraper';
  /** Optional extra class on the outer wrapper. */
  class?: string;
}

const { variant, class: extra = '' } = Astro.props;

// width/height drive an explicit reserved box. Leaderboard is responsive:
// 728×90 on desktop, collapsing to a 320×100 mobile banner via CSS, but the
// height is fixed at each breakpoint so there is never any reflow.
const SIZES = {
  leaderboard: { w: 728, h: 90 },
  rectangle:   { w: 300, h: 250 },
  skyscraper:  { w: 300, h: 600 },
} as const;

const { w, h } = SIZES[variant];
---

<aside
  class:list={['ad', `ad--${variant}`, extra]}
  style={`--ad-w:${w}px;--ad-h:${h}px;`}
  aria-hidden="true"
>
  <div class="ad__slot">
    {/* AdSense <ins class="adsbygoogle" …/> goes here. */}
  </div>
</aside>

<style>
  .ad {
    display: flex;
    justify-content: center;
  }
  /* The reserved box: fixed height, capped width. Reserving the height is what
     guarantees 0 CLS — content below never jumps when the ad paints. */
  .ad__slot {
    width: 100%;
    max-width: var(--ad-w);
    height: var(--ad-h);
    overflow: hidden;
  }

  /* Mobile leaderboard: shorter fixed height so the reserved space still
     matches what a 320×100 unit would occupy. */
  .ad--leaderboard .ad__slot {
    height: 100px;
  }
  @media (min-width: 768px) {
    .ad--leaderboard .ad__slot {
      height: var(--ad-h);
    }
  }

  .ad--skyscraper {
    position: sticky;
    top: 88px;
  }
</style>
