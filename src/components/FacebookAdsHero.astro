---
// Two-column marketing hero for the Facebook Ads preview page. Left: a blue
// eyebrow badge, headline (with the phrase after the em-dash tinted Facebook
// blue) + lede + on-this-page pills. Right: a Facebook feed-ad card mockup —
// the FB logo, skeleton copy, reactions and a blue CTA bar — over dotted-grid
// decoration and soft blue blobs.
//
// Color scheme mirrors the Facebook platform page (blue base). The accent is
// everything after the "—" so it stays language-agnostic across all 10 locales.
// The illustration is decorative (aria-hidden).
import type { SectionAnchor } from '../lib/headingAnchors';

interface Props {
  title: string;
  intro: string;
  sections: SectionAnchor[];
  onThisPageLabel: string;
}

const { title, intro, sections, onThisPageLabel } = Astro.props;

const dashIndex = title.indexOf('—');
const titleHead = dashIndex >= 0 ? title.slice(0, dashIndex + 1) : title;
const titleTail = dashIndex >= 0 ? title.slice(dashIndex + 1).trim() : '';

// Section navigation icons matching ICON_SETS.facebook in ToolSectionCards.astro
const ICONS = [
  '<path d="M16 3 21 8 8 21 3 16 16 3z"/><path d="M9 9l2 2M12 6l2 2M6 12l2 2"/>',
  '<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  '<path d="M3 21h18"/><rect x="5" y="10" width="3" height="8"/><rect x="10.5" y="5" width="3" height="13"/><rect x="16" y="13" width="3" height="5"/>',
  '<path d="M4 7V5h16v2M9 19h6M12 5v14"/>',
];
---

<header class="fahero">
  <div class="fahero__copy">
    <span class="fahero__eyebrow">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true">
        <path d="M15 8.5h-2.2c-.3 0-.5.2-.5.7V11h2.8l-.4 2.8h-2.4V21h-3v-7.2H7.5V11H9.3V9c0-2.1 1.3-3.5 3.5-3.5H15V8.5z"></path>
      </svg>
      Facebook tools
    </span>

    <h1 class="fahero__title">
      <span>{titleHead}</span>
      {titleTail && <><br /><span class="fahero__accent">{titleTail}</span></>}
    </h1>
    {intro && <p class="fahero__lede">{intro}</p>}
    {/* Jump navigation: mobile dropdown / desktop pills */}
    {sections.length > 0 && (
      <nav class="fahero__jump" aria-label={onThisPageLabel}>
        {/* Mobile dropdown */}
        <details class="fahero__mobile-nav">
          <summary class="fahero__mobile-toggle">
            <span class="fahero__mobile-label">{onThisPageLabel}</span>
            <svg class="fahero__mobile-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <ul class="fahero__mobile-list">
            {sections.map((section) => (
              <li>
                <a class="fahero__mobile-link" href={`#${section.id}`}>{section.label}</a>
              </li>
            ))}
          </ul>
        </details>

        {/* Desktop pills row */}
        <div class="fahero__desktop-nav">
          <span class="fahero__desktop-label">{onThisPageLabel}</span>
          <div class="fahero__pills">
            {sections.map((sec, idx) => (
              <a href={`#${sec.id}`} class="fahero__pill">
                <span class="fahero__pill-icon" set:html={`<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2">${ICONS[idx % ICONS.length]}</svg>`} />
                <span>{sec.label}</span>
              </a>
            ))}
          </div>
        </div>
      </nav>
    )}
  </div>

  <div class="fahero__art" aria-hidden="true">
    <span class="fahero__blob fahero__blob--solid"></span>
    <span class="fahero__blob fahero__blob--soft"></span>
    <span class="fahero__dots fahero__dots--tl"></span>
    <span class="fahero__dots fahero__dots--br"></span>

    <div class="fahero__card">
      <span class="fahero__titlebar"></span>

      <div class="fahero__media">
        <svg viewBox="0 0 24 24" class="fahero__fb" role="presentation">
          <circle cx="12" cy="12" r="12" fill="#1877F2"></circle>
          <path fill="#fff" d="M15 8.5h-2.2c-.3 0-.5.2-.5.7V11h2.8l-.4 2.8h-2.4V21h-3v-7.2H7.5V11H9.3V9c0-2.1 1.3-3.5 3.5-3.5H15V8.5z"></path>
        </svg>
      </div>

      <div class="fahero__lines">
        <span></span>
        <span></span>
      </div>

      <div class="fahero__reacts">
        <span class="fahero__react fahero__react--like">
          <svg viewBox="0 0 24 24" fill="#fff"><path d="M7 22V11H3a1 1 0 0 0-1 1v9a1 1 0 0 0 1 1zM9 11l3.2-6.4A1.6 1.6 0 0 1 14 5.4V10h5a2 2 0 0 1 2 2.3l-1.3 7A2 2 0 0 1 17.7 21H9z"></path></svg>
        </span>
        <span class="fahero__react fahero__react--love">
          <svg viewBox="0 0 24 24" fill="#fff"><path d="M12 21s-8-4.5-8-10a4 4 0 0 1 8-1 4 4 0 0 1 8 1c0 5.5-8 10-8 10z"></path></svg>
        </span>
        <span class="fahero__react fahero__react--haha">
          <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7.3 10.3c.7-.9 1.9-.9 2.6 0"></path>
            <path d="M14.1 10.3c.7-.9 1.9-.9 2.6 0"></path>
            <path d="M6.8 13.4c1.2 2.4 3.1 3.4 5.2 3.4s4-1 5.2-3.4z" fill="#fff" stroke="none"></path>
          </svg>
        </span>
      </div>

      <span class="fahero__cta"></span>
    </div>
  </div>
</header>

<style>
  .fahero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 40px;
  }

  /* ── Left column: copy (blue base, matching the Facebook platform page) ── */
  .fahero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: var(--color-link-bg-soft);
    color: var(--color-link-deep);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .fahero__title {
    font-size: clamp(30px, 5vw, 46px);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -1.8px;
    color: var(--color-ink);
    }

  .fahero__accent {
    color: var(--color-link);
  }

  .fahero__lede {
    margin-top: 18px;
    max-width: 34rem;
    font-size: 18px;
    line-height: 28px;
    color: var(--color-body);
  }

  /* ── Jump menu: responsive mobile / desktop ──────────────────────────── */
  .fahero__jump {
    margin-top: 24px;
  }

  .fahero__mobile-nav {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
  }

  .fahero__mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .fahero__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .fahero__mobile-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .fahero__mobile-chevron {
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.15s ease;
  }

  .fahero__mobile-nav[open] .fahero__mobile-chevron {
    transform: rotate(180deg);
  }

  .fahero__mobile-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0 8px 8px;
    list-style: none;
    border-top: 1px solid var(--color-hairline);
  }

  .fahero__mobile-link {
    display: block;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .fahero__mobile-link:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }

  .fahero__desktop-nav {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .fahero__desktop-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .fahero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .fahero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-body);
    transition: all 0.15s ease;
  }

  .fahero__pill:hover {
    border-color: var(--color-link);
    color: var(--color-link);
    box-shadow: var(--shadow-e1);
  }

  .fahero__pill-icon {
    display: inline-flex;
    align-items: center;
    color: var(--color-link);
  }

  @media (min-width: 640px) {
    .fahero__mobile-nav {
      display: none;
    }
    .fahero__desktop-nav {
      display: flex;
    }
  }

  /* ── Right column: Facebook card mockup ─────────────────────────────── */
  .fahero__art {
    position: relative;
    display: none;
    aspect-ratio: 1 / 1;
    max-width: 440px;
    margin-inline: auto;
    width: 100%;
  }

  .fahero__blob {
    position: absolute;
    border-radius: 50%;
  }
  .fahero__blob--solid {
    right: 2%;
    top: 12%;
    width: 22%;
    aspect-ratio: 1;
    background: var(--color-link);
    opacity: 0.9;
  }
  .fahero__blob--soft {
    left: 2%;
    top: 40%;
    width: 28%;
    aspect-ratio: 1;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-link-bg-soft) 85%, transparent), transparent 70%);
  }

  .fahero__dots {
    position: absolute;
    background-image: radial-gradient(currentColor 1.3px, transparent 1.3px);
    background-size: 11px 11px;
    color: color-mix(in srgb, var(--color-link) 28%, transparent);
  }
  .fahero__dots--tl {
    left: 8%;
    top: 14%;
    width: 74px;
    height: 60px;
  }
  .fahero__dots--br {
    right: 6%;
    bottom: 12%;
    width: 90px;
    height: 74px;
  }

  /* Feed card */
  .fahero__card {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60%;
    display: flex;
    flex-direction: column;
    gap: 11px;
    padding: 16px;
    border-radius: 18px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
  }

  .fahero__titlebar {
    width: 62%;
    height: 9px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas-soft-2);
  }

  .fahero__media {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 16 / 11;
    border-radius: 10px;
    background: var(--color-canvas-soft-2);
  }
  .fahero__fb {
    width: 42%;
    height: 42%;
    filter: drop-shadow(0 3px 6px rgba(11, 74, 173, 0.3));
  }

  .fahero__lines {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .fahero__lines span {
    height: 7px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas-soft-2);
  }
  .fahero__lines span:first-child {
    width: 85%;
  }
  .fahero__lines span:last-child {
    width: 60%;
  }

  .fahero__reacts {
    display: flex;
    align-items: center;
  }
  .fahero__react {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border: 1.5px solid var(--color-canvas);
  }
  .fahero__react:not(:first-child) {
    margin-left: -5px;
  }
  .fahero__react svg {
    width: 11px;
    height: 11px;
  }
  .fahero__react--like {
    background: #1877f2;
  }
  .fahero__react--love {
    background: #f33e58;
  }
  .fahero__react--haha {
    background: #f7b125;
  }

  .fahero__cta {
    height: 22px;
    border-radius: var(--radius-sm);
    background: linear-gradient(180deg, #2a86ff 0%, #1877f2 100%);
  }

  /* ── Responsive: two columns + illustration only on wider viewports ──── */
  @media (min-width: 900px) {
    .fahero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 48px;
      margin-bottom: 48px;
    }

    .fahero__art {
      display: block;
    }
  }
</style>
