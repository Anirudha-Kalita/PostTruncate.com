---
interface FAQItem {
  question: string;
  answerHtml: string;
}

interface Props {
  faqs: FAQItem[];
}

const { faqs } = Astro.props;

const schemaData = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answerHtml,
    },
  })),
};

const schemaJson = JSON.stringify(schemaData).replace(/</g, '\\u003c');
---

<script type="application/ld+json" set:html={schemaJson} />
