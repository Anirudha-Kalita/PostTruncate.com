---
// Shared body for the Privacy Policy page, used by BOTH privacy routes:
//   • /[lang]/privacy/          (src/pages/[lang]/privacy.astro)
//   • /[lang]/<slug>/privacy/   (src/pages/[lang]/[slug]/privacy.astro — nav)
// A hero with a 3D shield illustration + the numbered sections as accent cards.
// Colours use only the site palette tokens (violet / cyan / warning / link).
// Terms keeps the plain Prose renderer; only Privacy uses this layout.
import type { ContentPage } from '../i18n/types';
import { getLocale } from '../i18n/config';

interface Props {
  lang: string;
  page: ContentPage;
  /** Fully interpolated "Last updated: <date>" line. */
  lastUpdated: string;
  /** The date substring (for tinting it), e.g. "June 1, 2026". */
  lastUpdatedDate: string;
  backHome: string;
}

const { lang, page, lastUpdated, lastUpdatedDate, backHome } = Astro.props;
const home = `/${lang}/${getLocale(lang).slug}/`;

// Split the "last updated" line so the date can be tinted.
const dateIdx = lastUpdated.indexOf(lastUpdatedDate);
const luLabel = dateIdx >= 0 ? lastUpdated.slice(0, dateIdx) : lastUpdated;
const luDate = dateIdx >= 0 ? lastUpdatedDate : '';

// Per-section icon + tint, by index (privacy sections are fixed at five).
const MONITOR = '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>';
const DB = '<ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v6c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/><path d="M4 12v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>';
const MEGA = '<path d="M3 10v4a1 1 0 0 0 1 1h3l5 4V5L7 9H4a1 1 0 0 0-1 1z"/><path d="M16 8a4 4 0 0 1 0 8"/>';
const SEND = '<path d="M22 2 11 13M22 2l-7 20-4-9-9-4z"/>';
const CYCLE = '<path d="M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16M3 21v-5h5"/>';
const SECTION_META = [
  { icon: MONITOR, tint: 'tint-violet' },
  { icon: DB, tint: 'tint-green' },
  { icon: MEGA, tint: 'tint-amber' },
  { icon: SEND, tint: 'tint-blue' },
  { icon: CYCLE, tint: 'tint-violet' },
];
const metaFor = (i: number) => SECTION_META[i] ?? { icon: MONITOR, tint: 'tint-violet' };
---

<section class="pv container-page">
  <div class="pv__inner">
    {/* ── Hero ────────────────────────────────────────────────────────── */}
    <header class="pv-hero">
      <div class="pv-hero__copy">
        <h1 class="pv-hero__title">{page.title}</h1>
        <p class="pv-lu">
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M3 9h18M8 2v4M16 2v4"></path></svg>
          <span class="pv-lu__label">{luLabel}</span><span class="pv-lu__date">{luDate}</span>
        </p>
        <p class="pv-hero__intro">{page.intro}</p>
      </div>

      <div class="pv-hero__art" aria-hidden="true">
        <svg viewBox="0 0 200 190" fill="none" xmlns="http://www.w3.org/2000/svg" role="presentation">
          <defs>
            <linearGradient id="pv-shield" x1="0.3" y1="0" x2="0.7" y2="1">
              <stop offset="0" stop-color="#7928ca"></stop>
              <stop offset="1" stop-color="#4c2889"></stop>
            </linearGradient>
          </defs>

          <circle cx="100" cy="80" r="66" fill="#d8ccf1" opacity="0.4"></circle>
          <rect x="26" y="74" width="70" height="84" rx="10" fill="#d8ccf1" opacity="0.45" transform="rotate(-6 61 116)"></rect>
          <rect x="40" y="92" width="42" height="5" rx="2.5" fill="#c4b4ea" opacity="0.6" transform="rotate(-6 61 116)"></rect>
          <rect x="40" y="104" width="34" height="5" rx="2.5" fill="#c4b4ea" opacity="0.55" transform="rotate(-6 61 116)"></rect>

          <path d="M100 22 148 40V72c0 34-20 58-48 74-28-16-48-40-48-74V40z" fill="url(#pv-shield)"></path>
          <path d="M100 22 148 40v18c-18 12-78 12-96 0V40z" fill="#ffffff" opacity="0.12"></path>

          <path d="M88 78v-6a12 12 0 0 1 24 0v6" fill="none" stroke="#ffffff" stroke-width="6" stroke-linecap="round"></path>
          <rect x="82" y="78" width="36" height="30" rx="7" fill="#ffffff"></rect>
          <circle cx="100" cy="90" r="3.6" fill="#5b2e9e"></circle>
          <rect x="98.4" y="90" width="3.2" height="9" rx="1.6" fill="#5b2e9e"></rect>

          <circle cx="150" cy="128" r="18" fill="#ffffff" stroke="#50e3c2" stroke-width="3"></circle>
          <path d="M143 128 148 133 158 122" stroke="#29bc9b" stroke-width="3.6" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>

          <path d="M40 58h10M45 53v10" stroke="#7928ca" stroke-width="3" stroke-linecap="round" opacity="0.55"></path>
          <path d="M170 64h8M174 60v8" stroke="#7928ca" stroke-width="2.5" stroke-linecap="round" opacity="0.4"></path>
          <circle cx="166" cy="40" r="3.5" fill="#50e3c2"></circle>
          <circle cx="36" cy="132" r="3" fill="#7928ca" opacity="0.5"></circle>
        </svg>
      </div>
    </header>

    {/* ── Sections ────────────────────────────────────────────────────── */}
    {
      page.sections.map((s, i) => {
        const meta = metaFor(i);
        return (
          <section class={`pv-card ${meta.tint}`}>
            <span class="pv-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={meta.icon} /></span>
            <div class="pv-card__content">
              <h2 class="pv-card__title">{i + 1}. {s.heading}</h2>
              {s.paragraphs.map((p) => <p class="pv-card__p" set:html={p} />)}
            </div>
          </section>
        );
      })
    }

    <a class="pv-back" href={`${home}#workspace`}>← {backHome}</a>
  </div>
</section>

<style>
  .pv {
    scroll-margin-top: 80px;
    padding-top: 44px;
    padding-bottom: 96px;
  }
  .pv__inner {
    max-width: 60rem;
    margin-inline: auto;
  }

  /* ── Tint tokens (site palette only) ──────────────────────────────────── */
  .tint-violet {
    --soft: var(--color-violet-soft);
    --fg: var(--color-violet-deep);
  }
  .tint-green {
    --soft: var(--color-cyan-soft);
    --fg: var(--color-cyan-deep);
  }
  .tint-amber {
    --soft: var(--color-warning-soft);
    --fg: var(--color-warning-deep);
  }
  .tint-blue {
    --soft: var(--color-link-bg-soft);
    --fg: var(--color-link);
  }

  /* ── Hero ─────────────────────────────────────────────────────────────── */
  .pv-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    align-items: center;
    margin-bottom: 44px;
  }
  .pv-hero__title {
    font-size: clamp(34px, 5.4vw, 52px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -1.9px;
    color: var(--color-ink);
  }
  .pv-lu {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 14px;
    color: var(--color-mute);
  }
  .pv-lu__label {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .pv-lu__date {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-violet-deep);
  }
  .pv-hero__intro {
    margin-top: 16px;
    max-width: 34rem;
    font-size: 17px;
    line-height: 27px;
    color: var(--color-body);
  }
  .pv-hero__art {
    display: none;
    justify-self: end;
    width: 100%;
    max-width: 320px;
  }
  .pv-hero__art svg {
    width: 100%;
    height: auto;
  }

  /* ── Accent cards ─────────────────────────────────────────────────────── */
  .pv-card {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-top: 22px;
    padding: 26px 28px;
    border-radius: var(--radius-xl);
    border-left: 4px solid var(--fg);
    background: color-mix(in srgb, var(--fg) 4%, var(--color-canvas));
    box-shadow: var(--shadow-e1);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .pv-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-e4);
  }
  .pv-card:hover .pv-card__icon {
    transform: scale(1.06);
  }
  .pv-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--soft);
    color: var(--fg);
    transition: transform 0.2s ease;
  }
  .pv-card__icon svg {
    width: 22px;
    height: 22px;
  }
  .pv-card__content {
    flex: 1;
    min-width: 0;
  }
  .pv-card__title {
    font-size: 21px;
    font-weight: 600;
    line-height: 29px;
    letter-spacing: -0.5px;
    color: var(--color-ink);
  }
  .pv-card__p {
    margin-top: 12px;
    font-size: 16px;
    line-height: 27px;
    color: var(--color-body);
  }
  .pv-card__p :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }
  .pv-card__p :global(a) {
    color: var(--color-violet-deep);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .pv-back {
    display: inline-block;
    margin-top: 36px;
    padding-top: 24px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-body);
    border-top: 1px solid var(--color-hairline);
    transition: color 0.15s ease;
  }
  .pv-back:hover {
    color: var(--color-ink);
  }

  @media (min-width: 900px) {
    .pv-hero {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 40px;
    }
    .pv-hero__art {
      display: block;
    }
  }

  @media (max-width: 600px) {
    .pv-card {
      flex-direction: column;
      gap: 14px;
      padding: 22px 20px;
    }
  }
</style>
