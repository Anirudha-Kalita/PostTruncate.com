---
// Two-column marketing hero for the Sentence Counter page. Left: a
// blue eyebrow badge, headline (with the accent tail in a blue gradient)
// + lede + on-this-page pills. Right: a document mockup illustration
// with selection guide lines, floating circular badges, and a metrics card.
//
// The accent tail is custom styled to stay clean across locales.
import type { SectionAnchor } from '../lib/headingAnchors';

interface Props {
  title: string;
  intro: string;
  sections: SectionAnchor[];
  onThisPageLabel: string;
}

const { title, intro, sections, onThisPageLabel } = Astro.props;

const dashIndex = title.indexOf('—');
const titleHead = dashIndex >= 0 ? title.slice(0, dashIndex + 1) : title;
const titleTail = dashIndex >= 0 ? title.slice(dashIndex + 1).trim() : '';

// Helper to resolve custom icons for each section in the Jump Links list
const getLinkIcon = (id: string) => {
  if (id.includes('why')) {
    // Diagram / Stats circles icon
    return '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>';
  }
  if (id.includes('what') || id.includes('sentence')) {
    // Quote / link icon
    return '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" /></svg>';
  }
  if (id.includes('private') || id.includes('instant')) {
    // Security lock icon
    return '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>';
  }
  // Lines/Paragraphs list icon (Default)
  return '<svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h16M4 18h12"></path></svg>';
};
---

<header class="schero">
  <div class="schero__copy">
    <span class="schero__eyebrow">
      <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
      </svg>
      Writing Tool
    </span>

    <h1 class="schero__title">
      <span>{titleHead}</span>
      {titleTail && <><br /><span class="schero__accent">{titleTail}</span></>}
    </h1>
    {intro && <p class="schero__lede">{intro}</p>}
    
    {/* Jump navigation: mobile dropdown / desktop pills */}
    {sections.length > 0 && (
      <nav class="schero__jump" aria-label={onThisPageLabel}>
        {/* Mobile dropdown */}
        <details class="schero__mobile-nav">
          <summary class="schero__mobile-toggle">
            <span class="schero__mobile-label">{onThisPageLabel}</span>
            <svg class="schero__mobile-chevron" width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
              <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </summary>
          <ul class="schero__mobile-list">
            {sections.map((section) => (
              <li>
                <a class="schero__mobile-link" href={`#${section.id}`}>{section.label}</a>
              </li>
            ))}
          </ul>
        </details>

        {/* Desktop pills row */}
        <div class="schero__desktop-nav">
          <span class="schero__desktop-label">{onThisPageLabel}</span>
          <div class="schero__pills">
            {sections.map((sec) => (
              <a href={`#${sec.id}`} class="schero__pill">
                <span class="schero__pill-icon" set:html={getLinkIcon(sec.id)} />
                <span>{sec.label}</span>
              </a>
            ))}
          </div>
        </div>
      </nav>
    )}
  </div>

  <div class="schero__art" aria-hidden="true">
    <span class="schero__blob schero__blob--1"></span>
    <span class="schero__blob schero__blob--2"></span>
    <span class="schero__dots"></span>

    {/* Connecting Guideline Lines */}
    <span class="schero__line-connect schero__line-connect--horizontal"></span>
    <span class="schero__line-connect schero__line-connect--vertical"></span>

    {/* Document mockup card */}
    <div class="schero__card">
      <div class="schero__card-inner">
        {/* Green header bar */}
        <div class="schero__card-header-bar"></div>
        {/* Skeleton lines representing document text */}
        <div class="schero__lines">
          <span class="schero__line schero__line--full"></span>
          <span class="schero__line schero__line--long"></span>
          <span class="schero__line schero__line--medium"></span>
          
          {/* Sentence selection visual */}
          <div class="schero__sentence-select">
            <span class="schero__select-dot schero__select-dot--left"></span>
            <span class="schero__select-line"></span>
            <span class="schero__select-dot schero__select-dot--right"></span>
          </div>

          <span class="schero__line schero__line--full"></span>
          <span class="schero__line schero__line--long"></span>
        </div>
      </div>
    </div>

    {/* Floating Lines/Paragraphs circular badge (left) */}
    <div class="schero__badge schero__badge--lines">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 6h16M4 12h16M4 18h12"></path>
      </svg>
    </div>

    {/* Floating Text letter circular badge (right) */}
    <div class="schero__badge schero__badge--letter">
      <span class="schero__letter-t">T</span>
    </div>

    {/* Floating Sentences/Paragraphs count card (bottom right) */}
    <div class="schero__floating-stats">
      <div class="schero__stat-item">
        <span class="schero__stat-bullet"></span>
        <div>
          <div class="schero__stat-num">12</div>
          <div class="schero__stat-lbl">sentences</div>
        </div>
      </div>
      <div class="schero__stat-item">
        <span class="schero__stat-bullet"></span>
        <div>
          <div class="schero__stat-num">6</div>
          <div class="schero__stat-lbl">paragraphs</div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .schero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 40px;
  }

  /* ── Left column copy ────────────────────────────────────────────────── */
  .schero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 18px;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, #2563eb 12%, transparent);
    color: #2563eb;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .schero__title {
    font-size: clamp(30px, 5vw, 44px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -1.6px;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .schero__accent {
    background: linear-gradient(96deg, #2563eb 0%, #4f86f7 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .schero__lede {
    margin-top: 18px;
    max-width: 35rem;
    font-size: 17px;
    line-height: 27px;
    color: var(--color-body);
  }

  /* ── Jump menu: responsive mobile / desktop ──────────────────────────── */
  .schero__jump {
    margin-top: 32px;
  }

  .schero__mobile-nav {
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    background: var(--color-canvas);
  }

  .schero__mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 14px;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }

  .schero__mobile-toggle::-webkit-details-marker {
    display: none;
  }

  .schero__mobile-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .schero__mobile-chevron {
    flex-shrink: 0;
    color: var(--color-mute);
    transition: transform 0.15s ease;
  }

  .schero__mobile-nav[open] .schero__mobile-chevron {
    transform: rotate(180deg);
  }

  .schero__mobile-list {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0 8px 8px;
    list-style: none;
    border-top: 1px solid var(--color-hairline);
  }

  .schero__mobile-link {
    display: block;
    padding: 8px 10px;
    border-radius: var(--radius-sm);
    font-size: 13px;
    line-height: 18px;
    color: var(--color-body);
    text-decoration: none;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .schero__mobile-link:hover {
    color: var(--color-ink);
    background: var(--color-canvas-soft-2);
  }

  .schero__desktop-nav {
    display: none;
    flex-direction: column;
    gap: 12px;
  }

  .schero__desktop-label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-mute);
  }

  .schero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .schero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    font-size: 13.5px;
    font-weight: 500;
    color: var(--color-body);
    transition: all 0.15s ease;
  }

  .schero__pill:hover {
    border-color: var(--color-link);
    color: var(--color-link);
    box-shadow: var(--shadow-e1);
  }

  .schero__pill-icon {
    display: inline-flex;
    align-items: center;
    color: var(--color-link);
  }

  @media (min-width: 640px) {
    .schero__mobile-nav {
      display: none;
    }
    .schero__desktop-nav {
      display: flex;
    }
  }

  /* ── Right column illustration ───────────────────────────────────────── */
  .schero__art {
    position: relative;
    display: none;
    aspect-ratio: 1.1 / 1;
    max-width: 460px;
    margin-inline: auto;
    width: 100%;
  }

  .schero__blob {
    position: absolute;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, #2563eb 12%, transparent), transparent 70%);
  }
  .schero__blob--1 {
    left: 2%;
    top: 15%;
    width: 32%;
    aspect-ratio: 1;
  }
  .schero__blob--2 {
    right: 2%;
    bottom: 10%;
    width: 25%;
    aspect-ratio: 1;
    opacity: 0.6;
  }
  .schero__dots {
    position: absolute;
    right: 6%;
    top: 5%;
    width: 76px;
    height: 50px;
    background-image: radial-gradient(currentColor 1.3px, transparent 1.3px);
    background-size: 11px 11px;
    color: color-mix(in srgb, #2563eb 22%, transparent);
  }

  /* Connecting guideline lines */
  .schero__line-connect {
    position: absolute;
    background: color-mix(in srgb, var(--color-link) 15%, transparent);
    z-index: 1;
  }
  .schero__line-connect--horizontal {
    left: 45%;
    bottom: 25%;
    width: 35%;
    height: 2px;
  }
  .schero__line-connect--vertical {
    left: 24%;
    bottom: 16%;
    width: 2px;
    height: 18%;
  }

  /* Document card */
  .schero__card {
    position: absolute;
    top: 48%;
    left: 44%;
    transform: translate(-50%, -50%);
    width: 58%;
    padding: 24px;
    border-radius: 20px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-e5);
    z-index: 2;
  }
  .schero__card-inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* Green header bar representing title */
  .schero__card-header-bar {
    width: 48%;
    height: 12px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-success) 24%, transparent);
    margin-bottom: 4px;
  }

  /* Skeleton text lines */
  .schero__lines {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .schero__line {
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--color-canvas-soft-2);
  }
  .schero__line--full   { width: 100%; }
  .schero__line--long   { width: 85%; }
  .schero__line--medium { width: 68%; }

  /* Sentence selection visual line with dot highlights */
  .schero__sentence-select {
    position: relative;
    display: flex;
    align-items: center;
    height: 16px;
    margin-block: 6px;
  }
  .schero__select-line {
    width: 40%;
    height: 3px;
    border-radius: var(--radius-pill);
    background: var(--color-link);
    margin-left: 10%;
  }
  .schero__select-dot {
    position: absolute;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-link);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-link) 25%, transparent);
  }
  .schero__select-dot--left {
    left: 10%;
  }
  .schero__select-dot--right {
    left: 50%;
    transform: translateX(-100%);
  }

  /* Floating badges */
  .schero__badge {
    position: absolute;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-canvas);
    box-shadow: var(--shadow-e3);
    z-index: 3;
    border: 1px solid var(--color-hairline);
  }
  .schero__badge--lines {
    left: 5%;
    top: 30%;
    width: 46px;
    height: 46px;
    background: var(--color-link);
    color: var(--color-on-primary);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--color-link) 35%, transparent);
    animation: schero-float 3.8s ease-in-out infinite;
  }
  .schero__badge--letter {
    right: 5%;
    top: 48%;
    width: 44px;
    height: 44px;
    background: color-mix(in srgb, var(--color-link) 12%, transparent);
    color: var(--color-link);
    border-color: color-mix(in srgb, var(--color-link) 20%, transparent);
    animation: schero-float 4.2s ease-in-out 0.3s infinite;
  }
  .schero__letter-t {
    font-size: 19px;
    font-weight: 700;
    font-family: var(--font-sans);
  }

  /* Floating sentences/paragraphs count metrics card */
  .schero__floating-stats {
    position: absolute;
    right: 6%;
    bottom: 10%;
    width: 140px;
    padding: 16px;
    border-radius: 16px;
    background: var(--color-canvas);
    box-shadow: var(--shadow-e4);
    border: 1px solid var(--color-hairline);
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 12px;
    animation: schero-float 4s ease-in-out 0.6s infinite;
  }
  .schero__stat-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .schero__stat-bullet {
    width: 16px;
    height: 20px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--color-link) 10%, transparent);
    flex-shrink: 0;
  }
  .schero__stat-num {
    font-mono: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-ink);
  }
  .schero__stat-lbl {
    font-size: 10.5px;
    color: var(--color-mute);
    line-height: 1;
    margin-top: 1px;
  }

  /* Floating animation */
  @keyframes schero-float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-5px); }
  }

  /* ── Responsive breakpoints ─────────────────────────────────────────── */
  @media (min-width: 900px) {
    .schero {
      grid-template-columns: 1.150fr 0.850fr;
      gap: 48px;
      margin-bottom: 48px;
    }

    .schero__art {
      display: block;
    }
  }
</style>
