---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { getTranslations } from '../i18n';
import { LOCALES, getLocale, DEFAULT_LOCALE } from '../i18n/config';

interface FAQSchemaItem {
  question: string;
  answerHtml: string;
}

export interface Props {
  /** Active locale code (e.g. "en", "da"). Drives every translated string. */
  lang: string;
  /** <title> + OG title. Defaults to the locale's SEO title. */
  title?: string;
  /** Meta description + OG/Twitter description. Defaults to the locale's. */
  description?: string;
  /** In-locale path (e.g. "/"); the locale prefix is added automatically. */
  path?: string;
  /** Optional JSON-LD blocks to inject (WebApplication, FAQPage, …). */
  jsonLd?: Record<string, unknown>[];
  /** Optional FAQ items rendered as a strict FAQPage JSON-LD block in <head>. */
  faqSchema?: FAQSchemaItem[];
  /** Error/utility pages: emit robots=noindex and drop canonical + hreflang
      (they're served locale-neutrally at the host root, so per-locale
      alternates would point at URLs that don't exist). */
  noindex?: boolean;
}

const {
  lang,
  title,
  description,
  path = '/',
  jsonLd = [],
  faqSchema = [],
  noindex = false,
} = Astro.props;

const t = getTranslations(lang);
const locale = getLocale(lang);

const pageTitle = title ?? t.seo.title;
const pageDescription = description ?? t.seo.description;

const site = Astro.site ?? new URL('https://posttruncate.com');
const ogImage = new URL('/og.png', site).href;

// Build the absolute URL for this same page in a given locale. Every locale is
// prefixed (/en/, /da/, …), so the canonical and all hreflang alternates are
// just the locale code + the in-locale path.
const localeHref = (code: string) =>
  new URL(`/${code}${path === '/' ? '/' : path}`, site).href;

const canonical = localeHref(lang);
---

<!doctype html>
<html lang={lang} dir={locale.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Truncater" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-VS8NYMW8FJ"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-VS8NYMW8FJ');
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {/* Keyword set is intentionally English across every locale — the long-form
        body copy below the editor targets the same high-volume English search
        terms regardless of UI language. */}
    <meta
      name="keywords"
      content="character counter, twitter character counter, letter counter, character checker, symbol counter, char length counter, character and word counter, character count check, character count in text, character count in word, character count limit, character counts online, character length, character length count, character number counter, count amount of characters, count characters of text, count letter online, count no of characters, count symbol online, count words and characters, online char counter, online count letters, word text counter, word to character count, words and characters counter, on line word counter, word counter tool, character and word count, word count character count, character count tool, character count online free, count how many characters, word counter tool online, character counter online, online character counter, chinese character counter, character counter tool, text character counter, character counter with spaces, instagram character counter, moz character counter, character counter including spaces, grammarly character counter, sms character counter, character counter word, macos character counter, word character counter, free character counter"
    />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#ffffff" />

    {/* hreflang alternates — one per locale + an x-default so search engines
        map the language variants to each other. Skipped on noindex (error)
        pages, which are served locale-neutrally at the host root. */}
    {
      !noindex &&
        LOCALES.map((l) => (
          <link rel="alternate" hreflang={l.code} href={localeHref(l.code)} />
        ))
    }
    {
      !noindex && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={localeHref(DEFAULT_LOCALE)}
        />
      )
    }

    {/* Apply the saved/system theme before first paint — no flash of light.
        Inlined (is:inline) so it runs synchronously in <head>, ahead of body
        render, rather than being bundled and deferred like normal scripts. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark =
            stored === 'dark' ||
            (!stored &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) {
            document.documentElement.dataset.theme = 'dark';
            var m = document.querySelector('meta[name="theme-color"]');
            if (m) m.setAttribute('content', '#0a0a0a');
          }
        } catch (e) {}
      })();
    </script>

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PostTruncate" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale.ogLocale} />
    {
      LOCALES.filter((l) => l.code !== lang).map((l) => (
        <meta property="og:locale:alternate" content={l.ogLocale} />
      ))
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    {
      jsonLd.map((block) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(block)}
        />
      ))
    }
    {faqSchema.length > 0 && <FAQSchema faqs={faqSchema} />}
  </head>
  <body>
    <a href="#workspace" class="skip-link">{t.seo.skipLink}</a>
    <Nav lang={lang} nav={t.nav} />
    <slot />
    <Footer lang={lang} footer={t.footer} />
  </body>
</html>

<style>
  /* Keyboard-only skip link — hidden until focused. */
  .skip-link {
    position: absolute;
    left: 16px;
    top: -48px;
    z-index: 100;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-on-primary);
    font-size: 14px;
    font-weight: 500;
    transition: top 0.15s ease;
  }
  .skip-link:focus {
    top: 16px;
  }
</style>
