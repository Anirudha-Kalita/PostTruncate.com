---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { getTranslations } from '../i18n';
import { LOCALES, getLocale, DEFAULT_LOCALE } from '../i18n/config';

interface FAQSchemaItem {
  question: string;
  answerHtml: string;
}

export interface Props {
  /** Active locale code (e.g. "en", "da"). Drives every translated string. */
  lang: string;
  /** <title> + OG title. Defaults to the locale's SEO title. */
  title?: string;
  /** Meta description + OG/Twitter description. Defaults to the locale's. */
  description?: string;
  /** In-locale path (e.g. "/"); the locale prefix is added automatically. */
  path?: string;
  /** Optional JSON-LD blocks to inject (WebApplication, FAQPage, …). */
  jsonLd?: Record<string, unknown>[];
  /** Optional FAQ items rendered as a strict FAQPage JSON-LD block in <head>. */
  faqSchema?: FAQSchemaItem[];
  /** Error/utility pages: emit robots=noindex and drop canonical + hreflang
      (they're served locale-neutrally at the host root, so per-locale
      alternates would point at URLs that don't exist). */
  noindex?: boolean;
  /**
   * Override the auto-generated hreflang alternates. When provided, these are
   * emitted instead of the LOCALES-derived block. Required for tool pages where
   * each locale has a different URL slug (so localeHref(code) would be wrong).
   * Must include an x-default entry if desired.
   */
  hreflangUrls?: { hreflang: string; href: string }[];
  /**
   * Override the canonical URL. When provided, replaces the localeHref-derived
   * canonical. Used by tool pages whose canonical can't be derived from `path`.
   */
  canonicalUrl?: string;
}

const {
  lang,
  title,
  description,
  path = '/',
  jsonLd = [],
  faqSchema = [],
  noindex = false,
  hreflangUrls,
  canonicalUrl: canonicalOverride,
} = Astro.props;

const t = getTranslations(lang);
const locale = getLocale(lang);

const pageTitle = title ?? t.seo.title;
const pageDescription = description ?? t.seo.description;

const site = Astro.site ?? new URL('https://posttruncate.com');
const ogImage = new URL('/og.png', site).href;

// Build the absolute URL for this same page in a given locale. For the
// homepage (path === '/') each locale uses its keyword-rich slug; other pages
// keep the shared in-locale path unchanged.
const localeHref = (code: string) => {
  const l = getLocale(code);
  const resolvedPath = path === '/' ? `/${l.slug}/` : path;
  return new URL(`/${code}${resolvedPath}`, site).href;
};

const canonical = canonicalOverride ?? localeHref(lang);
---

<!doctype html>
<html lang={lang} dir={locale.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Truncator" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content="Astro" />

    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-XJBDNTT4GP"
    ></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());

      gtag('config', 'G-XJBDNTT4GP');
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#ffffff" />

    {/* hreflang alternates — one per locale + an x-default so search engines
        map the language variants to each other. Skipped on noindex (error)
        pages, which are served locale-neutrally at the host root.
        Tool pages supply hreflangUrls directly because each locale has a
        different slug that localeHref() cannot derive from `path` alone. */}
    {
      !noindex && hreflangUrls
        ? hreflangUrls.map((a) => (
            <link rel="alternate" hreflang={a.hreflang} href={a.href} />
          ))
        : !noindex &&
          LOCALES.map((l) => (
            <link rel="alternate" hreflang={l.code} href={localeHref(l.code)} />
          ))
    }
    {
      !noindex && !hreflangUrls && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={localeHref(DEFAULT_LOCALE)}
        />
      )
    }

    {/* Apply the saved/system theme before first paint — no flash of light.
        Inlined (is:inline) so it runs synchronously in <head>, ahead of body
        render, rather than being bundled and deferred like normal scripts. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark =
            stored === 'dark' ||
            (!stored &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) {
            document.documentElement.dataset.theme = 'dark';
            var m = document.querySelector('meta[name="theme-color"]');
            if (m) m.setAttribute('content', '#0a0a0a');
          }
        } catch (e) {}
      })();
    </script>

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="PostTruncate" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale.ogLocale} />
    {
      LOCALES.filter((l) => l.code !== lang).map((l) => (
        <meta property="og:locale:alternate" content={l.ogLocale} />
      ))
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'PostTruncate',
        url: 'https://posttruncate.com/',
      })}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'PostTruncate',
        url: 'https://posttruncate.com/',
        logo: 'https://posttruncate.com/favicon-96x96.png',
        contactPoint: {
          '@type': 'ContactPoint',
          contactType: 'customer support',
          email: 'contact@posttruncate.com',
        },
      })}
    />
    {
      jsonLd.map((block) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(block)}
        />
      ))
    }
    {faqSchema.length > 0 && <FAQSchema faqs={faqSchema} />}
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t.seo.skipLink}</a>
    <Nav lang={lang} nav={t.nav} />
    <span id="main-content" class="skip-target" tabindex="-1" aria-hidden="true"></span>
    <slot />
    <Footer lang={lang} footer={t.footer} isHome={path === '/'} />
  </body>
</html>

<style>
  /* Keyboard-only skip link — hidden until focused. */
  .skip-link {
    position: absolute;
    left: 16px;
    top: -48px;
    z-index: 100;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-on-primary);
    font-size: 14px;
    font-weight: 500;
    transition: top 0.15s ease;
  }
  .skip-link:focus {
    top: 16px;
  }
  .skip-target {
    display: block;
    scroll-margin-top: 80px;
  }
</style>
