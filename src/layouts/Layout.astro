---
import '../styles/global.css';
// Import the primary Geist latin woff2 subset so Astro/Vite resolves the final
// hashed /_astro/...woff2 URL for an early <head> preload (fixes font-swap CLS).
import geistLatin from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2';
// Geist Mono drives --font-mono, used above the fold on nearly every page
// (section eyebrows, the editor's live counters, …). Without a preload hint
// the browser only discovers it once layout resolves the CSS @font-face rule,
// which lands it deep in the critical request chain (Lighthouse flags this).
import geistMonoLatin from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import FooterMinimal from '../components/FooterMinimal.astro';
import FAQSchema from '../components/FAQSchema.astro';
import { getTranslations } from '../i18n';
import { LOCALES, getLocale, DEFAULT_LOCALE } from '../i18n/config';

interface FAQSchemaItem {
  question: string;
  answerHtml: string;
}

export interface Props {
  /** Active locale code (e.g. "en", "da"). Drives every translated string. */
  lang: string;
  /** <title> + OG title. Defaults to the locale's SEO title. */
  title?: string;
  /** Meta description + OG/Twitter description. Defaults to the locale's. */
  description?: string;
  /** In-locale path (e.g. "/"); the locale prefix is added automatically. */
  path?: string;
  /** Optional JSON-LD blocks to inject (WebApplication, FAQPage, …). */
  jsonLd?: Record<string, unknown>[];
  /** Optional FAQ items rendered as a strict FAQPage JSON-LD block in <head>. */
  faqSchema?: FAQSchemaItem[];
  /** Error/utility pages: emit robots=noindex and drop canonical + hreflang
      (they're served locale-neutrally at the host root, so per-locale
      alternates would point at URLs that don't exist). */
  noindex?: boolean;
  /**
   * Override the auto-generated hreflang alternates. When provided, these are
   * emitted instead of the LOCALES-derived block. Required for tool pages where
   * each locale has a different URL slug (so localeHref(code) would be wrong).
   * Must include an x-default entry if desired.
   */
  hreflangUrls?: { hreflang: string; href: string }[];
  /**
   * Override the canonical URL. When provided, replaces the localeHref-derived
   * canonical. Used by tool pages whose canonical can't be derived from `path`.
   */
  canonicalUrl?: string;
  /** OpenGraph object type. Defaults to "website"; blog posts pass "article". */
  ogType?: 'website' | 'article';
  /** Override the OG/Twitter image (path or absolute URL). Defaults to /og.webp. */
  ogImage?: string;
  /** ISO 8601 publish time → article:published_time (only when ogType="article"). */
  articlePublishedTime?: string;
  /** ISO 8601 modified time → article:modified_time (only when ogType="article"). */
  articleModifiedTime?: string;
  /** Footer variant to render. Defaults to 'full'. */
  footerVariant?: 'full' | 'minimal';
  /** Suppress the bookmark/save toast (e.g. on legal pages). */
  hideBookmarkToast?: boolean;
}

const {
  lang,
  title,
  description,
  path = '/',
  jsonLd = [],
  faqSchema = [],
  noindex = false,
  hreflangUrls,
  canonicalUrl: canonicalOverride,
  ogType = 'website',
  ogImage: ogImageOverride,
  articlePublishedTime,
  articleModifiedTime,
  footerVariant = 'full',
  hideBookmarkToast = false,
} = Astro.props;

const t = getTranslations(lang);
const locale = getLocale(lang);

const pageTitle = title ?? t.seo.title;
const pageDescription = description ?? t.seo.description;

const site = Astro.site ?? new URL('https://posttruncate.com');
const ogImage = new URL(ogImageOverride ?? '/og.webp', site).href;

// Build the absolute URL for this same page in a given locale. For the
// homepage (path === '/') each locale uses its keyword-rich slug; other pages
// keep the shared in-locale path unchanged.
const localeHref = (code: string) => {
  const l = getLocale(code);
  const resolvedPath = path === '/' ? `/${l.slug}/` : path;
  return new URL(`/${code}${resolvedPath}`, site).href;
};

const canonical = canonicalOverride ?? localeHref(lang);
---

<!doctype html>
<html lang={lang} dir={locale.dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="PostTruncate" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content="Astro" />

    {/* Preload the primary Geist latin subset (self-hosted /_astro/ URL) so the
        font is discovered before the stylesheet pulls it in, letting the swap
        complete before first contentful paint. crossorigin matches the font's
        anonymous CORS fetch. */}
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoLatin} as="font" type="font/woff2" crossorigin />

    {/* Preconnect to the third-party origins AdSense and gtag load from, so
        when they fire (on first interaction, see below) the DNS/TLS/TCP
        handshake is already done. crossorigin is required for cross-origin
        script fetches. */}
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />

    <!-- Google AdSense — loaded lazily on first interaction (or on idle as a
         fallback), mirroring the gtag pattern below. The loader is required
         on any page that renders an AdSense <ins> unit; gating it keeps the
         ~127KB show_ads_impl.js off the critical render path. The <Ad>
         component is currently a placeholder, so no ad calls are delayed. -->
    <script is:inline>
      (function () {
        var loaded = false;
        function loadAds() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.crossOrigin = 'anonymous';
          s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8097135701630154';
          document.head.appendChild(s);
        }
        ['scroll', 'keydown', 'pointerdown', 'touchstart'].forEach(function (e) {
          window.addEventListener(e, loadAds, { once: true, passive: true });
        });
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadAds, { timeout: 3500 });
        } else {
          setTimeout(loadAds, 3500);
        }
      })();
    </script>

    <!-- Google tag (gtag.js) — loaded lazily on first interaction (or on idle as
         a fallback), not eagerly in <head>. gtag.js's initialization reads
         layout geometry for engagement/scroll tracking, which showed up as an
         unattributed forced reflow during load. The dataLayer stub below queues
         config immediately; the real library drains that queue once it loads, so
         no analytics events are lost. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-XJBDNTT4GP');

      (function () {
        var loaded = false;
        function loadGA() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=G-XJBDNTT4GP';
          document.head.appendChild(s);
        }
        // Load on the first real user interaction…
        ['scroll', 'keydown', 'pointerdown', 'touchstart'].forEach(function (e) {
          window.addEventListener(e, loadGA, { once: true, passive: true });
        });
        // …or when the browser goes idle, so analytics still fires for visitors
        // who never interact (bounce traffic).
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadGA, { timeout: 3500 });
        } else {
          setTimeout(loadGA, 3500);
        }
      })();
    </script>

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#ffffff" />

    {/* hreflang alternates — one per locale + an x-default so search engines
        map the language variants to each other. Skipped on noindex (error)
        pages, which are served locale-neutrally at the host root.
        Tool pages supply hreflangUrls directly because each locale has a
        different slug that localeHref() cannot derive from `path` alone. */}
    {
      !noindex && hreflangUrls
        ? hreflangUrls.map((a) => (
            <link rel="alternate" hreflang={a.hreflang} href={a.href} />
          ))
        : !noindex &&
          LOCALES.map((l) => (
            <link rel="alternate" hreflang={l.code} href={localeHref(l.code)} />
          ))
    }
    {
      !noindex && !hreflangUrls && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={localeHref(DEFAULT_LOCALE)}
        />
      )
    }

    {/* Apply the saved/system theme before first paint — no flash of light.
        Inlined (is:inline) so it runs synchronously in <head>, ahead of body
        render, rather than being bundled and deferred like normal scripts. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var dark =
            stored === 'dark' ||
            (!stored &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);
          if (dark) {
            document.documentElement.dataset.theme = 'dark';
            var m = document.querySelector('meta[name="theme-color"]');
            if (m) m.setAttribute('content', '#0a0a0a');
          }
        } catch (e) {}
      })();
    </script>

    <!-- OpenGraph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="PostTruncate" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={locale.ogLocale} />
    {ogType === 'article' && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {ogType === 'article' && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}
    {
      LOCALES.filter((l) => l.code !== lang).map((l) => (
        <meta property="og:locale:alternate" content={l.ogLocale} />
      ))
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: 'PostTruncate',
        url: 'https://posttruncate.com/',
      })}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Organization',
        name: 'PostTruncate',
        url: 'https://posttruncate.com/',
        logo: 'https://posttruncate.com/favicon-96x96.png',
        contactPoint: {
          '@type': 'ContactPoint',
          contactType: 'customer support',
          email: 'contact@posttruncate.com',
        },
      })}
    />
    {
      jsonLd.map((block) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(block)}
        />
      ))
    }
    {faqSchema.length > 0 && <FAQSchema faqs={faqSchema} />}
    <slot name="head" />
  </head>
  <body>
    <a href="#main-content" class="skip-link">{t.seo.skipLink}</a>
    <Nav lang={lang} nav={t.nav} />
    <span id="main-content" class="skip-target" tabindex="-1" aria-hidden="true"></span>
    <slot />
    {footerVariant === 'full' ? (
      <Footer lang={lang} footer={t.footer} isHome={path === '/'} />
    ) : (
      <FooterMinimal lang={lang} footer={t.footer} />
    )}

    <!-- Back-to-top: fixed floating control, revealed once the page is
         scrolled. Smooth-scrolls to the top (instant under reduced-motion). -->
    <button type="button" class="to-top" aria-label={t.nav.backToTop} hidden>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7" />
      </svg>
    </button>

    {/* Bookmark / save nudge — fixed slide-in toast shown once per visitor
        (localStorage-gated). Triggered contextually by the editor.
        The element is visibility-hidden initially so it never causes layout shift (CLS).
        Strings come from the active locale. */}
    {!hideBookmarkToast && (
      <aside
        class="bk-toast"
        role="dialog"
        aria-live="polite"
        aria-label={t.nav.bookmarkToast.heading}
      >
        <button type="button" class="bk-toast__close" aria-label={t.nav.bookmarkToast.close}>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M18 6 6 18M6 6l12 12" />
          </svg>
        </button>
        <div class="bk-toast__icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z" />
          </svg>
        </div>
        <div class="bk-toast__body">
          <p class="bk-toast__heading">{t.nav.bookmarkToast.heading}</p>
          {/* Desktop: the {shortcut} token is replaced client-side with the
              OS-correct keys wrapped in a <kbd> — so it's left empty here and
              filled from data-tpl by the script. */}
          <p
            class="bk-toast__text bk-toast__text--desktop"
            data-tpl={t.nav.bookmarkToast.desktopBody}
          ></p>
          {/* Mobile: a share/copy action button. */}
          <div class="bk-toast__mobile">
            <p class="bk-toast__text">{t.nav.bookmarkToast.mobileBody}</p>
            <button
              type="button"
              class="bk-toast__share"
              data-copied={t.nav.bookmarkToast.copied}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
                <path d="M8.59 13.51l6.83 3.98M15.41 6.51l-6.82 3.98" />
              </svg>
              <span class="bk-toast__share-label">{t.nav.bookmarkToast.mobileButton}</span>
            </button>
          </div>
        </div>
      </aside>
    )}

    <script>
      // ── Bookmark / save nudge ─────────────────────────────────────────────
      // Shown at most once per visitor. Triggered contextually by the editor
      // after a moment of demonstrated value (e.g. pasting text).
      (() => {
        const toast = document.querySelector<HTMLElement>('.bk-toast');
        if (!toast) return;

        const STORAGE_KEY = 'pt_bookmark_nudge_seen';

        let seen = false;
        try {
          seen = localStorage.getItem(STORAGE_KEY) === '1';
        } catch {}
        if (seen) return; // already shown once — do nothing this session

        let deferredPrompt: any = null;
        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault();
          deferredPrompt = e;
        });

        // Desktop = a device with a precise, hovering pointer (i.e. a mouse).
        // Everything else (touch) takes the mobile path.
        const isDesktop = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        toast.classList.add(isDesktop ? 'bk-toast--desktop' : 'bk-toast--mobile');

        const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        const isStandalone = window.matchMedia('(display-mode: standalone)').matches || ('standalone' in navigator && (navigator as any).standalone);

        // Fill the desktop body, swapping {shortcut} for an OS-correct <kbd>.
        if (isDesktop) {
          const textEl = toast.querySelector<HTMLElement>('.bk-toast__text--desktop');
          const tpl = textEl?.dataset.tpl ?? '';
          if (textEl && tpl) {
            const isMac = /Mac|iPhone|iPad|iPod/i.test(navigator.platform || navigator.userAgent);
            const kbd = document.createElement('kbd');
            kbd.className = 'bk-toast__kbd';
            kbd.textContent = isMac ? '⌘ + D' : 'Ctrl + D';
            const [before, after] = tpl.split('{shortcut}');
            textEl.append(document.createTextNode(before ?? ''), kbd, document.createTextNode(after ?? ''));
          }
        } else {
          // Mobile adjustments
          if (isIOS && !isStandalone) {
            const label = toast.querySelector('.bk-toast__share-label');
            if (label) {
              label.innerHTML = 'Tap Share &rarr; Add to Home Screen';
            }
          }
        }

        const markSeen = () => {
          try {
            localStorage.setItem(STORAGE_KEY, '1');
          } catch {}
        };

        let shown = false;
        const show = () => {
          if (shown) return;
          shown = true;
          markSeen(); // "triggered" counts as seen — never show again
          cleanup();
          // rAF so the transition runs from the hidden state.
          requestAnimationFrame(() => toast.classList.add('is-visible'));
        };

        const hide = () => {
          toast.classList.remove('is-visible');
          markSeen();
        };

        // ── Triggers ──────────────────────────────────────────────────────
        const cleanup = () => {
          window.removeEventListener('pt:show-bookmark-toast', show);
        };

        window.addEventListener('pt:show-bookmark-toast', show, { once: true });

        // ── Interactions ──────────────────────────────────────────────────
        toast
          .querySelector<HTMLButtonElement>('.bk-toast__close')
          ?.addEventListener('click', hide);

        const shareBtn = toast.querySelector<HTMLButtonElement>('.bk-toast__share');
        shareBtn?.addEventListener('click', async () => {
          markSeen();
          
          if (deferredPrompt) {
            deferredPrompt.prompt();
            const { outcome } = await deferredPrompt.userChoice;
            deferredPrompt = null;
            if (outcome === 'accepted') {
              hide();
            }
            return;
          }

          const url = window.location.href;
          const shareData = { title: document.title, url };
          if (navigator.share) {
            try {
              await navigator.share(shareData);
            } catch {
              /* user cancelled — leave the toast as-is */
            }
            return;
          }
          // Fallback: copy the link and confirm in the button label.
          try {
            await navigator.clipboard.writeText(url);
            const label = shareBtn.querySelector('.bk-toast__share-label');
            const copied = shareBtn.dataset.copied;
            if (label && copied) label.textContent = copied;
            shareBtn.classList.add('is-copied');
          } catch {
            /* clipboard blocked — no-op */
          }
        });
      })();
    </script>

    <script>
      // Reveal the back-to-top control once the page is scrolled past a
      // threshold. Instead of reading window.scrollY on load and on every
      // scroll — a geometric read that forced a synchronous reflow (flagged by
      // Lighthouse) — we observe an off-screen sentinel SHOW_AT px down the
      // page. IntersectionObserver computes visibility off the main thread, so
      // toggling the button never thrashes layout.
      const btn = document.querySelector<HTMLButtonElement>('.to-top');
      if (btn) {
        const SHOW_AT = 400; // px scrolled before the button appears

        // Invisible, out-of-flow marker pinned SHOW_AT px from the document top
        // (position:absolute → zero layout shift). While it's in view (near the
        // top) the button stays hidden; once it scrolls out of view, the button
        // appears.
        const sentinel = document.createElement('div');
        sentinel.setAttribute('aria-hidden', 'true');
        sentinel.style.cssText =
          'position:absolute;top:' +
          SHOW_AT +
          'px;left:0;width:1px;height:1px;visibility:hidden;pointer-events:none;';
        document.body.appendChild(sentinel);

        const io = new IntersectionObserver((entries) => {
          btn.hidden = entries[0].isIntersecting;
        });
        io.observe(sentinel);

        btn.addEventListener('click', () => {
          const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
        });
      }
    </script>
  </body>
</html>

<style>
  /* Keyboard-only skip link — hidden until focused. */
  .skip-link {
    position: absolute;
    left: 16px;
    top: -48px;
    z-index: 100;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: var(--color-on-primary);
    font-size: 14px;
    font-weight: 500;
    transition: top 0.15s ease;
  }
  .skip-link:focus {
    top: 16px;
  }
  .skip-target {
    display: block;
    scroll-margin-top: 80px;
  }

  /* Floating back-to-top control — fixed bottom-right, above page content. */
  .to-top {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 40;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-e3);
    cursor: pointer;
    transition: transform 100ms ease, background 0.15s ease, color 0.15s ease;
  }
  .to-top[hidden] {
    display: none;
  }
  .to-top:hover {
    background: var(--color-canvas-soft-2);
  }
  .to-top:active {
    transform: scale(0.92);
  }
  @media (min-width: 768px) {
    .to-top {
      right: 28px;
      bottom: 28px;
    }
  }

  /* ── Bookmark / save nudge toast ───────────────────────────────────────
     Fixed-position (never in flow → zero CLS). Hidden via visibility +
     opacity + an off-screen transform; revealed by .is-visible. The device
     class (--desktop / --mobile) is added by the script and drives both
     placement and which body variant is shown. */
  .bk-toast {
    position: fixed;
    z-index: 60;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 16px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-hairline);
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: var(--shadow-e5);
    transition: opacity 0.3s ease, transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0.35s;
  }
  .bk-toast.is-visible {
    visibility: visible;
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  /* Desktop: compact card that slides in from the top-right. Sits below the
     64px sticky nav so it never covers the logo/links. */
  .bk-toast--desktop {
    right: 24px;
    top: 80px;
    width: min(360px, calc(100vw - 48px));
    transform: translateX(28px) translateY(-8px);
  }
  /* Mobile: full-width bar that slides down from the top-center. */
  .bk-toast--mobile {
    left: 16px;
    right: 16px;
    top: 80px;
    transform: translateY(calc(-100% - 96px));
  }

  /* Body-variant switching, keyed off the device class. */
  .bk-toast__mobile {
    display: none;
    flex-direction: column;
    gap: 10px;
  }
  .bk-toast--mobile .bk-toast__text--desktop {
    display: none;
  }
  .bk-toast--mobile .bk-toast__mobile {
    display: flex;
  }
  .bk-toast--desktop .bk-toast__mobile {
    display: none;
  }

  .bk-toast__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
